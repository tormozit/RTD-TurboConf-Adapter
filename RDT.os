Функция ОбновитьПараметрыМетодаИВернутьФокус(Знач ВернутьФокусВКонфигуратор = Истина, ФормаВызовМетода = Неопределено) Экспорт
	Пока Истина Цикл
		//ПозицияКаретки = ТурбоКонф.ПолучитьПозициюКаретки();  
		ЭтоДокумент = ЭтоДокумент();
		ПодключениеИР = ПодключениеИРИзКэша();
		Если ПодключениеИР = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ВернутьФокусВКонфигуратор Тогда
			ЭтоДокумент = Ложь; // Чтобы точно брать последний документ
		КонецЕсли;
		РазобратьПозициюВТексте();
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,, Истина, ЭтоДокумент, Истина);
		Если ПолеТекстаПрограммы = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ФормаВызовМетода = ПолеТекстаПрограммы.ФормаВызовМетода(Истина);
		Если Не ФормаВызовМетода.Открыта() Тогда
			Прервать;
		КонецЕсли;
		ФормаВызовМетода.Автообновление = Не ВернутьФокусВКонфигуратор; 
		Если ФормаВызовМетода.Открыта() Тогда
			ФормаВызовМетода.ОбновитьИлиЗакрытьФорму(Ложь, Истина); // полезный только 2й параметр
		КонецЕсли;
		Если ВернутьФокусВКонфигуратор Тогда
			ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
			ВернутьФокусВКонфигуратор = Ложь;
		КонецЕсли;
		ТурбоКонф.Ждать(500);
	КонецЦикла;
	Возврат ПолеТекстаПрограммы;
КонецФункции

Процедура ОткрытьПараметрыМетода() Экспорт
	ПолеТекстаПрограммы = ОбновитьПараметрыМетодаИВернутьФокус(Ложь);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	ВФоновомЗадании = ЛиВФоновомЗадании();
	СброситьКонтекст = ВФоновомЗадании;
	ФормаВызова = ПолеТекстаПрограммы.ФормаВызовМетода(СброситьКонтекст);
	Сообщить("Имя вызываемого метода = " + ПолеТекстаПрограммы.мИмяМетодаВызова);
	Если ВФоновомЗадании Тогда
		ПодключениеИР.Visible = Ложь;
		//ПодключениеИР.Предупреждение("1");
		//Возврат;
		ТурбоКонф.Ждать(20); // Без этого иногда не запоминается позиция каретки и окно открывается по центру экрана
		ФормаВызова.ЗапомнитьПозициюКаретки();
		ФормаВызова.Автообновление = Истина;
		//ФормаВызова.ПараметрПоверхВсехОкон = Истина;
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОбновитьПараметрыМетодаИВернутьФокус",, Истина);
	Иначе
		ПозицияКаретки = ТурбоКонф.ПолучитьПозициюКаретки();  
		ОповеститьПользователяОПриостановке(ПодключениеИР);
		МодулиИР = МодулиИР(ПодключениеИР);
		ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
		Окно = ТурбоКонф.ПолучитьАктивноеОкно();
		ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Метод.*", 3000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР, ПозицияКаретки);
	КонецЕсли;
	Попытка
		Результат = ФормаВызова.ОткрытьМодально();
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;  
	Если Не ВФоновомЗадании Тогда
		ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	КонецЕсли;
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	Если Результат = Истина Тогда 
		ПерейтиВПозицию(,, ПолеТекстаПрограммы, Истина); 
	ИначеЕсли ЗначениеЗаполнено(Результат) Тогда
		ПерейтиПоСсылкеМД(Результат);
	КонецЕсли;
	Если ПолеТекстаПрограммы.мЗамещающийФрагмент <> Неопределено Тогда
		ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы);
	КонецЕсли;
КонецПроцедуры

Функция ЛиВФоновомЗадании() Экспорт
	Возврат ФоновыеЗадания.ПолучитьТекущее() <> Неопределено;
КонецФункции

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура ПереименоватьСлово()
	ПозицияКаретки = ТурбоКонф.ПолучитьПозициюКаретки();  
	ЭтоДокумент = ЭтоДокумент();
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,, Истина, ЭтоДокумент, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = Неопределено;
	ОповеститьПользователяОПриостановке(ПодключениеИР);
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Переименовать.*", 2000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР, ПозицияКаретки);
	Попытка
		Результат = ПолеТекстаПрограммы.ПереименоватьСлово(Ложь);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если Результат = "НайтиВнешниеСсылки" Тогда 
		НайтиВМодулях();
	ИначеЕсли Результат <> Неопределено Тогда
		ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы,, Результат.ВесьМодульИзменен);
	КонецЕсли;
КонецПроцедуры 

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
//&ВосстанавливатьБуферОбмена
Процедура ОбъявитьТипВыражения()
	ЭтоДокумент = ЭтоДокумент();
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, ЭтоДокумент);
	Если Ложь
		Или ПолеТекстаПрограммы = Неопределено 
		Или ПолеТекстаПрограммы.мЯзыкПрограммы <> 0
		//Или ПолеТекстаПрограммы.мМетодМодуля = Неопределено
	Тогда
		Возврат;
	КонецЕсли;

	//ИмяПараметра = ПолеТекстаПрограммы.мКонтекст;
	//ОткрытьКонтекстноеМеню();
	//КликнутьПоЭлементу("Рефакторинг", "элемент меню");
	//Если ПустаяСтрока(ПолеТекстаПрограммы.мМетодМодуля.ТипЗначения) Тогда
	//	Добавка = "процедуры";
	//Иначе
	//	Добавка = "функции";
	//КонецЕсли;
	//ИмяЭлементаМеню = "Создать описание " + Добавка;
	//КликнутьПоЭлементу(ИмяЭлементаМеню, "элемент меню");
	//Если ТурбоКонф.НайтиЭлементПоИмени(ИмяЭлементаМеню, "элемент меню") Тогда
	//	ТурбоКонф.Клавиша(Клавиши.Escape);
	//КонецЕсли;
	//Если ТурбоКонф.НайтиЭлементПоИмени("Рефакторинг", "элемент меню") Тогда
	//	ТурбоКонф.Клавиша(Клавиши.Escape);
	//	ПоказатьВсплывающееУведомление("Команда применима только внутри метода доступного для изменении модуля");
	//	Возврат;
	//КонецЕсли;
	//РазобратьПозициюВТексте();
	//ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, ЭтоДокумент);
	//ПолеТекстаПрограммы.ОбъявитьТипВыражения(ИмяПараметра);
	//
	Если Не ПолеТекстаПрограммы.ОбъявитьТипВыражения() Тогда
		Возврат;
	КонецЕсли;
	Если ПолеТекстаПрограммы.мЗаменяемыйДиапазон = Неопределено Тогда
		ПередатьГраницыВыделенияИзПолеТекстаПрограммы(ПолеТекстаПрограммы);
		Возврат;
	КонецЕсли;
	ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы, Ложь, Ложь);
КонецПроцедуры 

Процедура ВыделитьТекущееСловоПоляДокумента() Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.W);
КонецПроцедуры 

//&ЗапроситьИнформациюОДокументе
Процедура ЗапомнитьДляСравнения()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Текст = ВыделенныйТекст;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Текст = ТекстМодуля;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗапомнитьТекстДляСравнения(ПодключениеИР, ПолеТекстаПрограммы, Текст);
КонецПроцедуры

Процедура ЗапомнитьТекстДляСравнения(Знач ПодключениеИР, Знач ПолеТекстаПрограммы, Знач Текст) Экспорт
	Результат = ПолеТекстаПрограммы.ЗапомнитьДляСравнения(Ложь, Текст);
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		ПоказатьВсплывающееУведомление(Результат);
	Иначе
		ВосстановитьОкноПриложения(ПодключениеИР);
	КонецЕсли;
КонецПроцедуры

Процедура АвтодополнениеМодальное()
	ПозицияКаретки = ТурбоКонф.ПолучитьПозициюКаретки();
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	// ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта);
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,, Истина);
	ОповеститьПользователяОПриостановке(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Тип:.*", 2000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР, ПозицияКаретки);
	Попытка
		ПолеТекстаПрограммы.ОткрытьАвтодополнение(, Истина);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура СинтаксПомощник()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.F1);
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяНастройки = "AutoFilterSyntaxHelper"; 
	Если ТурбоКонф.ПолучитьЗначениеНастройки(ИмяНастройки) Тогда
		Если ЛиДоступнаУстановкаПользовательскихНастроек() Тогда
			ТурбоКонф.УстановитьЗначениеНастройкиПрограммы(ЭтотОбъект, ИмяНастройки, Ложь, "Нужно для автоматического выбора главы синтакс-помощника");
		Иначе
			//СписокРекомендаций.Добавить("Отключить ""Ассистирование/ Автоматически показывать фильтр выбора главы синтакс-помощника""");
		КонецЕсли; 
	КонецЕсли;
	ТаблицаТипов = ПолеТекстаПрограммы.ТаблицаТиповТекущегоВыражения(Ложь, Ложь, Истина, Ложь, Ложь); // полезный - 4й
	ИскомаяСтрока = "";
	Если ТаблицаТипов.Количество() > 0 Тогда
		ЛучшийТип = ТаблицаТипов.Получить(0);
		Если ПолеТекстаПрограммы.ЛиСистемноеСлово(ЛучшийТип) Тогда
			Если Не ЗначениеЗаполнено(ИскомаяСтрока) Тогда
				Попытка
					ТипКонтекста = ЛучшийТип.СтрокаОписания.ТипКонтекста;
					ИскомаяСтрока = ТипКонтекста;
				Исключение
				КонецПопытки;
				ПодготовитьИмяТипаДляПоискаВГлавахСинтаксПомощника(ИскомаяСтрока, ПолеТекстаПрограммы);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИскомаяСтрока) Тогда
				Попытка
					ИскомаяСтрока = ЛучшийТип.СтрокаОписания.БазовыйТип;
				Исключение
					ИскомаяСтрока = ЛучшийТип.СтрокаОписания.Слово;
				КонецПопытки;
				Если ЗначениеЗаполнено(ИскомаяСтрока) Тогда
					ИскомаяСтрока = "/" + ПолеТекстаПрограммы.ПолноеИмяТипаИзСокращенного(ИскомаяСтрока);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИскомаяСтрока) Тогда
			// Например ПередЗаписью
			Если Не ЗначениеЗаполнено(ПолеТекстаПрограммы.мРодительскийКонтекст) Тогда
				Попытка
					ИскомаяСтрока = ПолеТекстаПрограммы.мМодульМетаданных.СтруктураТипа.ИмяОбщегоТипа;
				Исключение
				КонецПопытки;
				ПодготовитьИмяТипаДляПоискаВГлавахСинтаксПомощника(ИскомаяСтрока, ПолеТекстаПрограммы);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.КонтролКлавиша(Клавиши.F1);
	Сообщить("ИскомаяСтрока=" + ИскомаяСтрока);
	Если ИскомаяСтрока = "" Тогда
		ПоказатьПредложениеОткрытьПсевдокодПлатформы(ПодключениеИР, ПолеТекстаПрограммы, ТипКонтекста);
		Возврат;
	КонецЕсли;
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	ЛиОднозначныйРезультат = Ложь;
	Если ПолеТекстаПрограммы.мЯзыкПрограммы = 0 Тогда
		Если СтрНачинаетсяС(ТурбоКонф.ПолучитьЗаголовокТекущегоОкна(), "Выбор главы") Тогда
			Если НайтиСтрокуВОкне(ИскомаяСтрока) Тогда
				ЗаголовокТекущегоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
				Если Не СтрНачинаетсяС(ЗаголовокТекущегоОкна, "Выбор главы") Тогда
					Сообщить("Не найдена глава справки. ЗаголовокТекущегоОкна = " + ЗаголовокТекущегоОкна);
					ТурбоКонф.Клавиша(Клавиши.Enter);
				Иначе
					Если НайтиГлавуСинтаксПомощникаВСпискеВыбора(ИскомаяСтрока) Тогда
						ТурбоКонф.Клавиша(Клавиши.F3);
						ТурбоКонф.Ждать(20);
						ЛиОднозначныйРезультат = Не НайтиГлавуСинтаксПомощникаВСпискеВыбора(ИскомаяСтрока);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Уже открыта нужная страница синтакс-помощника или это мета слово
			ПоказатьПредложениеОткрытьПсевдокодПлатформы(ПодключениеИР, ПолеТекстаПрограммы, ТипКонтекста);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ЛиОднозначныйРезультат Тогда
		ТурбоКонф.Клавиша(Клавиши.Enter);
	Иначе
		ТурбоКонф.Клавиша(Клавиши.Escape);
		ВосстановитьОкноПриложения(ПодключениеИР);
		ПолеТекстаПрограммы.ОткрытьКонтекстнуюСправку(ВыделенныйТекст);
	КонецЕсли; 
	ПоказатьПредложениеОткрытьПсевдокодПлатформы(ПодключениеИР, ПолеТекстаПрограммы, ТипКонтекста);
	
	//ТурбоКонф.КонтролШифтКлавиша(Клавиши.F1);
	//
	//// Активируем вкладку "Индекс"
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	////Если ТурбоКонф.НайтиЭлементПоИмени("Содержание", "вкладка") Тогда
	////	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	////	ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, 1000, Истина);
	////ИначеЕсли ТурбоКонф.НайтиЭлементПоИмени("Поиск", "вкладка") Тогда
	////	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	////	ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, 1000, Истина);
	////КонецЕсли;
	//КликнутьПоЭлементу("Индекс", "элемент вкладки");
	//ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, 1000, Истина);

	//ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	//ТурбоКонф.ОтправитьТекст(ПолноеИмяСлова);
	//ТурбоКонф.Клавиша(Клавиши.Enter);
	//ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры   

Процедура ПоказатьПредложениеОткрытьПсевдокодПлатформы(Знач ПодключениеИР, Знач ПолеТекстаПрограммы, Знач ТипКонтекста) Экспорт
	//Если ПолеТекстаПрограммы.мИмяМодуля = ПолеТекстаПрограммы.мПлатформа.ИмяМодуляПсевдокодаПлатформы() Тогда
	//	Возврат;
	//КонецЕсли; 
	МодулиИР = МодулиИР(ПодключениеИР);
	ТекущееСлово = ПоследнийФрагментЛкс(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ПолеТекстаПрограммы.мКонтекст, "("));
	СсылкаВызова = ПолеТекстаПрограммы.СсылкаВызоваСобытияИзПсевдокодаПлатформы(ТекущееСлово, ТипКонтекста);
	Если ЗначениеЗаполнено(СсылкаВызова) Тогда
		ПараметрыОбработчика = Новый Структура;
		ПараметрыОбработчика.Вставить("Ссылка", СсылкаВызова);
		ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Показать использование в псевдокоде платформы",, ЭтотОбъект, "ОткрытьВызовыСобытияИзПсевдокодаПлатформы", ПараметрыОбработчика);
	КонецЕсли;
КонецПроцедуры   

Процедура ОткрытьВызовыСобытияИзПсевдокодаПлатформы(Параметры)
	// Не нашел способа универсально закрыть активное модальное окно из клика уведомления
	ОкноВыбораГлавы = ТурбоКонф.НайтиОкноПоЗаголовку("Выбор главы");
	Если ОкноВыбораГлавы Тогда
		ТурбоКонф.АктивироватьОкно(ОкноВыбораГлавы);
		ЗакрытьМодальноеОкно();
	КонецЕсли;
	
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта);
	ПерейтиПоСсылкеМД(Параметры.Ссылка); 
КонецПроцедуры

Функция ПодготовитьИмяТипаДляПоискаВГлавахСинтаксПомощника(ИскомаяСтрока, Знач ПолеТекстаПрограммы) Экспорт
	Если ЗначениеЗаполнено(ИскомаяСтрока) Тогда
		ИскомаяСтрока = ПолеТекстаПрограммы.ПолноеИмяТипаИзСокращенного(ИскомаяСтрока);
		Если ИскомаяСтрока <> "Глобальный контекст" Тогда
			ИскомаяСтрока = СтрЗаменить(ИскомаяСтрока, "формы клиентского приложения для ", "");
			ИскомаяСтрока = "/" + ИскомаяСтрока;
		КонецЕсли;
		ИскомаяСтрока = ИскомаяСтрока + "/";
	КонецЕсли;
	Возврат ИскомаяСтрока;
КонецФункции

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура СинтаксПомощникИР()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР);
	ПолеТекстаПрограммы.ОткрытьКонтекстнуюСправку();
КонецПроцедуры

Функция НайтиГлавуСинтаксПомощникаВСпискеВыбора(Знач ИскомаяСтрока) Экспорт
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина
		И Не СтрЗаканчиваетсяНа(ИскомаяСтрока, "/") 
		И Не СтрЗаканчиваетсяНа(ТурбоКонф.ПолучитьИмяЭлемента(), ИскомаяСтрока)
		И СтрНачинаетсяС(ТурбоКонф.ПолучитьЗаголовокТекущегоОкна(), "Выбор главы")
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала < 1000
	Цикл
		ТурбоКонф.Клавиша(Клавиши.F3);
	КонецЦикла;
	Результат = Истина;
	Если Не СтрНачинаетсяС(ТурбоКонф.ПолучитьЗаголовокТекущегоОкна(), "Выбор главы") Тогда
		ТурбоКонф.Клавиша(Клавиши.Enter);
		Результат = Ложь;
	КонецЕсли;
	Возврат Результат;
КонецФункции

//&ЗапроситьИнформациюОДокументе
Процедура НайтиВМодулях(Знач ЧтоИскать = Неопределено)
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РежимСсылки = Ложь;
	ОкноПоискаОткрыто = Ложь;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Если ПустаяСтрока(ЧтоИскать) Тогда
			ЧтоИскать = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР);
			РежимСсылки = ЗначениеЗаполнено(ЧтоИскать);
		КонецЕсли;
		ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
		Если ПустаяСтрока(ЧтоИскать) Тогда
			ЧтоИскать = ВыделенныйТекст();
		КонецЕсли;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР); // Надо делать до открытия формы ИР, т.к. она может эмулировать ввод в режиме управляемого приложения
	Если РежимСсылки Тогда
		Если Не ПолеТекстаПрограммы.ОткрытьПоискВызововСлова(ЧтоИскать, Истина, Ложь) Тогда 
			Возврат;
		КонецЕсли;
	Иначе
		Если Не ПолеТекстаПрограммы.ОткрытьПоискВМодулях(ЧтоИскать, Ложь) Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); // Так пользователь сможет прерывать
	ЗапуститьКонтрольДлительныхОперацийИР();
КонецПроцедуры

//.
// Параметры:
//   ПодключениеИР - Application {V83.Application}, Неопределено - 
// Возвращаемое значение:
//    - 
Функция ПолеТекстаПрограммыБезКонтекста(ПодключениеИР) Экспорт
	Результат = ПолеТекстаПрограммыИР(ПодключениеИР,,,, Ложь, Ложь, Ложь);
	Возврат Результат;
КонецФункции

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура ДеревоВызововМетода()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РежимСсылки = Ложь;
	ОкноПоискаОткрыто = Ложь;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		ПоказатьВсплывающееУведомление("Команда доступна только в модуле");
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР); // Надо делать до открытия формы ИР, т.к. она может эмулировать ввод в режиме управляемого приложения
	Если Не ПолеТекстаПрограммы.ОткрытьДеревоВызовов(Неопределено, Ложь) Тогда 
		Возврат;
	КонецЕсли;
	//ТурбоКонф.КонтролКлавиша(Клавиши.Enter); // Так пользователь сможет прерывать
КонецПроцедуры 

Процедура АнализЗамера() 
	Если Не ТурбоКонф.НайтиЭлементПоИмени("Для вызова процедур и функций включать время выполнения", "флажок") Тогда
		ПоказатьВсплывающееУведомление("Команда доступна только в окне замера производительности");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	ИмяФайла = СохранитьСодержимоеОкнаВоВременныйФайл("pff");
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ВосстановитьОкноПриложения(ПодключениеИР);
	ТурбоКонф.Ждать(100);
	МодулиИР.ирКлиент.ОткрытьЗамерПроизводительностиЛкс(ИмяФайла);
КонецПроцедуры

Функция СохранитьСодержимоеОкнаВоВременныйФайл(Знач Расширение = "mxl", Знач РазмерСерииДоступности = 1) Экспорт
	ТурбоКонф.ОткрытьМеню("Файл", "Сохранить копию...");
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	Если Не УстановитьИмяФайлаВДиалогеВыбораФайла(ИмяФайла, "Сохран", РазмерСерииДоступности) Тогда
		ИмяФайла = "";
	КонецЕсли;
	Возврат ИмяФайла;
КонецФункции

Функция ЗагрузитьСодержимоеОкнаИзФайла(Знач ИмяФайла) Экспорт
	Если Не КликнутьПоЭлементу("Открыть...", "кнопка") Тогда
		ТурбоКонф.ОткрытьМеню("Файл", "Открыть...");
	КонецЕсли;
	Возврат УстановитьИмяФайлаВДиалогеВыбораФайла(ИмяФайла, "Открыт");
КонецФункции

//.
// Параметры:
//    ИмяФайла - Строка - 
// Возвращаемое значение:
//  Булево - Истина, если дождались окна и отправили в него выбранное имя файла
Функция УстановитьИмяФайлаВДиалогеВыбораФайла(Знач ИмяФайла, Знач ЗаголовокОкна, Знач РазмерСерииДоступности = 1) Экспорт
	ОкноСохранения = ТурбоКонф.ЖдатьОкно(ЗаголовокОкна, 2000, Истина, Истина);
	//Если Не ЖдатьПотерюАктивностиОкна() Тогда 
	//	Сообщить("Не дождались появления диалога выбора файла");
	//	Возврат Ложь;
	//КонецЕсли;
	УстановитьЗначениеПолюВвода(ИмяФайла);
	Возврат ЖдатьДоступностиФайла(ИмяФайла,, РазмерСерииДоступности);
КонецФункции 

// .
//
// Параметры:
//  ИмяФайла	 - Строка - 
//  ЧислоСекунд		- Число - 
// 
// Возвращаемое значение:
//  Булево - Истина, если файл стал доступен
//
Функция ЖдатьДоступностиФайла(Знач ИмяФайла, Знач ЧислоСекунд = 2, Знач РазмерСерииДоступности = 1) Экспорт
	МоментНачала = ТекущаяДата();
	Файл = Новый Файл(ИмяФайла);
	Пока ТекущаяДата() <= МоментНачала + ЧислоСекунд Цикл 
		Попытка
			Пустышка = Файл.ПолучитьВремяИзменения();
			ФайлДоступен = Истина;
		Исключение
			ФайлДоступен = Ложь;
		КонецПопытки;
		Если ФайлДоступен Тогда
			РазмерСерииДоступности = РазмерСерииДоступности - 1;
			Если РазмерСерииДоступности = 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		ТурбоКонф.Ждать(100);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПодпискиНаСобытия()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	АктивироватьТекущийОбъектВДеревеКонфигурации();
	МодулиИР = МодулиИР(ПодключениеИР);
	СсылкаНаОбъектМД = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР, Истина);
	ВосстановитьОкноПриложения(ПодключениеИР);
	Если СтрНачинаетсяС(СсылкаНаОбъектМД, "ПодпискаНаСобытие") Тогда
		Событие = ПодключениеИР.String(ПодключениеИР.Метаданные.ПодпискиНаСобытия.Найти(СтрРазделить(СсылкаНаОбъектМД, ".")[1]).Событие); // Опасный тип https://www.hostedredmine.com/issues/959928
	Иначе
		ОбъектМД = СсылкаНаОбъектМД;
	КонецЕсли;
	МодулиИР.ирКлиент.ОткрытьПодпискиНаСобытияЛкс(ОбъектМД, Событие);
КонецПроцедуры 

Процедура ОткрытьОбъектМетаданных()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	АктивироватьТекущийОбъектВДеревеКонфигурации();
	МодулиИР = МодулиИР(ПодключениеИР);
	СсылкаНаОбъектМД = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР);
	ВосстановитьОкноПриложения(ПодключениеИР);
	МодулиИР.ирКлиент.ОткрытьОбъектМетаданныхЛкс(СсылкаНаОбъектМД);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура ПроверитьМодуль()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР);
	ПолеТекстаПрограммы.ОткрытьПроверкуМодуля();
	ТурбоКонф.Ждать(200); // Для того чтобы сообщения первого запуска сразу выводились, иначе они будут видно только после выполнения
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); // Так пользователь сможет прерывать
	ЗапуститьКонтрольДлительныхОперацийИР();
КонецПроцедуры

Процедура ЗапуститьКонтрольДлительныхОперацийИР()
	ИмяМетода = "ЖдатьЗавершенияДлительнойОперацииПриложенияИР";
	// Бесполезная проверка, т.к. предыдущие запуски в другом процессе сидят и тут мы их не увидим
	//ВыбранныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("ИмяМетода, Состояние", ИмяМетода, СостояниеФоновогоЗадания.Активно));
	//Если ВыбранныеЗадания.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
	ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода);
КонецПроцедуры

Процедура ЖдатьЗавершенияДлительнойОперацииПриложенияИР(ИДПроцесса) Экспорт
	ПодключениеИР = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР");
	Пока Истина Цикл
		СохранитьЗначениеСеансаКонфигуратора("БлокировкаПриложенияИР", Истина, Ложь);
		Попытка
			Если Не ПодключениеИР.Visible Тогда // Тут встаем в ожидание
				ПодключениеИР = Неопределено;
			КонецЕсли;
		Исключение
			Если ПодключениеИР <> Неопределено Тогда
				ТурбоКонф.ПоказатьВсплывающееУведомление("Ошибка проверки блокировки приложения ИР: " + НазваниеСкрипта(), ОписаниеОшибки());
			КонецЕсли;
			ПодключениеИР = Неопределено;
		КонецПопытки;
		СохранитьЗначениеСеансаКонфигуратора("БлокировкаПриложенияИР", Ложь, Ложь);
		Если ПодключениеИР = Неопределено Тогда
			Сообщить("Приложение ИР скрыто после длительной операции");
			Возврат;
		КонецЕсли;
		ТурбоКонф.Ждать(2000);
	КонецЦикла;
КонецПроцедуры

// Не используется
Процедура ЗапуститьПроверкуМодулей()
	// https://github.com/EvilBeaver/OneScript/blob/723c08d85bd991ec2eabf8277572e368867faf01/src/OneScript.StandardLibrary/Tasks/BackgroundTasksManager.cs#L156
	ИмяМетода = "ПроверитьИзмененныеМодули";
	// Бесполезная проверка, т.к. предыдущие запуски в другом процессе сидят и тут мы их не увидим
	//ВыбранныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("ИмяМетода, Состояние", ИмяМетода, СостояниеФоновогоЗадания.Активно));
	//Если ВыбранныеЗадания.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
	ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода);
КонецПроцедуры

Процедура ПроверитьИзмененныеМодули()
	ДатаПоследнейПроверки = ВосстановитьЗначениеБазы("ДатаПоследнейПроверки");
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = МодулиИР.ирКэш.ПолеТекстаПрограммы(0);
	//ПолеТекстаПрограммы.ПроверитьМодули(ДатаПоследнейПроверки);
	Если ПолеТекстаПрограммы.ОшибкиМодуля.Количество() > 0 Тогда
		ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеПриложения(), СтрШаблон("В измененных модулях выявлено %1 возможных ошибок", ),, ЭтотОбъект, "ПоказатьНайденныеОшибки");
	КонецЕсли;
КонецПроцедуры

Процедура ПоказатьНайденныеОшибки() Экспорт
	ВосстановитьОкноПриложения(ПодключениеИРИзКэша());
КонецПроцедуры

Процедура СписокОбщихМетодов()
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Процедуры и функции" Тогда
		ЗакрытьМодальноеОкно();
	КонецЕсли;
	ОткрытьСписокМетодов();
	ЗапуститьКонтрольДлительныхОперацийИР();
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура СписокМетодовМодуля()
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Процедуры и функции" Тогда
		ЗакрытьМодальноеОкно();
	КонецЕсли;
	ОткрытьСписокМетодов(Истина);
КонецПроцедуры

Процедура ОткрытьСписокМетодов(ТолькоЭтогоМодуля = Ложь)
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР);
	ПолеТекстаПрограммы.ОткрытьСписокМетодов(ВыделенныйТекст, ТолькоЭтогоМодуля);
КонецПроцедуры

Процедура РедактироватьКомпоновку()
	ЗаголовокКнопки = "Сохранить схему в файл";
	Если Не ТурбоКонф.НайтиЭлементПоИмени(ЗаголовокКнопки, "кнопка") Тогда
		ПоказатьВсплывающееУведомление("Команда доступна только в окне конструктора схемы компоновки");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Для Счетчик = 1 По 7 Цикл
		Если ТурбоКонф.НайтиЭлементПоИмени(ЗаголовокКнопки, "кнопка") Тогда
			Прервать;
		КонецЕсли;
		ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	КонецЦикла;
	Если Не КликнутьПоЭлементу(ЗаголовокКнопки, "кнопка") Тогда
		Возврат;
	КонецЕсли;
	Если Не УстановитьИмяФайлаВДиалогеВыбораФайла(ИмяФайла, "Сохран") Тогда 
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ВосстановитьОкноПриложения(ПодключениеИР);
	ТурбоКонф.Ждать(200);
	МодулиИР.ирКлиент.РедактироватьСхемуКомпоновкиИзФайлаЛкс(ИмяФайла);
	ПоказатьВсплывающееУведомление("Измененную схему нужно будет вручную загрузить в конфигуратор!", 4000);
	УдалитьФайлы(ИмяФайла);
КонецПроцедуры

//&ВосстанавливатьБуферОбмена
Процедура РедактироватьТаблицу()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаголовокДокумента = ТурбоКонф.ПолучитьЗаголовокКонфигуратора(Конфигуратор.ГлавноеОкно);
	СтарыйЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	ТурбоКонф.КонтролКлавиша(Клавиши.G); // Раньше была проверка через контекстное меню, но она работала нестабильно (похоже что то залипало в Турбоконфе)
	ТурбоКонф.Ждать(50);
	НовыйЗаголовок = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если НовыйЗаголовок <> "Перейти к ячейке" Тогда
		Если НовыйЗаголовок <> СтарыйЗаголовокОкна Тогда
			ЗакрытьМодальноеОкно();
		КонецЕсли;
		ПоказатьВсплывающееУведомление("Для редактирования таблицы необходимо вызывать команду в табличном документе");
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ИмяВременногоФайла = СохранитьСодержимоеОкнаВоВременныйФайл(, 2);
	Если ПустаяСтрока(ИмяВременногоФайла) Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.Ждать(100);
	МодулиИР = МодулиИР(ПодключениеИР);
	ЗаголовокДокумента = СокрЛП(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ЗаголовокДокумента, " - Конфигуратор -"));
	
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ОповеститьПользователяОПриостановке(ПодключениеИР); 
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Табл.*", 5000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		Результат = МодулиИР.ирКлиент.РедактироватьТабличныйДокументИзФайлаЛкс(ИмяВременногоФайла, ЗаголовокДокумента);
	Исключение
		Результат = Ложь;
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	
	Если Результат Тогда
		Попытка
			ТурбоКонф.Ждать(50);
			ЗагрузитьСодержимоеОкнаИзФайла(ИмяВременногоФайла);
			// непонятно как определить, что файл уже загрузился
			ТурбоКонф.Ждать(100);
			КомандаВыделитьВсе();
			ТурбоКонф.Копировать();
			ЗакрытьДочернееОкноКонфигуратора();
			КомандаВыделитьВсе();
			ТурбоКонф.ВставитьТекстИзБуфера(); 
		Исключение
			ПоказатьВсплывающееУведомление("Файл таблицы сохранен:
			|" + ИмяВременногоФайла, 10000);
			ВызватьИсключение;
		КонецПопытки;
		ТурбоКонф.АльтКлавиша(Клавиши.Enter);  
		
		// Переключаем палитру свойств в режим "Табличный документ"
		ТурбоКонф.КонтролАльтКлавиша(Клавиши.I);
		ТурбоКонф.Клавиша(Клавиши.Tab);
		ТурбоКонф.КонтролКлавиша(Клавиши.Down);
		ТурбоКонф.Клавиша(Клавиши.Up);
		ТурбоКонф.Клавиша(Клавиши.Enter);
		
		АктивироватьСвойствоВПалитреСвойств("СохранятьСвойстваОтображения", 1);
		Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
			ТурбоКонф.Клавиша(Клавиши.Space);
			ТурбоКонф.КонтролКлавиша(Клавиши.G);  
			ТурбоКонф.ЖдатьОкно("Перейти к ячейке", 1000, Истина);
			ТурбоКонф.Клавиша(Клавиши.D2);
			ЗакрытьМодальноеОкно(, Клавиши.Enter);
			Если Не КликнутьПоЭлементу("Зафиксировать таблицу", "кнопка") Тогда
				ТурбоКонф.ОткрытьМеню("Таблица", "Вид", "Зафиксировать таблицу");
			КонецЕсли;
		КонецЕсли;
		// Переключаем палитру свойств в режим "Ячейки"
		ТурбоКонф.КонтролАльтКлавиша(Клавиши.I);
		ТурбоКонф.Клавиша(Клавиши.Tab);
		ТурбоКонф.КонтролКлавиша(Клавиши.Down);
		ТурбоКонф.Клавиша(Клавиши.Down);
		ТурбоКонф.Клавиша(Клавиши.Enter); 
		
		ТурбоКонф.Клавиша(Клавиши.Escape);
		ТурбоКонф.Клавиша(Клавиши.Right); // Снимаем выделение
		ТурбоКонф.Клавиша(Клавиши.Left);
	КонецЕсли;
	УдалитьФайлы(ИмяВременногоФайла); 
КонецПроцедуры

Процедура КомандаВыделитьВсе() Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.A);
КонецПроцедуры

Функция ВосстановитьЗначениеСеансаКонфигуратора(Ключ, ИДКонфигуратора = Неопределено)
	Если Не ЗначениеЗаполнено(ИДКонфигуратора) Тогда
		ИДКонфигуратора = Конфигуратор.PID;
	КонецЕсли;
	СеансБазы = "" + ИДКонфигуратора; 
	Значение = ТурбоКонф.ВосстановитьЗначениеСеанса(СеансБазы + Ключ);
	//Сообщить("ВосстановитьЗначениеСеансаКонфигуратора. СеансБазы=" + СеансБазы + ";" + Ключ + "=" + Значение);
	Возврат Значение;
КонецФункции

Процедура СохранитьЗначениеСеансаКонфигуратора(Ключ, Значение, Знач ПисатьВЛог = Истина)
	Если Не ЗначениеЗаполнено(Конфигуратор) Тогда
		Возврат;
	КонецЕсли;
	ИДКонфигуратора = Конфигуратор.PID;
	ПодлюченныеКонфигураторы = ТурбоКонф.ВосстановитьЗначениеСеанса("ИР.ПодлюченныеКонфигураторы");
	Если ПодлюченныеКонфигураторы = Неопределено Тогда
		ПодлюченныеКонфигураторы = Новый Соответствие();
	КонецЕсли;
	Если ПодлюченныеКонфигураторы[ИДКонфигуратора] = Неопределено Тогда
		ПодлюченныеКонфигураторы[ИДКонфигуратора] = 1;
		ТурбоКонф.СохранитьЗначениеСеанса("ИР.ПодлюченныеКонфигураторы", ПодлюченныеКонфигураторы);
	КонецЕсли;
	СеансБазы = "" + ИДКонфигуратора;
	ТурбоКонф.СохранитьЗначениеСеанса(СеансБазы + Ключ, Значение);
	Если ПисатьВЛог Тогда
		Сообщить("СохранитьЗначениеСеансаКонфигуратора. СеансБазы=" + СеансБазы + ";" + Ключ + "=" + Значение);
	КонецЕсли;
КонецПроцедуры

Функция ПодлюченныеКонфигураторы()
	ПодлюченныеКонфигураторы = ТурбоКонф.ВосстановитьЗначениеСеанса("ИР.ПодлюченныеКонфигураторы");
	Если ПодлюченныеКонфигураторы = Неопределено Тогда
		ПодлюченныеКонфигураторы = Новый Соответствие();
	КонецЕсли;	
	Возврат ПодлюченныеКонфигураторы;
КонецФункции

// Возвращает либо здоровое подключение, либо Неопределено
Функция ПодключениеИРИзКэша(Знач ИДКонфигуратора = Неопределено, ИДПриложения = Неопределено)
	Если ЛиПриложениеИРЗаблокировано(ИДКонфигуратора) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПодключениеИР = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР", ИДКонфигуратора); // Application {V83.Application}
	Если ПодключениеИР <> Неопределено Тогда
		ИДПриложения = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИД", ИДКонфигуратора);
		Попытка
			Пустышка = ПодключениеИР.Visible;
		Исключение
			ПроцессОС = ПолучитьПроцессОСЛкс(ИДПриложения);
			Если ПроцессОС <> Неопределено Тогда
				УбитьПроцесс(ПроцессОС, "из-за порчи");
			КонецЕсли;
			Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
			ПодключениеИР = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат ПодключениеИР;
КонецФункции 

// Если ИДКонфигуратора пустой, то после закрытия конфигуратора возвращает Истина.
// Возвращаемое значение:
//  Булево  - 
Функция ЛиПриложениеИРЗаблокировано(Знач ИДКонфигуратора = Неопределено)
	Если Не ЗначениеЗаполнено(ИДКонфигуратора) И Не ЗначениеЗаполнено(Конфигуратор) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ВосстановитьЗначениеСеансаКонфигуратора("БлокировкаПриложенияИР", ИДКонфигуратора) = Истина Тогда
		Указатель = ПоказатьВсплывающееУведомление("Команды адаптера отключены до завершения длительной операция в приложении ИР", 2000);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Функция - Строка соединения базы ИР с пользователем и паролем
//
// Параметры:
//  ПарольИлиСтрокаСоединения	 - 	 - 
//  СтрокаСоединенияБезПароля		 - 	 - выходной
// 
// Возвращаемое значение:
//   - 
//
Функция СтрокаСоединенияБазыИР(Знач ПарольИлиСтрокаСоединения = Неопределено, СтрокаСоединенияБезПароля = "")
	Если ПарольИлиСтрокаСоединения = Неопределено Тогда
		ПарольИлиСтрокаСоединения = ВосстановитьЗначениеБазы("ПарольИлиСтрокаСоединения", Истина);
	КонецЕсли;
	Если ЛиСтрокаСоединения(ПарольИлиСтрокаСоединения) Тогда
		СтрокаСоединения = ПарольИлиСтрокаСоединения;
		СтрокаСоединенияБезПароля = СтрокаСоединенияБезПароля(СтрокаСоединения);
	Иначе
		СтрокаСоединенияБезПароля = СтрокаСоединенияБазыКонфигуратора();
		СтрокаСоединения = СтрокаСоединенияБезПароля + СтрШаблон("Pwd=""%1"";", ПарольИлиСтрокаСоединения);
	КонецЕсли;
	//МаркерПользователя = ";usr=";
	//Если Не ЛиКраткаяСПользователем И Найти(НРег(СтрокаСоединенияБезПароля), МаркерПользователя) > 0 Тогда
	//	СтрокаСоединенияБезПароля = Лев(СтрокаСоединенияБезПароля, СтрНайти(НРег(СтрокаСоединенияБезПароля), МаркерПользователя) - 1);
	//КонецЕсли;
	Сообщить("Строка соединения базы " + НазваниеПриложения() + " без пароля = " + СтрокаСоединенияБезПароля);
	Возврат СтрокаСоединения;
КонецФункции

Функция СтрокаСоединенияБезПароля(Знач СтрокаСоединения) Экспорт
	СтрокаСоединенияБезПароля = СтрокаСоединения;
	МаркерПароля = "pwd=";
	ПозицияПароля = Найти(НРег(СтрокаСоединенияБезПароля), МаркерПароля);
	Если ПозицияПароля > 0 Тогда
		СтрокаСоединенияБезПароля = Лев(СтрокаСоединенияБезПароля, ПозицияПароля - 1);
	КонецЕсли;
	Возврат СтрокаСоединенияБезПароля;
КонецФункции

//.
// Параметры:
//    ПарольИлиСтрокаСоединения - Строка - 
// Возвращаемое значение:
//    Булево - 
Функция ЛиСтрокаСоединения(Знач ПарольИлиСтрокаСоединения) Экспорт
	Результат = Истина
		И Найти(ПарольИлиСтрокаСоединения, "=") > 0 
		И Найти(ПарольИлиСтрокаСоединения, ";") > 0
		И (Ложь
			Или Найти(НРег(ПарольИлиСтрокаСоединения), "file") > 0
			Или Найти(НРег(ПарольИлиСтрокаСоединения), "srvr") > 0);
	Возврат Результат;
КонецФункции

Функция СтрокаСоединенияБазыКонфигуратора(Знач СПользователем = Истина)
	ИнфоПроцесса = ИнфоПроцесса();
	Если ИнфоПроцесса.Режим = "Серверный" Тогда
		СтрокаСоединения = СтрШаблон("Srvr=""%1"";Ref=""%2"";", ИнфоПроцесса.Сервер, ИнфоПроцесса.БазаДанных);
	Иначе
		СтрокаСоединения = СтрШаблон("File=""%1"";", ИнфоПроцесса.Каталог);  
	КонецЕсли;
	Если СПользователем И ЗначениеЗаполнено(ИнфоПроцесса.Пользователь) Тогда
		СтрокаСоединения = СтрокаСоединения + СтрШаблон("Usr=""%1"";", ИнфоПроцесса.Пользователь);
	КонецЕсли;
	//Сообщить("Строка соединения базы конфигуратора = " + СтрокаСоединения);
	Возврат СтрокаСоединения;
КонецФункции

Функция ИнфоПроцесса()
	Возврат Конфигуратор.ПараметрыИнформационнойБазы;
КонецФункции

Функция ПодключениеИРНовое() Экспорт
	ПодключениеИР(,,,, Истина);
КонецФункции

Функция ПодключениеИР(Знач ПарольИлиСтрокаСоединения = Неопределено, Знач РазобратьПозициюВТексте = Истина, Знач ВидимостьДляНовогоПодключения = Ложь, выхПодключеноНоНетПодсистемы = Ложь,
	Знач ЗапретитьФоновыйРежим = Ложь) Экспорт
	
	Если ЛиПриложениеИРЗаблокировано() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если РазобратьПозициюВТексте Тогда
		РазобратьПозициюВТексте();
	КонецЕсли;
	Если ПарольИлиСтрокаСоединения = Неопределено И Не ПроверитьРазрешениеИР() Тогда
		ПродолжитьОбработкуНажатияКлавиш();
		Возврат Неопределено; 
	КонецЕсли;
	Если Не ЗапретитьФоновыйРежим Тогда
		ПодключениеИР = ПодключениеИРИзКэша();
		Если ПодключениеИР <> Неопределено Тогда
			Возврат ПодключениеИР;
		КонецЕсли;
		// TODO переделать на ЗапуститьМоноФоновоеЗадание
		ДатаЗапускаПодключенияИР = ВосстановитьЗначениеСеансаКонфигуратора("ДатаЗапускаПодключенияИР");
		Если Истина
			И ЗначениеЗаполнено(ДатаЗапускаПодключенияИР) 
			И ТекущаяДата() - ДатаЗапускаПодключенияИР < 60
		Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЗапуститьПодключениеИР();
		Возврат Неопределено;
	КонецЕсли;
	ТекущаяВерсияТурбоКонф = ТурбоКонф.ПолучитьВерсиюТурбоКонф();
	Если ТекущаяВерсияТурбоКонф < МинимальнаяВерсияТурбоКонф Тогда
		Сообщить("Несовместимая версия ТурбоКонф", СтатусСообщения.Внимание);
		ТекстСообщения = СтрШаблон("Обнаружена несовместимая версия TurboConf. Необходима версия %1 и выше", МинимальнаяВерсияТурбоКонф);
		ПоказатьВсплывающееУведомление(ТекстСообщения, 5000); // Может заблокироваться модальным окном и будет мешаться
	КонецЕсли;
	ТурбоКонф.СохранитьЗначениеСеанса("СтрокаЗапускаОбновлениеКэшаМодулей", Неопределено);
	СтрокаСоединенияБезПароля = "";
	СтрокаСоединения = СтрокаСоединенияБазыИР(ПарольИлиСтрокаСоединения, СтрокаСоединенияБезПароля);
	УведомлениеЗапуска = ПоказатьВсплывающееУведомление("Подключается приложение " + НазваниеПриложения() + ". Закрыть его можно командой ЗакрытьПриложениеИР.", 60000);
	ЛиДоступноУправлениеМодальнымОкнами = ТурбоКонф.ПолучитьВерсиюТурбоКонф() > "6.2.";
	СохранитьЗначениеСеансаКонфигуратора("ДатаЗапускаПодключенияИР", ТекущаяДата());
	//ТурбоКонф.Ждать(10000);
	Попытка
		Для НомерПопытки = 1 По 2 Цикл
			Попытка
				МоментСтартаПроцесса = ТекущаяДата();
				ПодключениеИР = Новый COMОбъект("V83.Application");
				ПроцессОС = ПолучитьПроцессОСЛкс(, МоментСтартаПроцесса,, "-Embedding");
				Если ПроцессОС = Неопределено Тогда
					ПоказатьВсплывающееУведомление("Не удалось найти идентификатор процесса COM объекта. Сообщите разработчику.");
				Иначе
					ИдентификаторПроцессаИР = ПроцессОС.ProcessID;
				КонецЕсли;
				Если ЛиДоступноУправлениеМодальнымОкнами Тогда
					// Для отлова модального окна ошибки обработчиков начала работы системы https://turboconf.ru/Tasks/9443
					ИДЗадачи = "" + ТекущаяДата();
					ТурбоКонф.НачатьУправлениеМодальнымиОкнами(5000, , ИдентификаторПроцессаИР,, ИДЗадачи); 
				КонецЕсли;
				УспехПодключения = ПодключениеИР.Connect(СтрокаСоединения);
				Если ЛиДоступноУправлениеМодальнымОкнами Тогда
					ТурбоКонф.ЗавершитьУправлениеМодальнымиОкнами(ИДЗадачи);
				КонецЕсли;
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				УспехПодключения = Ложь;
			КонецПопытки;
			Если УспехПодключения Тогда
				Прервать;
			Иначе
				ПодключениеИР = Неопределено;
				Если Ложь
					Или Найти(ОписаниеОшибки, "пароль") > 0
					Или Найти(ОписаниеОшибки, "password") > 0 
					Или Найти(ОписаниеОшибки, "Пользователь ИБ не идентифицирован") > 0 
				Тогда
					Если ПарольИлиСтрокаСоединения = Неопределено Тогда
						ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Неверное имя или пароль. Команда СброситьНастройкиАдаптераБазы настроит подключение заново." + Символы.ПС + ОписаниеОшибки,,
							ЭтотОбъект, "СброситьНастройкиАдаптераБазы");
					Иначе
						ПоказатьВсплывающееУведомление("Неверное имя или пароль." + Символы.ПС + ОписаниеОшибки);
					КонецЕсли;
					ЗавершитьОперациюПодключения(УведомлениеЗапуска);
					Возврат Неопределено;
				ИначеЕсли Ложь
					Или Найти(ОписаниеОшибки, "0x800706BE") > 0
				Тогда
					ПоказатьВсплывающееУведомление("Ошибка подключения ИР: " + ОписаниеОшибки);
					ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Ошибка инициации приложения. Подробности в журнале регистрации.",, ЭтотОбъект, "ОткрытьЖурналРегистрации");
					ЗавершитьОперациюПодключения(УведомлениеЗапуска);
					Возврат Неопределено;
				КонецЕсли;
				Если НомерПопытки = 2 Тогда
					ФрагментыОшибки = СтрРазделитьЛкс(ОписаниеОшибки, "COMException):", Истина,,,, Истина);
					Если ФрагментыОшибки.Количество() > 1 Тогда
						ОписаниеОшибки = ФрагментыОшибки[1];
					КонецЕсли;
					ОписаниеОшибки = "Ошибка подключения приложения ИР " + СтрокаСоединенияБезПароля + " через COM V83.Application:
					|"+ ОписаниеОшибки; 
					ПоказатьВсплывающееУведомление(ОписаниеОшибки, 6000);
					Сообщить(ОписаниеОшибки, СтатусСообщения.Важное);
					Если Найти(ОписаниеОшибки, "Ошибка разделенного доступа") = 0 Тогда
						ПоказатьВсплывающееУведомление(//"Не удалось подключиться к текущей инфобазе через COM интерфейс V83.Application."
								"Если ошибка связана с COM, откройте в базе ""Управление COM классами 1С"" из ""Инструменты разработчика"" и зарегистрируйте V83.Application текущей версии платформы 1С. Затем перезапустите Турбоконф.");
					КонецЕсли;
					ЗавершитьОперациюПодключения(УведомлениеЗапуска);
					Возврат Неопределено;
				КонецЕсли;
				ИмяИсполняемогоФайла = ИмяИсполняемогоФайла();
				Сообщить("Файл конфигуратора = " + ИмяИсполняемогоФайла);
				Если ТекущаяВерсияТурбоКонф >= "6.0.8771.35683" Тогда 
					Сообщить("Разрядность конфигуратора = " + Конфигуратор.РазрядностьПроцесса);
					Если Конфигуратор.РазрядностьПроцесса = 32  Тогда
						Подветка = "";
						ТекущаяРазрядность = "32";
						УдаляемаяРазрядность = "64";
					Иначе 
						Подветка = "\WOW6432Node";
						ТекущаяРазрядность = "64";
						УдаляемаяРазрядность = "32";
					КонецЕсли;
					РеестрОС = ПолучитьCOMОбъект("winmgmts:{impersonationLevel=impersonate}!\\.\root\default:StdRegProv");
					ВеткаРеестра = "SOFTWARE\Classes" + Подветка + "\CLSID\{e92b75e3-2ea1-4fec-b493-cef3ec59fca6}\LocalServer32";
					
					КорневаяВетка = "2147483650"; // HKLM, HKEY_LOCAL_MACHINE
					Попытка
						// TODO OneScript 1.7 пока не умеет читать выходные параметры из COM https://github.com/EvilBeaver/OneScript/issues/1324
						//РеестрОС.GetStringValue(КорневаяВетка, ВеткаРеестра,, ИмяФайлаКласса);  
						//
						ИмяФайлаЛокальнойМашины = ТурбоКонф.ПолучитьЗначениеИзРеестра("HKEY_LOCAL_MACHINE\" + ВеткаРеестра, "", "");
					Исключение
						// https://turboconf.ru/Tasks/9040#c69369430a1c4dc987f6e5d83f5b9467
						ИмяФайлаЛокальнойМашины = ""; 
					КонецПопытки;
					Сообщить(УдаляемаяРазрядность + "b класс V83.Application локальной машины = " + ИмяФайлаЛокальнойМашины);
					Если ЗначениеЗаполнено(ИмяФайлаЛокальнойМашины) Тогда
						Если РеестрОС.DeleteKey(КорневаяВетка, ВеткаРеестра) > 0 Тогда
							ТекстСообщения = "Запустите TurboConf от имени администратора, чтобы адаптер удалил " + УдаляемаяРазрядность + "b класс V83.Application. "
								+ "Или удалите его вручную через ""Управление COM классами 1С (ИР)"".";
							ПоказатьВсплывающееУведомление(ТекстСообщения, 10000);
							Сообщить(ТекстСообщения);
							ЗавершитьОперациюПодключения(УведомлениеЗапуска);
							Возврат Неопределено;
						Иначе
							ТекстСообщения = "Удален " + УдаляемаяРазрядность + "b класс V83.Application из HKLM, чтобы ОС отдавала " + ТекущаяРазрядность + "b вместо него.";
							//ПоказатьВсплывающееУведомление(ТекстСообщения, 4000);
							Сообщить(ТекстСообщения);
						КонецЕсли;
					КонецЕсли;
					
					КорневаяВетка = "2147483649"; // HKCU, HKEY_CURRENT_USER
					Попытка
						ИмяФайлаТекущегоПользователя = ТурбоКонф.ПолучитьЗначениеИзРеестра("HKEY_CURRENT_USER\" + ВеткаРеестра, "", "");
					Исключение
						// https://turboconf.ru/Tasks/9040#c69369430a1c4dc987f6e5d83f5b9467
						ИмяФайлаТекущегоПользователя = ""; 
					КонецПопытки;
					Сообщить(УдаляемаяРазрядность + "b класс V83.Application текущего пользователя = " + ИмяФайлаТекущегоПользователя);
					Если ЗначениеЗаполнено(ИмяФайлаТекущегоПользователя) Тогда
						Если РеестрОС.DeleteKey(КорневаяВетка, ВеткаРеестра) > 0 Тогда
							ТекстСообщения = "Ошибка удаления " + УдаляемаяРазрядность + "b класс V83.Application из HKCU. Удалите его вручную через ""Управление COM классами 1С (ИР)"".";
							ПоказатьВсплывающееУведомление(ТекстСообщения, 6000);
							Сообщить(ТекстСообщения);
							ЗавершитьОперациюПодключения(УведомлениеЗапуска);
							Возврат Неопределено;
						Иначе 
							ТекстСообщения = "Удален " + УдаляемаяРазрядность + "b класс V83.Application из HKCU, чтобы ОС отдавала " + ТекущаяРазрядность + "b вместо него.";
							//ПоказатьВсплывающееУведомление(ТекстСообщения, 4000);
							Сообщить(ТекстСообщения);
						КонецЕсли;
					КонецЕсли;
					ЗапуститьПриложение("""" + ИмяИсполняемогоФайла + """ /RegServer -CurrentUser",, Истина);
					ПоказатьВсплывающееУведомление("Из-за ошибки подключения регистрируем класс V83.Application для текущей версии платформы 1С и текущего пользователя ОС", 3000);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ДлительностьПодключения = ТекущаяДата() - МоментСтартаПроцесса;
		ЗаголовокПриложенияИР = НазваниеПриложения() + " - " + СтрРазделитьЛкс(СтрокаСоединенияБезПароля, "Usr")[0];
		Попытка
			ПодключениеИР.КлиентскоеПриложение.УстановитьЗаголовок(ЗаголовокПриложенияИР);
		Исключение
			// 8.3.9-
			ПодключениеИР.УстановитьЗаголовокСистемы(ЗаголовокПриложенияИР);
		КонецПопытки;
		ПодключениеИР.Visible = ВидимостьДляНовогоПодключения;
		ТекстСообщенияПодключено = СтрШаблон("Приложение " + ЗаголовокПриложенияИР + " подключено за %1 секунд", ДлительностьПодключения);
		ИспользуемоеИмяФайлаПортативногоИР = "";
		МодулиИР = МодулиИР(ПодключениеИР,, ИспользуемоеИмяФайлаПортативногоИР);
		Если МодулиИР = Неопределено Тогда
			выхПодключеноНоНетПодсистемы = Истина;
			ЗавершитьОперациюПодключения(УведомлениеЗапуска);
			Возврат Неопределено;
		КонецЕсли;
		СохранитьЗначениеБазы("ИспользуемоеИмяФайлаПортативногоИР", ИспользуемоеИмяФайлаПортативногоИР);
		Если МодулиИР <> Неопределено Тогда
			ИмяФайлаБуфера = ПолучитьИмяВременногоФайла();
			Попытка
				НомерВерсииПодсистемыИР = МодулиИР.ирКэш.НомерВерсииПодсистемыИРЛкс();
			Исключение
				НомерВерсииПодсистемыИР = 0;
			КонецПопытки;
			Если НомерВерсииПодсистемыИР < Число(СтрЗаменить(МинимальнаяВерсияИР, ".", "")) Тогда
				ПодключениеИР.Visible = Истина;
				Сообщить("Несовместимая версия подсистемы ИР: " + НомерВерсииПодсистемыИР);
				ТекстСообщения = СтрШаблон("Обнаружена несовместимая версия подсистемы """ + НазваниеПодсистемы() + """. Необходима версия %1 и выше", МинимальнаяВерсияИР);
				ПоказатьВсплывающееУведомление(ТекстСообщения, 5000); // Может заблокироваться модальным окном и будет мешаться
				ПодключениеИР.Сообщить(ТекстСообщения);
				МодулиИР.ирКлиент.ОткрытьСправкуПоПодсистемеЛкс();
			КонецЕсли;
			Попытка
				МодулиИР.ирКлиент.ПодключитьСвязанныйКонфигураторЛкс(Конфигуратор.PID, ИмяФайлаБуфера); // ИР 7.03+
			Исключение
				ПодключениеИР.Visible = Истина;
				ТекстСообщения = "Нет прав на использование подсистемы """ + НазваниеПодсистемы() + """";
				Если ПустаяСтрока(Конфигуратор.ПараметрыИнформационнойБазы.Пользователь) Тогда
					ТекстСообщения = ТекстСообщения + ". Необходимо создать пользователя.";
				КонецЕсли;
				ПоказатьВсплывающееУведомление(ТекстСообщения, 5000); // Может заблокироваться модальным окном и будет мешаться
				ПодключениеИР.Сообщить(ТекстСообщения);
			КонецПопытки;
			МодулиИР.ирКлиент.ЗакрытьВсеЧужиеФормыЛкс();
			Попытка
				ПодключениеИР.СтандартныеПодсистемыКлиент.ПропуститьПредупреждениеПередЗавершениемРаботыСистемы(); // Для БСП
			Исключение
				// Из-за этого потом не пробрасываются исключения https://github.com/EvilBeaver/OneScript/issues/1495
			КонецПопытки;
			Если ПарольИлиСтрокаСоединения = Неопределено Тогда
				МодулиИР.ирКэш.СостояниеПодготовкиКэшМДСеансаЛкс();
				МодулиИР.ирКэш.ПолеТекстаПрограммы().РазобратьТекущийКонтекст(); // внутри выполнится ИнициацияОписанияМетодовИСвойств()
				МодулиИР.ирКэш.ПолеТекстаПрограммы().ПодготовитьГлобальныйКонтекст();
			КонецЕсли;
		КонецЕсли;
		ЗапрещенныеОбработчикиОжидания = Новый Массив;
		ЗапрещенныеОбработчикиОжидания.Добавить("ОбработчикОжиданияПроверкиДинамическогоИзмененияИБ"); //БСП 2.0
		Для Каждого ИмяОбработчика Из ЗапрещенныеОбработчикиОжидания Цикл
			ПодключениеИР.ОтключитьОбработчикОжидания(ИмяОбработчика);
		КонецЦикла;
		УстановитьРазрешениеИР(Истина);
		Если ЗакрытьПриложениеИР(, "замещено новым", Истина) Тогда
			СеансИР = ПодключениеИР.ПолучитьТекущийСеансИнформационнойБазы();
			СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР", ПодключениеИР);
			СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИД", МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс());
			СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.Кэш", Новый Соответствие);
			СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.НомерСеанса", СеансИР.НомерСеанса);
			СохранитьЗначениеСеансаКонфигуратора("ИмяФайлаБуфера", ИмяФайлаБуфера);
		КонецЕсли; 
		ПоказатьВсплывающееУведомление(ТекстСообщенияПодключено, 3000);
		ЗапуститьМоноФоновоеЗадание("СледитьЗаТекущимМетодомФоновый", 1000000);
	Исключение
		// В фоне не перехватывает исключение https://github.com/EvilBeaver/OneScript/issues/1495
		//Сообщить("====Тест");
		//ЗакрытьПриложениеИР(, "Ошибка запуска");
		ЗавершитьОперациюПодключения(УведомлениеЗапуска);
		ПоказатьВсплывающееУведомление("Ошибка подключения: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьОперациюПодключения(УведомлениеЗапуска);
	// ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта); // Видимо позже еще раз берет фокус
	Возврат ПодключениеИР; 
КонецФункции

Процедура ПродолжитьОбработкуНажатияКлавиш(Знач ЗначениеФлага = Истина) Экспорт
	Попытка
		ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = ЗначениеФлага;
	Исключение
		// 6.2.8963.2470-
	КонецПопытки;
КонецПроцедуры

Функция ИмяИсполняемогоФайла()
	Результат = ТурбоКонф.ПолучитьПутьКИсполняемомуФайлу(Конфигуратор.ГлавноеОкно) + "\1cv8.exe";
	Возврат Результат;
КонецФункции

Процедура ЗавершитьОперациюПодключения(УведомлениеЗапуска)
	СохранитьЗначениеСеансаКонфигуратора("ДатаЗапускаПодключенияИР", Неопределено);
	ТурбоКонф.СкрытьВсплывающееУведомление(УведомлениеЗапуска);
КонецПроцедуры  

//&ЗапроситьИнформациюОДокументе
//&ВосстанавливатьБуферОбмена
Процедура НайтиВОкнах()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Истина);
	Если ПолеТекстаПрограммы <> Неопределено Тогда
		МетодМодуля = ПолеТекстаПрограммы.мМетодМодуля;
		Если МетодМодуля <> Неопределено Тогда
			ИмяМетода = МетодМодуля.Имя;
		КонецЕсли;
	КонецЕсли;
	Если ПолеТекстаПрограммы = Неопределено Тогда
		ПолноеИмяОбъекта = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР);
		Сообщить("ПолноеИмяОбъекта = "+ ПолноеИмяОбъекта);
		Фрагменты = СтрРазделитьЛкс(ПолноеИмяОбъекта);
		Если Фрагменты.Количество() = 2 Тогда
			// Это объект первого уровня
			ОткрытьКонтекстноеМенюДереваМетаданных();
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			Если Истина
				И ТурбоКонф.НайтиЭлементПоИмени("Справочная информация", "элемент меню")
				И КликнутьПоЭлементу("Изменить", "элемент меню") 
			Тогда 
				ЖдатьСменуТекущегоЭлемента(СтарыйИД);
				АктивироватьТекущийОбъектВДеревеКонфигурации();
				ВернутьсяВПредыдущееМестоКонфигуратора();
				ЗакрытьДочернееОкноКонфигуратора();
			КонецЕсли;
		КонецЕсли;
		Если Фрагменты.Количество() >= 4 Тогда
			// Это реквизит
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			ВернутьсяВПредыдущееМестоКонфигуратора();
			ЖдатьСменуТекущегоЭлемента(СтарыйИД);
			СжатоеИмяОбъектаОкна = СжатоеИмяОбъектаОкна(ПодключениеИР);
			Сообщить("Сжатое имя объекта = "+ СжатоеИмяОбъектаОкна);
			Если СтрЧислоВхождений(СжатоеИмяОбъектаОкна, ".") = 2 Тогда
				ТурбоКонф.АльтКлавиша(Клавиши.D4);
				НажатьКлавишуЦикл(Клавиши.Right, 4);
				ТурбоКонф.Ждать(20);
				Если НайтиСтрокуВОкне("(" + Фрагменты[0] + "Объект." + Фрагменты[1] + ")", Истина) Тогда
					НажатьКлавишуЦикл(Клавиши.Left, 4);
					ТурбоКонф.Клавиша(Клавиши.Add);
					ТурбоКонф.Клавиша(Клавиши.Down);
					ТурбоКонф.Ждать(20);
					Если Истина
						И НайтиСтрокуВОкне(Фрагменты[3]) 
						И Фрагменты.Количество() = 6
					Тогда
						ТурбоКонф.Клавиша(Клавиши.Add);
						ТурбоКонф.Клавиша(Клавиши.Down);
						ТурбоКонф.Ждать(20);
						НайтиСтрокуВОкне(Фрагменты[5]);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		АктивироватьТекущийОбъектВДеревеКонфигурации();
	КонецЕсли;
	
	ОткрытьОкноОкна();
	Если Не УстановитьФокусВПервуюТаблицуИлиСписок() Тогда
		Возврат;
	КонецЕсли;
	//ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента(); // Не работает
	//ТекстЯчейки = ТурбоКонф.ПолучитьЭлементыСписка()[0];
	ТурбоКонф.КопироватьТекстВБуфер();
	ТекстЯчейки = ТурбоКонф.ПолучитьБуферОбмена();
	Сообщить("ТекстЯчейки="+ТекстЯчейки);
	// Без клика не сработает CTRL+F
	Если Не КликнутьПоЭлементу(ТекстЯчейки, "элемент списка") Тогда
		Возврат;
	КонецЕсли;
	Если НайтиСтрокуВОкне("Сравнение") Тогда
		ЗакрытьМодальноеОкно(, Клавиши.Enter);
		УстановитьФокусВПервуюТаблицуИлиСписок();
		ТурбоКонф.Клавиша(Клавиши.Add);
		Возврат;
	КонецЕсли;
	МаркерыОконКонфигураций = Новый Массив;
	МаркерыОконКонфигураций.Добавить(".cf");
	МаркерыОконКонфигураций.Добавить("Конфигурация базы данных");
	Для Каждого МаркерОкна Из МаркерыОконКонфигураций Цикл
		Если НайтиСтрокуВОкне(МаркерОкна) Тогда
			ЗакрытьМодальноеОкно(, Клавиши.Enter);
			//ТурбоКонф.КонтролАльтКлавиша(Клавиши.M); // Всегда активирует фильтр основной конфигурации
			
			// Через фильтр
			//Если Не ПустаяСтрока(ТурбоКонф.ПолучитьИмяЭлемента()) Тогда
			//	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
			//КонецЕсли;
			//УстановитьЗначениеПолюВвода(ИмяОбъекта);
			
			// Через поиск
			Если ПустаяСтрока(ТурбоКонф.ПолучитьИмяЭлемента()) Тогда
				ТурбоКонф.Клавиша(Клавиши.Tab); // Активируем дерево
			КонецЕсли; 
			Если НайтиОбъектМетаданныхВДереве(ПолноеИмяОбъекта) Тогда
				ТурбоКонф.Клавиша(Клавиши.Add);
			КонецЕсли;   
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	// Через глобальный поиск
	//ЗакрытьМодальноеОкно();
	//НайтиВОткрытыхДокументах(ИмяОбъекта, ПолноеИмяОбъекта);
	ЗакрытьМодальноеОкно();

КонецПроцедуры

//.
// Параметры:
//   ИмяОбъекта - Произвольный - 
//   ПолноеИмяОбъекта - Произвольный, Строка - 
Процедура НайтиВОткрытыхДокументах(Знач ИмяОбъекта, Знач ПолноеИмяОбъекта) Экспорт
	ОткрытьГлобальныйПоиск();
	НажатьКлавишуЦикл(Клавиши.Tab, 3);
	ИмяНастройки = ТурбоКонф.ПолучитьЗначение();
	Если ПустаяСтрока(ИмяНастройки) Тогда
		УстановитьЗначениеПолюВвода("Основная", Ложь);
		ЗакрытьМодальноеОкно(); // Чтобы сохранилась настройка
		ОткрытьГлобальныйПоиск();
	КонецЕсли;
	НажатьКлавишуЦикл(Клавиши.Tab, 3, Истина);
	УстановитьЗначениеПолюВвода(ИмяОбъекта, Ложь);
	НажатьКлавишуЦикл(Клавиши.Tab, 2);
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.Клавиша(Клавиши.Space); // Включаем "Слово целиком"
	КонецЕсли;
	НажатьКлавишуЦикл(Клавиши.Tab, 1);
	ИмяСтаройНастройки = ТурбоКонф.ПолучитьЗначение();
	УстановитьЗначениеПолюВвода("Свойства в открытых документах", Ложь);
	НажатьКлавишуЦикл(Клавиши.Tab, 5);
	ТурбоКонф.Клавиша(Клавиши.Space); // Снимаем все пометки
	НажатьКлавишуЦикл(Клавиши.Tab, 4, Истина);
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Клавиша(Клавиши.Space); // Включаем "Свойства"
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	НажатьКлавишуЦикл(Клавиши.Tab, 2);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.Клавиша(Клавиши.Space); // Выключаем "Искать в файлах"
	КонецЕсли;
	НажатьКлавишуЦикл(Клавиши.Tab, 1);
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.Клавиша(Клавиши.Space); // Включаем "Искать в открытых документах"
	КонецЕсли;
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ЗакрытьМодальноеОкно(,Клавиши.Enter);
	ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, 5000, Ложь);
	ОткрытьРезультатыПоиска();
	Если НайтиСтрокуВОкне(ПолноеИмяОбъекта) Тогда
		ТурбоКонф.Клавиша(Клавиши.Enter);
		ТурбоКонф.Клавиша(Клавиши.Add);
	КонецЕсли;
	// Восстановим настройку глобального поиска
	ОткрытьГлобальныйПоиск();
	НажатьКлавишуЦикл(Клавиши.Tab, 3);
	ТурбоКонф.КонтролКлавиша(Клавиши.Down);
	КликнутьПоЭлементу(ИмяСтаройНастройки, "элемент списка");
	ЗакрытьМодальноеОкно(); // Чтобы сохранилась настройка
	//ПоказатьВсплывающееУведомление("Окно сравнения конфигураций или файла конфигурации не найдено");
КонецПроцедуры

Функция ОткрытьРезультатыПоиска() Экспорт
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.O); //Иначе панель результатов не возьмет фокус
	Если Не КликнутьПоЭлементу("Результаты поиска", "кнопка") Тогда
		ТурбоКонф.ОткрытьМеню("Окна", "Служебные окна", "Результаты поиска");
	КонецЕсли;
КонецФункции

Процедура ОткрытьГлобальныйПоиск() Экспорт
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.F);
	ТурбоКонф.ЖдатьОкно("Глобальный поиск по текстам", 2000, Истина);
КонецПроцедуры

Процедура ОткрытьОкноОкна() Экспорт
	Если Не КликнутьПоЭлементу("Окна…", "кнопка") Тогда
		ТурбоКонф.ОткрытьМеню("Окна", "Окна…"); // Символ "многоточие"!
	КонецЕсли;
	ТурбоКонф.ЖдатьОкно("Окна", 1000, Истина);
КонецПроцедуры

Процедура АктивироватьТекущийОбъектВДеревеКонфигурации() Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.T);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&_ВосстанавливатьБуферОбмена
Процедура НайтиПоследнююПравкуВХранилище()
	ТипЭлементаИнтерфейса = ПолучитьТипТекущегоЭлемента();
	Если Не ЭтоДокумент(ТипЭлементаИнтерфейса) Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МетодМодуля = ПолеТекстаПрограммы.мМетодМодуля;
	Если МетодМодуля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяМетода = МетодМодуля.Имя;
	ОпределениеРабочее = ПолеТекстаПрограммы.ТекстМетодаСОписанием(МетодМодуля);
	ТипМодуля = ПолеТекстаПрограммы.мМодульМетаданных.ТипМодуля;
	АктивироватьТекущийОбъектВДеревеКонфигурации();
	ОткрытьКонтекстноеМеню();
	КликнутьПоЭлементу("Выборочная история объекта", "элемент меню");
	КликнутьПоЭлементу("Модуль", "элемент меню");
	КликнутьПоЭлементу("Модуль объекта", "элемент меню");
	КликнутьПоЭлементу("Форма", "элемент меню");
	ОкноФильтра = ТурбоКонф.ЖдатьОкно("Отбор выборочной истории объекта", 2000, Истина);
	Если ОкноФильтра = 0 Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.ЖдатьЗакрытияОкна(ОкноФильтра,, 1000);
	ТекстСтрокиИсторииСтарый = "";
	ТурбоКонф.Ждать(500); // Было 300
	Пока Истина Цикл
		ОткрытьКонтекстноеМеню(); 
		КликнутьПоЭлементу("Сравнить выборочно с объектом конфигурации", "элемент меню");
		КликнутьПоЭлементу("Модуль", "элемент меню");
		КликнутьПоЭлементу("Модуль объекта", "элемент меню");
		КликнутьПоЭлементу("Форма (Модуль)", "элемент меню");
		ТурбоКонф.Ждать(50);
		ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
		Если ЗаголовокОкна = "Выборочное сравнение" Тогда
			// Версии идентичны. Нажимаем ОК
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			ТурбоКонф.Клавиша(Клавиши.Enter);
		Иначе
			ТурбоКонф.Клавиша(Клавиши.Tab);
			РазобратьПозициюВТексте();
			ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Ложь);
			СтрокаМетода = ПолеТекстаПрограммы.мМодульМетаданных.Методы.Найти(НРег(ИмяМетода), "НИмя");
			ОпределениеИзВерсии = "";
			Если СтрокаМетода <> Неопределено Тогда
				ОпределениеИзВерсии = ПолеТекстаПрограммы.ТекстМетодаСОписанием(СтрокаМетода);
			КонецЕсли;
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			Если ОпределениеИзВерсии <> ОпределениеРабочее Тогда
				НайтиСтрокуВОкне(СтрПолучитьСтроку(СокрЛ(ОпределениеРабочее), 1));
				ВосстановитьОкноПриложения(ПодключениеИР);
				МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(ОпределениеИзВерсии, ОпределениеРабочее, Ложь, "Старая", "Новая",,,,, "ВстроенныйЯзык", ИмяМетода);
				//ТурбоКонф.КонтролКлавиша(Клавиши.F); // Антибаг Турбоконфа https://turboconf.ru/Tasks/9876 . После завершения потока прилетит еще нажатие Escape. Поэтому откроем бесполезное окно
				Возврат;
			КонецЕсли;
			// Закрываем немодальное окно сравнения текстов модулей
			//ТурбоКонф.Клавиша(Клавиши.Escape); // Антибаг Турбоконфа https://turboconf.ru/Tasks/9876 . Отключаем какой то внутренний цикл (оверлей?)
			//ТурбоКонф.Клавиша(Клавиши.Escape); 
			ЗакрытьМодальноеОкно(); // Не понял почему, но проблему https://turboconf.ru/Tasks/9876 решило именно это
		КонецЕсли;
		ЖдатьСменуТекущегоЭлемента(СтарыйИД);
		ТекстСтрокиИсторииНовый = ВыделенныйТекст(Ложь);
		Если не ЗначениеЗаполнено(ТекстСтрокиИсторииНовый) Тогда
			ВызватьИсключение "Не удалось получить текст элемента списка версий";
		КонецЕсли;
		Если ТекстСтрокиИсторииСтарый = ТекстСтрокиИсторииНовый Тогда
			Прервать;
		КонецЕсли;
		ТекстСтрокиИсторииСтарый = ТекстСтрокиИсторииНовый;
		ТурбоКонф.Клавиша(Клавиши.Up);
	КонецЦикла;

КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ВосстанавливатьБуферОбмена
Процедура НайтиПоследнююПравкуВГите()
	ТипЭлементаИнтерфейса = ПолучитьТипТекущегоЭлемента();
	Если Не ЭтоДокумент(ТипЭлементаИнтерфейса) Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//СтароеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	Если Не ПолеТекстаПрограммы.ОткрытьМодульВГите() Тогда
		ВосстановитьОкноПриложения(ПодключениеИР);
	КонецЕсли;
	//ТурбоКонф.ЖдатьСменуАктивногоОкна(СтароеОкно, 1000, Истина);   
	ТурбоКонф.ЖдатьОкно("Visual Studio Code", 2000, Ложь, Истина);
	Если Найти(ТурбоКонф.ПолучитьЗаголовокТекущегоОкна(), "Visual Studio Code") = 0 Тогда
		ПоказатьВсплывающееУведомление("Не удалось дождаться активации окна Visual Studio Code. Поэтому туда НЕ передан текст из окна модуля конфигуратора.");
		Возврат;
	КонецЕсли; 
	//Если ТурбоКонф.ПолучитьТипТекущегоЭлемента() <> "редактор" тогда
	ТурбоКонф.Ждать(500);
	// https://turboconf.ru/Tasks/9445
	//ТурбоКонф.УстановитьЗначение(ТекстМодуля); // Зависает
	КомандаВыделитьВсе();
	ТурбоКонф.ВставитьТекст(ТекстМодуля); // Часто делает двойную вставку, но не всегда
	ТурбоКонф.КонтролКлавиша(Клавиши.Z); // Откатывает возможную вторую вставку 
	ТурбоКонф.КонтролКлавиша(Клавиши.Z); // Откатывает первую вставку или делает ничего
	ТурбоКонф.КонтролКлавиша(Клавиши.Y); // Повторяет первую вставку. Альтернативное сочетание по умолчанию - Ctrl+Shift+Z
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.КонтролКлавиша(Клавиши.G);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	//ТурбоКонф.ВставитьТекст(XMLСтрока(НомерСтрокиТекста)); // Делает двойную вставку // часто вызывает ошибку "Сбой при выполнении запрошенной операции с буфером обмена"
	//ТурбоКонф.КонтролКлавиша(Клавиши.Z); // Откатывает вторую вставку
	ТурбоКонф.ОтправитьТекст(XMLСтрока(НомерСтрокиТекста)); // Работает
	//ТурбоКонф.УстановитьЗначение(XMLСтрока(НомерСтрокиТекста)); // Не работает
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры

Процедура НажатьКлавишуЦикл(Знач Клавиша, Знач Количество, Знач ЗажатьШифт = Ложь, Знач ЗажатьКонтрол = Ложь)
	Для Счетчик = 1 По Количество Цикл
		Если ЗажатьШифт Тогда
			ТурбоКонф.ШифтКлавиша(Клавиша);
		ИначеЕсли ЗажатьКонтрол Тогда
			ТурбоКонф.КонтролКлавиша(Клавиша);
		Иначе
			ТурбоКонф.Клавиша(Клавиша);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура РазобратьПозициюВТексте(ПолучатьТипЭлемента = Истина)
	Если ПолучатьТипЭлемента Тогда
		ТипЭлементаИнтерфейса = ПолучитьТипТекущегоЭлемента(); // 8мс
	КонецЕсли;
	Сообщить("Разобрана позиция в элементе интерфейса типа """ + ТипЭлементаИнтерфейса + """");
	ВыделенныйТекст = "";
	ПозицияВТексте = 0;
	НомерСтрокиТекста = 0;
	НомерКолонкиТекста = 0;
	Если Ложь
		Или ЭтоДокумент(ТипЭлементаИнтерфейса) 
		Или ТипЭлементаИнтерфейса = ТипЭлемента.Поле 
		Или ТипЭлементаИнтерфейса = ТипЭлемента.ПолеСоСписком
	Тогда
		ТекстМодуля = ТурбоКонф.ПолучитьТекстСПозицией(ВыделенныйТекст, ПозицияВТексте, НомерКолонкиТекста, НомерСтрокиТекста);
	КонецЕсли;
КонецПроцедуры

Функция МодулиИР(Знач Приложение, Знач ЭтоПервоеПодключение = Ложь, выхИспользуемоеИмяФайлаПортативногоИР = "") Экспорт
	ИспользуемоеИмяФайла = "";
	Попытка
		ирПлатформа = Приложение.ирПортативный;
		//ФлагОбновления = Приложение.ирПлатформа; // Вызывает 200мс задержку в некоторых случаях
		ФлагОбновления = Приложение.ирПерехватКлавиатуры;
		Значение = Приложение;
	Исключение
		Если Не ЗначениеЗаполнено(ПапкаПортативногоИР) Тогда
			ПапкаПортативногоИР = ТекущийКаталог() + "\" + ТурбоКонф.ПолучитьКаталогСкрипта() + "\ИР";
			Файл = Новый Файл(ПапкаПортативногоИР);
			Сообщить("Каталог ИР = " + ПапкаПортативногоИР);
			Если Не Файл.Существует() Тогда
				СоздатьКаталог(ПапкаПортативногоИР);
				Файл = Новый Файл(ПапкаПортативногоИР + "\ИР.zip");
				Попытка
					ТурбоКонф.ЗагрузитьФайл("http://devtool1c.ucoz.ru/load/0-0-1-6-20", Файл.ПолноеИмя, ЭтотОбъект, "ПослеЗавершенияЗагрузкиФайла", Файл.ПолноеИмя);  
				Исключение
					ПоказатьВсплывающееУведомление("В базе нет подсистемы """ + НазваниеПодсистемы() + """ и в " + ПапкаПортативногоИР + " нет ее портативного варианта."
						+ " Ссылки для скачивания на случай недоступности сайта ИР:
						|Расширение - http://devtool1c.ucoz.ru/load/osnovnye/ustanovshhik_varianta_rasshirenie/1-1-0-21 
						|Портативный - http://devtool1c.ucoz.ru/load/osnovnye/portativnye_instrumenty_razrabotchika_dlja_1s_8_2/1-1-0-6", 6000);
				КонецПопытки;  
				ПапкаПортативногоИР = "";
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПапкаПортативногоИР) Тогда
			Попытка
				Значение = Приложение.ВнешниеОбработки.ПолучитьФорму(ПапкаПортативногоИР + "\ирПортативный.epf");
				Значение.ЗапретитьАвтозапуск = Истина; // 7.45
			Исключение
				// Платформа 1С не позволяет ловить такие исключения
			КонецПопытки;
			Если Значение <> Неопределено Тогда
				выхИспользуемоеИмяФайлаПортативногоИР = Значение.ИспользуемоеИмяФайла; 
				Если ЭтоПервоеПодключение Тогда
					Приложение.Visible = Истина; // Должно быть видимым на случай различных диалогов, например предупреждений безопасности
				КонецЕсли;
				Если Не Значение.Открыта() Тогда
					Значение.Открыть();
					Если Не Значение.Открыта() Тогда
						ФлагОбновления = "ВерсияИРОбновлена";
					КонецЕсли;
				КонецЕсли;
			Иначе
				ПоказатьВсплывающееУведомление("Для портативного """ + НазваниеПодсистемы() + """ нужно обычное клиентское приложение, а запущено управляемое."
					+ " Поэтому запускаем установщик расширения.", 10000);
				Приложение.ЗапуститьСистему("/Execute""" + ПапкаПортативногоИР + "\Модули\ирУстановщикРасширения.epf""");
				ЗакрытьПриложениеИР();
			КонецЕсли;
		КонецЕсли;
	КонецПопытки; 
	//ФлагОбновления = "ВерсияИРОбновлена";
	Если ФлагОбновления = "ВерсияИРОбновлена" Тогда
		//ЗакрытьПриложениеИР(, "закрыта базовая форма");
		//ЗакрытьПриложениеИР(, "обновлена версия ИР"); // https://turboconf.ru/Tasks/9188
		ИДПриложения = 0;
		ПодключениеИР = ПодключениеИРИзКэша(, ИДПриложения);
		Если ПодключениеИР <> Неопределено Тогда
			ПроцессОС = ПолучитьПроцессОСЛкс(ИДПриложения);
			Если ПроцессОС <> Неопределено Тогда
				УбитьПроцесс(ПроцессОС);
			КонецЕсли;
		КонецЕсли;
		Сообщение = "Запущено подключение новой версии ИР";
		ПоказатьВсплывающееУведомление(Сообщение);
		ЗапуститьПодключениеИР();
		ВызватьИсключение "Требуется переподключение ИР";
	КонецЕсли;
	//! Значение = Приложение;
	Возврат Значение;
КонецФункции

// Функция - Получить процесс ОСЛкс
//
// Параметры:
//  ИдентификаторПроцесса					 - 	 - 
//  НачалоПроцесса							 - 	 - 
//  ДопустимоеОтклонениеВремени				 - 	 - 
//  МаркерВКоманднойСтроке					 - 	 - 
//  ИмяИсполняемогоФайла					 - 	 - 
// 
// Возвращаемое значение:
//  COMОбъект - :
//   * ProcessID - Число
//   * ParentProcessId - Число
//   * CommandLine - Строка
//   * CreationDate - Строка
//   * Name - Строка 
//
Функция ПолучитьПроцессОСЛкс(Знач ИдентификаторПроцесса, Знач НачалоПроцесса = Неопределено, Знач ДопустимоеОтклонениеВремени = 2,
	Знач МаркерВКоманднойСтроке = Неопределено, Знач ИмяИсполняемогоФайла = "1cv8.exe") Экспорт
	
	WMIЛокатор = ПолучитьCOMОбъектWMIЛкс();
	// ТекстОтбора = "1=1 AND"; Синтаксис WQL такого не допускает
	ТекстОтбора = "";
	Если ЗначениеЗаполнено(ИдентификаторПроцесса) Тогда
		Если ТекстОтбора <> "" Тогда
			ТекстОтбора = ТекстОтбора + " AND ";
		КонецЕсли; 
		ТекстОтбора = ТекстОтбора + " ProcessID = " + XMLСтрока(ИдентификаторПроцесса);
	КонецЕсли; 
	Если ЗначениеЗаполнено(МаркерВКоманднойСтроке) Тогда
		Если ТекстОтбора <> "" Тогда
			ТекстОтбора = ТекстОтбора + " AND ";
		КонецЕсли; 
		ТекстОтбора = ТекстОтбора + " CommandLine LIKE '%" + МаркерВКоманднойСтроке + "%'";
	КонецЕсли; 
	Если ЗначениеЗаполнено(ИмяИсполняемогоФайла) Тогда
		Если ТекстОтбора <> "" Тогда
			ТекстОтбора = ТекстОтбора + " AND ";
		КонецЕсли; 
		ТекстОтбора = ТекстОтбора + " Name = '" + ИмяИсполняемогоФайла + "'";
	КонецЕсли; 
	Если НачалоПроцесса <> Неопределено Тогда
		Если ТекстОтбора <> "" Тогда
			ТекстОтбора = ТекстОтбора + " AND ";
		КонецЕсли; 
		ТекстОтбора = ТекстОтбора + " CreationDate >= " + ПолучитьЛитералДатыДляWQLЛкс(НачалоПроцесса - ДопустимоеОтклонениеВремени);
		ТекстОтбора = ТекстОтбора + " AND CreationDate <= " + ПолучитьЛитералДатыДляWQLЛкс(НачалоПроцесса + 1 + ДопустимоеОтклонениеВремени);
	КонецЕсли; 
	Значение = Неопределено; 
	ТекстЗапросаWQL = "Select * from Win32_Process Where " + ТекстОтбора;
	ВыборкаПроцессовОС = WMIЛокатор.ExecQuery(ТекстЗапросаWQL);
	Для Каждого ПроцессОС Из ВыборкаПроцессовОС Цикл
		Значение = ПроцессОС;
		Сообщить("Процесс ОС найден");
		Прервать;
	КонецЦикла;
	Возврат Значение;
КонецФункции

Функция ПолучитьЛитералДатыДляWQLЛкс(Знач Результат) Экспорт 
	
	Результат = Результат - СмещениеСтандартногоВремени();
	Результат = "'" + Формат(Результат, "ДФ='yyyyMMdd HH:mm:ss'; ДП=") + "'";
	Возврат Результат

КонецФункции

Процедура УбитьПроцесс(ПроцессОС, Причина = "") Экспорт
	Попытка
		ПроцессОС.Terminate();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;
	ТурбоКонф.ПоказатьУведомление("Процесс приложения " + НазваниеПриложения() + " завершен " + Причина);
КонецПроцедуры

Функция ПолучитьCOMОбъектWMIЛкс() Экспорт
	//http://msdn.microsoft.com/en-us/library/windows/desktop/aa389763(v=vs.85).aspx
	Locator = Новый COMОбъект("WbemScripting.SWbemLocator");
	Значение = Locator.ConnectServer(".", "root\cimv2");
	Возврат Значение;
КонецФункции

// см. СобытияМодуль.ПриПодключенииКонфигуратора
Процедура ПриПодключенииКонфигуратора(Параметры)
	СтрокаСоединенияБазыКонфигуратора = СтрокаСоединенияБазыКонфигуратора(Ложь);
	СохранитьЗначениеСеансаКонфигуратора("СтрокаСоединенияБазыКонфигуратора", СтрокаСоединенияБазыКонфигуратора);
	ТекущееРазрешение = ПроверитьРазрешениеИР();
	УстановитьРазрешениеИР(ТекущееРазрешение);
	Если ТекущееРазрешение Тогда
		ПредложитьПодключитьИР();
		ПоследниеМетоды = ВосстановитьЗначениеБазы("ПоследниеМетодыЖСОН");
		Если ПоследниеМетоды <> Неопределено Тогда
			СписокЗначений = Новый СписокЗначений;
			Для Каждого ЭлементСписка Из ОбъектИзЖСОН(ПоследниеМетоды) Цикл
				ЗаполнитьЗначенияСвойств(СписокЗначений.Добавить(0), ЭлементСписка); // https://github.com/EvilBeaver/OneScript/issues/1452
			КонецЦикла;
			СохранитьЗначениеСеансаКонфигуратора("ПоследниеМетоды", СписокЗначений);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПредложитьПодключитьИР() Экспорт
	ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Хотите сразу подключить приложение " + НазваниеПриложения() + "?", 4000, ЭтотОбъект, "ЗапуститьПодключениеИР");
КонецПроцедуры

Процедура ЗапуститьПодключениеИР(Параметры = Неопределено)
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодключениеИРНовое");
КонецПроцедуры

// До 5мс
Функция ВосстановитьЗначениеБазы(Ключ, Шифрование = Ложь)
	//МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	База = СтрокаСоединенияБазыКонфигуратора(Ложь);
	Значение = ТурбоКонф.ВосстановитьЗначение(База + Ключ, Шифрование);
	//Сообщить("ВосстановитьЗначениеБазы. База=" + База + ";" + Ключ + "=" + ?(Шифрование, "***", Значение));
	//Сообщить("Длительность восстановления - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
	Возврат Значение;
КонецФункции

// Процедура - Сохранить значение базы
//
// Параметры:
//  Ключ		 - 	 - 
//  Значение - Строка, Число, Булево, Дата - 
//  Шифрование	 - 	 - 
//
Процедура СохранитьЗначениеБазы(Ключ, Значение, Шифрование = Ложь, Знач СтрокаСоединения = "")
	Если Не ЗначениеЗаполнено(СтрокаСоединения) Тогда
		СтрокаСоединения = СтрокаСоединенияБазыКонфигуратора(Ложь);
	КонецЕсли;
	ТурбоКонф.СохранитьЗначение(СтрокаСоединения + Ключ, Значение, Шифрование);
	Сообщить("СохранитьЗначениеБазы. База=" + СтрокаСоединения + ";" + Ключ + "=" + ?(Шифрование, "***", Значение));
КонецПроцедуры

Функция СообщениеСброситьНастройки()
	Возврат " ";
КонецФункции

Процедура СброситьНастройкиАдаптераБазы(Знач Параметры = Неопределено)
	Если Не ЗакрытьПриложениеИР() Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	УстановитьРазрешениеИР(Ложь);
	СохранитьЗначениеБазы("РазрешенИР", Неопределено);
	СохранитьЗначениеБазы("ПарольИлиСтрокаСоединения", Неопределено);
	ПроверитьРазрешениеИР(); 
КонецПроцедуры 

Процедура РазрешитьЗапретитьИР(Знач Параметры = Неопределено)
	ТекущееРазрешение = ВосстановитьЗначениеБазы("РазрешенИР");
	Если ТекущееРазрешение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущееРазрешение = Не ТекущееРазрешение;
	СохранитьЗначениеБазы("РазрешенИР", ТекущееРазрешение);
	УстановитьРазрешениеИР(ТекущееРазрешение);
	ПоказатьРазрешениеПриложенияИР();
	Если ТекущееРазрешение Тогда
		ПредложитьПодключитьИР();
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьРазрешениеИР(Знач ТекущееРазрешение) Экспорт
	УстановитьРежимЗаменыШтатнойПодсказки(ТекущееРазрешение);
	Попытка
		ТурбоКонф.УстановитьВидимостьТурбоКнопокСкриптаДляПроцесса("ИРАдаптер", Конфигуратор.PID, ТекущееРазрешение); // https://turboconf.ru/Tasks/10020
	Исключение
		// Старые версии
	КонецПопытки;
КонецПроцедуры

Функция ПроверитьРазрешениеИР(Отказ = Ложь)
	РазрешенИР = ВосстановитьЗначениеБазы("РазрешенИР");
	Если РазрешенИР = Ложь Тогда
		Если ВосстановитьЗначениеСеансаКонфигуратора("УведомлениеОЗапретеОтображалось") <> Истина Тогда
			СохранитьЗначениеСеансаКонфигуратора("УведомлениеОЗапретеОтображалось", Истина);
			ПоказатьРазрешениеПриложенияИР();
		КонецЕсли
	ИначеЕсли РазрешенИР = Неопределено Тогда
		Отказ = Истина;
		ВопросПользователю = НовыйВопросПользователю();
		ВопросПользователю.Заголовок = "TurboConf";
		ВопросПользователю.Текст = "Разрешить приложение " + НазваниеПриложения() + " для этой базы? 
		|Это необходимо для работы команд ИР. Можно изменить командой РазрешитьЗапретитьИР.";
		ВопросПользователю.УстановитьОбработчик(ЭтотОбъект, "ОбработчикОтветаРазрешитьИР");
		ВопросПользователю.Показать();  
	Иначе
		//УстановитьРежимЗаменыШтатнойПодсказки(Истина);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ПоказатьРазрешениеПриложенияИР(Знач ПредлагатьУстановитьАвтоподсказки = Истина) Экспорт
	ТекущееРазрешение = ВосстановитьЗначениеБазы("РазрешенИР");
	Если ТекущееРазрешение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Текст = "Вы " + ?(ТекущееРазрешение, "разрешили", "запретили") + " приложение " + НазваниеПриложения() + " для этой базы. Можно изменить командой РазрешитьЗапретитьИР.";
	Параметры = Новый Структура("ОкноКонфигуратора", Конфигуратор.ГлавноеОкно);
	ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), Текст, 10000, ЭтотОбъект, "РазрешитьЗапретитьИР", Параметры);
	Если Не ТекущееРазрешение Тогда
		//ЗакрытьПриложениеИР(); // Лучше не закрывать, т.к. отключение может быть кратковременным
	КонецЕсли;
	Если ЛиДоступнаЧистаяПодсказка() И ПредлагатьУстановитьАвтоподсказки Тогда
		//УстановитьАвтоподсказкуКонфигуратора(Не ТекущееРазрешение);
		ПредложитьУстановитьАвтоподсказку(Не ТекущееРазрешение);
			//ТекущееЗначениеАвтоподсказки = ЛиАвтоПодсказкаКонфигуратора();
			//Если ТекущееЗначениеАвтоподсказки <> Истина Тогда
				//УстановитьАвтоподсказкуКонфигуратора(Истина); //  Много побочных эффектов, которые у себя пока не смог воспроизвести https://turboconf.ru/Tasks/9400
			//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// .
//
// Параметры:
//  РежимДиалогаВопрос	 - РежимДиалогаВопрос - по умолчанию ДаНетОтмена
// 
// Возвращаемое значение:
//  ОбработкаОбъект.ВопросПользователю - 
//
Функция НовыйВопросПользователю(РежимДиалогаВопросМой = Неопределено) Экспорт
	Если РежимДиалогаВопросМой = Неопределено Тогда
		РежимДиалогаВопросМой = РежимДиалогаВопрос.ДаНетОтмена;
	КонецЕсли;
	// https://github.com/EvilBeaver/OneScript/issues/1399
	Если ТурбоКонф.ПолучитьВерсиюТурбоКонф() >= "6.1.8847.27150" Тогда
		// Вариант для ОСкрипт 1.9 
		Параметры = Новый Массив;
		Параметры.Добавить(РежимДиалогаВопросМой);
		ВопросПользователю = Новый ("ВопросПользователю", Параметры);
	Иначе
		// Вариант для ОСкрипт 1.7 
		ВопросПользователю = Новый ("ВопросПользователю", РежимДиалогаВопросМой); 
	КонецЕсли;
	Возврат ВопросПользователю;
КонецФункции

Процедура УстановитьРежимЗаменыШтатнойПодсказки(Знач НовоеЗначение) Экспорт
	ТурбоКонф.СохранитьЗначениеСеанса(Строка(Конфигуратор.ГлавноеОкно)+"_"+"T9AlwaysShowOnCtrlSpace", НовоеЗначение);
	ТурбоКонф.СохранитьЗначениеСеанса(Строка(Конфигуратор.ГлавноеОкно)+"_"+"T9AllowAutoInvokeInsideCommonStrings", НовоеЗначение);
КонецПроцедуры

Процедура ОбработчикОтветаРазрешитьИР(Значение, Параметры) Экспорт
	Если Значение = КодВозвратаДиалога.Да Тогда
		ПараметрыИнформационнойБазы = Неопределено;
		Попытка
			ПараметрыИнформационнойБазы = ТурбоКонф.ПолучитьПараметрыИнформационнойБазы();
		Исключение
			// <6.3.9148.1632
			Попытка
				ТурбоКонф.ОбновитьПараметрыИнформационнойБазы();
			Исключение
				// <6.2.9007.29810
			КонецПопытки;
		КонецПопытки;
		Если ТипЗнч(ПараметрыИнформационнойБазы) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Конфигуратор.ПараметрыИнформационнойБазы, ПараметрыИнформационнойБазы);
		КонецЕсли;
		ВводПароля();
	ИначеЕсли Значение = КодВозвратаДиалога.Нет Тогда
		СохранитьЗначениеБазы("РазрешенИР", Ложь);
		ПроверитьРазрешениеИР();
	КонецЕсли;
КонецПроцедуры

Процедура ВводПароля()
	ИнфоПроцесса = ИнфоПроцесса();
	ПримерСтрокиСоединения = "File=""C:\БД"";Usr=""1"";Pwd=""2""";
	Форма = Новый ("ФормаВводаЗначения"); // ОбработкаОбъект.ФормаВводаЗначения
	Форма.УстановитьОбработчик(ЭтотОбъект, "ОбработчикВводаПароля");
	Форма.Значение = "";
	Форма.Заголовок = "Введите параметры подключения " + НазваниеПриложения();
	Форма.Текст = "Введите пароль пользователя """ + ИнфоПроцесса.Пользователь + """, чтобы приложение " + НазваниеПриложения() + " подключалось к этой базе.
	|Либо введите строку соединения базы с такой же конфигурацией в виде " + ПримерСтрокиСоединения + " для подключения к ней. Для аутентификации ОС укажите строку без имени и пароля.";
	//Форма.МногострочныйРежим = Истина;
	Форма.РежимВводаПароля = Истина;
	Форма.Показать();
	Сообщить("Пример строки соединения " + НазваниеПриложения() + ": " + ПримерСтрокиСоединения);
КонецПроцедуры

Процедура ОбработчикВводаПароля(Значение, Отказ, Параметры) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	ПодключеноНоНетПодсистемы = Ложь;
	ПодключениеИР = ПодключениеИР(Значение,, Ложь, ПодключеноНоНетПодсистемы, Истина);
	Если ПодключениеИР <> Неопределено Тогда
		СохранитьЗначениеБазы("РазрешенИР", Истина);
		СохранитьЗначениеБазы("ПарольИлиСтрокаСоединения", Значение, Истина);
		ПоказатьВсплывающееУведомление("Подключено приложение " + НазваниеПриложения());
		МодулиИР = МодулиИР(ПодключениеИР, Истина);
		Если Не ЗначениеЗаполнено(МодулиИР.ирОбщий.ДатаОбновленияКэшаМодулейЛкс()) Тогда 
			ОбновитьКэшМодулей(ПодсказкаОбновленияКэшаМодулей());
		КонецЕсли;
	ИначеЕсли ПодключеноНоНетПодсистемы Тогда
		ПоказатьВсплывающееУведомление("Сначала установите совместимую версию ИР. Затем вызовите в конфигураторе любую команду ИР для повтора подключения.", 5000);
	Иначе
		ПроверитьРазрешениеИР();
	КонецЕсли;
КонецПроцедуры

Функция ПодсказкаОбновленияКэшаМодулей()
	Результат = " Обновить кэш можно командой ОбновитьКэшМодулей";
	Возврат Результат;
КонецФункции

Процедура ОбновитьКэшМодулей(ДобавкаТекста = "")
	Если Не ПроверитьРазрешениеИР() Тогда
		ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Сначала нужно разрешить " + НазваниеПриложения() + " для этой базы!", 5000, ЭтотОбъект, "СброситьНастройкиАдаптераБазы");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	Если МодулиИР.ирКэш.ЛиФайловаяБазаЛкс() Тогда
		Если МодулиИР.ирКэш.Получить().ЕстьАдминистративныеПраваУУчетнойЗаписиОС() Тогда
			ВопросПользователю = НовыйВопросПользователю(РежимДиалогаВопрос.ОКОтмена);
			ВопросПользователю.Заголовок = НазваниеСкрипта(); 
			ВопросПользователю.Текст = "Заполнить кэш модулей " + НазваниеПриложения() + " БЕЗ закрытия конфигуратора? 
			|После завершения рекомендуется сбросить памятный кэш через список автодополнения.
			|Кэш модулей необходим командам ИР для видения остальных модулей, кроме текущего, который обновляется при вызове любой команды.
			|" + ДобавкаТекста;
		Иначе
			ВопросПользователю = НовыйВопросПользователю(РежимДиалогаВопрос.ОКОтмена);
			ВопросПользователю.Заголовок = НазваниеСкрипта(); 
			ВопросПользователю.Текст = "Заполнить кэш модулей " + НазваниеПриложения() + " С закрытием конфигуратора (нет прав администратора ОС)? 
			|Кэш модулей необходим командам ИР для видения остальных модулей, кроме текущего, который обновляется при вызове любой команды.
			|" + ДобавкаТекста;
		КонецЕсли;
	Иначе
		ВопросПользователю = НовыйВопросПользователю();
		ВопросПользователю.Заголовок = НазваниеСкрипта(); 
		ВопросПользователю.Текст = "Заполнить кэш модулей " + НазваниеПриложения() + " С закрытием конфигуратора?
		|Ответ ""Нет"" потребует автономный сервер.
		|Кэш модулей необходим командам ИР для видения остальных модулей, кроме текущего, который обновляется при вызове любой команды.
		|" + ДобавкаТекста;
	КонецЕсли;
	ВопросПользователю.УстановитьОбработчик(ЭтотОбъект, "ОбработчикОтветаЗаполнитьКэшМодулей");
	ВопросПользователю.Показать();
КонецПроцедуры

// Процедура - Обработчик ответа заполнить кэш модулей
//
// Параметры:
//  Значение	 - КодВозвратаДиалога - 
//  Параметры	 - 	 - 
//
Процедура ОбработчикОтветаЗаполнитьКэшМодулей(Значение, Параметры) Экспорт
	Если Значение = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Если Значение = КодВозвратаДиалога.ОК Тогда
		ПодключениеИР = ПодключениеИР();
		МодулиИР = МодулиИР(ПодключениеИР);
		Если МодулиИР.ирКэш.Получить().ЕстьАдминистративныеПраваУУчетнойЗаписиОС() Тогда
			Значение = КодВозвратаДиалога.Нет;
		Иначе
			Значение = КодВозвратаДиалога.Да;
		КонецЕсли;
	КонецЕсли;
	ИмяИсполняемогоФайла = ИмяИсполняемогоФайла();
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	СтрокаКоманды = ЗапуститьТолстыйКлиент(Ложь, Ложь, "/CОбновитьКэшМодулейИР;" + (Не Булево("" + Значение)), ИмяИсполняемогоФайла, Значение = КодВозвратаДиалога.Да, Ложь);
	ТурбоКонф.СохранитьЗначениеСеанса("СтрокаЗапускаОбновлениеКэшаМодулей", СтрокаКоманды);
	Если Значение = КодВозвратаДиалога.Да Тогда
		ПоказатьВсплывающееУведомление("Закройте этот конфигуратор, если он не закроется сам, чтобы запустилась выгрузка модулей", 5000);
		ТурбоКонф.Ждать(50);
		ТурбоКонф.АльтКлавиша(Клавиши.F4);
	КонецЕсли; 
КонецПроцедуры

// см. СобытияМодуль.ПриЗакрытииКонфигуратора
Процедура ПриЗакрытииКонфигуратора(Параметры)
	// Тут уже нет строки соединения. Поэтому восстанавливаем ее из значения сеанса
	Если Не ЗначениеЗаполнено(Параметры.PID) Тогда
		Сообщить("ПриЗакрытииКонфигуратора. PID=0!", СтатусСообщения.Внимание); // Ни разу видел срабатывание
		Возврат;
	КонецЕсли;
	СтрокаСоединенияБазы = ВосстановитьЗначениеСеансаКонфигуратора("СтрокаСоединенияБазыКонфигуратора", Параметры.PID);
	Если ПустаяСтрока(СтрокаСоединенияБазы) Тогда
		// Турбоконф иногда ошибочно присылает событие при завершении клиентского приложения
		Сообщить("ПриЗакрытииКонфигуратора. Неизвестный процесс PID=" + Параметры.PID, СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	СтрокаЗапуска = ТурбоКонф.ВосстановитьЗначениеСеанса("СтрокаЗапускаОбновлениеКэшаМодулей");
	Сообщить("СтрокаЗапускаОбновлениеКэшаМодулей=" + СтрокаЗапуска);
	// TODO сделать проброс ИДКонфигуратора
	//ПодключениеИР = ПодключениеИРИзКэша(Параметры.PID);
	//Если ПодключениеИР <> Неопределено Тогда
	//	ПередатьИзмененияМодулей(ПодключениеИР);
	//КонецЕсли;
	ЗакрытьПриложениеИР(Параметры.PID, " после закрытия конфигуратора"); // При обновлении кэша раньше закрывали без сохранения настроек, чтобы не потерялись настройки конфигуратора https://turboconf.ru/Tasks/8425
	Если ЗначениеЗаполнено(СтрокаЗапуска) Тогда
		ЗапуститьПриложение(СтрокаЗапуска);
	КонецЕсли;
	ТурбоКонф.СохранитьЗначениеСеанса("СтрокаЗапускаОбновлениеКэшаМодулей", Неопределено);
	ПоследниеМетоды = ВосстановитьЗначениеСеансаКонфигуратора("ПоследниеМетоды", Параметры.PID); // СписокЗначений
	Если ПоследниеМетоды <> Неопределено Тогда
		МассивСохранения = Новый Массив;
		Для Каждого ЭлементСписка Из ПоследниеМетоды Цикл
			Элемент = Новый Структура("Значение,Представление");
			ЗаполнитьЗначенияСвойств(Элемент, ЭлементСписка);
			МассивСохранения.Добавить(Элемент);
		КонецЦикла;
		Если ЗначениеЗаполнено(СтрокаСоединенияБазы) Тогда
			СохранитьЗначениеБазы("ПоследниеМетодыЖСОН", ОбъектВЖСОН(МассивСохранения),, СтрокаСоединенияБазы); 
		КонецЕсли;
	КонецЕсли;
	Сообщить("Завершен сеанс конфигуратора. PID=" + Параметры.PID + ". СтрокаСоединения=" + СтрокаСоединенияБазы);
КонецПроцедуры

// см. СобытияМодуль.ПриЗавершенииРаботыПрограммы
Процедура ПриЗавершенииРаботыПрограммы()
	ПодлюченныеКонфигураторы = ПодлюченныеКонфигураторы();
	Для каждого КлючИЗначение Из ПодлюченныеКонфигураторы Цикл
		ЗакрытьПриложениеИР(КлючИЗначение.Ключ, "после завершения ТурбоConf");
	КонецЦикла;
КонецПроцедуры

Процедура ОткрытьЖурналРегистрации(Параметры = Неопределено)
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	ТурбоКонф.ОткрытьМеню("Администрирование", "Журнал регистрации");
КонецПроцедуры

Процедура СообщитьОПроблеме()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТехническаяИнформация = ТехническаяИнформацияИР(ПодключениеИР);
	ПутьКФайлам = КаталогВременныхФайлов() + "\ИРАдаптер";
	УдалитьФайлы(ПутьКФайлам);
	СоздатьКаталог(ПутьКФайлам); 
	ИмяФайлаМодуля = ПутьКФайлам + "\Модуль.txt";
	ИмяФайлаИнфо = ПутьКФайлам + "\Инфо.txt";
	ИмяФайлаОшибка = ПутьКФайлам + "\ОшибкаТурбоконф.txt";
	ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстМодуля);
	ТекстовыйДокумент.Записать(ИмяФайлаМодуля); 
	ТекстовыйДокумент.УстановитьТекст(ТехническаяИнформация);
	ТекстовыйДокумент.Записать(ИмяФайлаИнфо); 
	Попытка
		ТекстОшибки = ТурбоКонф.ПолучитьСообщениеОбОшибке(); // 6.2.9009.28888+
	Исключение
		ТекстОшибки = Неопределено;
	КонецПопытки;
	Если ТекстОшибки <> Неопределено Тогда
		ТекстовыйДокумент.УстановитьТекст(ТекстОшибки);
		ТекстовыйДокумент.Записать(ИмяФайлаОшибка); 
	КонецЕсли;
	ЗаписьЗип = новый ЗаписьZipФайла;
	ЗаписьЗип.Открыть(ИмяФайлаАрхива);
	ЗаписьЗип.Добавить(ПутьКФайлам, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьЗип.Записать();
	МодулиИР = МодулиИР(ПодключениеИР);
	МодулиИР.ирКлиент.ОткрытьФайлВПроводникеЛкс(ИмяФайлаАрхива);
	ПоказатьВсплывающееУведомление("Укажите в сообщении показанный файл, картинку и текст ошибки, шаги для повторения проблемы, лог TurboConf с уровнем ""Отладка""", 10000);
	ЗапуститьПриложение("https://turboconf.ru/Tasks/Create?forumId=28");
КонецПроцедуры

//.
// Параметры:
//   ПодключениеИР - Application {V83.Application}, Неопределено - 
//   МодулиИР - Application {V83.Application}, Неопределено - 
// Возвращаемое значение:
//   Строка - 
Функция ТехническаяИнформацияИР(Знач ПодключениеИР) Экспорт
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте,,,, Ложь, Истина);
	СеансИР = ПодключениеИР.ПолучитьТекущийСеансИнформационнойБазы();
	ТехническаяИнформация =
		"Турбоконф. Версия: " + ТурбоКонф.ПолучитьВерсиюТурбоКонф() + "
		|ИР Адаптер. Версия: " + ВерсияАдаптера + "
		|Приложение ИР. Начало сеанса: " + СеансИР.НачалоСеанса + "
		|Приложение ИР. Номер сеанса: " + СеансИР.НомерСеанса;
	Если ПолеТекстаПрограммы <> Неопределено Тогда
		ТехническаяИнформация = ТехническаяИнформация + "
			|Конфигуратор. ИмяМодуля: " + ПолеТекстаПрограммы.мИмяМодуля + "
			|Конфигуратор. ПозицияВМодуле: строка " + ПолеТекстаПрограммы.мНачальнаяСтрока + ", колонка " + ПолеТекстаПрограммы.мНачальнаяКолонка + ", позиция " + ПозицияВТексте;
	КонецЕсли;
	ТехническаяИнформация = ТехническаяИнформация + "
		|" + МодулиИР.ирКлиент.ТехническаяИнформацияЛкс();
	Возврат ТехническаяИнформация;
КонецФункции

// ИмяИсполняемогоФайла передаем когда процесс нет активного конфигуратора
//
// Параметры:
//  ПодключитьОтладчик	 - 	 - 
//  СПользователем		 - 	 - 
//  ДопПараметры		 - 	 - 
//  ИмяИсполняемогоФайла - 	 - 
//  ТолькоВернутьСтроку	 - 	 - 
//  ЛиВБазеКонфигуратора - Булево - если база приложения ИР не совпадает с базой конфигуратора, то брать строку параметры запуска от базы конфигуратора
// 
// Возвращаемое значение:
//   - 
//
Функция ЗапуститьТолстыйКлиент(Знач ПодключитьОтладчик = Истина, Знач СПользователем = Истина, Знач ДопПараметры = "", Знач ИмяИсполняемогоФайла = "", Знач ТолькоВернутьСтроку = Ложь,
		Знач ЛиВБазеКонфигуратора = Истина)
	ДобавкаПортативныйИР = "";
	ИспользуемоеИмяФайлаИР = ВосстановитьЗначениеБазы("ИспользуемоеИмяФайлаПортативногоИР");
	Если ИспользуемоеИмяФайлаИР = Неопределено Тогда
		ПодключениеИР();
		ИспользуемоеИмяФайлаИР = ВосстановитьЗначениеБазы("ИспользуемоеИмяФайлаПортативногоИР");
	КонецЕсли;
	Если ЗначениеЗаполнено(ИспользуемоеИмяФайлаИР) Тогда
		ДобавкаПортативныйИР = "/Execute""" + ИспользуемоеИмяФайлаИР + """";
	КонецЕсли;
	ДобавкаАдресОтладчика = "";
	Если ПодключитьОтладчик Тогда
		АдресОтладчика = ВосстановитьЗначениеСеансаКонфигуратора("АдресОтладчика");
		Если АдресОтладчика = Неопределено Тогда
			ТурбоКонф.ОткрытьМеню("Отладка", "Подключение...");
			Окно = ТурбоКонф.ЖдатьОкно("Предметы отладки", 2000, Ложь);
			Если Окно <> 0 Тогда
				ТурбоКонф.Ждать(50);
				ЗаголовокКнопки = "Настройкa..."; // Последняя "a" - буква английского алфавита!
				КликнутьПоЭлементу(ЗаголовокКнопки, "кнопка");
				Окно = ТурбоКонф.ЖдатьОкно("Настройки отладчика", 1000, Ложь);
				Если Окно = 0 Тогда
					ТурбоКонф.Клавиша(Клавиши.Escape);
					Возврат "";
				КонецЕсли;
			КонецЕсли;
			Если Окно <> 0 Тогда
				ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
				АдресОтладчика = ТурбоКонф.ПолучитьЗначение();
				Если ЗначениеЗаполнено(АдресОтладчика) Тогда
					СохранитьЗначениеСеансаКонфигуратора("АдресОтладчика", АдресОтладчика);
				КонецЕсли;
				ТурбоКонф.Клавиша(Клавиши.Escape);
				ТурбоКонф.Клавиша(Клавиши.Escape);
			КонецЕсли
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресОтладчика) Тогда
			ДобавкаАдресОтладчика = " /DEBUGGERURL""" + АдресОтладчика + """";
		КонецЕсли;
	КонецЕсли;
	Возврат ЗапуститьПриложение1С("/DEBUG" + ДобавкаАдресОтладчика + " " + ДобавкаПортативныйИР + " " + ДопПараметры, СПользователем, ИмяИсполняемогоФайла, ТолькоВернутьСтроку, ЛиВБазеКонфигуратора);
КонецФункции

// ИмяИсполняемогоФайла передаем когда нет активного конфигуратора
Функция ЗапуститьПриложение1С(Знач ДопПараметры, Знач _СПользователем = Истина, Знач ИмяИсполняемогоФайла = "", Знач ТолькоВернутьСтроку = Ложь, Знач ЛиВБазеКонфигуратора = Истина)
	Если ПустаяСтрока(ИмяИсполняемогоФайла) Тогда
		ИмяИсполняемогоФайла = ИмяИсполняемогоФайла();
	КонецЕсли;
	Если ЛиВБазеКонфигуратора Тогда
		СтрокаСоединения = СтрокаСоединенияБазыКонфигуратора();
		ПарольИлиСтрокаСоединения = ВосстановитьЗначениеБазы("ПарольИлиСтрокаСоединения", Истина);
		Если ЛиСтрокаСоединения(ПарольИлиСтрокаСоединения) Тогда
			СтрокаСоединения = СтрокаСоединенияБазыКонфигуратора(Ложь);
		Иначе
			СтрокаСоединения = СтрокаСоединения + СтрШаблон("Pwd=""%1"";", ПарольИлиСтрокаСоединения);
		КонецЕсли;
	Иначе 
		СтрокаСоединения = СтрокаСоединенияБазыИР();
	КонецЕсли; 
	
	// Антибаг 8.3.25 https://www.hostedredmine.com/issues/993141
	ИмяПользователя = НСтр(СтрокаСоединения, "Usr");
	Пароль = НСтр(СтрокаСоединения, "Pwd");
	СтрокаСоединения = СтрРазделитьЛкс(СтрокаСоединения, ";Usr=")[0];
	ДопПараметры = ДопПараметры + " /N""" + ИмяПользователя + """ /P""" + Пароль + """";
	
	СтрокаСоединения = """" + СтрЗаменить(СтрокаСоединения, """", """""") + """";
	Результат = """" + ИмяИсполняемогоФайла + """ ENTERPRISE /IBConnectionString" + СтрокаСоединения + " " + ДопПараметры;
	Если ТолькоВернутьСтроку Тогда
		Возврат Результат;
	Иначе 
		ЗапуститьПриложение(Результат);
	КонецЕсли;
КонецФункции

// Внешний вызов
// см. СобытияМодуль.ПриАктивизацииСтрокиТ9
Процедура ПриАктивизацииСтрокиТ9(Параметры, Отказ, СтандартнаяОбработка)
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Не ПроверитьРазрешениеИР(Отказ) Тогда
		СтандартнаяОбработка = Истина;
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОписаниеКом = ПолеТекстаПрограммы.ОписаниеТекущегоСловаАвтодополнения(Параметры.Значение, Параметры.ЭтоМетод, Параметры.КлючСловаря);
	Если ОписаниеКом <> Неопределено Тогда
		ТипСлова = ОписаниеКом.Тип;
		ОписаниеСлова = ОписаниеКом.Описание;
	КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("Тип", ТипСлова);
	Описание.Вставить("Описание", ОписаниеСлова);
	Параметры.Описание = Описание;
	Сообщить("ПриАктивизацииСтрокиT9 - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + "мс");
КонецПроцедуры 

// Внешний вызов со старым некорректным именем (латинская T https://turboconf.ru/Tasks/9890)
// см. СобытияМодуль.ПриАктивизацииСтрокиT9
Процедура ПриАктивизацииСтрокиT9(Параметры, ШаблонДляВставки, ФорматироватьТекст, Отказ, СтандартнаяОбработка)
	ПриАктивизацииСтрокиТ9(Параметры, Отказ, СтандартнаяОбработка);
КонецПроцедуры

// Внешний вызов
// см. СобытияМодуль.ПослеВставкиЗначенияТ9
Процедура ПослеВставкиЗначенияТ9(Параметры, Отказ, СтандартнаяОбработка)
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Не ПроверитьРазрешениеИР(Отказ) Тогда
		СтандартнаяОбработка = Истина;
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ПолеТекстаПрограммы.Адаптер_ОбновитьСтатистикуВыбораСлова(Параметры.Значение, Параметры.ЭтоМетод, Параметры.КлючСловаря);
	Если ПолеТекстаПрограммы.ЛиСохранитьСтатистикуВыбора() Тогда
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "СохранитьСтатистикуВыбораПодсказки");
	КонецЕсли;
	Если Параметры.ЭтоМетод Тогда
		Попытка
			Параметры.ВызватьПодсказкуПараметров = Истина; // 6.3.9199.30724
		Исключение
			// Антибаг Турбоконфа https://turboconf.ru/Tasks/9979
			ТурбоКонф.КонтролШифтКлавиша(Клавиши.Space);
		КонецПопытки;
	КонецЕсли;
	Сообщить("ПослеВставкиЗначенияT9 - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
КонецПроцедуры

// Внешний вызов со старым некорректным именем (латинская T https://turboconf.ru/Tasks/9890) 
// см. СобытияМодуль.ПриВыбореЗначенияT9
Процедура ПослеВставкиЗначенияT9(Параметры, Отказ, СтандартнаяОбработка)
	ПослеВставкиЗначенияТ9(Параметры, Отказ, СтандартнаяОбработка);
КонецПроцедуры

// Внешний вызов
// см. СобытияМодуль.ПриВыбореЗначенияТ9
Процедура ПриВыбореЗначенияТ9(Параметры, ШаблонДляВставки, ФорматироватьТекст, Отказ, СтандартнаяОбработка)
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Не ПроверитьРазрешениеИР(Отказ) Тогда
		СтандартнаяОбработка = Истина;
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	НовыйШаблон = ПолеТекстаПрограммы.Адаптер_ПриВыбореСтрокиАвтодополнения(Параметры.Значение, Параметры.ЭтоМетод, Параметры.КлючСловаря, ШаблонДляВставки, ФорматироватьТекст);
	Если НовыйШаблон <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = ПустаяСтрока(НовыйШаблон);
		ШаблонДляВставки = НовыйШаблон;
		Если Отказ Тогда
			ПоказатьВсплывающееУведомление("Генератор вернул пустой текст для вставки");
		КонецЕсли;
	ИначеЕсли Найти(ШаблонДляВставки, "Для Каждого") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ФорматироватьТекст = Истина;
		ШаблонДляВставки = СтрЗаменить(ШаблонДляВставки, "Для Каждого <!> Из  Цикл", "Для Каждого  Из <!> Цикл");
	КонецЕсли;
	Если Истина
		И Не ТурбоКонф.РежимСовместимости() 
		И Лев(Параметры.Значение, 1) = "<"
		И ПолеТекстаПрограммы.ЛиГенераторСПоглощениемНачалаСтроки(Параметры.Значение)
	Тогда
		РежимДетальнойВставки = Истина;
		Попытка
			Пустышка = Параметры.УдалитьТекстС; // 6.3.9199.27671
		Исключение
			РежимДетальнойВставки = Ложь;
		КонецПопытки;
		Если РежимДетальнойВставки Тогда
			УдаляемыйФрагментСлева = ПолеТекстаПрограммы.мРодительскийКонтекст;
			Если ЗначениеЗаполнено(УдаляемыйФрагментСлева) Тогда
				УдаляемыйФрагментСлева = УдаляемыйФрагментСлева + "." + ПоследнийФрагментЛкс(Параметры.СтрокаСлева);
			Иначе
				УдаляемыйФрагментСлева = СокрЛ(Параметры.СтрокаСлева);
			КонецЕсли;
			Параметры.УдалитьТекстС = Параметры.Позиция - СтрДлина(УдаляемыйФрагментСлева);
			Параметры.УдалитьТекстПо = Параметры.Позиция;
		Иначе
			ПозицияВТексте = ПолеТекстаПрограммы.мПозицияВТексте - 1;
			ТурбоКонф.ВыделитьТекст(ПозицияВТексте - СтрДлина(ПолеТекстаПрограммы.мКонтекст), ПозицияВТексте);
			ТурбоКонф.Клавиша(Клавиши.Delete);
			ТурбоКонф.Ждать(10); // Чтобы все асинхронное завершилось https://turboconf.ru/Tasks/10006
		КонецЕсли;
	КонецЕсли;
	Сообщить("ПриВыбореЗначенияT9 - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
КонецПроцедуры

// Внешний вызов со старым некорректным именем (латинская T https://turboconf.ru/Tasks/9890)
// см. СобытияМодуль.ПриВыбореЗначенияT9
Процедура ПриВыбореЗначенияT9(Параметры, ШаблонДляВставки, ФорматироватьТекст, Отказ, СтандартнаяОбработка)
	ПриВыбореЗначенияТ9(Параметры, ШаблонДляВставки, ФорматироватьТекст, Отказ, СтандартнаяОбработка);
КонецПроцедуры

Процедура СохранитьСтатистикуВыбораПодсказки() Экспорт
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ПолеТекстаПрограммы.СохранитьСтатистикуВыбораПодсказки();
КонецПроцедуры

Процедура ПослеЗавершенияЗагрузкиФайла(ИмяФайла)
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Имя = "ИР.zip" Тогда
		ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяФайла);
		ЧтениеАрхива.ИзвлечьВсе(Файл.Путь);
		ЧтениеАрхива.Закрыть();
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			// ScriptEngine.Machine.ExternalSystemException: ... (System.IO.IOException): Процесс не может получить доступ к файлу "C:\turboconf\user_scripts\ИР\ИР.zip", так как этот файл используется другим процессом.
		КонецПопытки;
		ВводПароля();
	КонецЕсли;
КонецПроцедуры

// Функция разбивает строку разделителем.
// Старые имена - РазбитьСтрокуРазделителем, ПолучитьМассивИзСтрокиСРазделителем
// 
// Параметры:
//  Стр      - Строка - которую разбиваем;
//  Разделитель - Строка, "." - символ-разделитель;
//  ОбрезатьНепечатныеСимволы - Булево, *Ложь - делать СокрЛП.
//  ОставлятьПустуюСтроку - Булево, *Истина - если передана пустая строка, то добавлять ее в массив
//
// Возвращаемое значение:
//  Массив - фрагментов.
//
Функция СтрРазделитьЛкс(Знач Стр, Знач Разделитель = ".", Знач ОбрезатьНепечатныеСимволы = Ложь, Знач ОставлятьПустуюСтроку = Истина, Знач _УчитыватьКавычки = Ложь, Знач _ПропускатьПустые = Ложь,
	Знач ТолькоПервыйРазделитель = Ложь) Экспорт
	
	МассивСтрок = Новый Массив;
	Если Истина
		И Не ОставлятьПустуюСтроку 
		И ПустаяСтрока(Стр)
	Тогда
		Возврат МассивСтрок;
	КонецЕсли;   
	ОбрезатьНепечатныеСимволыСразу = ОбрезатьНепечатныеСимволы;
	ДлинаРазделителя = СтрДлина(Разделитель);
	Пока 1=1 Цикл
		Поз = Найти(Стр, Разделитель);
		Если Поз=0 Тогда
			Фрагмент = Стр;
			Если ОбрезатьНепечатныеСимволыСразу Тогда
				Фрагмент = СокрЛП(Фрагмент);
			КонецЕсли;
			МассивСтрок.Добавить(Фрагмент);
			Прервать;
		КонецЕсли;
		Фрагмент = Лев(Стр, Поз-1);
		Если ОбрезатьНепечатныеСимволыСразу Тогда
			Фрагмент = СокрЛП(Фрагмент);
		КонецЕсли;
		МассивСтрок.Добавить(Фрагмент);
		Стр = Сред(Стр, Поз+ДлинаРазделителя);
		Если ТолькоПервыйРазделитель Тогда
			МассивСтрок.Добавить(Стр);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат МассивСтрок; 
		
КонецФункции

// Разделитель тоже удаляется.
Функция СтрокаБезПоследнегоФрагментаЛкс(Знач Строка, Знач Разделитель = ".", Знач БратьГраницуЕслиНеНайден = Ложь) Экспорт
	Позиция = СтрНайти(Строка, Разделитель, НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Если БратьГраницуЕслиНеНайден Тогда
			Результат = Строка;
		Иначе
			Результат = "";
		КонецЕсли;
	Иначе
		Результат = Лев(Строка, Позиция - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

//&ТолькоТекстовыеДокументы
Процедура СохранитьМодульВФайл()
	ТурбоКонф.КонтролКлавиша(Клавиши.S);
	Если Истина
		И ТурбоКонф.ПолучитьВерсиюAPI() >= 6 
		И Не ТурбоКонф.ЭтоСкрипт 
	Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстМодуля) Или Не ЭтоДокумент() Тогда
		Возврат;    
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	Маркер = "//#Дублировать" + " в файл "; // Разделено для не обнаружения себя же
	ИмяФайла = СокрЛП(МодулиИР.ирОбщий.ТекстМеждуМаркерамиЛкс(ТекстМодуля, Маркер, Символы.ПС, Ложь));
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ТекстМодуля);
		Текст.Записать(ИмяФайла);   
		ПоказатьВсплывающееУведомление(СтрШаблон("Текст модуля сохранен в файл %1", ИмяФайла), 3000);
		ТурбоКонф.ПерезагрузитьСкрипты();  // Может вызывать залипание https://turboconf.ru/Tasks/9940
		ТурбоКонф.ОтжатьМодификаторы();
	Иначе 
		ПоказатьВсплывающееУведомление("Модуль не связан с файлом. В тексте модуля должна быть строка 
		|" + Маркер + "<Полное имя файла>", 4000);
	КонецЕсли;
КонецПроцедуры

// Получает идентификатор из любой строки.
//  "3-я Дебиторка По контрагентам с интервалами СНГ (для  Руководства)" => "_3_яДебиторкаПоКонтрагентамСИнтерваламиСНГ_дляРуководства_".
//
// Параметры:
//  Представление			 - Строка
//  ЗаменаПустойСтроки		 - 	 - 
//  ДопРазрешенныеСимволы	 - 	 - 
//  ЗаменаСпецСимвола		 - Строка - если пустая, то следующий символ приводится к верхнему регистру
// 
// Возвращаемое значение:
//  Строка - .
//
Функция ИдентификаторИзПредставленияЛкс(Знач Представление = Неопределено, Знач ЗаменаПустойСтроки = "_", ДопРазрешенныеСимволы = "", Знач ЗаменаСпецСимвола = "_") Экспорт

	Если ПустаяСтрока(Представление) Тогда
		Представление = ЗаменаПустойСтроки;
	КонецЕсли;
	Если Истина
		И СокрЛП(Представление) = Представление 
		И Найти(Представление, ",") = 0
	Тогда
		Попытка
			Пустышка = Новый Структура(Представление);
			Возврат Представление;
		Исключение КонецПопытки;
	КонецЕсли; 
	НовоеПредставление = Представление;
	ПервыйСимвол = Сред(Представление, 1, 1);
	Если ЛиЦифраЛкс(ПервыйСимвол) Тогда
		// Первый символ - цифра
		НовоеПредставление = "_" + НовоеПредставление;
	КонецЕсли;
	ПредыдущийСимвол = " ";
	ТекущаяСтрока = "";
	ШаблонСимволаИдентификатора = ШаблонСимволаИдентификатораЛкс(ДопРазрешенныеСимволы);
	Для Счетчик = 1 По СтрДлина(НовоеПредставление) Цикл
		ТекущийСимвол = Сред(НовоеПредставление, Счетчик, 1);
		Если ПустаяСтрока(ПредыдущийСимвол) Тогда
			// Предыдущий символ - непечатаемый или спецсимвол
			ТекущийСимвол = ВРег(ТекущийСимвол);
		КонецЕсли;
		Если Найти(ШаблонСимволаИдентификатора, НРег(ТекущийСимвол)) > 0 Тогда
			// Предыдущий символ - непечатаемый
			ТекущаяСтрока = ТекущаяСтрока + ТекущийСимвол;
		Иначе
			Если Не ПустаяСтрока(ТекущийСимвол) Тогда
				ТекущаяСтрока = ТекущаяСтрока + ЗаменаСпецСимвола;
				Если ЗаменаСпецСимвола = "" Тогда
					ТекущийСимвол = " ";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ПредыдущийСимвол = ТекущийСимвол;
	КонецЦикла;
	Результат = ТекущаяСтрока;
	Возврат ТекущаяСтрока;

КонецФункции

Функция ШаблонСимволаИдентификатораЛкс(Знач ДопРазрешенныеСимволы = "") Экспорт 
	
	РусскиеБуквы = РусскиеБуквыЛкс();
	ШаблонСимволаИдентификатора = НРег("_0123456789" + РусскиеБуквы + "abcdefghijklmnopqrstuvwxyz" + ДопРазрешенныеСимволы); // Русский и Ангийский
	Возврат ШаблонСимволаИдентификатора;

КонецФункции

Функция РусскиеБуквыЛкс() Экспорт 
	
	РусскиеБуквы = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Возврат РусскиеБуквы;

КонецФункции  

Функция ЛиЦифраЛкс(Символ) Экспорт 
	Результат = Символ <> "" И Найти("0123456789", Символ) > 0;
	Возврат Результат;
КонецФункции

// Не используется
// Заменен на собственный индикатор Турбоконфа
Процедура ПоискПоМодулюФоновый() Экспорт
	Если Истина
		И Конфигуратор.ОкноВызоваСкрипта = ТурбоКонф.ПолучитьАктивноеОкно()
		И ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Поиск"
	Тогда
		ИскомаяСтрока = ТурбоКонф.ПолучитьЗначение();
		СтараяИскомаяСтрока = ВосстановитьЗначениеСеансаКонфигуратора("СтараяИскомаяСтрока");
		Если СтрДлина(ИскомаяСтрока) > 2 И СтараяИскомаяСтрока <> ИскомаяСтрока Тогда
			Попытка
				ПоследнийДокумент = Конфигуратор.ПоследнийДокумент;
			Исключение
				ПоследнийДокумент = Неопределено;
				Возврат;
			КонецПопытки;
			Если ПоследнийДокумент <> Неопределено Тогда
				ПодключениеИР = ПодключениеИР(,, Ложь);
				МодулиИР = МодулиИР(ПодключениеИР);
				Вхождения = Неопределено;  
				СловоЦеликом = Ложь;
				//СловоЦеликом = ТурбоКонф.ПолучитьСостояниеФлажка();
				МодулиИР.ирОбщий.СтрНайтиСловоЛкс(ПоследнийДокумент.Текст, ИскомаяСтрока, 0, СловоЦеликом, Ложь, Вхождения);
				Если Вхождения = Неопределено Тогда
					//ИР 7.41-
					Возврат;
				КонецЕсли;
				ТекстРезульта = СтрШаблон("Найдено %1", Вхождения.Количество());
				ТурбоКонф.ПоказатьПодсказку(ТекстРезульта);
				//МодулиИР.ирОбщий.ОбновитьТекстПослеМаркераЛкс(ТекущийЗаголовок, "", ТекстРезульта);
				//ТурбоКонф.УстановитьЗаголовокТекущегоОкна(ТекущийЗаголовок); // Не работает
			КонецЕсли;
			СохранитьЗначениеСеансаКонфигуратора("СтараяИскомаяСтрока", ИскомаяСтрока);
		КонецЕсли;
	КонецЕсли;
	Если ТурбоКонф.НайтиОкноПоЗаголовку("Поиск") <> 0 Тогда
		ТурбоКонф.Ждать(1000);
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоискПоМодулюФоновый");
	Иначе
		//ПоказатьВсплывающееУведомление("Отключено обновление поиска"); // Для отладки
	КонецЕсли;
КонецПроцедуры

// Внешний вызов     
//&ВосстанавливатьБуферОбмена
// см. СобытияМодуль.ПриОткрытииОкна 
Процедура ПриОткрытииОкна(Параметры)
	ЗаголовокОкна = Параметры.Заголовок;
	Сообщить("Активировано окно - " + ЗаголовокОкна);
	Если Конфигуратор = Неопределено Тогда
		// Недоработка Турбоконфа в диалогах выбора файла https://turboconf.ru/Tasks/9001
		Возврат;
	КонецЕсли;
	Если ЗаголовокОкна = "Конфигуратор" Тогда
		ПарольИлиСтрокаСоединения = ВосстановитьЗначениеБазы("ПарольИлиСтрокаСоединения", Истина);
		ЕстьПанельБлокировкиБазы = Ложь;
		ЕстьНеверноеИмя = Ложь;
		Элементы = ТурбоКонф.НайтиЭлементыПоТипу("панель");
		Для каждого Элемент Из Элементы Цикл
			ЕстьПанельБлокировкиБазы = СтрНачинаетсяС(Элемент, "Ошибка исключительной блокировки");
			ЕстьНеверноеИмя = СтрНачинаетсяС(Элемент, "Неверное имя!");
		КонецЦикла;
		Если Истина
			И ЕстьПанельБлокировкиБазы
			И ПодключениеИРИзКэша() <> Неопределено
		Тогда
			//ЗапуститьПроверкуМодулей();
			Если Не ЛиСтрокаСоединения(ПарольИлиСтрокаСоединения) Тогда 
				АктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
				ТекстОбновитьДинамически = "Обновить динамически";
				ЕстьКнопкаОбновитьДинамически = ТурбоКонф.НайтиЭлементПоИмени(ТекстОбновитьДинамически, "кнопка");
				Если ЕстьКнопкаОбновитьДинамически Тогда 
					//КликнутьПоЭлементу(ТекстОбновитьДинамически, "кнопка"); // Метод признан ненадежным https://turboconf.ru/Tasks/8611
					УспехУстановкиФокуса = ТурбоКонф.УстановитьФокусНаЭлемент(ТекстОбновитьДинамически, "кнопка");
					Если УспехУстановкиФокуса Тогда
						ТурбоКонф.Клавиша(Клавиши.Enter);
						Попытка
							ТурбоКонф.ЖдатьЗакрытияОкна(АктивноеОкно, , 5000);
							Дождались = Истина; 
						Исключение
							Дождались = Ложь;
						КонецПопытки;
						Если Дождались Тогда
							ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "БД обновлена динамически. Переподключить приложение ИР для обновления в нем метаданных?",
								6000, ЭтотОбъект, "ЗапуститьПереподключениеПриложенияИР");
						Иначе
							ПоказатьВсплывающееУведомление("Конфигурация БД обновляется динамически из-за подключенного приложения ИР", 4000); 
						КонецЕсли;
					КонецЕсли;
					ЗаголовокОкна = ""; // Чтобы дальше поиск элементов интерфейса не выполнялся, иначе будет замирать указатель мыши https://turboconf.ru/Tasks/9573
				Иначе 
					ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Приложение ИР блокирует обновление базы. Закрыть?", 5000, ЭтотОбъект, "ЗакрытьПриложениеИР");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;  
		Если ТурбоКонф.НайтиЭлементПоИмени("Для выполнения отладки необходимо включить поддержку сетевого протокола TCP/IP", "панель") Тогда
			ПоказатьВсплывающееУведомление("Возможно отсутствуют свободные порты в диапазоне для отладчика https://partners.v8.1c.ru/forum/t/747951/m/768516");
		КонецЕсли;
		Если ЕстьНеверноеИмя Тогда 
			ТурбоКонф.Клавиша(Клавиши.Enter);
			Тип = ПолучитьТипТекущегоЭлемента();
			Если Тип = ТипЭлемента.Поле Тогда
				СтарыйТекст = ТурбоКонф.ПолучитьЗначение();
				Если ЗначениеЗаполнено(СтарыйТекст) Тогда
					НовыйТекст = ИдентификаторИзПредставленияЛкс(СокрЛП(СтарыйТекст));
					
					////ТурбоКонф.УстановитьЗначение(НовыйТекст); // В палитре свойств не взводится модифицированность 
					//УстановитьЗначениеПолюВвода(НовыйТекст, Ложь); // Почему то криво работает
					ТурбоКонф.УстановитьЗначение("");
					ТурбоКонф.ВставитьТекст(НовыйТекст); // В палитре свойств взводится модифицированность
					
					ТурбоКонф.Клавиша(Клавиши.End);
					ПоказатьВсплывающееУведомление("Значение имени преобразовано из """ + СтарыйТекст + """", 5000);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;                                  
	КонецЕсли;
	Если ЗаголовокОкна = "Выбор объекта" Тогда
		// Ставим фокус в поле фильтра
		ТурбоКонф.КонтролАльтКлавиша(Клавиши.M); 
	КонецЕсли;
	Если Ложь
		Или ЗаголовокОкна = "Отбор по подсистемам" 
		Или ЗаголовокОкна = "Подсистемы" // из общей картинки
	Тогда
		// Ставим фокус в дерево
		ТурбоКонф.Клавиша(Клавиши.Home); 
	КонецЕсли;
	// Теперь это делает сам Турбоконф
	Если ЗаголовокОкна = "Замена" Тогда
		ЧтоЗаменять = ТурбоКонф.ПолучитьЗначение(); 
		Если ЗначениеЗаполнено(ЧтоЗаменять) Тогда
			ТурбоКонф.Клавиша(Клавиши.Tab);
			УстановитьЗначениеПолюВвода(ЧтоЗаменять, Ложь);
			КомандаВыделитьВсе();
		КонецЕсли;
	КонецЕсли;
	Если ЗаголовокОкна = "Перейти по номеру строки" Тогда
		Текст = ТурбоКонф.ПолучитьБуферОбмена(); 
		Попытка
			Число = Число(Текст);
		Исключение
			Число = 0;
		КонецПопытки;
		Если ЗначениеЗаполнено(Число) И ТурбоКонф.ПолучитьЗначение() = "1" Тогда
			УстановитьЗначениеПолюВвода(Число, Ложь);
			КомандаВыделитьВсе();
		КонецЕсли;
	КонецЕсли;
	Если ВосстановитьЗначениеБазы("РазрешенИР") = Истина Тогда
		// Теперь это делает сам Турбоконф
		//Если Истина
		//	И ЗаголовокОкна = "Поиск" 
		//	И Не ТурбоКонф.НайтиЭлементПоИмени("По текущей колонке", "флажок")
		//Тогда
		//	СохранитьЗначениеСеансаКонфигуратора("СтараяИскомаяСтрока", "");
		//	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоискПоМодулюФоновый"); 
		//КонецЕсли;
		//
		Если ЗаголовокОкна = "Редактирование типа данных" Тогда
			УстановитьФокусВПервуюТаблицуИлиСписок();
			ИмяЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
			//Сообщить("ИмяЭлемента="+ИмяЭлемента);
			Если Ложь
				Или ИмяЭлемента = "Булево"
				Или ИмяЭлемента = "Строка"
				Или ИмяЭлемента = "Число"
				Или ИмяЭлемента = "Дата"
				Или ИмяЭлемента = "" // тип был не выбран, поэтому пометка установится первому, но он не станет текущим
			Тогда
				//
			Иначе
				Если ТурбоКонф.УстановитьФокусНаЭлемент("Составной тип данных", "флажок") Тогда
					Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
						ТурбоКонф.УстановитьСостояниеФлажка(Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			// Ставим фокус в поле фильтра
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.M); 
		КонецЕсли;
		Если ЗаголовокОкна = "Реорганизация информации" Тогда
			Если Не ТурбоКонф.ПолучитьДоступностьЭлемента("Принять", "кнопка") Тогда
				ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Открыть подготовку к изменению структуры БД (ИР) для устранения конфликтов?
				|Конфигуратор будет закрыт!", Неопределено, ЭтотОбъект, "ОткрытьПодготовкуКИзменениюСтруктурыБД", Новый Структура("Окно", ТурбоКонф.ПолучитьАктивноеОкно()));
			КонецЕсли;
		КонецЕсли;  
		ЗаголовокОкнаАвтоПодключение = "Автоматическое подключение";
		Если ЗаголовокОкна = "Предметы отладки" Тогда
			ПодключениеИР = ПодключениеИРИзКэша();
			Если ПодключениеИР <> Неопределено Тогда
				УстановитьФокусВПервуюТаблицуИлиСписок();
				НажатьКлавишуЦикл(Клавиши.Tab, 2);
				ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка();
				Если ВидимыеЭлементы <> Неопределено Тогда
					НомерСеанса = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР.НомерСеанса");
					Если ВидимыеЭлементы.ИменаЭлементов.Найти(XMLСтрока(НомерСеанса) + " Сеанс") <> Неопределено Тогда
						ТурбоКонф.Ждать(20); // увеличение не спасает от плавающей ошибки следующего ожидания окна
						Если КликнутьПоЭлементу("Автоматическое подключение...", "кнопка") Тогда
							ТурбоКонф.ЖдатьОкно(ЗаголовокОкнаАвтоПодключение, 2000, Истина, Истина);
							ИмяФлажка = "Клиентские и внешние соединения на сервере";
							Если ТурбоКонф.УстановитьФокусНаЭлемент(ИмяФлажка, "флажок") Тогда
								Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
									ТурбоКонф.УстановитьСостояниеФлажка(Ложь);
									ПоказатьВсплывающееУведомление("Флажок автоподключения ""Клиентские и внешние соединения на сервере"" нельзя включать при подключенном приложении ИР");
								КонецЕсли;
							Иначе
								// HTTP отладка
							КонецЕсли;
							ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
						КонецЕсли; 
						УстановитьФокусВПервуюТаблицуИлиСписок();
						НажатьКлавишуЦикл(Клавиши.Tab, 2);
						НажатьКлавишуЦикл(Клавиши.Right, 3); // Активируем колонку "Сеанс"
						Для Счетчик = 1 По 2 Цикл
							Если Не НайтиСтрокуВОкне(XMLСтрока(НомерСеанса)) Тогда
								Прервать;
							КонецЕсли;
							КликнутьПоЭлементу("Отключить", "кнопка");
							УстановитьФокусВПервуюТаблицуИлиСписок();
							НажатьКлавишуЦикл(Клавиши.Tab, 2);
							ТурбоКонф.Ждать(20);
						КонецЦикла;
						ПоказатьВсплывающееУведомление(СтрШаблон("Отключен запрещенный предмет отладки (сеанс %1) приложения ИР.", НомерСеанса));
					КонецЕсли;
				КонецЕсли;
				Если Конфигуратор.ПараметрыИнформационнойБазы.Режим = "Серверный" Тогда
					МодулиИР = МодулиИР(ПодключениеИР);
					Если МодулиИР.ирКэш.РежимОтладкиСервераИзКоманднойСтрокиЛкс() = "нет" Тогда
						ПоказатьВсплывающееУведомление("Отладка на сервере запрещена в параметрах запуска службы. Разрешить ее можно запуском на сервере инструмента ""Управление службами серверов 1С (ИР)""");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЗаголовокОкна = ЗаголовокОкнаАвтоПодключение Тогда
			НажатьКлавишуЦикл(Клавиши.Tab, 1);
		КонецЕсли;
		Если Ложь
			//Или ЗаголовокОкна = "Выберите файл конфигурации" 
			Или (Истина
				И ЗаголовокОкна = "Конфигуратор" 
				И ТурбоКонф.НайтиЭлементПоИмени("Объединение конфигураций завершено.", "панель"))
			Или ЗаголовокОкна = "Получение объектов из хранилища конфигурации" 
			Или (Истина
				И ЗаголовокОкна = "Глобальный поиск по текстам" 
				И ТурбоКонф.НайтиЭлементПоИмени("Заменить все", "кнопка")
				И ТурбоКонф.ПолучитьДоступностьЭлемента("Заменить все", "кнопка")) 
		Тогда
			ПоказатьВсплывающееУведомление("После массовых изменений модулей рекомендуется выполнить команду ОбновитьКэшМодулей", 4000);
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры  

Процедура ОткрытьПодготовкуКИзменениюСтруктурыБД(Знач Параметры = Неопределено) Экспорт
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	Если Параметры <> Неопределено Тогда
		ТурбоКонф.АктивироватьОкно(Параметры.Окно);
	КонецЕсли;                         
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Реорганизация информации" Тогда
		ЗакрытьМодальноеОкно();
		ТурбоКонф.Ждать(2000);
	КонецЕсли;
	ИмяИсполняемогоФайла = ИмяИсполняемогоФайла();
	ТурбоКонф.АльтКлавиша(Клавиши.F4);
	ТурбоКонф.Ждать(2000);
	ЗапуститьТолстыйКлиент(Ложь,, "/CПодготовкаКИзменениюСтруктурыБД", ИмяИсполняемогоФайла);
КонецПроцедуры

Процедура ЗапуститьПереподключениеПриложенияИР(Параметры) Экспорт
	Если Не ЗакрытьВсеОкнаВПриложенииИР() Тогда
		Возврат;
	КонецЕсли;
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодключениеИРНовое");
КонецПроцедуры

// см. ОбработкаОбъект.ТурбоКонф.КликнутьПоЭлементу
Функция КликнутьПоЭлементу(Знач ТекстЭлемента, Знач ТипЭлемента, Знач КнопкаМыши = 0, Знач ДвойнокКлик = Ложь) Экспорт 
	Если Не ТурбоКонф.ПолучитьДоступностьЭлемента(ТекстЭлемента, ТипЭлемента) Тогда
		// Непонятно, почему Турбоконф сам это не делает. TODO Турбоконф
		Возврат Ложь;
	КонецЕсли;
	Возврат ТурбоКонф.КликнутьПоЭлементу(ТекстЭлемента, ТипЭлемента, КнопкаМыши, ДвойнокКлик);
КонецФункции

// Внешний вызов   
Процедура ПриОбновленииКэша(Отказ, СтандартнаяОбработка)
	Если Не ПроверитьРазрешениеИР(Отказ) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст); 
	ДатаОбновленияСтруктурыФормыМодуля = ПолеТекстаПрограммы.ДатаОбновленияСтруктурыФормыМодуля();
	ПолеТекстаПрограммы.СброситьКэшТиповВыраженийМодуля();
	ПолеТекстаПрограммы.мПлатформа.ОчиститьКэшАнализатораЯзыка();
	ПолеТекстаПрограммы.мМодульМетаданных = Неопределено;
	ПолеТекстаПрограммы.мМетодМодуля = Неопределено;
	ПоказатьВсплывающееУведомление(
			"Памятный кэш анализатора кода очищен. 
			|Метаданные в приложении ИР обновляются при его перезапуске командой ЗакрытьПриложениеИР после обновления конфигурации БД. 
			|Модули в кэше приложения ИР обновляются автоматически при измении в окне модуля. Команда ОбновитьКэшМодулей обновляет их все.", 
			10000);
	Если ДатаОбновленияСтруктурыФормыМодуля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст); // чтобы сразу обновился кэш формы 
КонецПроцедуры

// см. СобытияМодуль.ПриНажатииКнопки
Процедура ПриНажатииКнопки(Кнопка)
	Если Не ПроверитьРазрешениеИР() Тогда
		ПоказатьРазрешениеПриложенияИР(Ложь);
		Возврат;
	КонецЕсли;
	Если Кнопка = "КнопкаРедактироватьТекст" Тогда
		РедактироватьТекст();
	ИначеЕсли Кнопка = "КнопкаОтладитьОбъект" Тогда
		ОтладитьОбъект();
	ИначеЕсли Кнопка = "КнопкаУсловиеОстанова" Тогда
		КнопкаУсловиеОстанова();
	ИначеЕсли Кнопка = "ВычислитьСвойствоРодителяИзВыражения" Тогда
		ВычислитьСвойствоРодителяИзВыражения();
	ИначеЕсли Кнопка = "ВключитьВТаблоИзВыражения" Тогда
		ВключитьВТаблоИзВыражения();
	ИначеЕсли Кнопка = "ВключитьВТаблоИзКоллекции" Тогда
		ВключитьВТаблоИзКоллекции();
	ИначеЕсли Кнопка = "ПодробноОкнаВыражение" Тогда
		ПодробноОкнаВыражение();
	ИначеЕсли Кнопка = "СравнитьОбъектыИзВыражения" Тогда
		СравнитьОбъектыИзВыражения();
	ИначеЕсли Кнопка = "СериализоватьИзВыражения" Тогда
		СериализоватьИзВыражения();
	ИначеЕсли Кнопка = "СократитьКоллекциюИзКоллекции" Тогда
		СократитьКоллекциюИзКоллекции();
	ИначеЕсли Кнопка = "КнопкаВыполнитьПроизвольныйКод" Тогда
		ВыполнитьПроизвольныйКод();
	ИначеЕсли Кнопка = "КнопкаПрерватьОтлаживаемыйКод" Тогда
		ПрерватьОтлаживаемыйКод();
	ИначеЕсли Кнопка = "ВычислитьОписатьПараметрыМетода" Тогда
		ВычислитьОписатьПараметрыМетода();
	ИначеЕсли Кнопка = "КнопкаНайтиЭлементКоллекции" Тогда
		НайтиЭлементКоллекцииВОкне();
	ИначеЕсли Кнопка = "КнопкаОткрытьЭлементКоллекции" Тогда
		КнопкаОткрытьЭлементКоллекции();
	ИначеЕсли Кнопка = "КнопкаНоваяОбычнаяГруппаВертикальная" Тогда
		КнопкаНоваяОбычнаяГруппаВертикальная(1);
	ИначеЕсли Кнопка = "КнопкаНоваяОбычнаяГруппаБезОтображенияВертикальная" Тогда
		КнопкаНоваяОбычнаяГруппаВертикальная(2);
	ИначеЕсли Кнопка = "КнопкаНоваяОбычнаяГруппаГоризонтальная" Тогда
		КнопкаНоваяОбычнаяГруппаГоризонтальная(1);
	ИначеЕсли Кнопка = "КнопкаНоваяОбычнаяГруппаБезОтображенияГоризонтальная" Тогда
		КнопкаНоваяОбычнаяГруппаГоризонтальная(2);
	ИначеЕсли Кнопка = "КнопкаУстановитьФорматПолнойДаты" Тогда
		КнопкаУстановитьФорматПолнойДаты();
	ИначеЕсли Кнопка = "УстановитьФильтрВыбораТипа" Тогда
		УстановитьФильтрВыбораТипа();
	ИначеЕсли Кнопка = "КнопкаТолькоПомеченные" Тогда
		ВыбратьИзПомеченныхЭлементовСписка();
	ИначеЕсли Кнопка = "КнопкаИскатьСсылки" Тогда
		КнопкаИскатьСсылки();
	ИначеЕсли Кнопка = "КнопкаИскатьФункциональныеОпции" Тогда
		КнопкаИскатьСсылки("ФункциональнаяОпция");
	ИначеЕсли Кнопка = "КнопкаВыбратьЕдинственным" Тогда
		КнопкаВыбратьЕдинственным();
	ИначеЕсли Кнопка = "КнопкаВыборТипаДанных" Тогда
		ВыбратьТипДанных();
	ИначеЕсли Кнопка = "КнопкаУстановитьТипПараметраВыбора" Тогда
		УстановитьТипПараметраВыбора();
	ИначеЕсли Кнопка = "ОткрытьСравнениеВерсийМетода" Тогда
		ОткрытьСравнениеВерсийМетода();
	ИначеЕсли Кнопка = "ОткрытьСравнениеТекстов" Тогда
		ОткрытьСравнениеТекстов();
	ИначеЕсли Кнопка = "ПереименоватьСлово" Тогда
		ЗакрытьМодальноеОкно();
		ПереименоватьСлово();
	ИначеЕсли Кнопка = "ВыделитьМетод" Тогда
		ЗакрытьМодальноеОкно();
		КонструкторМетода();
	ИначеЕсли Кнопка = "ПерейтиКСтрокеМодуляИзСобытия" Тогда
		ПерейтиКСтрокеМодуляИзСобытия();
	ИначеЕсли Кнопка = "ОткрытьПользователяИБ" Тогда
		ОткрытьПользователяИБ();
	ИначеЕсли Кнопка = "ОткрытьОбъектМетаданныхИзСобытия" Тогда
		ОткрытьОбъектМетаданныхИзСобытия();
	ИначеЕсли Кнопка = "ОтобратьТранзакциюИзСобытия" Тогда
		ОтобратьТранзакциюИзСобытия();
	ИначеЕсли Кнопка = "КнопкаСписокОбщихМетодов" Тогда
		СписокОбщихМетодов();
	ИначеЕсли Кнопка = "КнопкаСписокМетодовМодуля" Тогда
		СписокМетодовМодуля();
	ИначеЕсли Кнопка = "КнопкаПерейтиИзНавигатора" Тогда
		КнопкаПерейтиИзНавигатора();
	ИначеЕсли Кнопка = "КнопкаВставитьУсловиеИзТабло" Тогда
		ВставитьУсловиеИзТабло();
	ИначеЕсли Кнопка = "КнопкаВставитьОшибкуИзБуфера" Тогда
		ВставитьОшибкуИзБуфера();
	ИначеЕсли Кнопка = "ВыбратьИПодключитьПредметОтладки" Тогда
		ВыбратьИПодключитьПредметОтладки();
	ИначеЕсли Кнопка = "ОтключитьВсеПредметыОтладки" Тогда
		ОтключитьВсеПредметыОтладки();
	ИначеЕсли Кнопка = "ЗапретитьАвтоподключениеОтладки" Тогда
		ЗапретитьАвтоподключениеОтладки();
	ИначеЕсли Кнопка = "КнопкаНайтиТочкуОстанова" Тогда
		НайтиТочкуОстановаИлиЗакладку();
	ИначеЕсли Кнопка = "КнопкаНайтиЗакладку" Тогда
		НайтиТочкуОстановаИлиЗакладку();
	ИначеЕсли Кнопка = "КнопкаНайтиВСпискеОбъектов" Тогда
		НайтиВСпискеОбъектовМетаданных();
	ИначеЕсли Кнопка = "КнопкаНайтиКартинку" Тогда
		КнопкаНайтиКартинку();
	ИначеЕсли Кнопка = "ВставитьТочкиОстановаИзРезультатовПоиска" Тогда
		ВставитьТочкиОстановаИзРезультатовПоиска();
	ИначеЕсли Кнопка = "РедактироватьПользователя" Тогда
		РедактироватьПользователя();
	ИначеЕсли Кнопка = "ОткрытьЖурналПоПользователю" Тогда
		ОткрытьЖурналПоПользователю();
	ИначеЕсли Кнопка = "СброситьПарольПользователю" Тогда
		СброситьПарольПользователю();
	ИначеЕсли Кнопка = "УстановитьОтборТолькоОшибки" Тогда
		УстановитьОтборТолькоОшибки();
	ИначеЕсли Кнопка = "НайтиВМодуляхИзГлобальногоПоиска" Тогда
		НайтиВМодуляхИзГлобальногоПоиска();
	ИначеЕсли Кнопка = "ПоказатьИнфоКонфигуратора" Тогда
		ПоказатьИнфоКонфигуратора();
	ИначеЕсли Кнопка = "ПоказатьИнфоИР" Тогда
		ПоказатьИнфоИР();
	ИначеЕсли Кнопка = "НастроитьОтборПоПодсистемам" Тогда
		НастроитьОтборПоПодсистемам();
	ИначеЕсли Кнопка = "ПерейтиПоСсылкеИзБуфера" Тогда
		ПерейтиКОпределению(Ложь);
	ИначеЕсли Кнопка = "ПерейтиПоСсылкеИзБуфераИзМодальногоОкна" Тогда
		ПерейтиПоСсылкеИзБуфераИзМодальногоОкна();
	ИначеЕсли Кнопка = "СравнитьИОформитьОтчет" Тогда
		СравнитьИОформитьОтчет();
	ИначеЕсли Кнопка = "КнопкаПерейтиКОпределению" Тогда
		ПоказатьВсплывающееУведомление("Пробуй более функциональную команду ""Перейти к определению"" нажатием Ctrl+F12 в модуле");
	КонецЕсли;
КонецПроцедуры    

Процедура СравнитьИОформитьОтчет() Экспорт
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	КликнутьПоЭлементу("Подробно", "переключатель");
	КликнутьПоЭлементу("Текстовый документ", "переключатель");
	ТурбоКонф.Клавиша(Клавиши.Tab);
	ИмяФайла = ТурбоКонф.ПолучитьЗначение();
	ИДСтарый = ИдентификаторТекущегоЭлементаОкна();
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	ТурбоКонф.ЖдатьСменуТекущегоЭлемента(ИДСтарый, 500, Ложь);
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяФайла);
	Массив1 = Новый Массив;
	Массив2 = Новый Массив;
	Для НомерСтроки = 1 По ТекстовыйДокумент.КоличествоСтрок() Цикл
		Строка = ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки);
		Если Не Найти(Строка, "<--") > 0 Тогда
			Массив1.Добавить(Строка);
		КонецЕсли;
		Если Не Найти(Строка, "-->") > 0 Тогда
			Массив2.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	ЗакрытьДочернееОкноКонфигуратора();
	ВосстановитьОкноПриложения(ПодключениеИР);
	ЗаголовокОкна = МодулиИР.ирОбщий.ТекстМеждуМаркерамиЛкс(ТекстовыйДокумент.ПолучитьТекст(), Символы.ПС + "	- ***", Символы.ПС); 
	МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(СтрСоединить(Массив1, Символы.ПС), СтрСоединить(Массив2, Символы.ПС), Ложь,,,,, ЗаголовокОкна,,, ЗаголовокОкна);
КонецПроцедуры    

Процедура КнопкаИскатьСсылки(ИмяТипаСсылки = "")
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина, 20000);
	//СтарыйИД = ТурбоКонф.ПолучитьRuntimeIdСтрокой();
	//ЖдатьСменуТекущегоЭлемента(СтарыйИД, 20000);
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.O); // Окно сообщений
	Для Сч=1 По 10 Цикл
		Текст = ТурбоКонф.ПолучитьТекстМодуля("", 0);
		Вхождения = МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(Текст, "Объект ""[^""]+"" использован в:");
		Если Вхождения.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		ТурбоКонф.Ждать(500);
	КонецЦикла;
	Позиция = Вхождения.Получить(Вхождения.Количество() - 1).ПозицияВхождения;
	Если ЗначениеЗаполнено(ИмяТипаСсылки) Тогда
		Вхождения = МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(Сред(Текст, Позиция), "^" + ИмяТипаСсылки + "\.",,,, Истина);
		Если Вхождения.Количество() Тогда
			Позиция = Позиция + Вхождения.Получить(0).ПозицияВхождения;
		КонецЕсли;
	КонецЕсли;
	ТурбоКонф.ВыделитьТекст(Позиция, Позиция + 10);
	НомерСтроки = 0;           
	ТурбоКонф.ПолучитьТекстСПозицией("", 0, 0, НомерСтроки);
	ТурбоКонф.ПерейтиВПозицию(1, НомерСтроки);
КонецПроцедуры

Процедура КнопкаВыбратьЕдинственным()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.УстановитьФокусНаЭлемент("Составной тип данных", "флажок");
	Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Ложь);
	КонецЕсли;
	ЗаголовокОкнаВыбора = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Для Сч=1 По 2 Цикл
		УстановитьФокусВПервуюТаблицуИлиСписок();
		ТурбоКонф.Клавиша(Клавиши.Space);
		ЗакрытьМодальноеОкно(Ложь, Клавиши.Enter, Истина, 50);
		Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Конфигуратор" Тогда
			// Выбрано ничего
			ТекущееОкно = ТурбоКонф.ПолучитьАктивноеОкно();
			ЗакрытьМодальноеОкно(Ложь, Клавиши.Enter);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецПроцедуры

Процедура НайтиВМодуляхИзГлобальногоПоиска()
	УстановитьФокусНаКнопкуСправка();
	ТурбоКонф.Клавиша(Клавиши.Tab);
	НайтиВМодулях(ТурбоКонф.ПолучитьЗначение());
КонецПроцедуры     

Процедура ПерейтиПоСсылкеИзБуфераИзМодальногоОкна()
	ЗакрытьМодальноеОкно();
	ПерейтиКОпределению(Ложь);
КонецПроцедуры

Процедура ПоказатьИнфоИР()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТехническаяИнформацияИР = ТехническаяИнформацияИР(ПодключениеИР);
	ПоказатьВсплывающееУведомление(ТехническаяИнформацияИР, 10000);
КонецПроцедуры

Процедура ПоказатьИнфоКонфигуратора()
	
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПроцессОС = МодулиИР.ирОбщий.ПолучитьПроцессОСЛкс(Конфигуратор.PID);
	ДатаСтарта = МодулиИР.ирОбщий.СтрокаДатыWMIВДатуЛкс(ПроцессОС.CreationDate);
	ПоказатьВсплывающееУведомление(
	"PID=" + Конфигуратор.PID + ", x" + Конфигуратор.РазрядностьПроцесса + ", Старт=" + ДатаСтарта + " 
	|Строка запуска = " + ПроцессОС.CommandLine
	, 10000);
КонецПроцедуры

Процедура ВыбратьИПодключитьПредметОтладки()
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаПутемПеремещения();
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.R); // Обновим список
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если НайтиВСписке(ЯчейкиТекущейСтроки) Тогда
		КликнутьПоЭлементу("Подключить", "кнопка");
	КонецЕсли;
КонецПроцедуры   

Процедура ОтключитьВсеПредметыОтладки()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	НажатьКлавишуЦикл(Клавиши.Tab, 2);
	Пока Истина Цикл
		ТурбоКонф.Клавиша(Клавиши.Home); 
		Если Не КликнутьПоЭлементу("Отключить", "кнопка") Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры  

Процедура ЗапретитьАвтоподключениеОтладки()
	ЗаголовокОкнаАвтоПодключение = "Автоматическое подключение";
	ПодключениеИР = ПодключениеИРИзКэша();
	Если КликнутьПоЭлементу("Автоматическое подключение...", "кнопка") Тогда
		ТурбоКонф.ЖдатьОкно(ЗаголовокОкнаАвтоПодключение, 2000, Истина, Истина);
		ИменаФлажков = Новый Массив;
		ИменаФлажков.Добавить("Клиентские и внешние соединения на сервере");
		ИменаФлажков.Добавить("Web-сервисы");
		ИменаФлажков.Добавить("HTTP-сервисы");
		ИменаФлажков.Добавить("OData-сервисы");
		ИменаФлажков.Добавить("Фоновые задания");
		Для Каждого ИменаЭлемент Из ИменаФлажков Цикл
			Если ТурбоКонф.УстановитьФокусНаЭлемент(ИменаЭлемент, "флажок") Тогда
				Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
					ТурбоКонф.УстановитьСостояниеФлажка(Ложь);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	КонецЕсли;
	//ПоказатьВсплывающееУведомление("");
КонецПроцедуры   

Процедура ПерейтиКСтрокеМодуляИзСобытия()
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 6);
	ПерейтиКОпределению();
КонецПроцедуры 

Процедура ОткрытьПользователяИБ()
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 2); 
	ИмяПользователя = ТурбоКонф.ПолучитьЗначение();
	ЗакрытьМодальноеОкно();
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.ОткрытьМеню("Администрирование", "Пользователи");
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	НайтиСтрокуВОкне(ИмяПользователя, Истина);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	
КонецПроцедуры

Процедура ОткрытьОбъектМетаданныхИзСобытия()
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 7); 
	ПредставлениеМД = ТурбоКонф.ПолучитьЗначение();
	Если ПустаяСтрока(ПредставлениеМД) Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПредставлениеМД = СокрЛП(ПоследнийФрагментЛкс(ПредставлениеМД));
	СтрокаМД = МодулиИР.ирКэш.Получить().ДеревоОбъектовМД().Строки.Найти(ПредставлениеМД, "Представление", Истина);
	Если СтрокаМД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ПерейтиПоСсылкеМД(СтрокаМД.ПолноеИмяОбъекта);
КонецПроцедуры  

Процедура ОтобратьТранзакциюИзСобытия()
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 7, Истина); 
	Транзакция = ТурбоКонф.ПолучитьЗначение();
	Если ПустаяСтрока(Транзакция) Тогда
		Возврат;
	КонецЕсли;
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ЗакрытьМодальноеОкно();
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	КликнутьПоЭлементу("Отбор...", "кнопка");
	ТурбоКонф.ЖдатьОкно("Отбор", 2000, Истина);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	НажатьКлавишуЦикл(Клавиши.Tab, 1);
	УстановитьЗначениеПолюВвода(Транзакция); 
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
КонецПроцедуры  

