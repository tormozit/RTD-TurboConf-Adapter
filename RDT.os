//#Дублировать в файл C:\Portable\TurboConf\user_scripts\RDT.os

// Настройки
Перем ПапкаПортативногоИР;

Перем ТурбоКонф;
Перем МинимальнаяВерсияИР;
Перем МинимальнаяВерсияТурбоКонф;
Перем ВерсияАдаптера;
Перем ЗаголовокКонфигуратора;
Перем ВыделенныйТекст;
Перем ПозицияВТексте; 
Перем НомерСтрокиТекста;
Перем НомерКолонкиТекста;
Перем ТекстМодуля;
Перем ЯзыкПрограммы;
Перем ПеречТипЭлемента;
Перем ТипЭлементаИнтерфейса;

Функция НазваниеСкрипта()
	Возврат "ИР адаптер " + ВерсияАдаптера;
КонецФункции

Функция ИмяСкрипта()
	Возврат "ИРАдаптер";
КонецФункции

Функция НазваниеПриложения()
	Возврат "ИР";
КонецФункции

Функция НазваниеПодсистемы()
	Возврат "Инструменты разработчика Tormozit";
КонецФункции

// Просил добавить в API https://turboconf.ru/Tasks/9025
//  Сохраним историю границ выделения таким замороченным способом. Выделенный диапазон должен быть непустым. На историю переходов не влияет.
//  Полезно вызывать перед вставкой области, которая содержит выделенную пользователем область.
// 
// Возвращаемое значение:
//  Число - разница длин между старым и новым текстом модуля, возникает из-за ошибки платформы - при вставке текста из буфера, начинающегося с первой пустой строки перед ним иногда вставляются пробелы
//
Функция СохранитьГраницыВыделенияДляОтмены()

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВыделенныйТекст = "";
	ТекстМодуляДо = ТурбоКонф.ПолучитьТекстМодуля(ВыделенныйТекст, 0); 
	//ТурбоКонф.ВставитьТекст(ВыделенныйТекст); // Так не запоминает в истории
	//ТурбоКонф.ВставитьТекст(ВыделенныйТекст + " ");
	//ТурбоКонф.Клавиша(Клавиши.Back);
	////ТурбоКонф.ВыделитьТекст(Начало, Конец); // Почему то вызывает прокрутку окна чтобы выделенный диапазон стал в самый низ https://turboconf.ru/Tasks/8888
	Если ПустаяСтрока(ВыделенныйТекст) Тогда
		// Если выделенный текст пустой, то вставится текущее содержимое буфера обмена или текущей строки
		Результат = 0;
	Иначе
		ТурбоКонф.КонтролКлавиша(Клавиши.C);
		ТурбоКонф.КонтролКлавиша(Клавиши.V); 
		
		// Ждем завершения операции конфигуратора с буфером обмена
		
		// Способ 1
		ТурбоКонф.Ждать(100);   
		
		// Способ 2
		// Глючит https://turboconf.ru/Tasks/9302
		//ТурбоКонф.КонтролКлавиша(Клавиши.F);
		//ТурбоКонф.ОткрытьЗакрытьОкно("Поиск", 2000);     
		
		ТекстМодуляПосле = ТурбоКонф.ПолучитьТекстМодуля("", 0);
		Результат = СтрДлина(ТекстМодуляПосле) - СтрДлина(ТекстМодуляДо);
	КонецЕсли;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Сообщить("СохранитьГраницыВыделенияДляОтмены " + Длительность + "мс");
	Возврат Результат;
	
КонецФункции

Функция ОткрытьГлавноеОкноИРИОповеститьОПриостановке(Знач ПодключениеИР = Неопределено)
	БлокируемоеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	Если ПодключениеИР <> Неопределено Тогда
		ПодключениеИР.Visible = Истина;
	КонецЕсли;
	ТурбоКонф.ПоказатьУведомление("Работа TurboConf ПРИОСТАНОВЛЕНА на время диалога с приложением " + НазваниеПриложения(), 3000);
	Возврат БлокируемоеОкно;
КонецФункции

Процедура ОповеститьПользователяОВозобновлении()
	ТурбоКонф.ПоказатьУведомление("Работа TurboConf ВОЗОБНОВЛЕНА после диалога с приложением " + НазваниеПриложения(), 3000);
	//ТурбоКонф.ПоказатьВсплывающееУведомление("Работа TurboConf ВОЗОБНОВЛЕНА после диалога с приложением", 3000); // Для отладки
КонецПроцедуры

Процедура РедактироватьТекст(Знач ИмяЯзыкаПрограммы = "", Знач Текст = "", Знач Заголовок = "")
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР); 
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если ЗаголовокОкна = "Выражение" Тогда
		Если ПустаяСтрока(Текст) Тогда
			СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
			Выражение = СтруктураВыражения.Выражение;
			ЗначениеВыражения = ЗначениеВыраженияОкнаВыражение(Выражение);
			Если ЗначениеВыражения = Неопределено Тогда
				Возврат;
			КонецЕсли;
			Текст = ЗначениеВыражения.Значение;
			Заголовок = Выражение;
		КонецЕсли;
		Текст = ОткрытьРедакторТекста(Текст, Заголовок, ИмяЯзыкаПрограммы);
		Если Текст = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОткрытьОкноУстановкиЗначенияВВидеВыражения();
		ТурбоКонф.ВставитьТекст(МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(Текст));
		ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
		УстановитьФокусНаКнопкуСправка();
		ТурбоКонф.Клавиша(Клавиши.Tab);
		РезультатУстановкиЗначения = ТурбоКонф.ПолучитьТекстТекущегоЭлемента();
		Если Найти(РезультатУстановкиЗначения, "Изменение значения выполнено успешно") = 0 Тогда
			Возврат;
		КонецЕсли;
		ТурбоКонф.Клавиша(Клавиши.Escape);
	ИначеЕсли ЗаголовокОкна = "Просмотр значения выражения" Тогда
		ТурбоКонф.УстановитьФокусНаЭлемент("OK", "кнопка"); // английские буквы
		ТурбоКонф.Клавиша(Клавиши.Tab);
		Текст = ТурбоКонф.ПолучитьЗначение();
		ОткрытьРедакторТекста(Текст, Заголовок, ИмяЯзыкаПрограммы, Истина);
	Иначе
		Если ЗаголовокОкна = "Динамический список" Тогда
			Если Не ТурбоКонф.УстановитьФокусНаЭлемент("", "документ") Тогда
				Возврат;
			КонецЕсли;
			РазобратьПозициюВТексте();
		КонецЕсли;
		Если Истина
			И ЗаголовокОкна <> "Ввод выражения"
			И ЗаголовокОкна <> "Параметры точки останова"
			И Не ЗначениеЗаполнено(ТекстМодуля)
		Тогда
			ТекстМодуля = "ВЫБРАТЬ -0";
		КонецЕсли;
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина);
		Если ПолеТекстаПрограммы = Неопределено Тогда
			ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Ложь);
			Если ПолеТекстаПрограммы = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ЯзыкПрограммы = ПолеТекстаПрограммы.ЯзыкПрограммы;
		Значение = Ложь;
		БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
		ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Текст.*", 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
		// ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(".*", 2000, Конфигуратор.ГлавноеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
		ПодключениеИР.Visible = Истина;
		Попытка
			Если ЯзыкПрограммы = 0 Тогда
				ПолеТекстаПрограммы.КончитьОбработкуКоманды();
				ПолеТекстаПрограммы.РазобратьТекущийКонтекст();
				Значение = ПолеТекстаПрограммы.ОткрытьРедакторСтроковогоЛитерала();
			Иначе
				ПолеТекстаПрограммы.мЗаменяемыйДиапазон = Неопределено;
				Значение = МодулиИР.ирКлиент.ОткрытьТекстЛкс(ТекстМодуля, "", "", Ложь, Неопределено, Неопределено, Ложь, Истина, ПолеТекстаПрограммы.ПолеТекста.ВыделениеДвумерное());
				ПолеТекстаПрограммы.УстановитьТекст(Значение,,, Истина);
				Значение = Значение <> Неопределено И ТекстМодуля <> Значение;
			КонецЕсли;
		Исключение
			ПоказатьВсплывающееУведомление(ОписаниеОшибки());
		КонецПопытки;
		ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
		Если Значение Тогда
			ТурбоКонф.Ждать(100); // Иначе при закрытии по CTRL+ENTER ПолучитьТекстМодуля() возвращает пусто
			ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Функция ОткрытьРедакторТекста(Знач Текст, Знач Заголовок, Знач ИмяЯзыкаПрограммы = "", Знач ТолькоПросмотр = Ложь) Экспорт
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР); 
	Если Истина
		И Найти(Текст, Символы.ПС) = 0
		И ПустаяСтрока(ИмяЯзыкаПрограммы)
		И Не МодулиИР.ирОбщий.ЛиТекстJSONЛкс(Текст)
	Тогда
		ИмяЯзыкаПрограммы = "Обычный";
	КонецЕсли;
	Если Заголовок = Неопределено Тогда
		// Антибаг Оскрипт 1.9.3 https://github.com/EvilBeaver/OneScript/issues/1588
		Заголовок = "";
	КонецЕсли;
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Текст.*", 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		Текст = МодулиИР.ирКлиент.ОткрытьТекстЛкс(Текст, Заголовок, ИмяЯзыкаПрограммы, ТолькоПросмотр, Неопределено, Неопределено, Ложь, Истина);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
		Текст = Неопределено;
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Возврат Текст;
КонецФункции

Процедура КонструкторЗапроса(Знач ИмяЯзыкаПрограммы = "")
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР); 
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Если Не ЗначениеЗаполнено(ТекстМодуля) Тогда
		ТекстМодуля = "ВЫБРАТЬ -0";
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЯзыкПрограммы = ПолеТекстаПрограммы.ЯзыкПрограммы;
	Значение = Ложь;
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Конструктор запрос.*", 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	// ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(".*", 2000, Конфигуратор.ГлавноеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	ПодключениеИР.Visible = Истина;
	Попытка
		ПолеТекстаПрограммы.КончитьОбработкуКоманды();
		ПолеТекстаПрограммы.РазобратьТекущийКонтекст();
		Значение = ПолеТекстаПрограммы.ОткрытьКонструкторЗапроса();
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если Значение Тогда
		ТурбоКонф.Ждать(100); // Иначе при закрытии по CTRL+ENTER ПолучитьТекстМодуля() возвращает пусто
		ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы);
	КонецЕсли;	
КонецПроцедуры

Функция УстановитьФокусНаКнопкуСправка() Экспорт
	Возврат ТурбоКонф.УстановитьФокусНаЭлемент("Справка", "кнопка");
КонецФункции

// Если выделенный фрагмент непустой, то текущая позиция будет сохранена в истории переходов вызовом СохранитьГраницыВыделенияДляОтмены
// Параметры:
//    ПолеТекстаПрограммы - ОбработкаОбъект.ирКлсПолеТекстаПрограммы - 
Процедура ПередатьИзмененияИзПоляТекстаВОкноМодуля(Знач ПолеТекстаПрограммы, Знач ПроверитьНеизменность = Истина, Знач ВесьМодульДляAPI5 = Ложь, Знач ДобавкаПослеМетодаДляAPI5 = "", 
	Знач ВосстановитьБуфер = Истина, Знач УчестьЧислоВставленныхСтрок = Ложь) Экспорт
	
	// Нельзя такую проверку делать, т.к. для поля текста запроса оно всегда истинно
	//Если ПолеТекстаПрограммы.мЗамещающийФрагмент = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	СтароеЗначениеБуфераОбмена = ТурбоКонф.ПолучитьБуферОбмена();
	НовыйТекстМодуляИзКонфигуратора = ТурбоКонф.ПолучитьТекстМодуля(ВыделенныйТекст, 0);
	Если ПроверитьНеизменность Тогда
		Если Истина
			И ЗначениеЗаполнено(НовыйТекстМодуляИзКонфигуратора) 
			И НовыйТекстМодуляИзКонфигуратора <> ТекстМодуля 
		Тогда
			ПолеТекстаПрограммы.мЗамещающийФрагмент = Неопределено;
			Если ЯзыкПрограммы = 0 Тогда
				ТекстЛитерала = ПолеТекстаПрограммы.ВыделитьТекстовыйЛитерал();
			Иначе
				ТекстЛитерала = ПолеТекстаПрограммы.ПолеТекста.ПолучитьТекст();
			КонецЕсли;
			ТурбоКонф.УстановитьБуферОбмена(ТекстЛитерала);
			ПоказатьВсплывающееУведомление("Текст в окне конфигуратора был изменен с начала редактирования. Вставка не выполнена. Фрагмент помещен в буфер обмена:
			|" + ТекстЛитерала);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Ложь
		Или ТурбоКонф.ПолучитьВерсиюAPI() < 6 
		Или ТурбоКонф.РежимСовместимости()
	Тогда
		Если Истина
			И ЯзыкПрограммы = 0 
			И Не ВесьМодульДляAPI5 
			И ПолеТекстаПрограммы.мМетодМодуля <> Неопределено 
			И ПолеТекстаПрограммы.мКонечнаяСтрока <= ПолеТекстаПрограммы.мНомерПоследнейСтрокиТелаМетода + 1 // для форматирования
		Тогда
			// Заменяем только текущий метод
			ПолеТекстаПрограммы.РазобратьТекущийКонтекст();
			ТекстВставки = ПолеТекстаПрограммы.ОпределениеМетодаБезОписания() + ДобавкаПослеМетодаДляAPI5;
			НачальнаяКолонкаМетода = 1 + СтрДлина(ТекстВставки) - СтрДлина(СокрЛ(ТекстВставки));
			ТекстВставки = СокрЛ(ТекстВставки);
			НомерСтрокиОпределенияМетода = СтрЧислоСтрок(Лев(ТекстМодуля, ПолеТекстаПрограммы.мМетодМодуля.ПозицияОпределения) + "й");
			ПерейтиВПозицию(НачальнаяКолонкаМетода, НомерСтрокиОпределенияМетода); 
			ТурбоКонф.КонтролШифтКлавиша(Клавиши.OemCloseBrackets);
		Иначе
			// Заменяем весь модуль и теряем свертки, точки останова, закладки
			ТекстВставки = ПолеТекстаПрограммы.ПолеТекста.ПолучитьТекст();
			КомандаВыделитьВсе();
			ТурбоКонф.Ждать(200);
		КонецЕсли;
	Иначе
		СмещениеНачала = 0;
		ЗаменяемыйДиапазон = ПолеТекстаПрограммы.мЗаменяемыйДиапазон;
		ИсправитьНеопределеноCOM(ЗаменяемыйДиапазон);
		Если ВыделенныйТекст <> "" Тогда
			СмещениеНачала = СохранитьГраницыВыделенияДляОтмены();
		ИначеЕсли Истина
			И ЗаменяемыйДиапазон <> Неопределено
			И ЗаменяемыйДиапазон.Свойство("НомерСтроки") 
		Тогда
			ТурбоКонф.ПерейтиВПозицию(1, ЗаменяемыйДиапазон.НомерСтроки); // Для сохранения позиции в истории переходов
		КонецЕсли;
		Если ЗаменяемыйДиапазон <> Неопределено Тогда
			ТекстВставки = ПолеТекстаПрограммы.мЗамещающийФрагмент;
			ПолеТекстаПрограммы.мЗамещающийФрагмент = Неопределено;
			ТурбоКонф.ВыделитьТекст(СмещениеНачала + ЗаменяемыйДиапазон.Начало - 1, СмещениеНачала + ЗаменяемыйДиапазон.Конец - 1);
		Иначе
			ТекстВставки = ПолеТекстаПрограммы.ПолеТекста.ПолучитьТекст();
			ТурбоКонф.ВыделитьТекст(0, СтрДлина(ТурбоКонф.ПолучитьТекстТекущегоЭлемента()));
		КонецЕсли;
	КонецЕсли;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ТурбоКонф.ВставитьТекст(ТекстВставки);
	Исключение
		Если ЛиВФоновомЗадании() Тогда
			// (System.Threading.ThreadStateException): Текущий поток должен быть задан как поток однопоточного контейнера (STA), чтобы вызовы OLE стали возможны. Проверьте, что ваша функция Main помечена атрибутом STAThreadAttribute.}
			ОписаниеОшибки = ОписаниеОшибки();
			Сообщить(ОписаниеОшибки, СтатусСообщения.Внимание);
			ПоказатьВсплывающееУведомление("Вызовите команду ПоказатьПараметрыМетода дважды для перевода окна подсказки в блокирующий режим");
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	ДлительностьВставки = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Сообщить("Вставка блока " + ДлительностьВставки + "мс");
	Если ДлительностьВставки > 3000 Тогда
		ПоказатьВсплывающееУведомление("Вставка текста в окно конфигуратора замедлилась. Для ускорения рекомендуется перезапустить конфигуратор или снизить таймауты UIAtomation в настройках программы");
	КонецЕсли;
	СмещениеКонца = 0;
	Если УчестьЧислоВставленныхСтрок Тогда
		СмещениеКонца = СтрЧислоСтрок(ТекстВставки) - 1;
	КонецЕсли;
	ПередатьГраницыВыделенияИзПолеТекстаПрограммы(ПолеТекстаПрограммы, -СмещениеКонца);
	Если ВосстановитьБуфер Тогда
		УстановитьБуферОбмена(СтароеЗначениеБуфераОбмена);
	КонецЕсли;
КонецПроцедуры

// Антибаг ОСкрипт 1.9.3 https://github.com/EvilBeaver/OneScript/issues/1588
Процедура ИсправитьНеопределеноCOM(ЗначениеИзCOM) Экспорт
	Если ЗначениеИзCOM = -2147352572 Тогда
		ЗначениеИзCOM = Неопределено;
	КонецЕсли;
КонецПроцедуры

Процедура ПередатьГраницыВыделенияИзПолеТекстаПрограммы(Знач ПолеТекстаПрограммы, Знач СмещениеКонца = 0) Экспорт
	Если Ложь
		Или ТурбоКонф.ПолучитьВерсиюAPI() < 6 
		Или ТурбоКонф.РежимСовместимости()
	Тогда
		ВыделениеДвумерное = ПолеТекстаПрограммы.ПолеТекста.ВыделениеДвумерное();
		ПерейтиВПозицию(ВыделениеДвумерное.НачальнаяКолонка, ВыделениеДвумерное.НачальнаяСтрока);
	Иначе 
		ВыделениеОдномерное = ПолеТекстаПрограммы.ПолеТекста.ВыделениеОдномерное();
		ТурбоКонф.ВыделитьТекст(ВыделениеОдномерное.Начало - 1, ВыделениеОдномерное.Конец - 1 + СмещениеКонца);
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьАвтоФильтрВыбораТипа() Экспорт
	ЭтоКоманда = Неопределено; // Булево
	Текст = ИмяВладельцаВыбираемогоТипа(ЭтоКоманда);
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.M);
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Фильтр = Текст;
	ПодключениеИР = ПодключениеИРИзКэша();
	МодулиИР = МодулиИР(ПодключениеИР); 
	Если Не ЭтоКоманда Тогда
		Ошибка = "";
		КорниСлов = МодулиИР.ирОбщий.КорниСловЛкс(Текст, Истина,, Ошибка);
		Если ЗначениеЗаполнено(КорниСлов) Тогда
			Фильтр = КорниСлов;
		КонецЕсли;
	КонецЕсли;
	УстановитьЗначениеПолюВвода(Фильтр, Ложь, Клавиши.Space);
	Если Не УстановитьФокусВПервуюТаблицуИлиСписок() Тогда
		Возврат;
	КонецЕсли;
	СтарыйТип = ТурбоКонф.ПолучитьИмяЭлемента();
	ИмяТипа = МодулиИР.ирОбщий.ИмяТипаИзИмениПеременнойЛкс(Текст);
	Если ЗначениеЗаполнено(ИмяТипа) Тогда
		МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТурбоКонф.ПолучитьИмяЭлемента() = СтарыйТип И ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала < 2000 Цикл
			ТурбоКонф.Ждать(100);
		КонецЦикла;
		УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
		//НайтиСтрокуВОкне(ПоследнийФрагментЛкс(ИмяТипа)); // TODO Заработает только в 8.5.1 https://www.hostedredmine.com/issues/1003228
		ТурбоКонф.Клавиша(Клавиши.Down);
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеПриложения(), "Ошибка запроса корней слов из https://sinonim.org : " + Ошибка);
	КонецЕсли;
КонецПроцедуры

Процедура КнопкаНайтиЛучшийТип() Экспорт
	ЭтоКоманда = Неопределено; // Булево
	Текст = ИмяВладельцаВыбираемогоТипа(ЭтоКоманда);
	Если ПустаяСтрока(Текст) Тогда
		//ТурбоКонф.КонтролАльтКлавиша(Клавиши.M); // похоже поле фильтра само активируется
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИРИзКэша();
	МодулиИР = МодулиИР(ПодключениеИР); 
	ЛучшийТип = МодулиИР.ирОбщий.ИмяТипаИзИмениПеременнойЛкс(Текст);
	Если ПустаяСтрока(ЛучшийТип) Тогда
		//ТурбоКонф.КонтролАльтКлавиша(Клавиши.M); // похоже поле фильтра само активируется
		Возврат;
	КонецЕсли;
	Если Не УстановитьФокусВПервуюТаблицуИлиСписок(Истина) Тогда
		Возврат;
	КонецЕсли; 
	АктивироватьСтрокуДерева(ЛучшийТип);
КонецПроцедуры

Функция ИмяВладельцаВыбираемогоТипа(выхЭтоКоманда = Ложь) Экспорт
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ЗакрытьМодальноеОкно(,,, Истина);
	ТурбоКонф.Ждать(20);
	выхЭтоКоманда = Ложь;
	ТекстСтарогоПоля = ТурбоКонф.ПолучитьЗначение();
	ИмяЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
	Если ИмяЭлемента = "Тип значения" Тогда
		ТекстСтарогоПоля = ИмяЭлемента;
		ЧислоШагов = 16; /// Путь
		НажатьКлавишуЦикл(Клавиши.Tab, ЧислоШагов, Истина); 
		ТурбоКонф.Ждать(100);
		Текст = СтрРазделитьЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ")[0];
		Сообщить("ИмяПоляКомпоновки=" + Текст);
		НажатьКлавишуЦикл(Клавиши.Tab, ЧислоШагов);
		ТурбоКонф.Клавиша(Клавиши.Enter);
		ТурбоКонф.Ждать(100);
		ТекстНовогоПоля = ТурбоКонф.ПолучитьИмяЭлемента();
		Сообщить("ЗначениеТипаНовое=" + ТекстНовогоПоля);
	Иначе
		Для СчетчикШагов = 1 По 5 Цикл
			ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
			ТурбоКонф.Ждать(20);
			ЖдатьОсвобожденияПотокаВвода();
			Текст = ТурбоКонф.ПолучитьЗначение();
			Если Ложь
				ИЛи Найти(Текст, "анель") > 0 // - если шагаем вверх
				Или Текст = "Одиночный" // - если шагаем вниз, не понял почему такое происходит
				Или Текст = "Множественный" // - если шагаем вниз, не понял почему такое происходит
			Тогда
				ИмяСвойстваПредставления = "Синоним";
				выхЭтоКоманда = Истина;
				Прервать;
			ИначеЕсли Ложь
				Или Текст = "Использовать"
				Или Текст = "Не использовать"
			Тогда
				// Реквизит метаданных
				ИмяСвойстваПредставления = "Синоним";
				Прервать;
			ИначеЕсли Текст = "Открыть" Тогда // Срабатывает в константе
				// Реквизит формы или обработки
				ИмяСвойстваПредставления = "Заголовок";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если выхЭтоКоманда Тогда
			АктивироватьДеревоОсновнойКонфигурации();
			ПолноеИмяМД = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР);
			ТурбоКонф.АльтКлавиша(Клавиши.Enter);
			Фрагменты = СтрРазделитьЛкс(ПолноеИмяМД);
			Если Фрагменты.Количество() < 3 Тогда
				// Общая команда
				Возврат "";
			КонецЕсли;
			Текст = Фрагменты[1];
			АктивироватьСвойствоВПалитреСвойств("Тип параметра команды");
		Иначе
			АктивироватьСвойствоВПалитреСвойств(ИмяСвойстваПредставления);
			ТурбоКонф.Ждать(20);
			Текст = ТурбоКонф.ПолучитьЗначение();
			АктивироватьСвойствоВПалитреСвойств("Тип");
		КонецЕсли;
		ТурбоКонф.Ждать(20);
		ТекстНовогоПоля = ТурбоКонф.ПолучитьЗначение();
	КонецЕсли;
	Если ТекстНовогоПоля <> ТекстСтарогоПоля Тогда
		// контроль корректности перемещений не пройден
		Возврат "";
	КонецЕсли;
	Сообщить("ИмяСвойстваПредставления=" + ИмяСвойстваПредставления);
	Сообщить("ИмяВладельцаВыбираемогоТипа=" + Текст);
	СохранитьЗначениеСеансаКонфигуратора("ПрограммноеОткрытиеВыбораТипа", Истина);
	ТурбоКонф.Клавиша(Клавиши.F4);
	ТурбоКонф.ЖдатьОкно("Редактирование типа данных", 1000, Ложь);
	Возврат Текст;
КонецФункции

Процедура КнопкаВыбратьПутьИтога() Экспорт
	ЗакрытьМодальноеОкно(,,, Истина);
	ТурбоКонф.Ждать(10);
	АктивироватьСвойствоВПалитреСвойств("ПутьКДанным");
	ТурбоКонф.Ждать(20);
	ПутьКДанным = ТурбоКонф.ПолучитьЗначение();
	Если ПустаяСтрока(ПутьКДанным) Тогда
		ПоказатьВсплывающееУведомление("Базовый путь к данным поля пуст");
		Возврат;
	КонецЕсли; 
	АктивироватьСвойствоВПалитреСвойств("ПутьКДаннымПодвала");
	ТурбоКонф.Ждать(20);
	ТурбоКонф.Клавиша(Клавиши.F4);
	ТурбоКонф.ЖдатьОкно("Выбор реквизита", 1000, Истина);
	УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
	ПутьКДанным = СтрокаБезПоследнегоФрагментаЛкс(ПутьКДанным) + ".Итог" + ПоследнийФрагментЛкс(ПутьКДанным);
	АктивироватьСтрокуДерева(ПутьКДанным);
КонецПроцедуры

Процедура КнопкаВыбратьПутьИзБуфера() Экспорт
	ТекстИзБуфера = ТурбоКонф.ПолучитьБуферОбмена();
	УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
	АктивироватьСтрокуДерева(ТекстИзБуфера);
КонецПроцедуры

Процедура КнопкаВставитьTab() Экспорт              
	Если ТипТекущегоЭлементаИнтерфейса() <> ПеречТипЭлемента.ПолеСоСписком Тогда
		ТурбоКонф.Клавиша(Клавиши.r); // к
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.ВставитьТекст(Символы.Таб);
КонецПроцедуры

Процедура ВыбратьИзПомеченныхЭлементовСписка() Экспорт
	ТекущийТип = ТурбоКонф.ПолучитьЗначение();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
	ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, 1000);
	ТурбоКонф.Ждать(50);
	ЗначениеТипа = ТурбоКонф.ПолучитьЗначение();
	ТурбоКонф.Клавиша(Клавиши.F4); 
	СтароеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.ЖдатьСменуАктивногоОкна(СтароеОкно, 1000, Ложь);
	ИменаПомеченных = СтрРазделитьЛкс(ЗначениеТипа, ",", Истина);
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ИменаПомеченных);
	Список.СортироватьПоЗначению();
	ИменаПомеченных = Список.ВыгрузитьЗначения();
	Индекс = ВыбратьЭлементСписка(ИменаПомеченных, ТекущийТип,,, "Помеченные элементы");
	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ВыбранноеИмя = ИменаПомеченных[Индекс];
	СвернутьДеревоИПерейтиВНачало();
	АктивироватьСтрокуДерева(ВыбранноеИмя);
	ТурбоКонф.Ждать(100); // Чтобы успела сработать установка фокуса в поле фильтра. Не всегда достаточно 100мс
	УстановитьФокусВПервуюТаблицуИлиСписок();
КонецПроцедуры

Процедура УстановитьТипПараметраВыбора() Экспорт
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЧислоКолонок = 2;
	МодулиИР = МодулиИР(ПодключениеИР); 
	// Для выхода из режима редактирования строки
	НажатьКлавишуЦикл(Клавиши.Tab, ЧислоКолонок); 
	УстановитьФокусВПервуюТаблицуИлиСписок();
	НажатьКлавишуЦикл(Клавиши.Left, 1);
	ИмяПараметраВыбора = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " Имя");
	//Сообщить("ИмяПараметраВыбора="+ИмяПараметраВыбора);
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
	ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, 1000); 
	СтароеИмя = ТурбоКонф.ПолучитьИмяЭлемента();
	АктивироватьТекущийОбъектВДеревеКонфигурации(); 
	ТурбоКонф.Ждать(100);
	Если СтароеИмя = ТурбоКонф.ПолучитьИмяЭлемента() Тогда
		// Это реквизит объекта метаданных. Иногда из-за сбоя в работе CTRL+T сюда приходим и в форме
		АктивироватьСвойствоВПалитреСвойств("Тип");
		ТурбоКонф.Ждать(100); // https://turboconf.ru/Tasks/10331
		ИмяТипаСсылки = ТурбоКонф.ПолучитьЗначение();
	Иначе
		// Это поле формы
		ТурбоКонф.Клавиша(Клавиши.Enter); // - Активируем строку структуры формы
		ТурбоКонф.Клавиша(Клавиши.F12);
		НажатьКлавишуЦикл(Клавиши.Right, 4); // - Активируем колонку ТипЗначения списка реквизитов
		ТурбоКонф.Ждать(100);
		ИмяТипаСсылки = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " Тип");
		ТурбоКонф.Клавиша(Клавиши.F12);
		ТурбоКонф.Клавиша(Клавиши.Enter);
	КонецЕсли;
	Сообщить("ИмяТипаСсылки="+ИмяТипаСсылки);
	ТурбоКонф.Ждать(20);
	АктивироватьСвойствоВПалитреСвойств("Параметры выбора"); // ПараметрыВыбора - только для поля формы работает 
	ТурбоКонф.Клавиша(Клавиши.F4);
	ТурбоКонф.ЖдатьОкно("Редактирование параметров выбора", 1000, Истина);
	ТурбоКонф.Ждать(20);
	ИмяПоляБД = ПоследнийФрагментЛкс(ИмяПараметраВыбора);
	ИмяТаблицыБД = СтрЗаменить(ИмяТипаСсылки, "Ссылка.", ".");
	ИмяТипаПоля = МодулиИР.ирОбщий.ИмяТипаПоляТаблицыБДЛкс(ИмяТаблицыБД, ИмяПоляБД);
	Если ИмяТипаПоля = Неопределено Тогда
		ПоказатьВсплывающееУведомление(СтрШаблон("Поле (%1) не найдено в таблице БД (%2)", ИмяПоляБД, ИмяТаблицыБД));
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок(); 
	Если ТурбоКонф.ПолучитьИмяЭлемента() <> ИмяПараметраВыбора + " Имя" Тогда
		НайтиСтрокуВОкне(ИмяПараметраВыбора,, Истина);
	КонецЕсли;
	НажатьКлавишуЦикл(Клавиши.Right, ЧислоКолонок);
	ТурбоКонф.Клавиша(Клавиши.F2);
	ТурбоКонф.ШифтКлавиша(Клавиши.F4);
	ТурбоКонф.Клавиша(Клавиши.F4);
	ТурбоКонф.ЖдатьОкно("Выбор типа данных", 1000, Истина);
	ТурбоКонф.Ждать(20);
	Сообщить("ИмяТипаПоля="+ ИмяТипаПоля);
	НайтиСтрокуВОкне(ИмяТипаПоля,, Истина);
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
КонецПроцедуры

// Свойство активируется через фильтрацию по подстроке. Поэтому в редких случаях возможна стабильная активная неправильного элемента
Процедура АктивироватьСвойствоВПалитреСвойств(Знач ИмяСвойства, Знач ЧислоПолейШапки = 0, Знач ТребоватьПоле = Ложь, Знач ВставкаЧерезБуфер = Ложь) Экспорт
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Ждать(20);
	//ТурбоКонф.Клавиша(Клавиши.Subtract); // Иногда он ошибочно считает что группа раскрыта
	//ТурбоКонф.Ждать(20);
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Ждать(20);
	//ВызватьИсключение 1;
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.I);
	ТурбоКонф.Ждать(20); 
	Если ВставкаЧерезБуфер Тогда
		// В свойствах общего модуля почему то активным с точки зрения UIAutomation становится поле первого свойства вместо фильтра. Поэтому нужно через буфер вставлять.
		// В фоновом задании не работает, например при переходе из окна вызова метода. Не работает в команде УстановитьФильтр окна "Редактирование типа"
		ТурбоКонф.ВставитьТекст(ИмяСвойства); 
	Иначе
		УстановитьЗначениеПолюВвода(ИмяСвойства,, Клавиши.Space);
	КонецЕсли;
	//Возврат;

	// На случай нескольких свойств в результате фильтра - всплепую берем верхний. 
	ТурбоКонф.АльтКлавиша(Клавиши.Enter);
	ТурбоКонф.Ждать(20);
	Если ТребоватьПоле Тогда
		Для Сч=1 По 5 Цикл
			ТипТекущегоЭлемента = ТипТекущегоЭлементаИнтерфейса();
			Если Ложь
				Или ТипТекущегоЭлемента = ПеречТипЭлемента.Поле 
				Или ТипТекущегоЭлемента = ПеречТипЭлемента.ПолеСоСписком
			Тогда
				Прервать;
			КонецЕсли;
			СтарыйИД = ТурбоКонф.ПолучитьRuntimeIdСтрокой();
			ТурбоКонф.Клавиша(Клавиши.Tab);
			Если ЖдатьСменуТекущегоЭлемента(СтарыйИД, 20) = СтарыйИД Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.I);
	ТурбоКонф.Ждать(10);
	ТурбоКонф.ШифтКлавиша(Клавиши.F4);
	ТурбоКонф.Ждать(10);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТурбоКонф.Ждать(10);
	
	// Лечим пропажу фокуса ввода в поле значения свойства
	ТурбоКонф.Клавиша(Клавиши.Up);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Ждать(10);
КонецПроцедуры

Процедура ВыбратьТипДанных() Экспорт
	Если НайтиВСписке() Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
	КонецЕсли;
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура КонструкторМетода()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Запрос" Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Конструктор метода.*", 5000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Значение = Ложь;
	// ПодключениеИР.Visible = Истина;
	Попытка
		Значение = ПолеТекстаПрограммы.ОткрытьКонструкторМетода();
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если Значение = Ложь Тогда
		Возврат;
	ИначеЕсли Значение = "Ошибка" Тогда
		ВосстановитьОкноПриложения(ПодключениеИР);
	Иначе
		ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы,,, Символы.ПС + Символы.ПС + Значение);
	КонецЕсли;
		
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ВосстанавливатьБуферОбмена
//&ЗапроситьИнформациюОДокументе
Процедура ФорматироватьТекст()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;             
	Если ПолеТекстаПрограммы.ЯзыкПрограммы = 0 Тогда 
		Если Не ЗначениеЗаполнено(ВыделенныйТекст) Тогда
			ПоказатьВсплывающееУведомление("Необходимо выделить блок текста", 2000);
			Возврат;
		КонецЕсли;
		Если ПолеТекстаПрограммы.ФорматироватьТекстВстроенногоЯзыка(Ложь) Тогда
			ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы, Ложь, ПолеТекстаПрограммы.мКонечнаяСтрока > ПолеТекстаПрограммы.мНомерПоследнейСтрокиТелаМетода + 1);
		КонецЕсли;
	ИначеЕсли ПолеТекстаПрограммы.ЯзыкПрограммы = 1 Тогда 
		Если ПолеТекстаПрограммы.ФорматироватьТекстЯзыкаЗапросов() Тогда 
			ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы, Ложь, Истина,, Ложь);
		КонецЕсли;
	КонецЕсли;
		         
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ВосстанавливатьБуферОбмена
Процедура СортироватьСтрокиТекста()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;             
	Если Не ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		ПоказатьВсплывающееУведомление("Необходимо выделить блок текста", 2000);
		Возврат;
	КонецЕсли;
	Если ПолеТекстаПрограммы.СортироватьСтрокиТекста() Тогда
		ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы, Ложь, ПолеТекстаПрограммы.мКонечнаяСтрока > ПолеТекстаПрограммы.мНомерПоследнейСтрокиТелаМетода + 1,, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьОкноПриложения(ПодключениеИР)
	// ПодключениеИР нельзя из кэша брать, т.к. там активное окно конфигуратора заново получается
	СтароеАктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	ПодключениеИР.Visible = Истина; 
	МодулиИР = МодулиИР(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	// В 8.3.9- заголовок окна будет с добавкой слева
	ФиктивноеОкно = 1;
	Если Не ЗначениеЗаполнено(Конфигуратор) Тогда
		ОкноКонфигуратора = ФиктивноеОкно;
	Иначе
		ОкноКонфигуратора = Конфигуратор.ГлавноеОкно;
	КонецЕсли;
	//Если ЗначениеЗаполнено(ЗаголовокПриложенияИР) Тогда
	//	ШаблонЗаголовка = МодулиИР.ирОбщий.ТекстДляРегВыраженияЛкс(ЗаголовокПриложенияИР);
	//КонецЕсли;
	ШаблонЗаголовка = "";
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(ШаблонЗаголовка, 2000, ОкноКонфигуратора, РежимОткрытияВнешнегоОкна.ГлавноеОкно, Истина, ИдентификаторПроцессаИР);
	ЗавершитьВызовВнешнегоОкнаАсинх(ФиктивноеОкно, ИдентификаторПроцессаИР);
	
	// Подождем получения фокуса окном приложения ИР, что иногда не сразу происходит https://turboconf.ru/Tasks/8912
	ЖдатьПотерюАктивностиОкна(СтароеАктивноеОкно);
КонецПроцедуры

// Ненадежно. Вместо этого метода лучше вызывать ТипТекущегоЭлементаИнтерфейса(),
//
// Параметры:
//  СтароеАктивноеОкно	 - Число - 
//  ЧислоСекунд			 - Число - 
// 
// Возвращаемое значение:
//  Булево - Истина если окно потеряло фокус
//
Функция ЖдатьПотерюАктивностиОкна(Знач СтароеАктивноеОкно = Неопределено, Знач ЧислоСекунд = 2, Знач НадежныйРежим = Ложь) Экспорт
	Если СтароеАктивноеОкно = Неопределено Тогда
		СтароеАктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	КонецЕсли;
	Если ТурбоКонф.ПолучитьВерсиюAPI() < 6 Или НадежныйРежим Тогда
		МоментНачала = ТекущаяДата();
		Пока Истина
			И ТурбоКонф.ПолучитьАктивноеОкно() = СтароеАктивноеОкно 
			И ТекущаяДата() <= МоментНачала + ЧислоСекунд - 1 // Не больше ЧислоСекунд секунд ждем
		Цикл
			ТурбоКонф.Ждать(100);
		КонецЦикла;
		Результат = ТурбоКонф.ПолучитьАктивноеОкно() <> СтароеАктивноеОкно;
	Иначе 
		Результат = ТурбоКонф.ЖдатьСменуАктивногоОкна(СтароеАктивноеОкно, ЧислоСекунд * 1000, Ложь); // Не надеждно https://turboconf.ru/Tasks/9997
		//Сообщить("Резу="+ Результат);
		//Сообщить("СтароеАктивноеОкно="+ СтароеАктивноеОкно);
	КонецЕсли;
	Возврат Результат;
КонецФункции

//&ЗапроситьИнформациюОДокументе
Процедура КопироватьСсылку()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
		ЗаголовокКолонки = " Элемент";
		ИмяЭлементаФормы = "";
		Если СтрЗаканчиваетсяНа(ТекстЯчейки, ЗаголовокКолонки) Тогда
			ИмяЭлементаФормы = СтрокаБезПоследнегоФрагментаЛкс(ТекстЯчейки, ЗаголовокКолонки);
			АктивироватьТекущийОбъектВДеревеКонфигурации();
		КонецЕсли;
		Ссылка = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
			Ссылка = Ссылка + ".Элементы." + ИмяЭлементаФормы;
			ВернутьсяВПредыдущееМестоКонфигуратора();
		КонецЕсли;
	Иначе 
		Если Не ЗначениеЗаполнено(ПолеТекстаПрограммы.мИмяМодуля) Тогда
			// ПоказатьВсплывающееУведомление("Поддерживается копирование ссылок только в развернутых модулях");
			Возврат;
		КонецЕсли;
		// №1 расширенная ссылка
		Ссылка = "";
		Ссылка = Ссылка + Символы.ПС + "1. " + ПолеТекстаПрограммы.СсылкаСтрокиМодуля(, Истина);
		// №2 стандартный формат платформы
		Ссылка = Ссылка + Символы.ПС + "2. " + ПолеТекстаПрограммы.СсылкаСтрокиМодуля(, Ложь) + ": <Стандартная>";
		// №3 - полное имя метода
		Если ПолеТекстаПрограммы.мМетодМодуля <> Неопределено Тогда
			Ссылка = Ссылка + Символы.ПС + "3. см. " + ПолеТекстаПрограммы.ПолноеИмяМетода();
		КонецЕсли;
		Ссылка = СокрЛП(Ссылка);
	КонецЕсли;
	УстановитьБуферОбмена(Ссылка);
	ТурбоКонф.ОтжатьМодификаторы();
	УказательУведомления = ПоказатьВсплывающееУведомление("Скопирована ссылка - " + Ссылка);
	//УказательУведомления = ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Скопирована ссылка - " + Ссылка,, ЭтотОбъект, "ПерейтиКОпределениюИзУведомления",, "Перейти");
КонецПроцедуры

// Пока нет способа выполнить в другом конфигураторе https://turboconf.ru/Tasks/9986
Процедура ПерейтиКОпределениюИзУведомления(Знач Параметры)
	ПерейтиКОпределению(Ложь);
КонецПроцедуры  

Функция СсылкаНаОбъектМДВДеревеКонфигурации(Знач ПодключениеИР, Знач ТолькоВерхнийУровень = Ложь, выхИмяРасширения = "") Экспорт
	МодулиИР = МодулиИР(ПодключениеИР);
	
	//ТурбоКонф.КонтролКлавиша(Клавиши.F);
	//ТурбоКонф.ЖдатьОкно("Поиск объектов метаданных", 1000, Истина);
	//ЗакрытьМодальноеОкно(, Клавиши.Enter);
	//ОткрытьРезультатыПоиска();
	//НайденныйОбъект = ВыделенныйТекст(); // Копируются сразу все результаты
	//ВернутьсяВПредыдущееМестоКонфигуратора();
	//ВернутьсяВПредыдущееМестоКонфигуратора();
	//ЭтоРасширение = Найти(НайденныйОбъект, "Расширение конфигурации ");
	ЭтоРасширение = Ложь; // Так ссылка на объект расширения может быть неполной, зато очень быстро выполняется копирование
	ИмяЭлементаДереваНачальное = ТурбоКонф.ПолучитьИмяЭлемента();
	Если Не ЭтоРасширение И ОткрытьКонтекстноеМенюДереваМетаданных() Тогда
		СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
		Если КликнутьПоЭлементу("Справочная информация", "элемент меню") Тогда
			ЖдатьСменуТекущегоЭлемента(СтарыйИД, 50); // На корне конфигурации часто возникала ошибка System.NullReferenceException: Ссылка на объект не указывает на экземпляр объекта.
			// Частично дублируем логику см. ИмяМодуляДокумента Мультиметка250108_112016
			//ТурбоКонф.Ждать(10);
			Заголовок = МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТурбоКонф.ПолучитьЗаголовокКонфигуратора(Конфигуратор.ГлавноеОкно), "- Конфигуратор -", Ложь);
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			ЗакрытьДочернееОкноКонфигуратора();
			ЖдатьСменуТекущегоЭлемента(СтарыйИД, 50); // На корне конфигурации часто возникала ошибка System.NullReferenceException: Ссылка на объект не указывает на экземпляр объекта.
			ИмяЭлементаДереваНовое = ТурбоКонф.ПолучитьИмяЭлемента();
			Если ИмяЭлементаДереваНовое <> ИмяЭлементаДереваНачальное Тогда
				ВернутьсяВПредыдущееМестоКонфигуратора();
			КонецЕсли;
			Если ПустаяСтрока(Заголовок) Тогда
				ПоказатьВсплывающееУведомление("Разверните дочерние окна конфигуратора для ускорения получения ссылки на объект метаданных");
			Иначе
				ЧастиДвоеточия = СтрРазделитьЛкс(Заголовок, ":", Истина);
				ИмяКорневогоТипа = ИдентификаторИзПредставленияЛкс(СтрокаБезПоследнегоФрагментаЛкс(ЧастиДвоеточия[0], " "));
				Если ИмяКорневогоТипа = "Конфигурация" Тогда
					ПолноеИмяОбъекта = "ОбщаяФорма." + ЧастиДвоеточия[1];
				Иначе
					ИмяОбъекта = ПоследнийФрагментЛкс(ЧастиДвоеточия[0], " ");
					ПолноеИмяОбъекта = ИмяКорневогоТипа + "." + ИмяОбъекта;  
					Если Истина
						И ЧастиДвоеточия.Количество() > 1 
						И ЧастиДвоеточия[1] <> "Справочная информация"
					Тогда
						ПолноеИмяОбъекта = ПолноеИмяОбъекта + ".Форма." + ИдентификаторИзПредставленияЛкс(ЧастиДвоеточия[1]);
					КонецЕсли;
				КонецЕсли;
				Возврат ПолноеИмяОбъекта;
			КонецЕсли; 
		ИначеЕсли Истина
			И Не ТурбоКонф.НайтиЭлементПоИмени("Открыть макет", "элемент меню")
			И КликнутьПоЭлементу("Поиск ссылок в объекте", "элемент меню") 
		Тогда
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.O);
			Текст = ТекстАктивногоДокумента();
			ТекстовыйДокумент = Новый ТекстовыйДокумент;
			ТекстовыйДокумент.УстановитьТекст(Текст);
			Для НомерСтроки = -ТекстовыйДокумент.КоличествоСтрок() По 0 Цикл // Обратный обход
				СтрокаСообщения = ТекстовыйДокумент.ПолучитьСтроку(-НомерСтроки);
				ПолноеИмяОбъекта = ТекстМеждуМаркерамиЛкс(СтрокаСообщения, """", """", Ложь, Ложь, Ложь, Ложь);
				Если ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;  
			Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Поиск ссылок" Тогда
				ЗакрытьДочернееОкноКонфигуратора();
			Иначе
				ВернутьсяВПредыдущееМестоКонфигуратора();
				Возврат ПолноеИмяОбъекта;
			КонецЕсли;
		Иначе
			ЗакрытьДочернееОкноКонфигуратора();
		КонецЕсли;
	КонецЕсли;
	
	Фрагменты = ПутьВДеревеТабличногоПоля(ПодключениеИР);
	Если Ложь
		Или Фрагменты.Количество() < 2 
		Или Найти(Фрагменты[0], " ") > 0 // неполное дерево
	Тогда 
		АктивироватьСтрокуДерева(Фрагменты);
		Возврат "";
	КонецЕсли;
	Если Фрагменты[1] = "Общие" Тогда
		Фрагменты.Удалить(1);
	КонецЕсли;
	ПозицияФрагмента = Фрагменты.Найти("Табличные части");
	Если ПозицияФрагмента <> Неопределено Тогда
		Если Фрагменты.Количество() > ПозицияФрагмента + 2 Тогда
			Фрагменты.Вставить(ПозицияФрагмента + 2, "Реквизиты");
		КонецЕсли;
	КонецЕсли;
	ПозицияФрагмента = Фрагменты.Найти("Перерасчеты");
	Если ПозицияФрагмента <> Неопределено Тогда
		Если Фрагменты.Количество() > ПозицияФрагмента + 2 Тогда
			Фрагменты.Вставить(ПозицияФрагмента + 2, "Измерения");
		КонецЕсли;
	КонецЕсли;
	Для Счетчик = 1 По Цел(Фрагменты.Количество() / 2) Цикл
		ИндексФрагмента = 2*(Счетчик - 1) + 1;
		ИмяМножественное = ИдентификаторИзПредставленияЛкс(Фрагменты[ИндексФрагмента],,, "");
		ЕдинственноеИмя = МодулиИР.ирОбщий.ЕдинственноеИмяМДЛкс(ИмяМножественное);
		Если ЕдинственноеИмя = Неопределено Тогда
			ПоказатьВсплывающееУведомление("Неизвестный тип метаданных """ + ИмяМножественное + """");
			Возврат "";
		КонецЕсли;
		Фрагменты[ИндексФрагмента] = ЕдинственноеИмя;
	КонецЦикла;
	ИмяКонфигурации = Фрагменты[0];
	Фрагменты.Удалить(0); // Имя конфигурации/расширения
	СсылкаВосстановления = СтрСоединить(Фрагменты, ".");
	Пока ТолькоВерхнийУровень И Фрагменты.Количество() > 2 Цикл
		Фрагменты.Удалить(Фрагменты.ВГраница());
	КонецЦикла;
	Ссылка = СтрСоединить(Фрагменты, ".");
	ИмяОсновнойКонфигурации = ИмяОсновнойКонфигурации(ПодключениеИР);
	Если ИмяОсновнойКонфигурации <> ИмяКонфигурации Тогда
		выхИмяРасширения = ИмяКонфигурации;
		СсылкаВосстановления = ИмяКонфигурации + " " + СсылкаВосстановления;
		Ссылка = ИмяКонфигурации + " " + Ссылка;
	КонецЕсли;
	ТурбоКонф.Перейти(СсылкаВосстановления);
	Возврат Ссылка;
КонецФункции

//.
// Возвращаемое значение:
//   Булево - успешность открытия меню 
Функция ОткрытьКонтекстноеМенюДереваМетаданных() Экспорт
	Если ТипТекущегоЭлементаИнтерфейса() <> ПеречТипЭлемента.ЭлементСписка Тогда
		Возврат Ложь;
	КонецЕсли;
	ОткрытьКонтекстноеМеню();
	Попытка
		ТипАктивногоЭлемента = ТурбоКонф.ПолучитьТипАктивногоЭлемента();
	Исключение
		// < 6.3.9145.3319
		ТипАктивногоЭлемента = Неопределено;
	КонецПопытки;
	Сообщить("ТипАктивногоЭлемента=" + ТипАктивногоЭлемента);
	ЛиОткрылосьКонтекстноеМенюДереваМетаданных = Ложь
		Или ТипАктивногоЭлемента = ПеречТипЭлемента.ЭлементМеню // Не работает
		Или ТурбоКонф.НайтиЭлементПоИмени("Свойства", "элемент меню")
		Или ТурбоКонф.НайтиЭлементПоИмени("Добавить", "элемент меню")
		//Или ТурбоКонф.НайтиЭлементПоИмени("Вывести список...", "элемент меню")
		//Или ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.ЭлементМеню // турбоконф не видит активность контекстного меню
		;
	Возврат ЛиОткрылосьКонтекстноеМенюДереваМетаданных;
КонецФункции

Функция ИдентификаторТекущегоЭлементаОкна() Экспорт
	Результат = ТурбоКонф.ПолучитьRuntimeIdСтрокой();
	//Сообщить("ИД элемента = " + Результат); // Иногда Турбоконф начинает возвращать одинаковые значения в любых местах
	Возврат Результат;
КонецФункции

// Связанный метод - АктивироватьСтрокуДерева
Функция ПутьВДеревеТабличногоПоля(_ПодключениеИР = Неопределено, Знач РазрешитьВТаблице = Ложь) Экспорт
	Фрагменты = Новый Массив;
	КонтекстИнтерфейса = КонтекстИнтерфейса();
	Если Истина
		И КонтекстИнтерфейса.ЛиТаблица
		И (Ложь
			Или Не КонтекстИнтерфейса.Иерархический
			Или ПустаяСтрока(КонтекстИнтерфейса.ИмяКлючевойКолонки))
		//И Не (Истина
		//	И ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Неизвестный // ячейка табличного документа, дерево с колонками (структура элементов или реквизитов упр. формы)
		//	И ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента() = "сетка данных")
	Тогда
		Возврат Фрагменты;
	КонецЕсли;
	Если Истина
		И КонтекстИнтерфейса.ЛиТаблица 
		И Не СтрЗаканчиваетсяНа(ТурбоКонф.ПолучитьИмяЭлемента(), " " + КонтекстИнтерфейса.ИмяКлючевойКолонки)
	Тогда
		ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(3);
		Если Ложь
			Или ЯчейкиТекущейСтроки = Неопределено 
			Или Не КликнутьПоЭлементу(ЯчейкиТекущейСтроки[КонтекстИнтерфейса.ИндексКлючевойКолонки], ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента()) 
		Тогда
			Возврат Фрагменты;
		КонецЕсли;
	КонецЕсли;
	ШаблонЗамены = "\<[^\>]*\>";
	//МодулиИР = МодулиИР(ПодключениеИР);
	ИмяТекЭлемента = Неопределено;
	Пока ИмяТекЭлемента <> ТурбоКонф.ПолучитьИмяЭлемента() Цикл
		ИмяЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
		Если Не ЗначениеЗаполнено(ИмяЭлемента) Тогда
			Прервать;
		КонецЕсли;
		//ИмяЭлемента = МодулиИР.ирОбщий.ЗаменитьРегВыражениеЛкс(ИмяЭлемента, ШаблонЗамены, "", Ложь);
		ИмяЭлемента = ЗаменитьРегВыражение(ИмяЭлемента, ШаблонЗамены, "");
		Фрагменты.Вставить(0, ИмяЭлемента);
		ТурбоКонф.КонтролКлавиша(Клавиши.Up);
		ИмяТекЭлемента = ИмяЭлемента;
	КонецЦикла;
	Возврат Фрагменты;
КонецФункции    

Функция ЗаменитьРегВыражение(ГдеЗаменять, ЧтоЗаменять, ЧемЗаменять)
	РегулярноеВыражение = РегВыражение(ЧтоЗаменять);
	Возврат РегулярноеВыражение.Заменить(ГдеЗаменять, ЧемЗаменять);
КонецФункции

// https://oscript.io/syntax/Regex#%D0%BC%D0%B5%D1%82%D0%BE%D0%B4%D1%8B
Функция РегВыражение(Шаблон) Экспорт
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(Шаблон);
	РегулярноеВыражение = Новый ("РегулярноеВыражение", ПараметрыКонструктора);
	Возврат РегулярноеВыражение;
КонецФункции

//.
// Параметры:
//   ЧислоКолонок - Число - 
// Возвращаемое значение:
//   Массив из Строка, Неопределено - 6.3.9130.13871
Функция ЯчейкиТекущейСтроки(Знач ЧислоКолонок) Экспорт
	ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка(Истина);
	Если ВидимыеЭлементы = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаИзВидимыхЭлементов(ВидимыеЭлементы, ЧислоКолонок);
	Возврат ЯчейкиТекущейСтроки;
КонецФункции 

//.
// Параметры:
//   Путь - Строка, Массив из Строка - путь полученный функцией ПутьВДеревеТабличногоПоля
Функция АктивироватьСтрокуДерева(Знач Путь) Экспорт
	Если Не ЛиАктивноГлавноеОкно() Тогда
		КонтекстИнтерфейса = КонтекстИнтерфейса();
		Если Не КонтекстИнтерфейса.ПоддерживаетПоиск Тогда
			ПоказатьВсплывающееУведомление("Список не поддерживает поиск");
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.M);
			Если ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Поле Тогда
				УстановитьЗначениеПолюВвода(ПоследнийФрагментЛкс(Путь), Ложь);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Путь) = Тип("Строка") Тогда
		Путь = СтрРазделитьЛкс(Путь);
	КонецЕсли;
	ИмяТипаЭлемента = ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента();
	Счетчик = 1;
	Для Каждого Фрагмент Из Путь Цикл
		Если Не КликнутьПоЭлементу(Фрагмент, ИмяТипаЭлемента) Тогда
			НайтиСтрокуВОкне(Фрагмент, Ложь);
			Если Найти(ТурбоКонф.ПолучитьИмяЭлемента(), Фрагмент) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Если Счетчик <> Путь.Количество() Тогда
			ТурбоКонф.Клавиша(Клавиши.Add);
		КонецЕсли;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура СвернутьДругиеСтроки(Знач ПутьСтарый = Неопределено)
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПутьТекущий = ПутьВДеревеТабличногоПоля(ПодключениеИР);
	Если Не ЗначениеЗаполнено(ПутьТекущий) Тогда
		ПродолжитьОбработкуНажатияКлавиш();
		Возврат;
	КонецЕсли;
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.Subtract);
	Если ПутьСтарый <> Неопределено Тогда
	    АктивироватьСтрокуДерева(ПутьСтарый);
	КонецЕсли;
    АктивироватьСтрокуДерева(ПутьТекущий);
	//ТурбоКонф.ОтжатьМодификаторы();
КонецПроцедуры

// .
// Параметры:
//   ИменаЗначений - Строка - имена значений через ", ", например "Стул, Стол"
// Возвращаемое значение:
//   ФиксированнаяСтруктура - Ключ=Значение
Функция НовоеПеречислениеЛкс(Знач ИменаЗначений) Экспорт
	Параметры = СтрРазделить(ИменаЗначений, ", " + Символы.ПС, Ложь);
	Параметры.Вставить(0, ИменаЗначений);
	Результат = Новый ("ФиксированнаяСтруктура", Параметры); 
	//! Результат = Новый Структура(ИменаЗначений);
	Возврат Результат;
КонецФункции

// Обычно 8мс, но может быть 20мс при открытом окне "Служебные сообщения"
// Возвращаемое значение:
//   Строка - 
Функция ТипТекущегоЭлементаИнтерфейса()
	Если ТурбоКонф.ПолучитьВерсиюТурбоКонф() >= "6.4.9308.29774" Тогда
		КодТипа = ТурбоКонф.ПолучитьИдентификаторТипаТекущегоЭлемента();
	Иначе
		//ТипЭлементаИнтерфейса = ТурбоКонф.ТипТекущегоЭлементаИнтерфейса(); // Вероятно ошибка OScript https://turboconf.ru/Tasks/8430, https://turboconf.ru/Tasks/10190
		ТипЭлементаИнтерфейса = ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента(); 
		//Сообщить("==ПолучитьТипТекущегоЭлемента=" + ТипЭлементаИнтерфейса);
	КонецЕсли;
	Если Ложь
		Или ТипЭлементаИнтерфейса = "документ" 
		Или ТипЭлементаИнтерфейса = "document" 
		Или КодТипа = 50030
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Документ;
	ИначеЕсли Ложь
		// Не проверено
		Или ТипЭлементаИнтерфейса = "сетка данных" 
		Или ТипЭлементаИнтерфейса = "data grid" 
		Или КодТипа = 50028
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.СеткаДанных;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "кнопка" 
		Или ТипЭлементаИнтерфейса = "button" 
		Или КодТипа = 50000
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Кнопка;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "меню" 
		Или ТипЭлементаИнтерфейса = "menu" 
		Или КодТипа = 50009
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Меню;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "элемент меню" 
		Или ТипЭлементаИнтерфейса = "menu item" // не проверено
		Или КодТипа = 50011
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.ЭлементМеню;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "панель" 
		Или ТипЭлементаИнтерфейса = "panel" 
		Или КодТипа = 50033
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Панель;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "вкладка" 
		Или ТипЭлементаИнтерфейса = "tab" // не проверено 
		Или КодТипа = 50018
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Вкладка;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "поле" 
		Или ТипЭлементаИнтерфейса = "edit" 
		Или КодТипа = 50004
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Поле;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "поле со списком" 
		Или ТипЭлементаИнтерфейса = "combo box" // не проверено
		Или КодТипа = 50003
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.ПолеСоСписком;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "список" 
		Или ТипЭлементаИнтерфейса = "list"
		Или КодТипа = 50008
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Список;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "элемент списка" 
		Или ТипЭлементаИнтерфейса = "list item" // не проверено
		Или КодТипа = 50007
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.ЭлементСписка;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "таблицу" 
		Или КодТипа = 50036
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Таблица;
	ИначеЕсли Ложь
		Или ТипЭлементаИнтерфейса = "флажок" 
		Или ТипЭлементаИнтерфейса = "check box" // не проверено
		Или КодТипа = 50002
	Тогда
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Флажок;
	//ИначеЕсли ТипЭлементаИнтерфейса = "неизвестный" Тогда
	//	ТипЭлементаИнтерфейса = ПеречТипЭлемента.Неизвестный;
	Иначе
		// КодТипа = 50025
		// Например, ячейка таблицы
		ТипЭлементаИнтерфейса = ПеречТипЭлемента.Неизвестный;
	КонецЕсли;
	//Сообщить("==ТипЭлементаИнтерфейса=" + ТипЭлементаИнтерфейса);
	Возврат ТипЭлементаИнтерфейса;
КонецФункции

Функция ЭтоДокумент(Знач ТипПоля = "") 
	Если Не ЗначениеЗаполнено(ТипПоля) Тогда
		ТипПоля = ТипТекущегоЭлементаИнтерфейса();
	КонецЕсли;
	Возврат ТипПоля = ПеречТипЭлемента.Документ;
КонецФункции

Функция ЭтоПоле(Знач ТипПоля = "")
	Если Не ЗначениеЗаполнено(ТипПоля) Тогда
		ТипПоля = ТипТекущегоЭлементаИнтерфейса();
	КонецЕсли;
	Возврат ТипПоля = ПеречТипЭлемента.Поле;
КонецФункции

Функция ЭтоПолеСоСписком(Знач ТипПоля = "")
	Если Не ЗначениеЗаполнено(ТипПоля) Тогда
		ТипПоля = ТипТекущегоЭлементаИнтерфейса();
	КонецЕсли;
	Возврат ТипПоля = ПеречТипЭлемента.ПолеСоСписком;
КонецФункции

//&ТолькоТекстовыеДокументы
Процедура НайтиИспользование()
	ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Истина;
	ОткрытьКонтекстноеМеню();
	ШтатнаяКомандаДоступна = ТурбоКонф.ПолучитьДоступностьЭлемента("Найти использование", "элемент меню");
	ЗакрытьДочернееОкноКонфигуратора();
	Если ШтатнаяКомандаДоступна Тогда
		Возврат;
	КонецЕсли;
	Если ПерейтиКОпределению() Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.Right);
	КонецЕсли;
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура ПереключитьЗакладку()
	ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Истина;
	ТурбоКонф.СохранитьЗначениеСеанса("ПринудительноЗапомнитьМетод", Истина);
КонецПроцедуры

//&-ВосстанавливатьБуферОбмена
//&ЗапроситьИнформациюОДокументе
Функция ПерейтиКОпределению(Знач РазрешитьСсылкуИзТекущейПозиции = Истина)
	ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
	СтароеЗначениеБуфераОбмена = ТурбоКонф.ПолучитьБуферОбмена();
	ЭтоДокумент = ЭтоДокумент(ТипЭлементаИнтерфейса);
	Если РазрешитьСсылкуИзТекущейПозиции Тогда
		Если Не ЭтоДокумент Тогда
			ТекстМодуля = ВыделенныйТекст(Ложь);
		КонецЕсли;
		Если ЭтоДокумент Тогда
			РазобратьПозициюВТексте(Ложь); // Долго
		КонецЕсли;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		ТурбоКонф.ОтжатьМодификаторыПослеЗавершенияСкрипта = Истина;
		Возврат Ложь;
	КонецЕсли; 
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЭтоВызовИзПриложенияИР = Ложь;
	ИмяФайлаБуфера = ВосстановитьЗначениеСеансаКонфигуратора("ИмяФайлаБуфера");
	ФайлБуфера = Новый Файл(ИмяФайлаБуфера);
	Если ФайлБуфера.Существует() Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяФайлаБуфера);
		ЗначениеИзБуфера = СокрЛП(ТекстовыйДокумент.ПолучитьТекст());
		УдалитьФайлы(ИмяФайлаБуфера);
		ЭтоВызовИзПриложенияИР = Истина;
		РазрешитьСсылкуИзТекущейПозиции = Ложь;
		СохранитьЗначениеСеансаКонфигуратора("БлокировкаПриложенияИР", Ложь);
	Иначе 
		ЗначениеИзБуфера = СтароеЗначениеБуфераОбмена;
		Если Не ЗначениеЗаполнено(ТекстМодуля) Тогда
			ТекстМодуля = ЗначениеИзБуфера;
		КонецЕсли;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	Сообщить("Ссылка из буфера = " + ЗначениеИзБуфера);
	//Если ТипЭлементаИнтерфейса = ПеречТипЭлемента.Кнопка Тогда 
		// Работает лишь иногда. Ошибка платформы https://turboconf.ru/Tasks/10147
		ТекстКнопки = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " Колонка1");
		Если Ложь
			Или ТекстКнопки = "Записать" 
			Или ТекстКнопки = "Записать и закрыть" 
			Или ТекстКнопки = "Провести" 
			Или ТекстКнопки = "Провести и закрыть" 
			Или ТекстКнопки = "Отменить проведение" 
		Тогда
			ПерейтиПоСсылкеМД(МодулиИР.ирОбщий.СсылкаСтрокиМодуляЛкс(МодулиИР.ирКэш.Получить().ИмяМодуляПсевдокодаПлатформы(),, "ФормаОбъекта_Записать"));
			Возврат Истина;
		ИначеЕсли ТекстКнопки = "Удалить" Тогда
			ПерейтиПоСсылкеМД(МодулиИР.ирОбщий.СсылкаСтрокиМодуляЛкс(МодулиИР.ирКэш.Получить().ИмяМодуляПсевдокодаПлатформы(),, "Объект_Удалить"));
			Возврат Истина;
		КонецЕсли;
	//КонецЕсли;
	Значение = Неопределено; 
	СтруктураСсылки = Неопределено; 
	ПолеТекстаПрограммы = Неопределено;
	ИмяРасширения = "";
	Если ЗначениеЗаполнено(НомерСтрокиТекста) Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина,,,, ИмяРасширения,,,, Ложь);
		Если ПолеТекстаПрограммы = Неопределено Тогда
			// Берем текущую строку окна сообщений
			ТурбоКонф.Клавиша(Клавиши.Home);
			ТурбоКонф.ШифтКлавиша(Клавиши.End);
			//Значение = ВыделенныйТекст(); // Ненадежно
			ТурбоКонф.ПолучитьТекстМодуля(ВыделенныйТекст, 0); // Читаем выделенный текст
			Если МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(ВыделенныйТекст, "^\{\(\d+, \d+\)\}: ").Количество() > 0 Тогда
				ШаблонСсылкиНаСтрокуЗапроса = "(\{[^\}]+\}):[^\n]+\n(?:\{[^\}]+\}:[^\n]+\n)*по причине:\n(" + МодулиИР.ирОбщий.ТекстДляРегВыраженияЛкс(ВыделенныйТекст) + "\n[^\n]+)";
				СсылкаСтрокиЗапроса = МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(ТекстМодуля, ШаблонСсылкиНаСтрокуЗапроса);
				Если СсылкаСтрокиЗапроса.Количество() Тогда
					ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
					СсылкаСтрокиВыполненияЗапроса = СсылкаСтрокиЗапроса.Получить(0).Группа0;
					КоординатыВТекстеЗапроса = СсылкаСтрокиЗапроса.Получить(0).Группа1;
					Значение = ПолеТекстаПрограммы.СсылкаСтрокиМодуляИзОшибкиВТекущемЗапросе(СсылкаСтрокиВыполненияЗапроса, КоординатыВТекстеЗапроса);
					Если ПустаяСтрока(Значение) Тогда
						// Текст модуля в кэше устарел
						ПерейтиПоСсылкеМД(СсылкаСтрокиВыполненияЗапроса); 
						Значение = ПолеТекстаПрограммы.СсылкаСтрокиМодуляИзОшибкиВТекущемЗапросе(СсылкаСтрокиВыполненияЗапроса, КоординатыВТекстеЗапроса);
					КонецЕсли;
					РазрешитьСсылкуИзТекущейПозиции = Ложь;
				КонецЕсли;
			Иначе
				Вхождения = НайтиОбъектыМДВТекстеОкнаСообщений(МодулиИР, ВыделенныйТекст);
				Если Вхождения.Количество() > 0 Тогда
					Значение = Вхождения.Получить(0).Группа0;
					РазрешитьСсылкуИзТекущейПозиции = Ложь;
				КонецЕсли;
			КонецЕсли;
			ТекстМодуля = ВыделенныйТекст;
		Иначе
			ПолеТекстаПрограммы.ЗапомнитьИсточникПерехода();
			Если РазрешитьСсылкуИзТекущейПозиции Тогда 
				Значение = ПолеТекстаПрограммы.ПерейтиКОпределению(,, Ложь);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли РазрешитьСсылкуИзТекущейПозиции Тогда
		ИмяОсновнойКонфигурации = ИмяОсновнойКонфигурации(ПодключениеИР);
		КлючКэшаИмениКонфигурации = КлючКэшаИмениКонфигурацииДляПоля(2);
		ИмяРасширения = ВосстановитьЗначениеСеансаКонфигуратора(КлючКэшаИмениКонфигурации);
		Если ПустаяСтрока(ИмяРасширения) Тогда
			СсылкаМД = СсылкаНаОбъектМДВДеревеКонфигурации(ПодключениеИР, Истина, ИмяРасширения);
			Если ЗначениеЗаполнено(ИмяРасширения) Тогда
				ТекстМодуля = Сред(СсылкаМД, СтрДлина(ИмяРасширения) + 2);
			ИначеЕсли ЗначениеЗаполнено(СсылкаМД) Тогда
				ИмяРасширения = ИмяОсновнойКонфигурации;
			КонецЕсли;
			СохранитьЗначениеСеансаКонфигуратора(КлючКэшаИмениКонфигурации, ИмяРасширения);
		КонецЕсли;
		Сообщить("ИмяКонфигурации = " + ИмяРасширения);
		Если ИмяРасширения = ИмяОсновнойКонфигурации Тогда
			// Копируем значение свойства "Тип" из палитры свойств
			ТурбоКонф.АльтКлавиша(Клавиши.Enter);
			//ТурбоКонф.Клавиша(Клавиши.Tab);
			//ТурбоКонф.Клавиша(Клавиши.Tab);
			//ТурбоКонф.Клавиша(Клавиши.Tab);
			АктивироватьСвойствоВПалитреСвойств("Тип");
			ТекстМодуля = ВыделенныйТекст(Ложь);
			АктивироватьДеревоОсновнойКонфигурации();
		КонецЕсли;
		ИмяРасширения = "";
	КонецЕсли;
	//Сообщить("Фаза1 " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - моментНачала) + "мс");
	Если Значение = Неопределено Тогда
		СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(ЗначениеИзБуфера);
		Если Истина
			И СтруктураСсылки <> Неопределено 
			И Не РазрешитьСсылкуИзТекущейПозиции 
			И СтрЧислоСтрок(ЗначениеИзБуфера) > 1
			И Лев(ЗначениеИзБуфера, 1) <> "1" //
			И Не ЭтоВызовИзПриложенияИР // Иначе окно приложения ИР будет скрываться
		Тогда
			СтрокаСтека = Неопределено;
			ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
			ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
			БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
			Попытка
				ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Стек", 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
				СтрокаСтека = МодулиИР.ирКлиент.ОткрытьВыборСтрокиСтекаЛкс(ЗначениеИзБуфера);
			Исключение
				ПоказатьВсплывающееУведомление(ОписаниеОшибки());
			КонецПопытки;
			ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
			Если СтрокаСтека = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			ЗначениеИзБуфера = СтрокаСтека.Ссылка;
			СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(ЗначениеИзБуфера);
		КонецЕсли;
	КонецЕсли;
	Если Истина
		И ПолеТекстаПрограммы = Неопределено 
		И (Ложь
			Или РазрешитьСсылкуИзТекущейПозиции 
			Или ТекстМодуля = ЗначениеИзБуфера)
	Тогда 
		Если Лев(ТекстМодуля, 1) = "(" Тогда
			// В реквизитах управляемой формы иногда текст обрамлен скобками
			ТекстМодуля = СтрЗаменить(ТекстМодуля, "(", "");
			ТекстМодуля = СтрЗаменить(ТекстМодуля, ")", "");
		КонецЕсли;
		Значение = ТекстМодуля;
		Значение = МодулиИР.ирОбщий.ИменаМетаданныхИзОписанияТиповЛкс(Значение);
		Если Значение.Количество() = 0 Тогда
			// Текст параметризуемой команды
			Фрагменты = СтрРазделить(ТекстМодуля, " ", Ложь);
			Если Фрагменты.Количество() < 20 Тогда
				Для каждого Фрагмент Из Фрагменты Цикл
					ОбъектМД = ПодключениеИР.Метаданные.НайтиПоПолномуИмени(Фрагмент);
					Если ОбъектМД <> Неопределено Тогда
						Значение.Добавить(МодулиИР.ирОбщий.ПолноеИмяМДСРасширениемЛкс(ОбъектМД));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Иначе
			Значение.СортироватьПоЗначению();
			Значение.СортироватьПоПредставлению();
		КонецЕсли;
		Если Значение.Количество() = 0 И ЗначениеЗаполнено(ТекстМодуля) Тогда
			Значение = Неопределено;
			СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(ТекстМодуля);
			Если СтруктураСсылки <> Неопределено Тогда 
				ТекстМодуля = СтруктураСсылки.ТекстСсылки;
				Значение = ТекстМодуля;
			КонецЕсли; 
			Если Значение = Неопределено Тогда
				Вхождения = МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(ТекстМодуля, "^([_ЁА-ЯA-Z0-9]+)\s\(([^\(\)]+)\)$"); // шБукваЦифра
				Если Вхождения.Количество() Тогда
					Группы = Вхождения.Получить(0).Группы;
					ПространствоИмен = Группы.Получить(1);
					Пакет = МодулиИР.ирОбщий.НайтиЭлементКоллекцииЛкс(ПодключениеИР.Метаданные.ПакетыXDTO, "ПространствоИмен", ПространствоИмен);
					Если Пакет <> Неопределено Тогда
						Значение = "ПакетXDTO." + Пакет.Имя + "." + Группы.Получить(0);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если Значение = Неопределено Тогда
				Значение = ТекстМодуля;
				Если Не ЗначениеЗаполнено(НомерСтрокиТекста) Тогда 
					// Отделять пробелом нужно для ячеек табличных документов. В их имя в конце добавляется адрес через пробел, например "<ТекстЯчейки> A3" 
					ТекстМодуля = СтрРазделить(ТекстМодуля, " ")[0];
				КонецЕсли;
				ТекстМодуля = "//" + ТекстМодуля; 
				ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, СтрДлина(ТекстМодуля), ВыделенныйТекст,,, Ложь);
				Если ПолеТекстаПрограммы <> Неопределено Тогда
					ПолеТекстаПрограммы.КончитьОбработкуКоманды();
					Значение = ПолеТекстаПрограммы.ПерейтиКОпределению(,, Ложь);
				КонецЕсли;
				Если Значение = Неопределено Тогда
					Значение = ТекстМодуля;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ПродолжатьОбработку = Истина;
	Представление = "";
	Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
		//! Значение = 0 // СписокЗначений
		Если Значение.Количество() = 0 Тогда
			Значение = Неопределено;
		Иначе
			Если Значение.Количество() = 1 Тогда
				НоваяЦельПерехода = Значение.Получить(0);
			Иначе
				НоваяЦельПерехода = Неопределено;
				ЗаголовокФормыВыбора = "Выберите переход";
				ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
				БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
				Попытка
					ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(ЗаголовокФормыВыбора, 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
					НоваяЦельПерехода = МодулиИР.ирКлиент.ВыбратьЭлементСпискаЗначенийЛкс(Значение,, Истина, ЗаголовокФормыВыбора, Ложь, Истина);
				Исключение
					ПоказатьВсплывающееУведомление(ОписаниеОшибки());
				КонецПопытки;
				//ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР); // Так потом почему то начинает проскакивать F12 через мой макрос 21
				ЗавершитьВызовВнешнегоОкнаАсинх(0, ИдентификаторПроцессаИР, ПодключениеИР);
				// Не работает, т.к. фокус
				//Окно = ТурбоКонф.ЖдатьОкно("Объект перехода", 10, Ложь);
				//Если Окно > 0 Тогда
				//	ТурбоКонф.Клавиша(Клавиши.Escape);
				//КонецЕсли; 
				ТурбоКонф.АктивироватьОкно(БлокируемоеОкно);
			КонецЕсли;
			Если НоваяЦельПерехода = Неопределено Тогда
				ПродолжатьОбработку = Ложь;
			Иначе
				РезультатПереходаИР = Ложь;
				Если РезультатПереходаИР = Истина Тогда 
					Значение = Истина; 
				Иначе
					Значение = НоваяЦельПерехода.Значение;
					Представление = НоваяЦельПерехода.Представление;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Результат = Ложь;
	Если ПродолжатьОбработку Тогда
		// ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
		Сообщить("Ссылка из текущей позиции = " + Значение);
		ЗапомнитьМетод = Истина; 
		Результат = Истина;
		Если Значение = Истина Тогда
			// ИР совершил переход в своем поле модуля
			ПерейтиВПозицию(,, ПолеТекстаПрограммы);
			ВыполнитьКомандуИзСсылкиПослеПерехода(ПолеТекстаПрограммы, СтруктураСсылки);
		// ИначеЕсли Значение = "Справка" Тогда // Мертвая ветка
		// 	ВосстановитьОкноПриложения(ПодключениеИР); 
		// 	ПродолжатьОбработку = Ложь;
		ИначеЕсли Ложь
			Или СтрНачинаетсяС(Представление, "Модуль прямой") 
			Или СтрНачинаетсяС(Представление, "Метод прямой") 
			Или СтрНачинаетсяС(Представление, "Переменная прямой")
		Тогда   
			ТурбоКонф.Клавиша(Клавиши.F12);
			Если ЗначениеЗаполнено(ПолеТекстаПрограммы.мРодительскийКонтекст) Тогда
				Окно = ТурбоКонф.ЖдатьОкно("Объект перехода", 400, Ложь);
				Если Окно > 0 Тогда
					ТурбоКонф.Клавиша(Клавиши.Enter);
				КонецЕсли; 
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Представление, "Создать метод") Тогда
			ЗаголовокФормыВыбора = "Конструктор метода";
			ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
			БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
			Попытка
				ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(ЗаголовокФормыВыбора, 2000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
				РезультатСозданияМетода = ПолеТекстаПрограммы.ОткрытьКонструкторИзВызоваМетода();
			Исключение
				ПоказатьВсплывающееУведомление(ОписаниеОшибки());
			КонецПопытки;
			ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
			Если РезультатСозданияМетода <> Ложь Тогда
				ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы,,, Символы.ПС + Символы.ПС + Значение);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Представление, "Колонка БД") Тогда
			ВосстановитьОкноПриложения(ПодключениеИР);
			МодулиИР.ирКлиент.ОткрытьКолонкуБДЛкс(Значение);
		ИначеЕсли Ложь
			Или СтрНачинаетсяС(Представление, "Цвет") 
			Или СтрНачинаетсяС(Представление, "Шрифт")
		Тогда
			ВосстановитьОкноПриложения(ПодключениеИР);
			МодулиИР.ирКлиент.ОткрытьЦветИлиШрифтПоПолномуИмениЛкс(Значение);
		ИначеЕсли СтрНачинаетсяС(Представление, "Слово платформы") Тогда
			Если ПустаяСтрока(ПолеТекстаПрограммы.мРодительскийКонтекст) Тогда
				СинтаксПомощник();
			Иначе
				ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Слово определено в платформе. Открыть синтакс-помощник ИР?", 5000, ЭтотОбъект, "СинтаксПомощникИР");
			КонецЕсли;
			ПродолжатьОбработку = Ложь;
		ИначеЕсли СтрНачинаетсяС(Представление, "ГиперСсылка") Тогда
			ЗапуститьПриложение(Значение);
		ИначеЕсли Истина
			И ПустаяСтрока(НомерСтрокиТекста)
			И ПустаяСтрока(Представление)
			И Значение = "*"
			И ЛиАктивноГлавноеОкно() 
		Тогда
			// Чтобы открылась панель свойств текущего объекта метаданных из списка. Например в списке "Движения" окна объекта метаданных
			ТурбоКонф.АльтКлавиша(Клавиши.Enter);
			ТурбоКонф.Клавиша(Клавиши.Escape);
			//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			ТурбоКонф.АльтКлавиша(Клавиши.F9);
			//ЖдатьСменуТекущегоЭлемента(СтарыйИД);
			ЗакрытьДочернееОкноКонфигуратора();
		Иначе
			Результат = Ложь;
			Если Ложь
				Или Не ЗначениеЗаполнено(Значение)
				//Или (Истина 
				//	И МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(Значение) = Неопределено
				//	И Не ЭтоПолноеИмяМД(МодулиИР, Значение))  
			Тогда
				Значение = ЗначениеИзБуфера;
				Если Истина
					И МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(Значение) = Неопределено
					И Не ЭтоПолноеИмяМД(МодулиИР, Значение) 
				Тогда
					ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(),
						"Нет ссылки для перехода. В текущей позиции пусто. В буфере обмена не найдено. Открыть справку.", 5000,
						ЭтотОбъект, "ОткрытьСправкуКоманды", Новый Структура("Команда", "ПерейтиКОпределению"));
					ПродолжатьОбработку = Ложь;
				КонецЕсли;
			ИначеЕсли Значение = "*" Тогда
				ТекстСтроки = ПолеТекстаПрограммы.ПолеТекста.ПолучитьСтроку(ПолеТекстаПрограммы.мНачальнаяСтрока);
				СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(ТекстСтроки);
				Если СтруктураСсылки <> Неопределено Тогда
					Значение = СтруктураСсылки.ТекстСсылки;
				Иначе
					ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(),
						"Нет ссылки для перехода. В текущей позиции не найдено. Открыть справку.", 5000,
						ЭтотОбъект, "ОткрытьСправкуКоманды", Новый Структура("Команда", "ПерейтиКОпределению"));
					ПродолжатьОбработку = Ложь; 
				КонецЕсли;
			КонецЕсли;
			Если ПродолжатьОбработку Тогда
				Если ПерейтиПоСсылкеМД(Значение, ИмяРасширения, ЭтоВызовИзПриложенияИР Или Не РазрешитьСсылкуИзТекущейПозиции) Тогда
					ЗапомнитьМетод = Ложь;
					Результат = Истина;
				Иначе
					// Скорее всего бесполезно
					ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта);
					ТурбоКонф.Клавиша(Клавиши.F12);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ПродолжатьОбработку И ЗапомнитьМетод Тогда
			ТурбоКонф.СохранитьЗначениеСеанса("ПринудительноЗапомнитьМетод", Истина);
		КонецЕсли;
	КонецЕсли;
	// Почему то после этого перестает работать чтение из буфера обмена. Проверено на реквизитах управляемой формы. Похоже на баг Турбоконфа.
	// Например последующее фоновое чтение имени текущего метода для запоминания сталкивается с долгим ожиданием и ошибкой "Сбой запрошенной операции" при чтении текста модуля через буфер обмена
	//УстановитьБуферОбмена(СтароеЗначениеБуфераОбмена); 
	ТурбоКонф.ОтжатьМодификаторы(); // Иначе будет иногда залипать CTRL после перехода
	Возврат Результат;
КонецФункции   

// Добавляем текущий метод в историю
Процедура ЗапомнитьМетод(Знач СначалаЖдатьЕслиВФоне = Истина) Экспорт
	ПодключениеИР = ПодключениеИР(, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолучатьТипЭлемента = Ложь;
	Если СначалаЖдатьЕслиВФоне И ЛиВФоновомЗадании() Тогда
		ТурбоКонф.Ждать(200);
		ПолучатьТипЭлемента = Истина;
	КонецЕсли;
	Сообщить("Начат анализ имени текущего метода");
	моментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РазобратьПозициюВТексте(ПолучатьТипЭлемента);
	ИдентифицироватьДокумент = Истина; // - Иначе при переходе в другой модуль будет считать что модуль остался старый
	//Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() <> Конфигуратор.ПоследнийДокумент Тогда
	//	ТекущийДокумент = ТурбоКонф.ИдентифицироватьТекущийДокумент(); 
	//КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,,,,,,, ИдентифицироватьДокумент,,, Ложь);
	Если ПолеТекстаПрограммы <> Неопределено Тогда
		ТекстОбновления = ТурбоКонф.ВосстановитьЗначениеСеанса("ТекстОбновленияНапарника");
		//Если ТекстОбновления = Неопределено Тогда
		//	ТекстОбновления = ПолеТекстаПрограммы.ТелоЗапросаОбновленияНапарника();
		//КонецЕсли;
		Если ЗначениеЗаполнено(ТекстОбновления) Тогда
			МоментНачалаНапарника = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗапросНапарника = Новый HTTPЗапрос("/api/v1/context/update");
			Попытка
				Для Сч=1 По 2 Цикл
					ЧистыйОтвет = Неопределено; // Строка
					ТекстОтвета = ЗапроситьНапарника(ПолеТекстаПрограммы, ЗапросНапарника, ТекстОбновления, ЧистыйОтвет);
					Если ТекстОтвета <> "" Тогда
						ТекстОбновления = "";
						ЧистыйОтвет = ПолеТекстаПрограммы.ОбработатьОтветНапарника(ТекстОтвета, ТекстОбновления);
						Если ТекстОбновления = "" Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			Исключение
				Сообщить("Ошибка синхронизации метаданных Напарника: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
			КонецПопытки;
			ТурбоКонф.СохранитьЗначениеСеанса("ТекстОбновленияНапарника", );
			Сообщить("Синхронизация напарника " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаНапарника) + " мс");
		КонецЕсли;
	КонецЕсли;
	Сообщить("Запомнить метод " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - моментНачала) + " мс");
КонецПроцедуры   

Процедура АктивироватьДеревоОсновнойКонфигурации() Экспорт
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.C); // Активируем окно основной конфигурации
	АктивироватьПолеДереваКонфигурации();
КонецПроцедуры   

Процедура АктивироватьПолеДереваКонфигурации() Экспорт
	ТурбоКонф.Ждать(10); // На случай, если уже активно поле ввода в палитре свойств, чтобы раньше времени не решили что активно поле фильтра
	Для Сч=1 По 2 Цикл
		ТипТекущегоЭлемента = ТипТекущегоЭлементаИнтерфейса();
		Если Ложь
			Или ТипТекущегоЭлемента = ПеречТипЭлемента.Список // Если фильтрат пустой
			Или ТипТекущегоЭлемента = ПеречТипЭлемента.ЭлементСписка
		Тогда    
			Прервать;
		Иначе
			Если сч = 2 Тогда
				ВызватьИсключение "Не удалось активировать дерево конфигурации";
			КонецЕсли;
			ТурбоКонф.Клавиша(Клавиши.Tab);
			ТурбоКонф.Ждать(10); 
		КонецЕсли;
	КонецЦикла;
	//Сообщить("Куку=" + ТипТекущегоЭлемента);
КонецПроцедуры   

Процедура ОткрытьСправкуКоманды(Параметры) Экспорт
	Если Параметры.Команда = "ПерейтиКОпределению" Тогда
		ЗапуститьПриложение("https://fastcode.im/Templates/Shared/bc4da1a446444e249e02b6f9b5467296");
	КонецЕсли;
КонецПроцедуры

//.
// Параметры:
//   ОкноВозвратаФокуса - Число - если фокус не нужно устанавливать, то передать 0 или 1
//   ИдентификаторПроцесса -  - 
Процедура ЗавершитьВызовВнешнегоОкнаАсинх(Знач ОкноВозвратаФокуса = Неопределено, Знач ИдентификаторПроцесса = 0, Знач ПодключениеИР = Неопределено) Экспорт
	Если ОкноВозвратаФокуса = Неопределено Тогда
		ОкноВозвратаФокуса = Конфигуратор.ОкноВызоваСкрипта;
	КонецЕсли;
	Попытка
		ТурбоКонф.ЗавершитьВызовВнешнегоОкнаАсинх(ОкноВозвратаФокуса,, ИдентификаторПроцесса); // Вроде бы избыточная передача идентификатора
	Исключение
		// ниже 6.0.8819.34377
		ТурбоКонф.ЗавершитьВызовВнешнегоОкнаАсинх(ОкноВозвратаФокуса);
	КонецПопытки;
	Если ПодключениеИР <> Неопределено Тогда
		ОповеститьПользователяОВозобновлении();
		ПодключениеИР.Visible = Ложь;
	КонецЕсли;
КонецПроцедуры

// Ускоренный вариант Турбоконф.ПерейтиВПозицию для случая непервой колонки.
//   Пришлось делать, т.к. Турбоконф не мог сам сделать это простое улучшение. https://turboconf.ru/Tasks/9031
// Параметры:
//   НомерКолонкиТекста -  - 
//   НомерСтрокиТекста -  - 
//   ПолеТекстаПрограммы - -  если указано, то производится еще разворачивание блока
//   Строгое -  - 
//   ЗапомнитьСтаруюПозицию - Булево - пока отключен
Процедура ПерейтиВПозицию(Знач НомерКолонкиТекста = 0, Знач НомерСтрокиТекста = 0, Знач ПолеТекстаПрограммы = Неопределено, Знач Строгое = Ложь, Знач ЗапомнитьСтаруюПозицию = Истина)
	Если Не ЛиАктивноГлавноеОкно() Тогда
		// https://turboconf.ru/Tasks/9185
		Возврат;
	КонецЕсли;
	Если Ложь
		Или ТурбоКонф.ПолучитьВерсиюAPI() < 6 
		Или ТурбоКонф.РежимСовместимости() 
		Или НомерКолонкиТекста = 1
	Тогда
		ТурбоКонф.ПерейтиВПозицию(НомерКолонкиТекста, НомерСтрокиТекста);
	ИначеЕсли ПолеТекстаПрограммы <> Неопределено Тогда
		Если Не ЗапомнитьСтаруюПозицию Тогда
			// Технически старая позиция в любом случае запоминаетя конфигуратором в истории при переходе по номеру строки.
			// Но чтобы этом элемент истории не показывал другую позицию, мы сначала перейдем в нужную позицию скрытно и затем из нее перейдем открыто в нее же.
			// Но при этом не делается вертикальное центрирование строки.
			ПозицияКонцаТекста = СтрДлина(ПолеТекстаПрограммы.мОригинальныйТекст);
			ТурбоКонф.ВыделитьТекст(ПозицияКонцаТекста, ПозицияКонцаТекста);
			ВыделениеОдномерное = ПолеТекстаПрограммы.ПолеТекста.ВыделениеОдномерное();
			ВременнаяПозиция = ВыделениеОдномерное.Начало - 1;
			ТурбоКонф.ВыделитьТекст(ВременнаяПозиция, ВременнаяПозиция); // Почему то позиционируется текущую строку самой нижней в области просмотра
		КонецЕсли;
		Если Не Строгое Тогда
			ВыделениеДвумерное = ПолеТекстаПрограммы.ПолеТекста.ВыделениеДвумерное();
			ТурбоКонф.ПерейтиВПозицию(1, ВыделениеДвумерное.НачальнаяСтрока); // Нужно для запоминания позиции в истории переходов конфигуратора и для центрирования по высоте
		КонецЕсли;
		ВыделениеОдномерное = ПолеТекстаПрограммы.ПолеТекста.ВыделениеОдномерное();
		РазвернутьБлокМодуля(ВыделениеОдномерное.Начало - 1, ВыделениеОдномерное.Конец - 1,, Строгое);
	Иначе 
		Позиция = 0; 
		ТекстДокумента = ТурбоКонф.ПолучитьТекстДокумента(0, 0, Позиция, Позиция);
		Если ЗначениеЗаполнено(ТекстДокумента) Тогда
			ТурбоКонф.ПерейтиВПозицию(1, НомерСтрокиТекста);
			Позиция = Позиция + НомерКолонкиТекста - 1;
			ТурбоКонф.ВыделитьТекст(Позиция, Позиция); // Почему то делает текущую строку самой нижней в области просмотра
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура ПерейтиВНачалоРодителяВМодуле()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте,,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолеТекстаПрограммы.ПерейтиВНачалоРодителя() Тогда 
		Возврат;
	КонецЕсли;
	ПерейтиВПозицию(,, ПолеТекстаПрограммы);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура ПерейтиКГраницеКонструкцииНазад()
	ПерейтиКГраницеКонструкции();
КонецПроцедуры     

//&ТолькоТекстовыеДокументы
Процедура ПерейтиКГраницеКонструкцииВперед()
	ПерейтиКГраницеКонструкции();
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура ПерейтиКГраницеКонструкции()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Попытка
		ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Истина;
	Исключение
		ПоказатьВсплывающееУведомление("Рекомендуется отключить команды ""Перейти к границе конструкции"", т.к. в Турбоконф 6.1- они блокируют штатные команды конфигуратора", 5000);
	КонецПопытки;
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте,,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолеТекстаПрограммы.ПерейтиКГраницеКонструкции() Тогда 
		Возврат;
	КонецЕсли;
	ПродолжитьОбработкуНажатияКлавиш(Ложь);
	ПерейтиВПозицию(,, ПолеТекстаПрограммы, Истина);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура ВернутьсяИзПереходаИР()
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля,,,, Истина);
	Если Не ПолеТекстаПрограммы.ВернутьсяИзПерехода() Тогда 
		Возврат;
	КонецЕсли;
	ПерейтиВПозицию(,, ПолеТекстаПрограммы);
	//ВернутьсяВПредыдущееМестоКонфигуратора();
КонецПроцедуры

Функция ЭтоПолноеИмяМД(Знач МодулиИР, Значение, ИмяРасширения = "")
	Если Лев(Значение, 1) = "{" Тогда
		Возврат Ложь;
	КонецЕсли;
	Фрагменты = СтрРазделить(Значение, " ");
	Если Фрагменты.Количество() = 2 Тогда
		ПоследнийФрагмент = Фрагменты[1]; // Убираем имя расширения
	Иначе
		ПоследнийФрагмент = Значение;
	КонецЕсли;
	Результат = МодулиИР.ирОбщий.ЛиКорневойТипМетаданныхЛкс(СтрРазделить(ПоследнийФрагмент, ".")[0]);
	Если Результат И Фрагменты.Количество() = 2 Тогда
		ИмяРасширения = Фрагменты[0];
		Значение = Фрагменты[1]; // Убираем имя расширения
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЭтоСсылкаСтрокиМодуля(Значение)
	Возврат Лев(Значение, 1) = "{"; 
КонецФункции

// Переходит по сссылке на объект метаданных или строку модуля
Функция ПерейтиПоСсылкеМД(Знач СсылкаСтроки = "", Знач ИмяРасширения = "", Знач ЗапретитьКонтекстПоискаСсылок = Истина, Знач ТолькоОткрытьПанельСвойств = Ложь)
	// СтароеЗначениеБуфераОбмена = ТурбоКонф.ПолучитьБуферОбмена();
	НачатьСлежениеЗаТекущимМетодом();
	ПодключениеИР = ПодключениеИР(,, Ложь);
	МодулиИР = МодулиИР(ПодключениеИР);
	Если Не ЛиАктивноГлавноеОкно() Тогда // Не срабатывает при активации из Приложения ИР, т.к. оно всегда главное окно напрямую пытается актировать
		ЗакрытьМодальноеОкно();
	КонецЕсли;
	
	// Пробуем перейти в рамках текущего модуля
	ПереходПоСсылкеВыполнен = Ложь;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля,,,,,,,,,,, СсылкаСтроки, ПереходПоСсылкеВыполнен);
	Если ПереходПоСсылкеВыполнен Тогда
		ПерейтиВПозицию(,, ПолеТекстаПрограммы);
		СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(СсылкаСтроки);
		ВыполнитьКомандуИзСсылкиПослеПерехода(ПолеТекстаПрограммы, СтруктураСсылки);
		Возврат Истина;
	КонецЕсли;
	
	// Если Не ЗначениеЗаполнено(СсылкаСтроки) Тогда
	// 	СсылкаСтроки = СтароеЗначениеБуфераОбмена;
	// КонецЕсли;
	Если ЭтоПолноеИмяМД(МодулиИР, СсылкаСтроки, ИмяРасширения) Тогда
		Если Не ЗапретитьКонтекстПоискаСсылок И ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Документ Тогда
			Текст = ТурбоКонф.ПолучитьТекстМодуля("", ПозицияВТексте);
			Вхождения = НайтиОбъектыМДВТекстеОкнаСообщений(МодулиИР, Лев(Текст, ПозицияВТексте));
			Если Вхождения.Количество() > 0 Тогда
				// В окне сообщений в результате поиска ссылок на объект
				ПоследнееВхождение = Вхождения.Получить(Вхождения.Количество() - 1);
				Если ПоследнееВхождение.Группа1 <> Неопределено Тогда // только ссылки НА 
					БазовыйОбъект = ПоследнееВхождение.Группа0;
					Сообщить("БазовыйОбъект=" + БазовыйОбъект); 
					Если Истина
						И СтрЗаканчиваетсяНа(СсылкаСтроки, ".Состав")
						И (Ложь
							//Или СтрНачинаетсяС(СсылкаСтроки, "ФункциональнаяОпция.") // Закомментировал, т.к. ссылки в дочерних объектах некорректно обрабатывает
							Или СтрНачинаетсяС(СсылкаСтроки, "Подсистема.")
							Или СтрНачинаетсяС(СсылкаСтроки, "ПланОбмена."))
					Тогда
						Если ПерейтиПоСсылкеМД(БазовыйОбъект) Тогда
							ТурбоКонф.Клавиша(Клавиши.Enter);
							ТурбоКонф.Ждать(50);
							Если СтрНачинаетсяС(СсылкаСтроки, "Подсистема.") Тогда
								НажатьКлавишуЦикл(Клавиши.PageUp, 20,, Истина);
								НажатьКлавишуЦикл(Клавиши.PageDown, 1,, Истина);
								//КликнутьПоЭлементу("Основные", "вкладка");
								//КликнутьПоЭлементу("Подсистемы", "элемент вкладки"); // Не находит 
							ИначеЕсли СтрНачинаетсяС(СсылкаСтроки, "ФункциональнаяОпция.") Тогда
								НажатьКлавишуЦикл(Клавиши.PageUp, 20,, Истина);
								НажатьКлавишуЦикл(Клавиши.PageDown, 2,, Истина);
								//КликнутьПоЭлементу("Основные", "вкладка");
								//КликнутьПоЭлементу("Функциональные опции", "элемент вкладки"); // Не находит 
							ИначеЕсли СтрНачинаетсяС(СсылкаСтроки, "ПланОбмена.") Тогда
								НажатьКлавишуЦикл(Клавиши.PageDown, 20,, Истина);
								НажатьКлавишуЦикл(Клавиши.PageUp, 1,, Истина);
								//КликнутьПоЭлементу("Основные", "вкладка");
								//КликнутьПоЭлементу("Обмен данными", "элемент вкладки"); // Не находит 
							Иначе
								Возврат Ложь;
							КонецЕсли;
							Фрагменты = СтрРазделить(СсылкаСтроки, ".");
							ТурбоКонф.Ждать(20);
							НайтиСтрокуВОкне(Фрагменты[Фрагменты.ВГраница() - 1], Истина);
							Возврат Истина;
						Иначе
							Возврат Ложь;
						КонецЕсли;
					Иначе 
						// Свойства открываемые через палитру свойств
						ТурбоКонф.Клавиша(Клавиши.Enter);
						ТурбоКонф.АльтКлавиша(Клавиши.Enter);
						АктивироватьСвойствоВПалитреСвойств(МодулиИР.ирОбщий.ПредставлениеИзИдентификатораЛкс(ПоследнийФрагментЛкс(СсылкаСтроки)));
						СтарыйИД = ТурбоКонф.ПолучитьRuntimeIdСтрокой();
						Если ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Поле Тогда
							ТурбоКонф.Клавиша(Клавиши.F4);
						Иначе
							ТурбоКонф.Клавиша(Клавиши.Enter);
						КонецЕсли;
						ЖдатьСменуТекущегоЭлемента(СтарыйИД, 1000);
						УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
						Возврат АктивироватьСтрокуДерева(БазовыйОбъект);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ИмяСвойства = "";
		МаркерСтандартный = ".Стандартный.";
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, "//",,,,, Ложь);
		ЧастиИмениФормы = ПолеТекстаПрограммы.ЧастиПолногоИмениЭлементаФормы(СсылкаСтроки);
		ЧастиИмениМакета = ПолеТекстаПрограммы.ЧастиПолногоИмениЭлементаМакета(СсылкаСтроки);
		Если ЧастиИмениФормы <> Неопределено Тогда
			СсылкаСтроки = ЧастиИмениФормы.ИмяФормы;
			ПутьКЭлементуФормы = ЧастиИмениФормы.ПутьКЭлементу;
		ИначеЕсли ЧастиИмениМакета <> Неопределено Тогда
			СсылкаСтроки = ЧастиИмениМакета.ИмяМакета;
			ИмяЭлементаМакета = ЧастиИмениМакета.ПутьКЭлементу;
		ИначеЕсли СтрЧислоВхождений(СсылкаСтроки, ".") = 2 И СтрНачинаетсяС(СсылкаСтроки, "Перечисление.") Тогда
			Фрагменты = СтрРазделить(СсылкаСтроки, ".");
			Фрагменты.Вставить(2, "ЗначениеПеречисления");
			СсылкаСтроки = СтрСоединить(Фрагменты, ".");
		ИначеЕсли Истина
			И СтрЧислоВхождений(СсылкаСтроки, ".") = 2 
			И МодулиИР.ирОбщий.ЛиКорневойТипОбъектаСПредопределеннымЛкс(МодулиИР.ирОбщий.ПервыйФрагментЛкс(СсылкаСтроки))
		Тогда
			Фрагменты = СтрРазделить(СсылкаСтроки, ".");
			Фрагменты.Удалить(2);
			СсылкаСтроки = СтрСоединить(Фрагменты, ".");
		ИначеЕсли Найти(СсылкаСтроки, МаркерСтандартный) > 0 Тогда
			Фрагменты = СтрРазделитьЛкс(СсылкаСтроки, МаркерСтандартный);
			СсылкаСтроки = Фрагменты.Получить(0);
			ИмяРеквизита = Фрагменты.Получить(1);
		ИначеЕсли СтрНачинаетсяС(СсылкаСтроки, "ПакетXDTO.") Тогда
			ИмяТипаХДТО = ПоследнийФрагментЛкс(СсылкаСтроки);
			СсылкаСтроки = СтрокаБезПоследнегоФрагментаЛкс(СсылкаСтроки);
		ИначеЕсли СтрНачинаетсяС(СсылкаСтроки, "ПодпискаНаСобытие.") Тогда
			Фрагменты = СтрРазделитьЛкс(СсылкаСтроки);
			Если Фрагменты.Количество() > 2 Тогда
				ИмяСвойства = "Обработчик";
				Фрагменты.Удалить(2);
			КонецЕсли;
			СсылкаСтроки = СтрСоединить(Фрагменты, ".");
		ИначеЕсли СтрНачинаетсяС(СсылкаСтроки, "РегламентноеЗадание.") Тогда
			Фрагменты = СтрРазделитьЛкс(СсылкаСтроки);
			Если Фрагменты.Количество() > 2 Тогда
				ИмяСвойства = "Имя метода";
				Фрагменты.Удалить(2);
			КонецЕсли;
			СсылкаСтроки = СтрСоединить(Фрагменты, ".");
		КонецЕсли;
		ФрагментыИмени = СтрРазделить(СсылкаСтроки, ".");
		НижнееИскомоеИмя = ФрагментыИмени[ФрагментыИмени.ВГраница()]; 
		Если ЗначениеЗаполнено(ИмяРасширения) Тогда
			//Попытка
			//	ТурбоКонф.Перейти(ИмяРасширения + " " + СсылкаСтроки);
			//Исключение
			//	//Сообщить("Ошибка перехода к объекту метаданных """ + СсылкаСтроки + """: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
			//КонецПопытки; 
			//
			ТурбоКонф.ОткрытьМеню("Конфигурация", "Расширения конфигурации");
			АктивироватьСтрокуРасширенияКонфигурации(ИмяРасширения);
			СтарыйИД = ТурбоКонф.ПолучитьRuntimeIdСтрокой();
			//ТурбоКонф.Клавиша(Клавиши.Enter); // Не работает
			//КликнутьПоЭлементу(ТурбоКонф.ПолучитьИмяЭлемента(),,, Истина); // Не работает
			ОткрытьКонтекстноеМеню();
			//КликнутьПоЭлементу("Открыть конфигурацию", "элемент меню"); // Не работает
			ТурбоКонф.Клавиша(Клавиши.Down);
			ТурбоКонф.Клавиша(Клавиши.Enter);
			ЖдатьСменуТекущегоЭлемента(СтарыйИД);
			АктивироватьПолеДереваКонфигурации(); 
		Иначе
			АктивироватьДеревоОсновнойКонфигурации();
		КонецЕсли;
		Если ПустаяСтрока(ТурбоКонф.ПолучитьИмяЭлемента()) Тогда
			// Может не быть активного элемента дерева после изменения фильтра
			ТурбоКонф.Клавиша(Клавиши.Up);
		КонецЕсли;
		Если Не НайтиОбъектМетаданных(СсылкаСтроки) Тогда
			ПоказатьВсплывающееУведомление("Объект метаданных """ + СсылкаСтроки + """ не найден в конфигурации.");
			Возврат Ложь;
		КонецЕсли;
		Если ТолькоОткрытьПанельСвойств Тогда
			ТурбоКонф.АльтКлавиша(Клавиши.Enter);
		Иначе 
			// Активируем дерево конфигурации
			Если ПустаяСтрока(ИмяРасширения) Тогда
				АктивироватьДеревоОсновнойКонфигурации();
			Иначе
				// Ненадежно
				ВернутьсяВПредыдущееМестоКонфигуратора();
				ВернутьсяВПредыдущееМестоКонфигуратора(); // Почему то сначала активируется окно сообщений
				ЖдатьАктивацииТипаЭлементаИнтерфейса(, ПеречТипЭлемента.ЭлементСписка, Ложь);
			КонецЕсли;
			ТекущееИмя = ТурбоКонф.ПолучитьИмяЭлемента();
			Если НижнееИскомоеИмя <> ТекущееИмя Тогда
				Сообщить("ТекущееИмя=" + ТекущееИмя);
				Сообщить("ТекущийТип=" + ТипТекущегоЭлементаИнтерфейса());
				ОткрытьРезультатыПоиска();
				ТурбоКонф.Клавиша(Клавиши.Enter);
				ТурбоКонф.АльтКлавиша(Клавиши.Enter);
				//ЗакрытьДочернееОкноКонфигуратора();               
				Если ЛиПолноеИмяМакета(СсылкаСтроки, МодулиИР) Тогда
					АктивироватьСвойствоВПалитреСвойств("Макет");
				ИначеЕсли ЛиПолноеИмяФормы(СсылкаСтроки, МодулиИР) Тогда
					АктивироватьСвойствоВПалитреСвойств("Форма");
				ИначеЕсли МодулиИР.ирОбщий.СтрНайтиЛкс(СсылкаСтроки, ".Роль.") > 0 Тогда
					АктивироватьСвойствоВПалитреСвойств("Права");
				Иначе
					ПоказатьВсплывающееУведомление("Не удалось перейти к """ + СсылкаСтроки + """, но открыта панель свойств объекта. Отключите фильтр по подсистемам в дереве метаданных.");
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
			Если Ложь
				Или МодулиИР.ирОбщий.СтрНайтиЛкс(СсылкаСтроки, ".Команда.") > 0 
				Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СсылкаСтроки, "ОбщаяКоманда.") 
				Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СсылкаСтроки, "ПодпискаНаСобытие.")
				Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СсылкаСтроки, "РегламентноеЗадание.")
			Тогда 
				ТурбоКонф.АльтКлавиша(Клавиши.Enter); 
				Сообщить("ИмяСвойства="+ИмяСвойства);
				Если ЗначениеЗаполнено(ИмяСвойства) Тогда
					ТурбоКонф.Ждать(20);
					АктивироватьСвойствоВПалитреСвойств(ИмяСвойства);
				КонецЕсли;
			ИначеЕсли Ложь
				Или СтрНачинаетсяС(СсылкаСтроки, "ОбщийМакет.")
				Или СтрНачинаетсяС(СсылкаСтроки, "ОбщаяФорма.")
				Или СтрНачинаетсяС(СсылкаСтроки, "ОбщаяКартинка.")
				Или СтрНачинаетсяС(СсылкаСтроки, "ОбщийМодуль.")
				Или СтрНачинаетсяС(СсылкаСтроки, "ПакетXDTO.")
				Или СтрЧислоВхождений(СсылкаСтроки, ".") > 1
			Тогда
				ТурбоКонф.Клавиша(Клавиши.Enter); 
			ИначеЕсли СтрЧислоВхождений(СсылкаСтроки, ".") = 1 И СтрНачинаетсяС(СсылкаСтроки, "Перечисление.") Тогда
				ТурбоКонф.Клавиша(Клавиши.Multiply);
			КонецЕсли;
		КонецЕсли;
		// УстановитьБуферОбмена(СтароеЗначениеБуфераОбмена);
		Если ЗначениеЗаполнено(ПутьКЭлементуФормы) Тогда
			МаркерЭлементаФормы = "Элемент."; 
			ЭтоУправляемаяФорма = АктивироватьСтраницуДиалогРедактораФормы(МаркерЭлементаФормы);
			Если Найти(ПутьКЭлементуФормы, МаркерЭлементаФормы) > 0 Тогда
				ИмяЭлементаФормы = ПоследнийФрагментЛкс(ПутьКЭлементуФормы, МаркерЭлементаФормы);
				Если ЭтоУправляемаяФорма Тогда
					// Элемент управляемой формы
					НайтиСтрокуВОкне(ИмяЭлементаФормы);
					ИмяТекущегоЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
					Сообщить("ИмяТекущегоЭлемента=" + ИмяТекущегоЭлемента);
					Если ИмяТекущегоЭлемента <> ИмяЭлементаФормы + " Элемент" Тогда
						// Т.к. поиск делается по подстроке, то может быть найдено не то, что нужно. Поэтому оставляем дерево открытым.
						ПоказатьВсплывающееУведомление("Если найден неверный элемент, нажмите F3 для поиска следующего варианта");
					КонецЕсли;
				Иначе
					// Элемент обычной формы
					ИмяЭлементаФормы = " (" + ИмяЭлементаФормы + ") ";
					ТурбоКонф.КонтролШифтКлавиша(Клавиши.L); // Список элементов управления формы
					//ТурбоКонф.ЖдатьОкно("Список элементов управления формы", 1000, Истина); // Не работает
					Если НайтиУзелДерева(ПодключениеИР, ИмяЭлементаФормы) Тогда
						ТурбоКонф.Клавиша(Клавиши.Escape);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			МаркерРеквизитаФормы = "Реквизит."; 
			Если Найти(ПутьКЭлементуФормы, МаркерРеквизитаФормы) > 0 Тогда
				ПутьКРеквизиту = Сред(ПутьКЭлементуФормы, СтрДлина(МаркерРеквизитаФормы) + 1);
				Если ЭтоУправляемаяФорма Тогда
					// Реквизит управляемой формы
					АктивироватьСтраницуДиалогРедактораФормы(МаркерРеквизитаФормы);
					НажатьКлавишуЦикл(Клавиши.Left, 3); // До колонки "Реквизит"
					Если Не АктивироватьСтрокуДерева(ПутьКРеквизиту) Тогда
						ПоказатьВсплывающееУведомление("Реквизит (" + ПутьКРеквизиту + ") не найден");
					КонецЕсли;
				Иначе
					// Реквизит обычной формы
					СписокРеквизитовАктивирован = Ложь;
					Для Сч=1 По 3 Цикл
						ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
						Если Ложь
							Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Таблица
							Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Неизвестный // 50025
						Тогда 
							ТурбоКонф.Клавиша(Клавиши.Down);
							ТурбоКонф.Ждать(20);
							СписокРеквизитовАктивирован = Истина;
							Прервать;
						КонецЕсли;
						ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
						ТурбоКонф.Ждать(20);
					КонецЦикла;
					Если Не СписокРеквизитовАктивирован Тогда
						ПоказатьВсплывающееУведомление("Не удалось активировать список реквизитов формы");
					ИначеЕсли Не НайтиСтрокуВОкне(ПутьКРеквизиту) Тогда
						ПоказатьВсплывающееУведомление("Реквизит (" + ПутьКРеквизиту + ") не найден");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			МаркерКомандыФормы = "Команда."; 
			Если Найти(ПутьКЭлементуФормы, МаркерКомандыФормы) > 0 Тогда
				ИмяКоманды = ПоследнийФрагментЛкс(ПутьКЭлементуФормы, МаркерКомандыФормы);
				АктивироватьСтраницуДиалогРедактораФормы(МаркерКомандыФормы);
				Если Не АктивироватьСтрокуДерева(ИмяКоманды) Тогда
					ПоказатьВсплывающееУведомление("Команда (" + ИмяКоманды + ") не найдена");
				КонецЕсли;
			КонецЕсли;
			МаркерКомандыФормы = "Параметр."; 
			Если Найти(ПутьКЭлементуФормы, МаркерКомандыФормы) > 0 Тогда
				ИмяПараметра = ПоследнийФрагментЛкс(ПутьКЭлементуФормы, МаркерКомандыФормы);
				АктивироватьСтраницуДиалогРедактораФормы(МаркерКомандыФормы);
				Если Не АктивироватьСтрокуДерева(ИмяПараметра) Тогда
					ПоказатьВсплывающееУведомление("Параметр (" + ИмяПараметра + ") не найден");
				КонецЕсли;
			КонецЕсли;
			Если СтрНачинаетсяС(ПутьКЭлементуФормы, "<") Тогда
				// Обработчик события
				ПутьКЭлементуФормы = ТекстБезКрайнихСимволовЛкс(ПутьКЭлементуФормы);
				ФрагментыПути = СтрРазделитьЛкс(ПутьКЭлементуФормы);
				ФрагментыПути.Удалить(0); // "Событие"
				ИмяЭлементаФормы = ФрагментыПути[0];
				Если ЭтоУправляемаяФорма Тогда
					Если ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
						НайтиСтрокуВОкне(ИмяЭлементаФормы);
						ИмяТекущегоЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
						Сообщить("ИмяТекущегоЭлемента=" + ИмяТекущегоЭлемента);
					Иначе
						ТурбоКонф.Клавиша(Клавиши.Home);
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
						ИмяЭлементаФормы = " (" + ИмяЭлементаФормы + ") ";
						ТурбоКонф.КонтролШифтКлавиша(Клавиши.L); // Список элементов управления формы
						Если НайтиУзелДерева(ПодключениеИР, ИмяЭлементаФормы) Тогда
							ТурбоКонф.Клавиша(Клавиши.Escape);
						КонецЕсли;
					Иначе
						ТурбоКонф.Клавиша(Клавиши.Escape); // Активируем никакой элемент формы, т.е. свойства самой формы
					КонецЕсли;
				КонецЕсли;
				ТурбоКонф.КонтролАльтКлавиша(Клавиши.Enter);
				АктивироватьСвойствоВПалитреСвойств(ФрагментыПути[ФрагментыПути.ВГраница()],, Истина);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ИмяЭлементаМакета) Тогда
			СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
			ТурбоКонф.ОткрытьМеню("Таблица", "Имена", "Имена...");
			ЖдатьСменуТекущегоЭлемента(СтарыйИД);
			Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Имена" Тогда
				УстановитьЗначениеПолюВвода(ИмяЭлементаМакета);
				КликнутьПоЭлементу("Выбрать", "кнопка");
				ТурбоКонф.Клавиша(Клавиши.Escape);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ИмяТипаХДТО) Тогда
			Если НайтиУзелДерева(ПодключениеИР, ИмяТипаХДТО, Истина) Тогда
				ТурбоКонф.Клавиша(Клавиши.Escape);
			КонецЕсли;
		КонецЕсли;
		Возврат Истина; 
	КонецЕсли;
	СтруктураСсылки = МодулиИР.ирОбщий.СтруктураСсылкиСтрокиМодуляЛкс(СсылкаСтроки);
	Если СтруктураСсылки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Модуль открывает только если точка останова уже была в списке до вызова команды. Иначе открывает модуль последней точки останова.
	// Не возращает успешность. Не поддерживает модули расширений и внешних обработок.
	// ТурбоКонф.ОткрытьМодуль(СсылкаСтроки, ИмяФайлаВнешнейОбработки); 
	// Возврат Истина;
	
	ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если Ложь
		Или ЗаголовокОкна = "Событие" 
		Или ЗаголовокОкна = "Выражение"
	Тогда
		ЗакрытьМодальноеОкно();
	КонецЕсли;
	Успех = Ложь;
	НомерВерсииПлатформы = МодулиИР.ирКэш.НомерВерсииПлатформыЛкс();
	ИмяВременногоФайла = "";
	ОткрытьЧерезСписокТочекОстанова = Истина;
	Если Ложь
		//Или ЗначениеЗаполнено(СтруктураСсылки.Расширение) // Пока есть проблема https://turboconf.ru/Tasks/10166
		Или ЗначениеЗаполнено(СтруктураСсылки.Файл)
	Тогда
		//
	Иначе
		ОткрытьЧерезСписокТочекОстанова = Ложь;
		Если ЛиПолноеИмяФормы(СтруктураСсылки.Модуль, МодулиИР) Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Форма", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
			АктивироватьСтраницуМодульРедактораФормы();
		ИначеЕсли Ложь
			Или МодулиИР.ирОбщий.СтрНайтиЛкс(СтруктураСсылки.Модуль, ".Команда.") > 0 
			Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СтруктураСсылки.Модуль, "ОбщаяКоманда.") 
		Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Модуль команды", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СтруктураСсылки.Модуль, "ОбщийМодуль.") Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Модуль", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли МодулиИР.ирОбщий.СтрКончаетсяНаЛкс(СтруктураСсылки.Модуль, ".МодульМенеджера") Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Модуль менеджера", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли МодулиИР.ирОбщий.СтрКончаетсяНаЛкс(СтруктураСсылки.Модуль, ".МодульОбъекта") Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Модуль объекта", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли МодулиИР.ирОбщий.СтрКончаетсяНаЛкс(СтруктураСсылки.Модуль, ".МодульНабораЗаписей") Тогда
			Если Не ОткрытьМодульЧерезПалитруСвойств("Модуль набора записей", СтруктураСсылки, Успех) Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ОткрытьЧерезСписокТочекОстанова = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ОткрытьЧерезСписокТочекОстанова Тогда
		// Через список точек останова
		ИмяВременногоФайла = СохранитьТочкиОстановаВФайл();
		Если Не ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
			Возврат Ложь;
		КонецЕсли;
		ЛиНекорректнаяСсылка = Ложь;
		СтруктураСсылки = МодулиИР.ирКлиент.ДобавитьВФайлТочекОстановаЛкс(ИмяВременногоФайла, СсылкаСтроки);
		СтароеАктивноеОкно = Неопределено;
		Если Не ЗагрузитьФайлТочекОстанова(ИмяВременногоФайла, СтароеАктивноеОкно) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НомерВерсииПлатформы < 803024 Тогда
			ЧислоКолонок = 3;
			ИмяЯчейки = СтруктураСсылки.УсловиеОстанова + " Условие";
		Иначе
			ЧислоКолонок = 4;
			ИмяЯчейки = "условие: " + СтруктураСсылки.УсловиеОстанова + " Условие срабатывания";
		КонецЕсли;
		НачМомент = ТекущаяДата();
		ПредСтрока = Неопределено;
		Пока ТекущаяДата() - НачМомент < 2 Цикл
			ТурбоКонф.Клавиша(Клавиши.Home);
			ТурбоКонф.Ждать(50); // Файл загружается асинхронно. Менее чем за 100мс он обычно не успевает загрузиться
			//ТурбоКонф.Клавиша(Клавиши.PageDown); // Нельзя так делать, т.к. первая строка может уйти за видимую область
			Пока Истина Цикл 
				Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Конфигуратор" Тогда
					ЛиНекорректнаяСсылка = Истина;
					Прервать;
				КонецЕсли; 
				Если ПустаяСтрока(ТурбоКонф.ПолучитьИмяЭлемента()) Тогда
					Прервать;
				КонецЕсли;
				ТекстПоследнейСтроки = ИдентификаторТекущегоЭлементаОкна();
				ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка();
				Если ВидимыеЭлементы <> Неопределено Тогда
					ТекстПоследнейСтроки = ТекстПоследнейСтроки + "," + СтрСоединить(ВидимыеЭлементы.ИменаЭлементов, ",");
				КонецЕсли;
				Если ПредСтрока = ТекстПоследнейСтроки Тогда
					// Дошли до конца таблицы
					Прервать;
				КонецЕсли;
				ПредСтрока = ТекстПоследнейСтроки;
				// МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Если КликнутьПоЭлементу(ИмяЯчейки, Неопределено) Тогда // Было 1000мс (исправлено). Иногда возвращает ложь, хотя клик выполняет
					// Сообщить("Время клика " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска));
					//ТурбоКонф.Клавиша(Клавиши.Escape);
					Успех = Истина;
					Прервать;
				Иначе
					ТурбоКонф.Клавиша(Клавиши.PageDown);
					ТурбоКонф.Ждать(20);
				КонецЕсли;
			КонецЦикла;
			Если Успех Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Успех Тогда
			Если ЛиНекорректнаяСсылка Тогда
				ЗакрытьМодальноеОкно();
				ПоказатьВсплывающееУведомление("Модуль не найден: " + СтруктураСсылки.Модуль);
				ЗакрытьДочернееОкноКонфигуратора();
			КонецЕсли;
			// ТурбоКонф.Клавиша(Клавиши.Escape);
		Иначе
			СтароеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
			//ТурбоКонф.Клавиша(Клавиши.Return); // В 8.3.20- не работает TODO переделать на КликПоЭлементу. В 8.3.24+ не работает.
			КликнутьПоЭлементу("Перейти к исходному коду", "кнопка");
			НачМомент = ТекущаяДата();
			Пока ТекущаяДата() - НачМомент < 2 И Не ЭтоДокумент() Цикл
				ТурбоКонф.Ждать(20);
			КонецЦикла;
			ТурбоКонф.Клавиша(Клавиши.F9);
			ТурбоКонф.Ждать(20);
			Если СтруктураСсылки.НомерСтроки > 1 Тогда
				ТурбоКонф.ШифтКлавиша(Клавиши.End);
			КонецЕсли;
			Если НомерВерсииПлатформы >= 803024 Тогда
				ТурбоКонф.Клавиша(Клавиши.F9);
				ТурбоКонф.АльтКлавиша(Клавиши.F9);
				ЗакрытьДочернееОкноКонфигуратора();
			КонецЕсли;
			Попытка
				СтарыйИД = ИдентификаторТекущегоЭлементаОкна(); // Тут часто возвникает ошибка - Время ожидания операции истекло. (Исключение из HRESULT: 0x80131505)
			Исключение
			КонецПопытки; 
			ЖдатьСменуТекущегоЭлемента(СтарыйИД, 200);
			//ТурбоКонф.Ждать(200); // Иначе может вернуться пустой текст модуля
		КонецЕсли;
	КонецЕсли;
	
	Если Успех Тогда
		БлокРазвернут = Ложь;
		ИмяМетода = СтруктураСсылки.Метод;
		ТекстМодуля = ТурбоКонф.ПолучитьТекстМодуля(ВыделенныйТекст, ПозицияВТексте);
		Если Не ЗначениеЗаполнено(ТекстМодуля) Тогда
			ПоказатьВсплывающееУведомление("Получен пустой текст модуля", 3000);
		Иначе
			ЗапомнитьСтаруюПозицию = ЗначениеЗаполнено(ПозицияВТексте); // Вредно запоминать нулевую позицию
			ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,, Истина,,,,,, Истина, СсылкаСтроки);
			ПерейтиВПозицию(,, ПолеТекстаПрограммы, Не ЗначениеЗаполнено(СтруктураСсылки.НомерСтроки), ЗапомнитьСтаруюПозицию);
			Если Истина
				И ЗначениеЗаполнено(ИмяМетода)
				И (Ложь
					Или СтруктураСсылки.СмещениеСтрокиМетода <> 0
					Или Найти(НРег(ВыделенныйТекст), НРег(" " + ИмяМетода + "(")) = 0)
			Тогда
				БлокРазвернут = Истина;
				ВыполнитьКомандуИзСсылкиПослеПерехода(ПолеТекстаПрограммы, СтруктураСсылки);
			КонецЕсли;
			Если Не БлокРазвернут Тогда 
				РазвернутьБлокМодуля(,, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		УдалитьФайлы(ИмяВременногоФайла); // Нельзя сразу делать, т.к. загрузка идет асинхронно
	КонецЕсли;
	ТурбоКонф.ОтжатьМодификаторы(); // Иначе будет иногда залипать CTRL после перехода из формы приложения ИР к строке модуля, например после первого в окне конфигуратора вызова "Перейти в последние методы"
	Возврат Успех;

КонецФункции

Функция ЗагрузитьФайлТочекОстанова(Знач ИмяФайла, Знач СтароеАктивноеОкно = Неопределено) Экспорт
	Результат = ОткрытьФайл(ИмяФайла, "Загрузить точки останова из файла", СтароеАктивноеОкно);
	Возврат Результат;
КонецФункции

//.
// Параметры:
//   СсылкаСтроки - Строка - 
//   МодулиИР - Application {V83.Application}, Неопределено - 
// Возвращаемое значение:
//   Булево - 
Функция ЛиПолноеИмяМакета(Знач СсылкаСтроки, Знач МодулиИР) Экспорт
	Результат = Ложь
		Или МодулиИР.ирОбщий.СтрНайтиЛкс(СсылкаСтроки, ".Макет.") > 0
		Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СсылкаСтроки, "ОбщийМакет.") > 0;
	Возврат Результат;
КонецФункции

//.
// Параметры:
//   СсылкаСтроки - Строка - 
//   МодулиИР - Application {V83.Application}, Неопределено - 
// Возвращаемое значение:
//   Булево - 
Функция ЛиПолноеИмяФормы(Знач СсылкаСтроки, Знач МодулиИР) Экспорт
	Результат = Ложь
		Или МодулиИР.ирОбщий.СтрНайтиЛкс(СсылкаСтроки, ".Форма.") > 0
		Или МодулиИР.ирОбщий.СтрНачинаетсяСЛкс(СсылкаСтроки, "ОбщаяФорма.") > 0;
	Возврат Результат;
КонецФункции

Функция АктивироватьСтраницуДиалогРедактораФормы(Знач НачалоПутиЭлемента = "") Экспорт
	СтарыйТипЭлементаИнтерфейса = "";
	Для Сч=1 По 3 Цикл
		ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
		ЭтоУправляемаяФорма = ТипЭлементаИнтерфейса = СтарыйТипЭлементаИнтерфейса;
		Если ЭтоУправляемаяФорма Или СтарыйТипЭлементаИнтерфейса = ПеречТипЭлемента.Документ Тогда
			Прервать;
		КонецЕсли;
		СтарыйТипЭлементаИнтерфейса = ТипЭлементаИнтерфейса;
		ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
		ТурбоКонф.Ждать(20);
	КонецЦикла;
	Если ЭтоУправляемаяФорма Тогда
		Если СтрНачинаетсяС(НачалоПутиЭлемента, "Параметр") Тогда
			ТурбоКонф.АльтКлавиша(Клавиши.D7); 
		ИначеЕсли СтрНачинаетсяС(НачалоПутиЭлемента, "Команда") Тогда
			ТурбоКонф.АльтКлавиша(Клавиши.D5); 
		ИначеЕсли СтрНачинаетсяС(НачалоПутиЭлемента, "Реквизит") Тогда
			ТурбоКонф.АльтКлавиша(Клавиши.D4); 
		Иначе
			ТурбоКонф.АльтКлавиша(Клавиши.D3); 
		КонецЕсли;
		ТурбоКонф.Ждать(30);
	КонецЕсли;
	Возврат ЭтоУправляемаяФорма;
КонецФункции 

Процедура АктивироватьСтраницуМодульРедактораФормы() Экспорт
	СтарыйТипЭлементаИнтерфейса = "";
	Для Сч=1 По 3 Цикл
		ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
		ЭтоУправляемаяФорма = ТипЭлементаИнтерфейса = СтарыйТипЭлементаИнтерфейса;
		Если ЭтоУправляемаяФорма Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Документ Тогда
			Прервать;
		КонецЕсли;
		СтарыйТипЭлементаИнтерфейса = ТипЭлементаИнтерфейса;
		ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
		ТурбоКонф.Ждать(20);
	КонецЦикла;
	Если ЭтоУправляемаяФорма Тогда
		Если ТипЭлементаИнтерфейса <> ПеречТипЭлемента.Документ Тогда
			ТурбоКонф.АльтКлавиша(Клавиши.D2); // Активируем странцу "Модуль" редактора формы
			ТурбоКонф.Ждать(50);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

Функция ОткрытьМодульЧерезПалитруСвойств(Знач ИмяСвойстваМодуля, Знач СтруктураСсылки, выхУспех) Экспорт
	Если Не ПерейтиПоСсылкеМД(СтрокаБезПоследнегоФрагментаЛкс(СтруктураСсылки.Модуль), СтруктураСсылки.Расширение,, Истина) Тогда
		Возврат Ложь;
	КонецЕсли;
	АктивироватьСвойствоВПалитреСвойств(ИмяСвойстваМодуля,,, Истина);
	//КликнутьПоЭлементу("Открыть", "ссылка"); // Не работает
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД, 100);
	ЖдатьАктивацииТипаЭлементаИнтерфейса();
	выхУспех = Истина;
	Возврат Истина;
КонецФункции

//.
// Параметры:
//   ДлительностьОжидания -  - 
//   ЦелевойТипЭлемента - ТипТекущегоЭлемента - см. ПеречТипЭлемента
//   ЗапретитьСменуОкна -  - 
// Возвращаемое значение:
//   Булево - 
Функция ЖдатьАктивацииТипаЭлементаИнтерфейса(Знач ДлительностьОжидания = 100, Знач ЦелевойТипЭлемента = "Документ", Знач ЗапретитьСменуОкна = Истина) Экспорт
	АтомВремени = 10;
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	Для Сч=1 По ДлительностьОжидания/АтомВремени Цикл
		ТипТекущегоЭлемента = ТипТекущегоЭлементаИнтерфейса();
		//Сообщить("ТипТекущегоЭлемента=" + ТипТекущегоЭлемента);
		Если ТипТекущегоЭлемента = ЦелевойТипЭлемента Тогда
			Возврат Истина;
		КонецЕсли;
		Если ЗапретитьСменуОкна И Окно <> ТурбоКонф.ПолучитьАктивноеОкно() Тогда
			Прервать;
		КонецЕсли;
		ТурбоКонф.Ждать(АтомВремени);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

//.
// Параметры:
//   МодулиИР - Application {V83.Application}, Неопределено - 
//   Текст - Строка - 
// Возвращаемое значение:
//   ТаблицаЗначений - COM
Функция НайтиОбъектыМДВТекстеОкнаСообщений(МодулиИР, Знач Текст) Экспорт
	Возврат МодулиИР.ирОбщий.НайтиРегВыражениеЛкс(Текст, "^Объект ""([^""]+)"" (использован)?", "", Истина, Истина, Истина);
КонецФункции

//.
// Параметры:
//   ПодключениеИР -  - 
//   ТекстИскомогоЭлемента -  - 
//   СвернутьДерево -  - 
// Возвращаемое значение:
//   Булево - успех
Функция НайтиУзелДерева(Знач ПодключениеИР = Неопределено, Знач ТекстИскомогоЭлемента, Знач СвернутьДерево = Ложь) Экспорт
	Если СвернутьДерево Тогда
		ПутьСтарый = ПутьВДеревеТабличногоПоля(ПодключениеИР);
	КонецЕсли;
	НайтиСтрокуВОкне(ТекстИскомогоЭлемента, Истина);
	ИмяТекущегоЭлемента = ТурбоКонф.ПолучитьИмяЭлемента();
	Сообщить("ИмяТекущегоЭлемента=" + ИмяТекущегоЭлемента);
	Успех = ИмяТекущегоЭлемента = ТекстИскомогоЭлемента;
	Если Не Успех Тогда
		ПоказатьВсплывающееУведомление("Если найден неверный элемент, нажмите F3 для поиска следующего варианта");
	КонецЕсли;
	Если СвернутьДерево Тогда
		СвернутьДругиеСтроки(ПутьСтарый);
	КонецЕсли;
	Возврат Успех;
КонецФункции

//.
// Параметры:
//   ИскомаяСтрока -  - 
//   РазвернутьДеревоИПерейтиВНачало -  - 
//   ЖдатьЧерезЗаголовокОкна -  - 
// Возвращаемое значение:
//   Булево - 
Функция НайтиСтрокуВОкне(Знач ИскомаяСтрока, Знач РазвернутьДеревоИПерейтиВНачало = Ложь, Знач ЖдатьЧерезЗаголовокОкна = Истина, Знач РазрешитьВхождениеВТекущейСтроке = Истина) Экспорт
	Если ЛиТаблицаПуста() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РазвернутьДеревоИПерейтиВНачало Тогда
		РазвернутьДеревоИПерейтиВНачало();
	КонецЕсли; 
	Если РазрешитьВхождениеВТекущейСтроке Тогда
		ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
		Если Найти(ТекстЯчейки, ИскомаяСтрока) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	//Сообщить("ИскомаяСтрока=" + ИскомаяСтрока);
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.КонтролКлавиша(Клавиши.F);
	Если ЖдатьЧерезЗаголовокОкна Тогда
		ТурбоКонф.ЖдатьОкно("Поиск", 1000, Истина, Истина); // Где то не работало
	Иначе
		ЖдатьСменуТекущегоЭлемента(СтарыйИД, 1000, Истина); // Не работает в окне "Выбор типа данных" (из окна "Редактирование параметров выбора") и "Выбор объекта"
	КонецЕсли;
	//УстановитьЗначениеПолюВвода(ИскомаяСтрока); // Тут нет смысла в этом более затратном способе, т.к. и без него модифицированность включается
	ТурбоКонф.УстановитьЗначение(ИскомаяСтрока);
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Конфигуратор" Тогда
		// Могли уже стоять в строке с вхождением
		КликнутьПоЭлементу("OK", "кнопка");
		ЖдатьОсвобожденияПотокаВвода();
	КонецЕсли;
	ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
	//Сообщить("ТекстЯчейки"+ТекстЯчейки);
	Результат = Найти(ТекстЯчейки, ИскомаяСтрока) > 0;
	Возврат Результат;
КонецФункции  

// Фокус должен быть в дереве конфигурацииы
Функция НайтиОбъектМетаданных(Знач ПолноеИмяОбъекта) Экспорт
	ИмяОбъекта = ПоследнийФрагментЛкс(ПолноеИмяОбъекта);
	ТурбоКонф.КонтролКлавиша(Клавиши.F);
	ТурбоКонф.ЖдатьОкно("Поиск объектов метаданных", 1000, Истина);
	//УстановитьЗначениеПолюВвода(ИскомаяСтрока); // Тут нет смысла в этом более затратном способе, т.к. и без него модифицированность включается
	ТурбоКонф.УстановитьЗначение(ИмяОбъекта);
	ТурбоКонф.Ждать(20);
	
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТурбоКонф.Клавиша(Клавиши.Tab);
	//ТурбоКонф.УстановитьФокусНаЭлемент("Именах", "флажок"); // Так в 3 раза дольше
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина); // Включаем "Искать в именах"
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Tab);
	//ТурбоКонф.УстановитьФокусНаЭлемент("Синонимах", "флажок");
	Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Ложь); // Выключаем "Искать в синонимах"
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Tab);
	//ТурбоКонф.УстановитьФокусНаЭлемент("Комментариях", "флажок");
	Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Ложь); // Выключаем "Искать в комментариях"
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Tab);
	//ТурбоКонф.УстановитьФокусНаЭлемент("Учитывать регистр", "флажок");
	Если ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Ложь); // Выключаем "Учитывать регистр"
	КонецЕсли; 
	// На больших конфигурациях ручной поиск часто используют, т.к. он быстрее фильтра
	//ТурбоКонф.Клавиша(Клавиши.Tab);
	////ТурбоКонф.УстановитьФокусНаЭлемент("Слово целиком", "флажок");
	//Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
	//	ТурбоКонф.УстановитьСостояниеФлажка(Истина); // - Включаем "Слово целиком"
	//КонецЕсли;   
	Сообщить("Установка флажков " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
	
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	ОткрытьРезультатыПоиска();
	ТурбоКонф.Ждать(10); 
	Если ЛиТаблицаПуста() Тогда
		Возврат Ложь;
	КонецЕсли;
	Успех = НайтиСтрокуВОкне(ПолноеИмяОбъекта);
	Если Успех Тогда
		ТурбоКонф.Клавиша(Клавиши.Enter);
	КонецЕсли;
	Возврат Успех;
КонецФункции

Функция ПоследнийФрагментЛкс(Знач ПолноеИмяОбъекта, Знач Разделитель = ".") Экспорт
	Фрагменты = СтрРазделитьЛкс(ПолноеИмяОбъекта, Разделитель);
	ИмяОбъекта = Фрагменты[Фрагменты.ВГраница()];
	Возврат ИмяОбъекта;
КонецФункции

Процедура РазвернутьДеревоИПерейтиВНачало() Экспорт
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Add); // Для окна "Выражение"
КонецПроцедуры

Процедура СвернутьДеревоИПерейтиВНачало() Экспорт
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.Subtract);
КонецПроцедуры

//.
// Параметры:
//    ПолеТекстаПрограммы - ОбработкаОбъект.ирКлсПолеТекстаПрограммы - 
//    СсылкаСтроки - Структура - 
Процедура ВыполнитьКомандуИзСсылкиПослеПерехода(Знач ПолеТекстаПрограммы, Знач СтруктураСсылки) Экспорт
	Если Истина
		И СтруктураСсылки <> Неопределено
		И СтруктураСсылки.Команда = "ПодавитьПроверки" 
	Тогда
		СтрокаТекста = ПолеТекстаПрограммы.ПолеТекста.ПолучитьСтроку(ПолеТекстаПрограммы.мКонечнаяСтрока);
		Сообщить("Строка текста = " + СтрокаТекста);
		ИнструкцияПодавленияПроверки = ПолеТекстаПрограммы.ИнструкцияПодавленияПроверки();
		Если Найти(СтрокаТекста, ИнструкцияПодавленияПроверки) = 0 Тогда
			ТурбоКонф.Клавиша(Клавиши.End);
			ТурбоКонф.ВставитьТекст(" " + ИнструкцияПодавленияПроверки);
		КонецЕсли;
	ИначеЕсли Истина
		И СтруктураСсылки <> Неопределено
		И СтрНачинаетсяС(СтруктураСсылки.Команда, "УказатьВызывающийМодуль:")
	Тогда
		ВызывающийМодуль = СтрРазделить(СтруктураСсылки.Команда, ":")[1];
		ПолеТекстаПрограммы.УказатьВызывающийМодуль(ВызывающийМодуль);
		Если ПолеТекстаПрограммы.мЗамещающийФрагмент = Неопределено Тогда
			ПередатьГраницыВыделенияИзПолеТекстаПрограммы(ПолеТекстаПрограммы);
		Иначе
			ПередатьИзмененияИзПоляТекстаВОкноМодуля(ПолеТекстаПрограммы, Ложь, Ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция СохранитьТочкиОстановаВФайл() 
	Попытка
		СтарыйИД = ИдентификаторТекущегоЭлементаОкна(); // Тут часто возвникает ошибка - Время ожидания операции истекло. (Исключение из HRESULT: 0x80131505)
	Исключение
	КонецПопытки; 
	СтароеАктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.АльтКлавиша(Клавиши.F9); 
	
	// Такой способ не совместим с прикрепленным режимом окна в 8.3.24+
	//Окно = ТурбоКонф.ЖдатьОкно("Точки останова", 3000, Истина); // На 8.3.23- окно можно открываться очень долго, если есть точка останова из большого расширения (например ИР), которое не открыто
	//Если Окно = 0 Тогда
	//	Возврат "";
	//КонецЕсли;
	//
	ЖдатьСменуТекущегоЭлемента(СтарыйИД, 3000, Истина); // На 8.3.23- окно можно открываться очень долго, если есть точка останова из большого расширения (например ИР), которое не открыто
	
	////СтарыйИД = ТурбоКонф.ПолучитьRuntimeId();
	//ТурбоКонф.Ждать(20);
	ТурбоКонф.КонтролКлавиша(Клавиши.s);
	Окно = ТурбоКонф.ЖдатьОкно("Сохранить точки останова в файл", 2000, Истина);
	Если Окно = 0 Тогда
		Возврат "";
	КонецЕсли;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ТурбоКонф.УстановитьЗначение(ИмяВременногоФайла);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	НачМомент = ТекущаяДата();
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	Пока ТекущаяДата() - НачМомент < 2 Цикл
		Попытка
			ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
			Прервать;
		Исключение
		КонецПопытки;
		ТурбоКонф.Ждать(20);
	КонецЦикла;
	Если ПустаяСтрока(ТекстовыйДокумент.ПолучитьТекст()) Тогда
		УдалитьФайлы(ИмяВременногоФайла);
		Возврат "";
	КонецЕсли;
	Возврат ИмяВременногоФайла; 
КонецФункции

Функция ОткрытьФайл(Знач ИмяФайла, Знач Заголовок = "Открытие", СтароеАктивноеОкно = Неопределено)
	ТурбоКонф.КонтролКлавиша(Клавиши.o);
	Окно = ТурбоКонф.ЖдатьОкно(, 1000, Истина);
	Если Окно = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТурбоКонф.УстановитьЗначение(ИмяФайла);
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна(); // Тут часто возникает ошибка - Время ожидания операции истекло. (Исключение из HRESULT: 0x80131505)
	СтароеАктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
	ТурбоКонф.Клавиша(Клавиши.Enter);  
	Если Не ЖдатьПотерюАктивностиОкна(СтароеАктивноеОкно) Тогда
		Возврат Ложь;
	КонецЕсли;
	//// Загрузка выполняется асинхронно. Поэтому тут не будем проверять успешность загрузки
	//Попытка
	//	СтарыйИД = ИдентификаторТекущегоЭлементаОкна(); // Тут часто возвникает ошибка - Время ожидания операции истекло. (Исключение из HRESULT: 0x80131505)
	//Исключение
	//КонецПопытки; 
	Возврат Истина;
КонецФункции

Процедура ВставитьТочкиОстановаИзРезультатовПоиска()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Ждать(20);
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(5);
	ЗакрытьДочернееОкноКонфигуратора();
	ОткрытьРезультатыПоиска();
	//Текст = ВыделенныйТекст(); // Платформа всегда копирует все строки
	ОткрытьКонтекстноеМеню(30);
	КликнутьПоЭлементу("Вывести список...", "элемент меню");
	ТурбоКонф.ЖдатьОкно("Вывести список", 1000, Истина);
	ЗакрытьМодальноеОкно(Ложь, Клавиши.Enter, Истина);
	ТурбоКонф.Ждать(20);
	КомандаВыделитьВсе();
	ТурбоКонф.Копировать();
	ТурбоКонф.Ждать(20);
	Текст = ТурбоКонф.ПолучитьБуферОбмена();
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.Ждать(20);
	ЗакрытьДочернееОкноКонфигуратора();
	ИмяФайла = СохранитьТочкиОстановаВФайл();
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь); 
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	Если ЯчейкиТекущейСтроки.Количество() Тогда
		МодульТочки = СтрЗаменить(ЯчейкиТекущейСтроки[1], " Имя модуля", "");
		НомерСтрокиТочки = СтрЗаменить(ЯчейкиТекущейСтроки[2], " Строка", "");
	КонецЕсли;
	МодулиИР.ирКлиент.ДобавитьВФайлТочекОстановаРезультатыПоискаКонфигуратораЛкс(ИмяФайла, Текст, МодульТочки, НомерСтрокиТочки);
	ОткрытьФайл(ИмяФайла, "Загрузить точки останова из файла");
КонецПроцедуры

Процедура ЖдатьОсвобожденияПотокаВвода() Экспорт
	ТипТекущегоЭлементаИнтерфейса(); // Ждем
КонецПроцедуры

// После открытия контекстного меню текущий элемент не сразу меняется. Поэтому опасно вызывать ЖдатьСменуТекущегоЭлемента
Процедура ОткрытьКонтекстноеМеню(Знач ДопОжиданиеМиллисекунд = 0) Экспорт
	ТурбоКонф.КонтролШифтКлавиша(Клавиши.F10);
	ТурбоКонф.Ждать(30 + ДопОжиданиеМиллисекунд); // 30 иногда не хватает см. ВставитьТочкиОстановаИзРезультатовПоиска
КонецПроцедуры

// Если сработает, то сбрасывает выделение. Поэтому после выполения выделение переустанавливается.
// Поэтому настоятельно рекомендуется передавать НачалоВыделения и КонецВыделения
Процедура РазвернутьБлокМодуля(Знач НачалоВыделения = 0, Знач КонецВыделения = 0, Знач ВыделитьВсюСтроку = Ложь, Знач Строгое = Ложь)
	
	ТурбоКонф.КонтролКлавиша(Клавиши.Add);
	Если Не ЗначениеЗаполнено(КонецВыделения) Тогда
		КонецВыделения = НачалоВыделения;
	КонецЕсли;
	Если Ложь
		Или ВыделитьВсюСтроку 
		Или ТурбоКонф.ПолучитьВерсиюAPI() < 6 
		Или ТурбоКонф.РежимСовместимости()
	Тогда
		ТурбоКонф.Ждать(20);
		ТурбоКонф.ШифтКлавиша(Клавиши.End);
	Иначе 
		// Чтобы свернутый блок, внутри которого скрыта строка, развернулся
		ТурбоКонф.КонтролКлавиша(Клавиши.Left);
		ТурбоКонф.КонтролКлавиша(Клавиши.Right);

		// Неудобное позиционирование https://turboconf.ru/Tasks/8888
		Если ЗначениеЗаполнено(КонецВыделения) Тогда
			ТурбоКонф.ВыделитьТекст(НачалоВыделения, КонецВыделения);
		КонецЕсли;
		Если Не Строгое И НачалоВыделения = КонецВыделения Тогда
			ВыделитьТекущееСловоПоляДокумента();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ОткрытьОкноВыражения(выхПолеТекстаПрограммы = Неопределено, выхВыражение = "")
	Если Не ЭтоДокумент() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	выхПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,, Истина,,,,,,,, Ложь); // Для сохранения контекста в кэше 
	Если выхПолеТекстаПрограммы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта); // Так почему то не всегда затем получается заголовок модального окна
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	ТурбоКонф.ШифтКлавиша(Клавиши.F9);
	Попытка
		ТурбоКонф.ЖдатьОкно("Выражение", 1000, Истина);
	Исключение
		Возврат Неопределено; 
	КонецПопытки;
	Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		выхВыражение = ВыделенныйТекст;
	Иначе 
		выхВыражение = выхПолеТекстаПрограммы.мКонтекст;
	КонецЕсли; 
	Если Прав(выхВыражение, 1) = "(" Тогда
		выхВыражение = выхВыражение + ")";
	КонецЕсли;
	// Окно сначала появляется, а затем берет фокус, даже не смотря на то, что оно модальное
	//МоментНачала = ТекущаяДата();
	//Пока ТекущаяДата() - МоментНачала = 0 Цикл
	//	Успех = Истина;
	//	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = ЦелевойЗаголовок Тогда
	//		Прервать;
	//	КонецЕсли;
	//	Успех = Ложь;
	//	ТурбоКонф.Ждать(50);
	//КонецЦикла;
	Возврат ПодключениеИР;
КонецФункции

//&_ВосстанавливатьБуферОбмена
Процедура ВычислитьВыражение() 
	Сообщить("Команда.ВычислитьВыражение");
	Если Ложь
		Или Не ПроверитьРазрешениеИР() 
		Или ВосстановитьЗначениеСеансаКонфигуратора("ЗапретОбработкиОткрытияВыражения") = Истина 
	Тогда
		ПродолжитьОбработкуНажатияКлавиш();
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	БазовоеВыражение = "";
	Если Не ЭтоДокумент() И ЛиАктивноГлавноеОкно() Тогда
		ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка(Истина);
		Если Истина
			И ВидимыеЭлементы <> Неопределено 
			И ВидимыеЭлементы.ИменаЭлементов.Количество() > 0
		Тогда
			ИмяКолонки = " Выражение";
			ИмяЭлемента = ВидимыеЭлементы.ИменаЭлементов[0];
			Если Найти(ИмяЭлемента, ИмяКолонки) > 0 Тогда
				// Это ячейка окна "Табло"
				БазовоеВыражение = СтрокаБезПоследнегоФрагментаЛкс(ЯчейкиТекущейСтрокиСпискаИзВидимыхЭлементов(ВидимыеЭлементы, 3)[0], ИмяКолонки);
				//ПерейтиКТекущейСтрокеИсполнения();
				ТурбоКонф.Клавиша(Клавиши.Escape);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ПолеТекстаПрограммы = Неопределено; // ОбработкаОбъект.ирКлсПолеТекстаПрограммы
	ТекстПоля = "";
	ПодключениеИР = ОткрытьОкноВыражения(ПолеТекстаПрограммы, ТекстПоля); 
	Если ПодключениеИР = Неопределено Тогда
		ПоказатьВсплывающееУведомление("Команда применима только во время остановки отладки в редакторе модуля или табло");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекстПоля) Тогда
		ТекстПоля = ТурбоКонф.ПолучитьЗначение();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(БазовоеВыражение) Тогда
		БазовоеВыражение = ТекстПоля;
	КонецЕсли;
	Если ПустаяСтрока(БазовоеВыражение) Тогда
		Возврат;
	КонецЕсли;
	ПорогДлиныТекста = 100;
	Если БазовоеВыражение = ТекстПоля Тогда
		ТурбоКонф.Ждать(20);
		ЗначениеВыражения = ЗначениеВыраженияОкнаВыражение(ТекстПоля, ПорогДлиныТекста, Истина);
		ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
		ТурбоКонф.Клавиша(Клавиши.End);
		Если ЗначениеВыражения = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "РасширенноеПредставлениеЛкс");
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Если Истина
		И Не СтрНачинаетсяС(БазовоеВыражение, ТекстВызова) 
		И ЗначениеВыражения <> Неопределено
		И ЛиТипИмеетРасширенноеПредставление(ЗначениеВыражения.ТипЗначения)
	Тогда
		Выражение = ТекстВызова + "(" + БазовоеВыражение + ",, 1, 1 ,1 , 1,, 1)";
		УстановитьЗначениеПолюВвода(Выражение);
		ТекстыЯчеек = ЖдатьВычислениеВыражения();
		Если ЗначениеЗаполнено(ТекстыЯчеек[1]) Тогда 
			РасширенноеПредставление = ТекстБезКрайнихСимволовЛкс(ТекстыЯчеек[1]);
			РасширенноеПредставление = ПредставлениеСОграничениемДлиныЛкс(РасширенноеПредставление, 200);
			Сообщить("РасширенноеПредставлениеИсходное=" + РасширенноеПредставление);
			ИмяТипа = СокрЛП(ТекстМеждуМаркерамиЛкс(РасширенноеПредставление, ")", ":",));
			Если Истина
				И ЗначениеЗаполнено(РасширенноеПредставление)
				И РасширенноеПредставление <> "(*)" 
				//И Найти(РасширенноеПредставление, "(") > 0
				И ЛиТипИмеетРасширенноеПредставление(ИмяТипа)
			Тогда
				ТурбоКонф.ПоказатьПодсказку(РасширенноеПредставление);
				РасширенноеПредставление = СтрЗаменить(РасширенноеПредставление, ИмяТипа + ": ", ": ");
				Заголовок = ПредставлениеСОграничениемДлиныЛкс(БазовоеВыражение, 40);
				ПоказатьВсплывающееУведомление(Заголовок + " = " + Символы.ПС + РасширенноеПредставление, 4000);
			КонецЕсли;
		КонецЕсли;
		ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ИначеЕсли Истина
		И Не СтрНачинаетсяС(БазовоеВыражение, ТекстВызова) 
		И ЗначениеВыражения <> Неопределено
		И ЗначениеВыражения.ТипЗначения = "Строка"
		И СтрДлина(ЗначениеВыражения.Значение) > ПорогДлиныТекста
	Тогда
		Заголовок = ПредставлениеСОграничениемДлиныЛкс(БазовоеВыражение, 40);
		РасширенноеПредставление = "" + СтрДлина(ЗначениеВыражения.Значение) + " символов";
		ТурбоКонф.ПоказатьПодсказку(РасширенноеПредставление);
		ПоказатьВсплывающееУведомление(Заголовок + " = " + Символы.ПС + РасширенноеПредставление, 4000);
	КонецЕсли;
	Если ЗначениеЗаполнено(БазовоеВыражение) Тогда
		УстановитьЗначениеПолюВвода(БазовоеВыражение);
		УстановитьФокусВПервуюТаблицуИлиСписок();
		ТурбоКонф.Клавиша(Клавиши.Add);
		ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
		ТурбоКонф.Клавиша(Клавиши.End)
	КонецЕсли; 
	// Если на выходе иногда все же будет подвисание Турбоконфа, то попробовать включить ожидание вычисления https://turboconf.ru/Tasks/10496
	//ЖдатьВычислениеВыражения();
КонецПроцедуры

Функция ЗначениеВыраженияОкнаВыражение(Знач ТекстПоля, Знач ПорогДлиныТекста = 0, Знач ЛиКорневое = Ложь) Экспорт
	ЗначениеВыражения = Новый Структура("Выражение, Значение, ТипЗначения");
	ТурбоКонф.Ждать(100);
	Если Не УстановитьФокусВПервуюТаблицуИлиСписок() Тогда
		ВызватьИсключение "Не удалось активировать поле результата вычисления";
	КонецЕсли;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка(Не ЛиКорневое);
		Если Ложь
			Или ВидимыеЭлементы = Неопределено
			Или ВидимыеЭлементы.ИменаЭлементов.Количество() > 0
			Или ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала > 100 // Длительность ожидания
		Тогда
			Прервать;
		КонецЕсли;
		ТурбоКонф.Ждать(20);
	КонецЦикла;
	Если Истина
		И ВидимыеЭлементы <> Неопределено
		И ВидимыеЭлементы.ИменаЭлементов.Количество() > 0
	Тогда     
		Если ЛиКорневое Тогда
			ЯчейкиТекущейСтроки = ВидимыеЭлементы.ИменаЭлементов; 
		Иначе
			ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаИзВидимыхЭлементов(ВидимыеЭлементы, 3);
		КонецЕсли;
		ЗначениеВыражения.ТипЗначения = СтрокаБезПоследнегоФрагментаЛкс(ЯчейкиТекущейСтроки[2], " ");
		ЗначениеВыражения.Выражение = СтрокаБезПоследнегоФрагментаЛкс(ЯчейкиТекущейСтроки[0], " ");
		ЗначениеВыражения.Значение = СтрокаБезПоследнегоФрагментаЛкс(ЯчейкиТекущейСтроки[1], " ");
		Если Ложь
			Или ЗначениеВыражения.ТипЗначения = "Строка" 
			Или ЗначениеВыражения.ТипЗначения = "String" 
		Тогда
			ЗначениеВыражения.Значение = ТекстБезКрайнихСимволовЛкс(ЗначениеВыражения.Значение);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеВыражения.Выражение <> Неопределено Тогда
		//Сообщить("ТипЗначенияПервичный=" + ЗначениеВыражения.ТипЗначения);
		//Сообщить("ТекстЯчейкиЗначение=" + ПредставлениеСОграничениемДлиныЛкс(ЗначениеВыражения.Значение));
		//Сообщить("ТекстЯчейкиВыражения=" + ЗначениеВыражения.Выражение);
		Если Истина
			И ЛиКорневое
			И ЯчейкиТекущейСтроки[0] <> ТекстПоля + " Свойство" 
		Тогда
			ЗначениеВыражения.ТипЗначения = "";
		КонецЕсли;
		Если Ложь
			Или Найти(ЗначениеВыражения.Выражение, Символы.ПС) > 0
			Или ЛиПримитивныйТип(ЗначениеВыражения.ТипЗначения) И СтрДлина(ЗначениеВыражения.Значение) < ПорогДлиныТекста
		Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеВыражения;
КонецФункции

Функция ЛиПримитивныйТип(ТипЗначения) Экспорт
	Результат = Ложь
		Или ТипЗначения = "Строка"
		Или ТипЗначения = "String"
		Или ТипЗначения = "Число"
		Или ТипЗначения = "Number"
		Или ТипЗначения = "Булево"
		Или ТипЗначения = "Boolean"
		Или ТипЗначения = "Дата"
		Или ТипЗначения = "Date"
		Или ТипЗначения = "Неопределено"
		Или ТипЗначения = "Undefined";
	Возврат Результат;
КонецФункции

// Результат - Строка - длинна не более ПорогДлины
Функция ПредставлениеСОграничениемДлиныЛкс(Знач Значение, Знач ПорогДлины = 100, МаркерОтрезки = "…") Экспорт
	Если СтрДлина(Значение) > ПорогДлины Тогда
		Значение = Лев(Значение, ПорогДлины - СтрДлина(МаркерОтрезки)) + МаркерОтрезки;
	КонецЕсли;
	Возврат Значение;
КонецФункции    

Функция ТекстБезКрайнихСимволовЛкс(Знач ТекущиеАргументы) Экспорт
	Возврат Сред(ТекущиеАргументы, 2, СтрДлина(ТекущиеАргументы) - 2);
КонецФункции 

// Получает подстроку заключенную между первым вхождением начального маркера и первым вхождением 
// в правой части конечного маркера. Сами маркеры не включаются в результат. Опционально - если
// маркер не найден, то границей считается граница строки.
//
// Параметры:
//  Текст           - Строка - в которой ищем;
//  НачальныйМаркер  - Строка, *Неопределено - начальный маркер подстроки;
//  КонечныйМаркер   - Строка, *Неопределено - конечный маркер подстроки;
//  БратьГраницуЕслиНачальныйМаркерНеНайден - Булево, *Истина - разрешение использования границ строки в случае, если маркер не найден;
//  ВключатьМаркеры - Булево, *Ложь - включение маркеров в результат
//  ВыброситьИсключениеЕслиНеНайдено - Булево -
//  БратьГраницуЕслиКонечныйМаркерНеНайден - Булево, Неопределено - по умолчанию совпадает с БратьГраницуЕслиНачальныйМаркерНеНайден 
//
// Возвращаемое значение:
//  Неопределено - обязательные условия не выполнены;
//  Строка - найденная подстрока.
//
Функция ТекстМеждуМаркерамиЛкс(Текст, НачальныйМаркер = Неопределено, КонечныйМаркер = Неопределено, БратьГраницуЕслиНачальныйМаркерНеНайден = Истина, ВключатьМаркеры = Ложь,
	ВыброситьИсключениеЕслиНеНайдено = Ложь, Знач БратьГраницуЕслиКонечныйМаркерНеНайден = Неопределено) Экспорт

	ПозицияНачальногоМаркера = Найти(Текст, НачальныйМаркер);
	Если Истина
		И ПозицияНачальногоМаркера = 0
		И БратьГраницуЕслиНачальныйМаркерНеНайден = Ложь
	Тогда
		Если ВыброситьИсключениеЕслиНеНайдено Тогда
			ВызватьИсключение "Не найдено вхождение начального маркера";
		Иначе
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли;
	Если Ложь
		ИЛИ НачальныйМаркер = Неопределено
		ИЛИ ПозицияНачальногоМаркера = 0 
	Тогда
		ПозицияНачальногоМаркера = - СтрДлина(НачальныйМаркер);
	КонецЕсли;
	Стр = Сред(Текст, ПозицияНачальногоМаркера + СтрДлина(НачальныйМаркер));
	ПозицияКонечногоМаркера = Найти(Стр, КонечныйМаркер);
	Если БратьГраницуЕслиКонечныйМаркерНеНайден = Неопределено Тогда
		БратьГраницуЕслиКонечныйМаркерНеНайден = БратьГраницуЕслиНачальныйМаркерНеНайден;
	КонецЕсли;
	Если Истина
		И ПозицияКонечногоМаркера = 0
		И БратьГраницуЕслиКонечныйМаркерНеНайден = Ложь
	Тогда
		Если ВыброситьИсключениеЕслиНеНайдено Тогда
			ВызватьИсключение "Не найдено вхождение конечного маркера";
		Иначе
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли;
	Если Ложь
		ИЛИ КонечныйМаркер = Неопределено
		ИЛИ ПозицияКонечногоМаркера = 0 
	Тогда
		ПозицияКонечногоМаркера = СтрДлина(Стр) + 1;
	КонецЕсли;
	Результат = Лев(Стр, ПозицияКонечногоМаркера - 1);
	Если ВключатьМаркеры Тогда
		Если НачальныйМаркер <> Неопределено Тогда
			Результат = НачальныйМаркер + Результат;
		КонецЕсли; 
		Если КонечныйМаркер <> Неопределено Тогда
			Результат = Результат + КонечныйМаркер;
		КонецЕсли; 
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

//.
// Параметры:
//   ПолеТекстаПрограммы - ОбработкаОбъект.ирКлсПолеТекстаПрограммы - 
//   ИмяФункцииМодуля - Строка - 
// Возвращаемое значение:
//   Массив - 
Функция ТекстВызоваФункцииРежимаОтладки(Знач ПолеТекстаПрограммы, Знач ИмяФункцииМодуля) Экспорт
	ТекстВызова = СтрРазделить(ПолеТекстаПрограммы.ВычисляемыйКонтекстОтладчика(), "*")[0] + ИмяФункцииМодуля;
	Возврат ТекстВызова;
КонецФункции

//.
// Параметры:
//   ТекстЯчейкиТипЗначения - Строка - 
// Возвращаемое значение:
//    - 
Функция ЛиТипИмеетРасширенноеПредставление(Знач ТипЗначения) Экспорт
	Результат = Истина
		И Не ЛиПримитивныйТип(ТипЗначения)
		И ТипЗначения <> "Структура"
		И ТипЗначения <> "Structure"
		И ТипЗначения <> "ДанныеФормыСтруктура"
		И ТипЗначения <> "СтрокаТаблицыЗначений"
		И ТипЗначения <> "СтрокаДереваЗначений"
		И ТипЗначения <> "ДанныеФормыЭлементКоллекции";
	Возврат Результат;
КонецФункции

// 6.3.9130.13871
Функция ПолучитьВидимыеЭлементыСписка(Знач РасширеннаяИнформация = Ложь) Экспорт
	Если ЛиТаблицаПуста() Тогда
		// Антибаг против пустой таблицы https://turboconf.ru/Tasks/10009
		Возврат Новый Структура("ИменаЭлементов, ГраницыЭлементов, ИндексТекущегоЭлемента", Новый Массив, Новый Массив);
	КонецЕсли;
	Попытка
		ВидимыеЭлементы = ТурбоКонф.ПолучитьВидимыеЭлементыСписка(РасширеннаяИнформация);
	Исключение
		ВидимыеЭлементы = Неопределено;
	КонецПопытки;
	Возврат ВидимыеЭлементы;
КонецФункции

Функция ЛиТаблицаПуста() Экспорт
	ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
	Возврат Ложь
		Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Таблица
		Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Список;
КонецФункции

Процедура ВычислитьОписатьПараметрыМетода()
	Если Не ЛиДоступенВводВыражения() Тогда
		ПоказатьВсплывающееУведомление("Недоступно во вложенном окне из-за недоступности ввода выражения");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ПерейтиКТекущейСтрокеИсполнения();
	ПолеТекстаПрограммы = Неопределено;
	ОткрытьОкноВыражения(ПолеТекстаПрограммы);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ДокПар");
	ИменаПараметров = ПолеТекстаПрограммы.СтрокаИменПараметровМетода();
	Выражение = "Вычислить(" + ТекстВызова + "(""" + ИменаПараметров + """))";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ЖдатьВычислениеВыражения();
	РедактироватьТекст("ВстроенныйЯзык");
КонецПроцедуры

Процедура ВычислитьСоздатьКонструкторОбъекта()
	Если Не ЛиДоступенВводВыражения() Тогда
		ПоказатьВсплывающееУведомление("Недоступно во вложенном окне из-за недоступности ввода выражения");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	ЗакрытьМодальноеОкно();
	ПерейтиКТекущейСтрокеИсполнения();
	ПолеТекстаПрограммы = Неопределено;
	ОткрытьОкноВыражения(ПолеТекстаПрограммы);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяКонструктора = ИдентификаторИзПредставленияЛкс(СтруктураВыражения.Выражение) + "Образец";
	МодулиИР = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ОбъектВСтрокуЖСОНЛкс");
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Выражение + ")";
	ТекстыЯчеек = ВычислитьЗначениеВыраженияОтладчика(Выражение);
	Если ЗначениеЗаполнено(ТекстыЯчеек[2]) Тогда
		ОбразецСтрока = ТекстБезКрайнихСимволовЛкс(ТекстыЯчеек[1]);
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	Иначе
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
		ПоказатьВсплывающееУведомление("Ошибка сериализации объекта");
		Возврат;
	КонецЕсли;
	ОпределениеКонструктора = СтрШаблон("Функция %1() Экспорт
	|	Возврат ПрочитатьJSON(%2);
	|КонецФункции
	|", ИмяКонструктора, МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(ОбразецСтрока));
	ОткрытьРедакторТекста(ОпределениеКонструктора,, "ВстроенныйЯзык");
КонецПроцедуры

Процедура ПерейтиКТекущейСтрокеИсполнения() Экспорт
	Если Не КликнутьПоЭлементу("Текущая строка", "кнопка") Тогда
		ТурбоКонф.ОткрытьМеню("Отладка", "Текущая строка");
	КонецЕсли;
КонецПроцедуры

Функция ОстановитьИсполнение() Экспорт
	Если Не КликнутьПоЭлементу("Остановить", "кнопка") Тогда
		//ТурбоКонф.ОткрытьМеню("Отладка", "Остановить");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПродолжитьОтладкуИсполнения() Экспорт
	Если Не КликнутьПоЭлементу("Продолжить отладку", "кнопка") Тогда
		//ТурбоКонф.ОткрытьМеню("Отладка", "Продолжить отладку");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура ПереключитьЗамерПроизводительностиИсполнения() Экспорт
	Если Не КликнутьПоЭлементу("Замер производительности", "кнопка") Тогда
		ТурбоКонф.ОткрытьМеню("Отладка", "Замер производительности");
	КонецЕсли;
КонецПроцедуры

//.
// Параметры:
//   ЯчейкиТекущейСтроки -  - 
//   ИмяФайлаТабличногоДокумента - Строка - имя временного файла табличного документа, он будет удален
// Возвращаемое значение:
//   Булево - пользователь выбрал элемент
Функция НайтиВСписке(Знач ЯчейкиТекущейСтроки = Неопределено, Знач ИмяФайлаТабличногоДокумента = "")
	ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
	Сообщить("ТипПоляОкна = " + ТипЭлементаИнтерфейса);
	Если Истина
		И ЗначениеЗаполнено(ТипЭлементаИнтерфейса) 
		И ТипЭлементаИнтерфейса <> ПеречТипЭлемента.Неизвестный // ячейка таблицы
		И ТипЭлементаИнтерфейса <> ПеречТипЭлемента.ЭлементСписка
		И ТипТекущегоЭлементаИнтерфейса() <> ПеречТипЭлемента.Флажок
	Тогда
		ПоказатьВсплывающееУведомление("Команда доступна только для списков");
		Возврат Ложь;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	КонтекстИнтерфейса = КонтекстИнтерфейса();
	Заголовок = КонтекстИнтерфейса.Заголовок;
	Если Заголовок = "Командный интерфейс" Тогда
		// Слишком много колонок
		Возврат Ложь;
	КонецЕсли;
	ЛиТаблица = КонтекстИнтерфейса.ЛиТаблица;
	ЧислоКолонок = КонтекстИнтерфейса.ЧислоКолонок;
	Иерархический = КонтекстИнтерфейса.Иерархический;
	ПоддерживаетПоиск = КонтекстИнтерфейса.ПоддерживаетПоиск;
	ИндексКлючевойКолонки = КонтекстИнтерфейса.ИндексКлючевойКолонки;
	ИмяКлючевойКолонки = КонтекстИнтерфейса.ИмяКлючевойКолонки;
	Если ЯчейкиТекущейСтроки = Неопределено Тогда
		Если Не ЛиТаблица Или Иерархический Тогда
			Попытка
				ВидимыеЯчейкиТекущейСтраницы = ТурбоКонф.ПолучитьВидимыеЭлементыСписка(Истина); // 6.3.9130.1387 Тяжелый вызов для таблицы. Повышает надежность определения текущей строки. 
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ВидимыеЯчейкиТекущейСтраницы = Неопределено Тогда
			ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаПутемПеремещения(Иерархический);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяФайлаТабличногоДокумента) Тогда
		ТекстыЯчеек = Новый Массив;
	//ИначеЕсли КликнутьПоЭлементу("Вывести список...", "кнопка") Тогда
	//	ТурбоКонф.ЖдатьОкно("Вывести список", 1000, Истина);
	//	УстановитьФокусВПервуюТаблицуИлиСписок();
	//	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	//	ТурбоКонф.КонтролКлавиша(Клавиши.S); 
	//	ИмяФайлаТабличногоДокумента = ПолучитьИмяВременногоФайла(".mxl");
	//	УстановитьИмяФайлаВДиалогеВыбораФайла(ИмяФайлаТабличногоДокумента, "Сохран");
	Иначе
		ТурбоКонф.Клавиша(Клавиши.Home);
		МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			ВидимыеЯчейки = ТурбоКонф.ПолучитьВидимыеЭлементыСписка(Истина); // 6.3.9130.1387
		Исключение
			ВидимыеЯчейки = Неопределено;
		КонецПопытки;
		
		Если ВидимыеЯчейки = Неопределено Тогда
			// Старый вариант
			ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка();
			Если ТекстыЯчеек.Количество() = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
			Сообщить("ПолучитьЭлементыСписка - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
			Если ЧислоКолонок = Неопределено Тогда
				МаксЧислоКолонок = 25;
				Для ЧислоКолонок = 2 По МаксЧислоКолонок Цикл 
					УспешноеЧислоКолонок = ЧислоКолонок;
					Для ИндексЯчейки = 0 По Мин(МаксЧислоКолонок*2, ТекстыЯчеек.ВГраница() - ЧислоКолонок) Цикл
						ЗаголовокПервойСтроки = МодулиИР.ирОбщий.ПоследнийФрагментЛкс(ТекстыЯчеек[0*ЧислоКолонок + ИндексЯчейки], " ", Ложь);
						ЗаголовокВторойСтроки = МодулиИР.ирОбщий.ПоследнийФрагментЛкс(ТекстыЯчеек[1*ЧислоКолонок + ИндексЯчейки], " ", Ложь);
						Если ЗаголовокПервойСтроки <> ЗаголовокВторойСтроки Тогда
							УспешноеЧислоКолонок = Неопределено;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если УспешноеЧислоКолонок <> Неопределено Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;   
				Если УспешноеЧислоКолонок <> Неопределено Тогда
					ЧислоКолонок = УспешноеЧислоКолонок;
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Новый вариант
			ГраницыЭлементов = ВидимыеЯчейки.ГраницыЭлементов;
			Сообщить("ПолучитьВидимыеЭлементыСписка - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
			Если ЧислоКолонок = Неопределено Тогда
				ЛеваяГраницаСписка = Неопределено;
				Для ИндексЯчейки = 0 По ВидимыеЯчейки.ИменаЭлементов.ВГраница() Цикл
					ЛеваяГраницаЯчейки = ГраницыЭлементов[ИндексЯчейки*4 + 0]; // Может быть 0 в любой позиции!
					Если ЛеваяГраницаСписка = Неопределено Тогда
						ЛеваяГраницаСписка = ЛеваяГраницаЯчейки; 
						ЗаголовокПервойКолонки = МодулиИР.ирОбщий.ПоследнийФрагментЛкс(ВидимыеЯчейки.ИменаЭлементов[ИндексЯчейки], " ", Ложь);
					Иначе
						Если Истина
							И ЗаголовокПервойКолонки = МодулиИР.ирОбщий.ПоследнийФрагментЛкс(ВидимыеЯчейки.ИменаЭлементов[ИндексЯчейки], " ", Ложь)
							И ЛеваяГраницаЯчейки = ЛеваяГраницаСписка 
						Тогда
							ЧислоКолонок = ИндексЯчейки;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если ЧислоКолонок = Неопределено Тогда
					ВызватьИсключение "Не удалось определить число колонок таблицы";
				КонецЕсли;
			КонецЕсли;
			Если ВидимыеЯчейкиТекущейСтраницы <> Неопределено Тогда
				ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаИзВидимыхЭлементов(ВидимыеЯчейкиТекущейСтраницы, ЧислоКолонок);
			КонецЕсли;

			// Сканирование списка листанием
			// работает корректно везде при выполнении всех условий:
			// - нет колонок с динамическим (зависящим от текущей строки) заголовком
			// - нет неудобно расположенных полных дублей строк
			ТекстыЯчеек = ВидимыеЯчейки.ИменаЭлементов;
			ЧислоВидимыхСтрок = ВидимыеЯчейки.ИменаЭлементов.Количество() / ЧислоКолонок;
			Если Цел(ЧислоВидимыхСтрок) <> ЧислоВидимыхСтрок Тогда
				// https://turboconf.ru/Tasks/10020
				ПоказатьВсплывающееУведомление("Турбоконф вернул некорректный список видимых ячеек");
				Возврат Ложь;
			КонецЕсли;
			ТурбоКонф.Клавиша(Клавиши.PageDown);
			//СтарыйИД = ИдентификаторТекущегоЭлементаОкна(); 
			ЧислоСтрокПересеченияСтраниц = 1000;
			Пока Истина Цикл
				ТурбоКонф.Клавиша(Клавиши.PageDown); 
				ВидимыеЯчейки = ПолучитьВидимыеЭлементыСписка();
				ИндексВидимойСтроки = 0;
				Для ОбратныйИндексСтроки = 0 По ЧислоВидимыхСтрок - 1 Цикл
					НомерСтрокиСписка = ТекстыЯчеек.Количество() / ЧислоКолонок - 1 - ОбратныйИндексСтроки;
					ЯчейкиСтрокРавны = Истина;
					Для ИндексКолонки = 0 По ЧислоКолонок - 1 Цикл
						Если ВидимыеЯчейки.ИменаЭлементов[ИндексВидимойСтроки*ЧислоКолонок+ИндексКолонки] <> ТекстыЯчеек[НомерСтрокиСписка*ЧислоКолонок+ИндексКолонки] Тогда
							ЯчейкиСтрокРавны = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ЯчейкиСтрокРавны Тогда
						Для Сч=0 По (ОбратныйИндексСтроки+1)*ЧислоКолонок-1 Цикл
							ВидимыеЯчейки.ИменаЭлементов.Удалить(0);
						КонецЦикла;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				ДополнитьМассивЛкс(ТекстыЯчеек, ВидимыеЯчейки.ИменаЭлементов);
				//Если СтарыйИД <> ИдентификаторТекущегоЭлементаОкна() Тогда
				//	// Некорректно для переменного числа строк на странице (автовысота строки)
				//	Возврат Ложь;
				//КонецЕсли;
				Если Ложь
					Или ВидимыеЯчейки.ИменаЭлементов.Количество() = 0 
					//Или ОбратныйИндексСтроки > ЧислоСтрокПересеченияСтраниц // Оптимизация чтобы не вызывать повторно получение последней страницы
				Тогда
					Прервать;
				КонецЕсли;
				ЧислоСтрокПересеченияСтраниц = ОбратныйИндексСтроки;
			КонецЦикла;
			
			ТурбоКонф.Клавиша(Клавиши.Home);
		КонецЕсли;
	КонецЕсли;
	
	Сообщить("ЧислоКолонок="+ЧислоКолонок);  
	Если ЛиАктивноГлавноеОкно() Тогда
		МаркерСсылкиНаКонфигурацию = "Основная конфигурация ";
		МаркерСсылкиНаРасширение = "Расширение конфигурации ";
		Если Истина
			И ЧислоКолонок = 2
			И (Ложь
				Или СтрНачинаетсяС(ТекстыЯчеек[0], МаркерСсылкиНаКонфигурацию)
				Или СтрНачинаетсяС(ТекстыЯчеек[0], МаркерСсылкиНаРасширение))
		Тогда
			Заголовок = "Результаты поиска";
			ПоддерживаетПоиск = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Ищем номер строки
	ИндексЯчейкиВГруппе = 0;
	ГрязныйТекстТекущейЯчейки = "";
	НомерСтрокиСписка = Неопределено;
	Если ЯчейкиТекущейСтроки.Количество() Тогда
		ТекстИскомойЯчейки = ЯчейкиТекущейСтроки[0];
		НачальныйИндексЯчейки = ТекстыЯчеек.Найти(ТекстИскомойЯчейки);
		Если НачальныйИндексЯчейки <> Неопределено Тогда
			Для ИндексЯчейки = НачальныйИндексЯчейки По ТекстыЯчеек.ВГраница() Цикл
				Если ТекстИскомойЯчейки <> ТекстыЯчеек[ИндексЯчейки] Тогда
					Продолжить;
				КонецЕсли;
				ИндексЯчейкиВГруппе = ИндексЯчейкиВГруппе + 1;
				Если ИндексЯчейкиВГруппе = ЯчейкиТекущейСтроки.Количество() Тогда
					Если ЗначениеЗаполнено(ЧислоКолонок) Тогда
						НомерСтрокиСписка = Цел(ИндексЯчейки / ЧислоКолонок);
					КонецЕсли;
					Прервать;
				КонецЕсли;
				ТекстИскомойЯчейки = ЯчейкиТекущейСтроки[ИндексЯчейкиВГруппе];
			КонецЦикла;
		КонецЕсли;
		Сообщить("НомерСтрокиСписка="+НомерСтрокиСписка);
		
		// Ищем ключевую колонку
		ГрязныйТекстТекущейЯчейки = ЯчейкиТекущейСтроки[0];
		Если НомерСтрокиСписка <> Неопределено И ИндексКлючевойКолонки = 0 Тогда
			Для ИндексКолонки = 0 По ЧислоКолонок Цикл
				ТекстЯчейки = ТекстыЯчеек[НомерСтрокиСписка*ЧислоКолонок + ИндексКолонки];
				Если Истина
					И (Ложь
						Или НомерСтрокиСписка = 0
						Или ТекстЯчейки <> ТекстыЯчеек[(НомерСтрокиСписка-1)*ЧислоКолонок + ИндексКолонки])
					И (Ложь
						Или НомерСтрокиСписка = (ТекстыЯчеек.Количество() / ЧислоКолонок - 1)
						Или ТекстЯчейки <> ТекстыЯчеек[(НомерСтрокиСписка+1)*ЧислоКолонок + ИндексКолонки])
				Тогда 
					ИндексКлючевойКолонки = ИндексКолонки;
					ГрязныйТекстТекущейЯчейки = ТекстЯчейки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Сообщить("ИндексКлючевойКолонки="+ИндексКлючевойКолонки);
	Сообщить("ТекстКлючевойЯчейки="+ГрязныйТекстТекущейЯчейки);
	
	Если Истина
		И НомерСтрокиСписка <> Неопределено 
		И (Ложь 
			Или Не ПоддерживаетПоиск
			Или НомерСтрокиСписка < МаксНомерСтрокиДляТочногоПозиционирования())
	Тогда
		НажатьКлавишуЦикл(Клавиши.Down, НомерСтрокиСписка);
	ИначеЕсли ПоддерживаетПоиск Тогда
		НайтиСтрокуВОкне(ЧистыйТекстЯчейки(ГрязныйТекстТекущейЯчейки, ЛиТаблица));
	КонецЕсли;
	КлючВыбраннойСтроки = ВыбратьЭлементСписка(ТекстыЯчеек, ГрязныйТекстТекущейЯчейки,, ЛиТаблица, Заголовок, ЧислоКолонок, НомерСтрокиСписка, ИмяФайлаТабличногоДокумента);
	Если ЗначениеЗаполнено(ИмяФайлаТабличногоДокумента) Тогда
		УдалитьФайлы(ИмяФайлаТабличногоДокумента);
	КонецЕсли;
	Если КлючВыбраннойСтроки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Истина
		И ТипЗнч(КлючВыбраннойСтроки) = Тип("Число") 
		И ТекстыЯчеек.Количество() > 0
	Тогда
		Если Ложь
			Или Не ПоддерживаетПоиск
			//Или Иерархический 
			Или (Истина
				И ЗначениеЗаполнено(ЧислоКолонок)
				И ЧислоКолонок > 1 
				И КлючВыбраннойСтроки < МаксНомерСтрокиДляТочногоПозиционирования())
		Тогда
			ТурбоКонф.Клавиша(Клавиши.Home);
			НажатьКлавишуЦикл(Клавиши.Down, КлючВыбраннойСтроки);
		Иначе
			ГрязныйТекстТекущейЯчейки = ТекстыЯчеек[ЧислоКолонок*КлючВыбраннойСтроки + ИндексКлючевойКолонки];
			НайтиСтрокуВОкне(ЧистыйТекстЯчейки(ГрязныйТекстТекущейЯчейки, ЛиТаблица), Истина);
		КонецЕсли;
	Иначе
		НайтиСтрокуВОкне(КлючВыбраннойСтроки, Истина);
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Функция КонтекстИнтерфейса() Экспорт
	Заголовок = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если ЛиАктивноГлавноеОкно() Тогда
		Заголовок = Неопределено;
	КонецЕсли;
	ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
	//Сообщить("ТипЭлементаИнтерфейса=" + ТипЭлементаИнтерфейса);
	//Сообщить("ПолучитьНазваниеТипаТекущегоЭлемента()=" + ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента());
	ЛиТаблица = Истина
		И ТипЭлементаИнтерфейса <> ПеречТипЭлемента.ЭлементСписка
		И НЕ (Истина
			// Окна выбора сохраняемых реквизитов обычной формы
			И (Ложь
				Или Заголовок = "Выбор объекта" // Есть 2 таких окна - для объектов метаданных и для реквизитов обычной формы
				Или Заголовок = "Настройка редактирования"
				Или Заголовок = "Настройка просмотра")
			И ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Флажок
			);
	ИндексКлючевойКолонки = 0;
	Иерархический = Ложь;
	ПоддерживаетПоиск = ЗначениеЗаполнено(Заголовок); // Списки встроенные в главное окно часто многие не поддерживают, например в панели "Дополнительно"
	Если Не ЛиТаблица Тогда
		ЧислоКолонок = 1;
		Если СтрНачинаетсяС(Заголовок, "Выбор объекта") Тогда
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.M);
			ПоддерживаетПоиск = ТипТекущегоЭлементаИнтерфейса() <> ПеречТипЭлемента.Поле;
		ИначеЕсли СтрНачинаетсяС(Заголовок, "Выбор объектов") Тогда
			ПоддерживаетПоиск = Ложь;
		ИначеЕсли Заголовок = "Выбор реквизита" Тогда
			Иерархический = Истина;
		ИначеЕсли Заголовок = "Редактирование типа данных" Тогда
			Иерархический = Истина;
		ИначеЕсли Ложь
			Или Заголовок = "Отбор по подсистемам" 
			Или Заголовок = "Подсистемы" // из общей картинки
		Тогда
			Иерархический = Истина; 
			Если ТурбоКонф.НайтиОкноПоЗаголовку("Выбор объектов") > 0 Тогда
				// https://www.hostedredmine.com/issues/999422
				ПоддерживаетПоиск = Ложь; 
			КонецЕсли;
		ИначеЕсли Заголовок = "Выбор типа данных" Тогда
		КонецЕсли;
	Иначе
		ЧислоКолонок = Неопределено;
		Если Заголовок = "Закладки" Тогда
			ЧислоКолонок = 4;
			ПоддерживаетПоиск = Ложь;
		ИначеЕсли Заголовок = "Точки останова" Тогда
			ЧислоКолонок = 5;
			ПоддерживаетПоиск = Ложь;
		ИначеЕсли Заголовок = "Настройка условного оформления" Тогда
			ЧислоКолонок = 10;
		ИначеЕсли Заголовок = "Список выбора" Тогда
			ЧислоКолонок = 2;
		ИначеЕсли Заголовок = "Выражение" Тогда
			ЧислоКолонок = 3;
			Иерархический = Истина;
			ИмяКлючевойКолонки = "Свойство";
		ИначеЕсли Заголовок = "Предметы отладки" Тогда
			ЧислоКолонок = 5;
			ПоддерживаетПоиск = Ложь; // Нет уникальный колонок
		ИначеЕсли Заголовок = "Список элементов управления формы" Тогда
			ЧислоКолонок = 2;
			Иерархический = Истина;
		ИначеЕсли Заголовок = "Размещение данных" Тогда
			ЧислоКолонок = 2;
			Иерархический = Истина;
		ИначеЕсли Заголовок = "Редактирование параметров выбора" Тогда
			ЧислоКолонок = 2;
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("ЛиТаблица", ЛиТаблица);
	Результат.Вставить("ЧислоКолонок", ЧислоКолонок);
	Результат.Вставить("Иерархический", Иерархический);
	Результат.Вставить("ПоддерживаетПоиск", ПоддерживаетПоиск);
	Результат.Вставить("ИндексКлючевойКолонки", ИндексКлючевойКолонки);
	Результат.Вставить("ИмяКлючевойКолонки", ИмяКлючевойКолонки);
	Возврат Результат;
КонецФункции

Функция ЯчейкиТекущейСтрокиСпискаИзВидимыхЭлементов(Знач ВидимыеЭлементыСписка, Знач ЧислоКолонок) Экспорт
	Если Истина
		И ВидимыеЭлементыСписка.ИменаЭлементов.Количество() > 0 
		И ВидимыеЭлементыСписка.ГраницыЭлементов.Количество() = 0 
	Тогда
		ВызватьИсключение "Видимые элементы списка получены без флага РасширеннаяИнформация";
	КонецЕсли;
	ЯчейкиТекущейСтроки = Новый Массив; 
	ИндексТекущегоЭлемента = ВидимыеЭлементыСписка.ИндексТекущегоЭлемента;
	Если ИндексТекущегоЭлемента <> Неопределено Тогда
		ИндексПервойЯчейкиСтроки = Цел(ИндексТекущегоЭлемента/ЧислоКолонок)*ЧислоКолонок;
		Для ИндексЯчейки = ИндексПервойЯчейкиСтроки По ИндексПервойЯчейкиСтроки + ЧислоКолонок-1 Цикл
			ЯчейкиТекущейСтроки.Добавить(ВидимыеЭлементыСписка.ИменаЭлементов[ИндексЯчейки]);
		КонецЦикла;
	КонецЕсли;
	Возврат ЯчейкиТекущейСтроки;
КонецФункции

Функция ЛиАктивноГлавноеОкно(Знач ЗаголовокОкна = "")
	Если ПустаяСтрока(ЗаголовокОкна) Тогда
		ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	КонецЕсли;
	//Сообщить("ЗаголовокОкна=" + ЗаголовокОкна);
	Возврат Найти(ЗаголовокОкна, "Конфигуратор - ") > 0;
	//Возврат Истина // Так работает некорректно
	//	И Конфигуратор <> Неопределено
	//	И ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно;
КонецФункции

Функция ЧистыйТекстЯчейки(Знач ГрязныйТекстТекущейЯчейки, Знач ЛиТаблица) Экспорт
	Если ЛиТаблица Тогда
		ЧистыйТекстЯчейки = СтрокаБезПоследнегоФрагментаЛкс(ГрязныйТекстТекущейЯчейки, " ");
	Иначе
		ЧистыйТекстЯчейки = ГрязныйТекстТекущейЯчейки;
	КонецЕсли;
	Возврат ЧистыйТекстЯчейки;
КонецФункции

// Дополняет массив МассивПриемник значениями из массива МассивИсточник.
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения.
//  МассивИсточник - Массив - массив значений для заполнения.
//
Процедура ДополнитьМассивЛкс(МассивПриемник, МассивИсточник) Экспорт
	Для Каждого Значение Из МассивИсточник Цикл
		МассивПриемник.Добавить(Значение);
	КонецЦикла;
КонецПроцедуры

//.
// Возвращаемое значение:
//   Массив - 
Функция ЯчейкиТекущейСтрокиСпискаПутемПеремещения(Знач Иерархический = Ложь) Экспорт
	Если Не Иерархический Тогда
		НажатьКлавишуЦикл(Клавиши.Right, 5);
	КонецЕсли;
	ЯчейкиТекущейСтроки = Новый Массив;
	СтарыйИД = Неопределено;
	Для НомерКолонкиТекста = 1 По ?(Иерархический, 1, 10) Цикл
		НовыйИД = ИдентификаторТекущегоЭлементаОкна();
		Если СтарыйИД = НовыйИД Тогда
			Прервать;
		КонецЕсли;
		СтарыйИД = НовыйИД;
		ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
		Если ТекстЯчейки = "" И НомерКолонкиТекста = 1 Тогда
			// окно "Точки останова" - странная колонка в крайней правой позиции
		Иначе
			ЯчейкиТекущейСтроки.Вставить(0, ТекстЯчейки);
		КонецЕсли;
		ТурбоКонф.Клавиша(Клавиши.Left);
	КонецЦикла;
	Сообщить("ЧислоПозиционируемыхЯчеекВСтроке="+ЯчейкиТекущейСтроки.Количество());
	Возврат ЯчейкиТекущейСтроки;
КонецФункции

Функция МаксНомерСтрокиДляТочногоПозиционирования() Экспорт
	Возврат 100;
КонецФункции

// Слишком долгий и не надежный способ.
// Работает только если актива колонка с уникальными значениями.
Функция НомерСтрокиСписка(Знач ВосстановитьПозицию = Истина) Экспорт
	НомерСтрокиСписка = 0;
	//НовыйRuntimeIdСтрокой = Неопределено;
	НовыйТекстЯчейки = Неопределено;
	Пока Истина Цикл
		НомерСтрокиСписка = НомерСтрокиСписка + 1;
		//СтарыйRuntimeIdСтрокой = НовыйRuntimeIdСтрокой;
		СтарыйТекстЯчейки = НовыйТекстЯчейки;
		ТурбоКонф.Клавиша(Клавиши.Up);
		ТурбоКонф.Ждать(10);
		//НовыйRuntimeIdСтрокой = ИдентификаторТекущегоЭлементаОкна();
		НовыйТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
		Если Истина
			//И НовыйRuntimeIdСтрокой = СтарыйRuntimeIdСтрокой // назначается по номеру в видимой области. Поэтому нельзя использовать для навигации в полном списке
			И НовыйТекстЯчейки = СтарыйТекстЯчейки
		Тогда
			Прервать;
		КонецЕсли;
		Если НомерСтрокиСписка > МаксНомерСтрокиДляТочногоПозиционирования() Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	ПоказатьВсплывающееУведомление(НомерСтрокиСписка);
	Если ВосстановитьПозицию Тогда
		НажатьКлавишуЦикл(Клавиши.Down, НомерСтрокиСписка - 1); // - Восстановим позицию
	КонецЕсли;
	Возврат НомерСтрокиСписка;
КонецФункции

//.
// Параметры:
//    ТекстыЯчеек - Массив Из Строка - 
//    ТекстТекущейЯчейки - ? - 
//    ЛиМодально - Булево - 
//    ЛиТаблица - Булево - 
//    Заголовок - Строка - 
Функция ВыбратьЭлементСписка(Знач ТекстыЯчеек, Знач ТекстТекущейЯчейки = "", Знач ЛиМодально = Истина, Знач ЛиТаблица = Ложь, Знач Заголовок = Неопределено, Знач ЧислоКолонок = Неопределено,
		Знач НомерСтрокиСписка = Неопределено, Знач ИмяФайлаТабличногоДокумента = "", Знач МожноФокусВФильтр = Истина) Экспорт
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ТекстыПолейСтрока = ОбъектВЖСОН(ТекстыЯчеек);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Если ЛиМодально Тогда
		КлючХраненияВыбора = "Конфигуратор." + Заголовок;
		БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
		//ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(".*", 5000, Конфигуратор.ГлавноеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР); // Так окно не получает фокус
		ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("(Массив|Список|Таблица|Введи|Выбор).*", 5000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР); // Если откроется окно ввода числа колонок, то псевдомодальность теряется
	Иначе  
		ВосстановитьОкноПриложения(ПодключениеИР);
		ИДЗадачи = "" + ТекущаяДата();
		ТурбоКонф.НачатьУправлениеМодальнымиОкнами(3000, , ИдентификаторПроцессаИР,, ИДЗадачи);
	КонецЕсли;
	Попытка
		КлючВыбранногоЭлемента = МодулиИР.ирКлиент.ОткрытьТаблицуИзМассиваИзСтрокиВнутрЛкс(ТекстыПолейСтрока, ТекстТекущейЯчейки, ЛиТаблица, ЛиМодально, ЧислоКолонок, Заголовок, КлючХраненияВыбора,
			НомерСтрокиСписка, ИмяФайлаТабличногоДокумента, МожноФокусВФильтр);
	Исключение
		Если ЛиМодально Тогда
			ПоказатьВсплывающееУведомление(ОписаниеОшибки());
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Если ЛиМодально Тогда
		ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Иначе
		ТурбоКонф.ЗавершитьУправлениеМодальнымиОкнами(ИДЗадачи);
	КонецЕсли;
	Возврат КлючВыбранногоЭлемента;
КонецФункции

Функция ОбъектВЖСОН(Знач Элементы)
	ЗаписьТекста = Новый ЗаписьJSON;
	ЗаписьТекста.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТекста, Элементы);
	ТекстыПолейСтрока = ЗаписьТекста.Закрыть();
	Возврат ТекстыПолейСтрока;
КонецФункции

Функция ОбъектИзЖСОН(Знач ТекстСлов)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТекстСлов);
	ТаблицаСлов = ПрочитатьJSON(Чтение); 
	Возврат ТаблицаСлов;
КонецФункции

// Неуспешая попытка сделать замену поиска в окне Дополнительно
Процедура _НайтиСтроку() 
	// Не нашел способ проверять, что фокус в окне Дополнительно 
	// Нужна более надежная проверка https://turboconf.ru/Tasks/9471
	Если ТурбоКонф.НайтиЭлементПоИмени("Общие реквизиты", "элемент вкладки") Тогда
		НайтиВСписке(); 
	Иначе
		ТурбоКонф.КонтролКлавиша(Клавиши.F);
	КонецЕсли;
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура НайтиСледующийВыделенный() 
	НайтиСледующий();
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура НайтиСледующий() 
	ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Истина;
	ЗапуститьМоноФоновоеЗадание("ПоказатьУведомленияПриПереходеПоРезультатамПоиска", 2);
КонецПроцедуры  

Процедура РедактироватьЭлемент() 
	ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Истина;
	РегВыражение = РегВыражение(ШаблонЗаголовкаОкнаКоллекции());
	ЗаголовокТекущегоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если РегВыражение.Совпадает(ЗаголовокТекущегоОкна) Тогда
		КнопкаОткрытьЭлементКоллекции();
		ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Ложь;
	ИначеЕсли ЗаголовокТекущегоОкна = "Выражение" Тогда
		СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
		ЗначениеВыражения = ЗначениеВыраженияОкнаВыражение(СтруктураВыражения.Выражение);
		Если ЗначениеВыражения = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеВыражения.ТипЗначения = "Строка" Тогда
			РедактироватьТекст(, ЗначениеВыражения.Значение, СтруктураВыражения.Выражение);
			Если ПодключениеИРИзКэша() = Неопределено Тогда
				Возврат;
			КонецЕсли;
			ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Ложь;
		Иначе
			//УстановитьФокусВПервуюТаблицуИлиСписок();
			//ЖдатьОсвобожденияПотокаВвода();
			//ТурбоКонф.Клавиша(Клавиши.F2);
			//ТурбоКонф.ПродолжитьОбработкуНажатияКлавиш = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Фоновый запуск
Процедура ПоказатьУведомленияПриПереходеПоРезультатамПоиска(КлючСостоянияФоновогоМетода) Экспорт
	ДлинаВидимойЧастиИмени = 25;
	МинЧислоСтрокОтНачалаМетода = 40;
	Попытка
		моментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		РазобратьПозициюВТексте(Ложь);
		СтараяПозицияПоиска = ВосстановитьЗначениеСеансаКонфигуратора(КлючХраненияПозицияНайденного()); // см. НоваяПозицияПоиска
		Поле = ИдентификаторТекущегоЭлементаОкна();
		Если СтараяПозицияПоиска <> Неопределено Тогда
			Если Истина
				И Поле = СтараяПозицияПоиска.Поле
				И ПозицияВТексте < СтараяПозицияПоиска.Позиция 
			Тогда
				ПоказатьВсплывающееУведомление("Поиск достиг конца документа", 2000);
			КонецЕсли;
		КонецЕсли;
		НоваяПозицияПоиска = НоваяПозицияПоиска();
		НоваяПозицияПоиска.Позиция = ПозицияВТексте;
		НоваяПозицияПоиска.Поле = Поле;
		ПодключениеИР = ПодключениеИР(, Ложь);
		Если ПодключениеИР <> Неопределено Тогда
			ИдентифицироватьДокумент = Истина; // - Иначе при переходе в другой модуль будет считать что модуль остался старый
			ПолеТекста = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь,,,,,,, ИдентифицироватьДокумент,,, Ложь, Ложь);
			Сообщить("НайтиСледующий. Разбор текста " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - моментНачала) + " мс");
			НоваяПозицияПоиска.Метод = ПолеТекста.ИмяТекущегоМетода();
			Если Истина
				И ПолеТекста.ЯзыкПрограммы = 0 
				И ПолеТекста.мНачальнаяСтрока - ПолеТекста.мНомерПервойСтрокиТелаМетода > МинЧислоСтрокОтНачалаМетода
				И СтараяПозицияПоиска.Метод <> НоваяПозицияПоиска.Метод  
				//И Лев(СтараяПозицияПоиска.Метод, ДлинаВидимойЧастиИмени) = Лев(НоваяПозицияПоиска.Метод, ДлинаВидимойЧастиИмени) 
				И СтрДлина(НоваяПозицияПоиска.Метод) > ДлинаВидимойЧастиИмени
			Тогда
				ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта() + ": метод", НоваяПозицияПоиска.Метод, 3000);
			КонецЕсли;
		КонецЕсли;
		СохранитьЗначениеСеансаКонфигуратора(КлючХраненияПозицияНайденного(), НоваяПозицияПоиска);
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Внимание);
	КонецПопытки;
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
КонецПроцедуры

//.
// Возвращаемое значение:
//   Структура - 
Функция НоваяПозицияПоиска() Экспорт
	НоваяПозицияПоиска = Новый Структура("Позиция, Поле, Метод");
	Возврат НоваяПозицияПоиска;
КонецФункции

Функция КлючХраненияПозицияНайденного() Экспорт
	Возврат "Конфигуратор.СтруктураПозицииПоиска";
КонецФункции

Функция ВыделенныйТекст(ТолькоВыделенный = Истина)
	// Еще есть ТурбоКонф.ПолучитьТекстТекущегоЭлемента()
	Текст = Неопределено;
	Если Не ТолькоВыделенный Тогда 
		ТипЭлементаИнтерфейса = ТипТекущегоЭлементаИнтерфейса();
		Если Ложь 
			Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Поле
			Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.ПолеСоСписком
		Тогда
			Текст = ТурбоКонф.ПолучитьЗначение();
		ИначеЕсли Ложь
			Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.ЭлементСписка
			Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.ЭлементМеню
			Или ТипЭлементаИнтерфейса = ПеречТипЭлемента.Неизвестный
		Тогда
			Текст = ТурбоКонф.ПолучитьИмяЭлемента();
		КонецЕсли;
	КонецЕсли;
	Если Текст = Неопределено Тогда 
		//ТекстСтарый = "" + Новый УникальныйИдентификатор;
		//УстановитьБуферОбмена(ТекстСтарый); // Так ниже будет ошибка чтения из буфера обмена
		ТекстСтарый = ТурбоКонф.ПолучитьБуферОбмена();
		ТурбоКонф.Копировать(); // Так дальше может возникать ошибка "Сбой при выполнении запрошенной операции с буфером обмена" 
		//ТурбоКонф.КонтролКлавиша(Клавиши.C); // Так даже 100 мс ожидания не всегда хватает для получения нового содержимого буфера
		ТурбоКонф.Ждать(100); // 50мс не хватает для первого в жизни окна вызова, например в ячейку журнала регистрации	
		Текст = ТурбоКонф.ПолучитьБуферОбмена(); 
		Если Текст = ТекстСтарый Тогда
			Текст = "";
		КонецЕсли;
	КонецЕсли;
	Сообщить("Текст " + ?(ТолькоВыделенный, "выделенный ", "") + "элемента интерфейса = " + Лев(Текст, 1000));
	Возврат Текст;
КонецФункции

//&ТолькоТекстовыеДокументы
//&ВосстанавливатьБуферОбмена
Процедура ОтладитьОбъект()
	ТребоватьОтложеннуюОтладку = "Ложь";
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте,,,, ЭтоДокумент(), Истина);
	Если ПолеТекстаПрограммы <> Неопределено Тогда
		СсылкаСтрокиМодуля = ПолеТекстаПрограммы.СсылкаСтрокиМодуля(, Ложь);
	КонецЕсли;
	ЦелевойЗаголовок = "Выражение";
	ТекстПоля = "";
	МодулиИР = МодулиИР(ПодключениеИР);
	ЛиОтладкаВТолстомКлиенте = Ложь;
	Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() <> ЦелевойЗаголовок Тогда
		ЧислоКолонокВТаблицеСтека = 4;
		ТурбоКонф.КонтролАльтКлавиша(Клавиши.C); // - Стек вызовов
		ТурбоКонф.Ждать(30);
		ТурбоКонф.Клавиша(Клавиши.Home);
		ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка();
		Если Истина
			И ВидимыеЭлементы <> Неопределено 
			И ВидимыеЭлементы.ИменаЭлементов.Количество() % ЧислоКолонокВТаблицеСтека = 0
		Тогда
			ЯчейкиПервойСтроки = Новый Массив;
			Для Индекс = 0 По ЧислоКолонокВТаблицеСтека - 1 Цикл
				ЯчейкиПервойСтроки.Добавить(ВидимыеЭлементы.ИменаЭлементов[индекс]);
			КонецЦикла;
			ТекстСтека = СтрСоединить(ЯчейкиПервойСтроки);
		Иначе
			ТекстСтека = ВыделенныйТекст(Истина);
		КонецЕсли;
		ВернутьсяВПредыдущееМестоКонфигуратора();
		Сообщить("ТекстСтека=" + ТекстСтека);
		ЛиОтладкаВТолстомКлиенте = Найти(ТекстСтека, "Толстый клиент:") > 0;
		Если ОткрытьОкноВыражения(, ТекстПоля) = Неопределено Тогда
			ПоказатьВсплывающееУведомление(СтрШаблон("Команда применима только в редакторе модуля во время остановки отладки и в окне ""%1""", ЦелевойЗаголовок));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//СтароеЗначениеБуфераОбмена = ТурбоКонф.ПолучитьБуферОбмена();
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "От");
	// ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка(); // Нельзя тут вызывать, т.к. оно снимает выделение в поле ввода
	Если ПустаяСтрока(ТекстПоля) Тогда
		ТекстПоля = ТекстВычисленногоМногострочногоВыражения();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстПоля) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(ТекстПоля, Истина);
		Возврат;
	КонецЕсли;
	ПерваяСтрока = СокрЛП(НРег(СтрПолучитьСтроку(ТекстПоля, 1)));
	Если Лев(ПерваяСтрока, 1) = "(" Тогда
		ПерваяСтрока = СокрЛ(Сред(ПерваяСтрока, 2));
	КонецЕсли;
	ЛиИерархическоеЛогическоеВыражение = Истина
		И Найти(ТекстПоля, Символы.ПС) > 0
		И (Ложь
			Или ПерваяСтрока = "истина"
			Или ПерваяСтрока = "ложь");
	//ПоказатьВсплывающееУведомление(ПерваяСтрока);
	Если ЛиИерархическоеЛогическоеВыражение Тогда
		ВычисляемоеВыражение = "ирОбщий.РасшифровкаИерархическогоЛогическогоВыраженияЛкс("+ МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(ТекстПоля)+")";
		УстановитьФиктивноеВыражениеДляУстановкиЗначения();
		ИмяХранилища = "КодДляОтладчика";
		ТурбоКонф.ВставитьТекст("ирОбщий.СохранитьЗначениеЛкс(""" + ИмяХранилища + """, " + ВычисляемоеВыражение + ")");
		ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
		ЗакрытьМодальноеОкно();
		УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
		УстановитьЗначениеПолюВвода("Вычислить(ирОбщий.ВосстановитьЗначениеЛкс(""" + ИмяХранилища + """))");
		ЖдатьВычислениеВыражения();
		РедактироватьТекст("ВстроенныйЯзык");
		Возврат;
	КонецЕсли;
	Если СтрНачинаетсяС(ТекстПоля, ТекстВызова) Тогда
		ВключитьМодифицированностьПоляВвода();
	Иначе
		ДобавкаЗапятых = ",,";
		Если Найти(ТекстПоля, ",") = 0 Тогда
			ДобавкаЗапятых = ДобавкаЗапятых + ",";
		КонецЕсли;
		Выражение = ТекстВызова + "(" + ТекстПоля + ДобавкаЗапятых + " " + ТребоватьОтложеннуюОтладку + ",,,, """ + СсылкаСтрокиМодуля + """)";
		УстановитьЗначениеПолюВвода(Выражение);
		УстановитьФокусВПервуюТаблицуИлиСписок();
	КонецЕсли; 
	Если Не ЛиОтладкаВТолстомКлиенте Тогда
		ТекстыЯчеек = ЖдатьВычислениеВыражения();
	КонецЕсли;
	Если Истина
		И ТекстыЯчеек <> Неопределено
		И Найти(НРег(ТекстыЯчеек[1]), "открыть объект для отладки") > 0 
	Тогда
		НачатьОжиданиеМодальныхОконПриложенияИР(ПодключениеИР, Истина);
		МодулиИР.ирКлиент.ОтладитьОтложенныйОбъектЛкс(ТекстыЯчеек[1]);
		ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
		ЗавершитьВызовВнешнегоОкнаАсинх(0, ИдентификаторПроцессаИР);
	Иначе
		ИдентификаторПроцесса = 0; // Сделать получение через вычисление выражения
		ШаблонЗаголовкаОкна = "^(Консоль|Исследователь)";
		ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(ШаблонЗаголовкаОкна, 2000, Конфигуратор.ГлавноеОкно, РежимОткрытияВнешнегоОкна.ГлавноеОкно, Истина, ИдентификаторПроцесса);
		ЗавершитьВызовВнешнегоОкнаАсинх(0, ИдентификаторПроцесса);
	КонецЕсли;           
	Если Не ЛиОтладкаВТолстомКлиенте И ПустаяСтрока(ТекстыЯчеек[1]) Тогда
		ПоказатьВсплывающееУведомление("Не дождались снимка объекта. Либо повторите команду после его появления, либо активируйте окно отлаживаемого приложения.", 5000);
	КонецЕсли;
	// УстановитьБуферОбмена(СтароеЗначениеБуфераОбмена); // Почему то после этого перестает работать чтение из буфера обмена
КонецПроцедуры

Функция ЛиДоступенВводВыражения() Экспорт
	ЛиДоступенВводВыражения = ТурбоКонф.ПолучитьДоступностьЭлемента("Включить в табло", "кнопка");
	Возврат ЛиДоступенВводВыражения;
КонецФункции

Функция ЖдатьВычислениеВыражения(Знач МиллисекундЖдать = 1000) Экспорт
	УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
	ТекстыЯчеек = Новый Массив;
	ТекстыЯчеек.Добавить("");
	ТекстыЯчеек.Добавить("");
	ТекстыЯчеек.Добавить("");
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сообщить("Начинаем ожидание вычисления выражения");
	РезультатВычисления = Неопределено;
	ЛиПервыйПроход = Истина;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала <= МиллисекундЖдать Цикл
		ТекстыЯчеек = ЯчейкиТекущейСтроки(3);
		Если ТекстыЯчеек.Количество() > 1 Тогда
			ТекстыЯчеек[1] = СтрокаБезПоследнегоФрагментаЛкс(ТекстыЯчеек[1], " Значение");
			Если ТекстыЯчеек.Количество() > 2 Тогда
				ТекстыЯчеек[2] = СтрокаБезПоследнегоФрагментаЛкс(ТекстыЯчеек[2], " Тип");
			КонецЕсли;
		Иначе
			// <6.3.9130.13871 или фокус украло окно ИР
			Попытка
				ТекстТаблицы = ТурбоКонф.ПолучитьТекстТаблицы();  // Часто вызывает 4 секундное ожидание и ошибку "Не удалось дождаться смены элемента"
			Исключение
				ТекстТаблицы = Неопределено;
				Если ЛиПервыйПроход И СтрНачинаетсяС(ТурбоКонф.ПолучитьЗаголовокТекущегоОкна(), НазваниеПриложения()) Тогда
					ПоказатьВсплывающееУведомление("Рекомендую переподключить приложение ИР, т.к. оно начало забирать фокус при вычислении выражения");
				Иначе
					Сообщить("Текущее окно = " + ТурбоКонф.ПолучитьЗаголовокТекущегоОкна());
				КонецЕсли;
				ЛиПервыйПроход = Ложь;
				Сообщить(ОписаниеОшибки(), СтатусСообщения.Внимание);
			КонецПопытки;
			Если ЗначениеЗаполнено(ТекстТаблицы) Тогда
				ТекстыЯчеек = СтрРазделить(ТекстТаблицы, Символы.Таб);
			КонецЕсли;
		КонецЕсли;
		Если ТекстыЯчеек.Количество() > 1 Тогда
			РезультатВычисления = ТекстыЯчеек[1];
			Если ЗначениеЗаполнено(РезультатВычисления) Тогда
				Сообщить("Результат вычисления = " + РезультатВычисления);
				Прервать;
			КонецЕсли;
		КонецЕсли;
		ТурбоКонф.Ждать(50);
	КонецЦикла;
	Возврат ТекстыЯчеек;
КонецФункции

Функция ТекстВычисленногоМногострочногоВыражения() Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	ТекстПоля = ТурбоКонф.ПолучитьЗначение();
	Если Найти(ТекстПоля, "¶") > 0 Тогда
		УстановитьФокусВПервуюТаблицуИлиСписок(Истина);
		ВидимыеЭлементы = ПолучитьВидимыеЭлементыСписка();
		Если ВидимыеЭлементы <> Неопределено Тогда
			ТекстПоля = СтрокаБезПоследнегоФрагментаЛкс(ВидимыеЭлементы.ИменаЭлементов[0], " ");
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстПоля;
КонецФункции

Процедура УстановитьФиктивноеВыражениеДляУстановкиЗначения() Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода("Новый Структура(""_"")");
	ЖдатьВычислениеВыражения();
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Down);
	//ТурбоКонф.Ждать(20);
	ОткрытьОкноУстановкиЗначенияВВидеВыражения();
КонецПроцедуры

Процедура ВключитьМодифицированностьПоляВвода(Знач ЗавершитьВвод = Истина, Знач КлавишаВременнойДобавки = Неопределено) Экспорт
	ТурбоКонф.Клавиша(Клавиши.End);
	Если КлавишаВременнойДобавки = Неопределено Тогда
		КлавишаВременнойДобавки = Клавиши.D0; // Раньше был пробел, но в числах он не вводится
	КонецЕсли;
	ТурбоКонф.Клавиша(КлавишаВременнойДобавки); 
	ТурбоКонф.Клавиша(Клавиши.Back);
	Если ЗавершитьВвод Тогда
		ТурбоКонф.Клавиша(Клавиши.Enter);
		ТурбоКонф.Ждать(20);
	КонецЕсли;
КонецПроцедуры

// гарантирует, что после установки значения в поле ввода сработает родной обработчик изменения
// Параметры:
//   Текст - Строка - 
Процедура УстановитьЗначениеПолюВвода(Знач Текст, Знач ЗавершитьВвод = Истина, Знач КлавишаВременнойДобавки = Неопределено) Экспорт
	ТурбоКонф.УстановитьЗначение(Текст);
	ВключитьМодифицированностьПоляВвода(ЗавершитьВвод, КлавишаВременнойДобавки);
КонецПроцедуры

//&ТолькоТекстовыеДокументы
//&ЗапроситьИнформациюОДокументе
Процедура ТочкаОстановаПодробная()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НомерСтрокиТекста = ПолеТекстаПрограммы.ПолучитьНомерТекущейСтроки();
	СтрокаТекста = СокрЛП(ПолеТекстаПрограммы.ПолеТекста.ПолучитьСтроку(НомерСтрокиТекста));
	ОткрытьКонтекстноеМеню();
	МодулиИР = МодулиИР(ПодключениеИР);
	НомерВерсииПлатформы = МодулиИР.ирКэш.НомерВерсииПлатформыЛкс();
	Если НомерВерсииПлатформы  < 803024 Тогда
		ТекстЭлемента = "Точка останова с условием...";
		ЗаголовокОкна = "Условие останова";
	Иначе 
		ТекстЭлемента = "Точка останова с параметрами...";
		ЗаголовокОкна = "Параметры точки останова";
	КонецЕсли;
	Если Не ТурбоКонф.НайтиЭлементПоИмени(ТекстЭлемента, "элемент меню") Тогда 
		//ТурбоКонф.Клавиша(Клавиши.Escape);
		ПоказатьВсплывающееУведомление("Команда применима только в редакторе модуля НЕ во время отладки");
		Возврат;
	КонецЕсли;
	НачалоПредставления = """$";
	КликнутьПоЭлементу(ТекстЭлемента, "элемент меню");
	ТурбоКонф.ЖдатьОкно(ЗаголовокОкна, 1000, Истина);
	СтрокаТекста = НачалоПредставления + СтрЗаменить(СтрокаТекста, """", "'") + """<>1";
	Если НомерВерсииПлатформы  < 803024 Тогда
		СтарыйТекст = ТурбоКонф.ПолучитьТекстТекущегоЭлемента();
		РазрешитьИзменения = ПустаяСтрока(СтарыйТекст) Или СтрНачинаетсяС(СтарыйТекст, НачалоПредставления);
		Если РазрешитьИзменения Тогда
			Если СтрНачинаетсяС(СтарыйТекст, НачалоПредставления) Тогда
				ТурбоКонф.Клавиша(Клавиши.Escape);
				ТурбоКонф.Клавиша(Клавиши.F9);
				Возврат;
			КонецЕсли;
			ТурбоКонф.УстановитьЗначение(СтрокаТекста);
			ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
		КонецЕсли;
	Иначе 
		БылаВключена = Ложь;
		СтарыйТекст = АктивироватьУсловиеВОкнеПараметрыТочкиОстанова(БылаВключена);
		РазрешитьИзменения = ПустаяСтрока(СтарыйТекст) Или СтрНачинаетсяС(СтарыйТекст, НачалоПредставления);
		Если РазрешитьИзменения Тогда
			Если ПустаяСтрока(СтарыйТекст) Тогда
				ТурбоКонф.ВставитьТекст(СтрокаТекста);
			КонецЕсли;
			КликнутьПоЭлементу("При выполнении условия:", "флажок");
			Если Не БылаВключена Или Не РазрешитьИзменения Тогда
				КликнутьПоЭлементу("При выполнении условия:", "флажок");
			КонецЕсли;
			ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
			ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
			Если БылаВключена Тогда
				ТурбоКонф.Клавиша(Клавиши.F9);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция АктивироватьУсловиеВОкнеПараметрыТочкиОстанова(выхБылаВключена = Неопределено) Экспорт
	//ТурбоКонф.Клавиша(Клавиши.Tab); // После такого способа активации нужно еще ждать для надежности
	ТурбоКонф.УстановитьФокусНаЭлемент("При выполнении условия:", "флажок");
	выхБылаВключена = ТурбоКонф.ПолучитьСостояниеФлажка();
	Если Не выхБылаВключена Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	Сообщить("БылВключен=" + выхБылаВключена);
	ТурбоКонф.Клавиша(Клавиши.Tab);
	СтарыйТекст = ТурбоКонф.ПолучитьТекстТекущегоЭлемента();
	Возврат СтарыйТекст;
КонецФункции

//.
// Параметры:
//    МодулиИР - Application {V83.Application}, Неопределено - 
Процедура НачатьОжиданиеМодальныхОконПриложенияИР(ПодключениеИР, Знач ПоказыватьГлавноеОкно = Ложь) Экспорт
	МодулиИР = МодулиИР(ПодключениеИР);
	ОткрытьГлавноеОкноИРИОповеститьОПриостановке();
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс(); 
	Если ПоказыватьГлавноеОкно Тогда
		Режим = РежимОткрытияВнешнегоОкна.ГлавноеОкно;
	Иначе
		Режим = РежимОткрытияВнешнегоОкна.Диалог;
	КонецЕсли;
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх(".*", 2000, Конфигуратор.ГлавноеОкно, Режим, Истина, ИдентификаторПроцессаИР);
КонецПроцедуры

Функция ЗакрытьПриложениеИР(Знач ИДКонфигуратора = 0, Знач Причина = "по запросу пользователя", Знач БезСохраненияНастроек = Ложь) Экспорт 
	Если Не БезСохраненияНастроек Тогда
		Если Не ЗакрытьВсеОкнаВПриложенииИР(ИДКонфигуратора) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ПодключениеИР = ПодключениеИРИзКэша(ИДКонфигуратора);
	Если ПодключениеИР = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	УбитьПроцесс = Ложь;
	Попытка
		ПодключениеИР.ЗавершитьРаботуСистемы(Ложь);
	Исключение
		УбитьПроцесс = Истина;
	КонецПопытки;
	ИДПриложения = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИД", ИДКонфигуратора);
	СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИД", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.Кэш", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИмяКонфигурации", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ПолеТекстаПрограммы", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ЗапретОбработкиОткрытияВыражения", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ЛиФормаВызовМетодаОткрывалась", Неопределено);
	ПроцессОС = ПолучитьПроцессОСЛкс(ИДПриложения);
	Причина = ""; // Не сильно полезная информация
	Если ПроцессОС <> Неопределено Тогда
		Если УбитьПроцесс Тогда
			УбитьПроцесс(ПроцессОС, Причина);
		Иначе
			Если Не БезСохраненияНастроек Тогда
				ПоказатьВсплывающееУведомление("Приложение " + НазваниеПриложения() + " завершено " + Причина + ". На его отключение от базы уйдет несколько секунд.", 3000);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Не БезСохраненияНастроек Тогда
			ПоказатьВсплывающееУведомление("Приложение " + НазваниеПриложения() + " завершено " + Причина, 3000);
		КонецЕсли;
	 КонецЕсли;
	Возврат Истина;
КонецФункции

//.
// Параметры:
//    ИДКонфигуратора - ? - 
// Возвращаемое значение:
//    Булево - 
Функция ЗакрытьВсеОкнаВПриложенииИР(Знач ИДКонфигуратора = 0) Экспорт
	Если ЗначениеЗаполнено(Конфигуратор) Тогда
		ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	КонецЕсли;
	ПодключениеИР = ПодключениеИРИзКэша(ИДКонфигуратора);
	//Сообщить("Начало.ЗакрытьВсеОкнаВПриложенииИР");
	Если ПодключениеИР = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	// Делаем окно видимым, чтобы приложение штатно завершилось и сохранились настройки, включая положения окон
	ВосстановитьОкноПриложения(ПодключениеИР);
	
	// Вопросы не отображаются https://www.hostedredmine.com/issues/967021
	// Почему то не отправляет формам команду закрытия
	// ПодключениеИР.ЗавершитьРаботуСистемы(); 
	
	Попытка
		ВсеФормыЗакрыты = МодулиИР.ирКлиент.ЗакрытьВсеФормыЛкс();
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Сообщить(ОписаниеОшибки, СтатусСообщения.Важное);
		ВсеФормыЗакрыты = Истина;
	КонецПопытки;
	Если Не ВсеФормыЗакрыты Тогда
		ПоказатьВсплывающееУведомление("Закройте все окна в приложении " + НазваниеПриложения() + " и повторите команду");
		МодулиИР.ирОбщий.СообщитьЛкс("Закройте все окна");
		Возврат Ложь;
	КонецЕсли; 
	ПодключениеИР.Visible = Ложь;
	ПолеПрограммы = ПолеТекстаПрограммыИзКэша(ИДКонфигуратора);
	Если ПолеПрограммы <> Неопределено Тогда
		Попытка
			ПолеПрограммы.СохранитьСтатистикуВыбораПодсказки();
		Исключение
			// Могут быть ошибки по причине потери связи с ключом защиты
			ОписаниеОшибки = ОписаниеОшибки();
			Сообщить("Ошибка сохранения статистики выбора: " + ОписаниеОшибки, СтатусСообщения.Важное);
		КонецПопытки;
	КонецЕсли;
	ПодключениеИР.СохранитьНастройкиПользователя();
	//Сообщить("Конец.ЗакрытьВсеОкнаВПриложенииИР");
	Возврат Истина;
КонецФункции

// Внешний вызов
Процедура ПередПолучениемДанныхТ9(Параметры, Отказ, СтандартнаяОбработка)
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ПроверитьРазрешениеИР(Отказ) Тогда
		СтандартнаяОбработка = Ложь;
		УстановитьРежимЗаменыШтатнойПодсказки(Истина);
	КонецЕсли;  
	Сообщить("Обработчик ПередПолучениемДанныхТ9 - " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) + " мс");
КонецПроцедуры

//&ЗапроситьИнформациюОДокументе

// см. СобытияМодуль.ПриПолученииДанныхТ9 
Процедура ПриПолученииДанныхТ9(Параметры)
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НомерСтрокиТекста = 0;
	НомерКолонкиТекста = 0;
	ТекстМодуля = Параметры.ТекстМодуля; 
	// https://turboconf.ru/Tasks/9796
	//Если Найти(ТекстМодуля, Символы.ВК + Символы.ВК) > 0 Тогда
	//	Сообщить("Жунь");
	//КонецЕсли;
	ПозицияВТексте = Параметры.Позиция;  
	ЭтоДокумент = Параметры.ЭтоДокумент;
	Попытка
		ИмяКонфигурации = Параметры.ИмяКонфигурации;
		//Сообщить("ИмяКонфигурации = " + ИмяКонфигурации);
	Исключение
	КонецПопытки;
	Попытка
		ВыделенныйТекст = Параметры.ВыделенныйТекст;
	Исключение
		// Сделать в Турбоконфе https://turboconf.ru/Tasks/10201
		ВыделенныйТекст = "";
	КонецПопытки;
	Если ТурбоКонф.ПолучитьВерсиюТурбоКонф() > "6.2." Тогда
		ЛиАвтовызов = Параметры.Автовызов; 
		ПоследнийСимвол = Сред(ТекстМодуля, ПозицияВТексте, 1);
		ПредПоследнийСимвол = Сред(ТекстМодуля, ПозицияВТексте - 1, 1);
		Если Истина
			И ЛиАвтовызов
			И СтрДлина(ТекстМодуля) > 1
			И ПозицияВТексте > 1
			И ПредПоследнийСимвол = ПоследнийСимвол
		Тогда
			// после двух одинаковых символов не делаем автооткрытие
			Возврат;
		КонецЕсли;
	Иначе
		ЛиАвтовызов = Ложь;
	КонецЕсли; 
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МодулиИР = МодулиИР(ПодключениеИР);
	// ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта); // 55мс нужно в случае запуска приложения ИР
	//Сообщить("Активация модулей ИР " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	ОбновленаСтруктураФормы = Неопределено;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, ЭтоДокумент, Истина, ИмяКонфигурации, ОбновленаСтруктураФормы,, Ложь); 
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Если Не ЛиАвтовызов Тогда
			Если СтрДлина(ТекстМодуля) < 100 Тогда
				ПоказатьВсплывающееУведомление("Недостаточно текста для определения его языка");
			Иначе
				ПоказатьВсплывающееУведомление("Неизвестный язык текста");
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТаблицаТипов = ПолеТекстаПрограммы.ТаблицаТиповТекущегоВыражения(Ложь, Ложь, Истина, Истина);
	Если ОбновленаСтруктураФормы = Ложь И ПроверитьОбновитьСтруктуруФормы(ПолеТекстаПрограммы) Тогда
		ТаблицаТипов = ПолеТекстаПрограммы.ТаблицаТиповТекущегоВыражения(Ложь, Ложь, Истина, Истина);
	КонецЕсли;
	КоличествоТипов = ТаблицаТипов.Количество();
	Сообщить("Расчет типов контекста " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЕстьЛучшееСлово = Ложь;
	Успешно = ПолеТекстаПрограммы.ЗаполнитьТаблицуСлов(ТаблицаТипов, Истина, ЕстьЛучшееСлово, Ложь, Ложь, Не ЛиАвтовызов, Истина);
	Если Не Успешно Тогда
		Возврат;
	КонецЕсли;
	ТипКонтекста = ПолеТекстаПрограммы.ИмяТипаКонтекста();
	//Если Найти(ТипКонтекста, "+") > 0 Тогда
	//	Попытка
	//		ИменаТипов = ПолеТекстаПрограммы.ПредставлениеМассиваСтруктурТипов(ПолеТекстаПрограммы.мТаблицаТиповКонтекста,, 30);
	//	Исключение
	//		// ИР 7.00-
	//		ИменаТипов = "";
	//	КонецПопытки;
	//	Если ЯзыкПрограммы = 0 Тогда
	//		ДобавкаСообщения = "Во встроенном языке это делается проверкой типа https://www.hostedredmine.com/issues/970771 или присвоением с указанием типа в комментарии https://www.hostedredmine.com/issues/967806";
	//	Иначе
	//		ДобавкаСообщения = "В языке запросов это делается через ВЫРАЗИТЬ(<Выражение> КАК <Тип>)";
	//	КонецЕсли;
	//	ПоказатьВсплывающееУведомление("Чтобы увидеть слова другого типа, сузьте тип выражения до: " + ИменаТипов + Символы.ПС + ДобавкаСообщения, 4000);
	//КонецЕсли;
	Сообщить("Заполнение слов контекста " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КэшНаборовСлов = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР.Кэш");
	Если КэшНаборовСлов = Неопределено Тогда
		КэшНаборовСлов = Новый Соответствие();
	КонецЕсли;
	ПереданоСлов = 0;
	ВыведеноСлов = 0;
	Словари = Новый Массив;
	Для каждого КлючИЗначение Из ПолеТекстаПрограммы.мНаборыСлов Цикл
		ИмяНабораСлов = КлючИЗначение.Ключ;
		Если КэшНаборовСлов[ИмяНабораСлов] = Неопределено Тогда
			ТаблицаСлов = НаборСловИзИР(ПолеТекстаПрограммы, ИмяНабораСлов);
			ТурбоКонф.УстановитьСловарьT9(ИмяНабораСлов, ТаблицаСлов);
			КэшНаборовСлов[ИмяНабораСлов] = ТаблицаСлов.Количество();
			ПереданоСлов = ПереданоСлов + КэшНаборовСлов[ИмяНабораСлов];
		КонецЕсли;
		ВыведеноСлов = ВыведеноСлов + КэшНаборовСлов[ИмяНабораСлов];
		Словари.Добавить(ИмяНабораСлов);
	КонецЦикла;
	СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.Кэш", КэшНаборовСлов);
	ТаблицаСлов = НаборСловИзИР(ПолеТекстаПрограммы);
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Элементы", ТаблицаСлов);
	ПараметрыЗаполнения.Вставить("ДобавляемыеСловари", Словари);
	ПараметрыЗаполнения.Вставить("ТипКонтекста", ТипКонтекста);
	Попытка
		ПараметрыЗаполнения.Вставить("ЭтоКонтекстМодуля", ПолеТекстаПрограммы.мЭтоЛокальныйКонтекстТаблицыСлов);
	Исключение
		// Старая версия ИР
		ПараметрыЗаполнения.Вставить("ЭтоКонтекстМодуля", ТипКонтекста = "Локальный");
	КонецПопытки;
	ЛиДобавитьШаблоны = ЯзыкПрограммы = 0 И ПараметрыЗаполнения.ЭтоКонтекстМодуля И Не ПолеТекстаПрограммы.мЭтоОбъявлениеПсевдонима;
	Попытка
		Параметры.ДобавитьШаблоны = ЛиДобавитьШаблоны;
	Исключение
		// Старая версия Турбоконф
	КонецПопытки;
	ТурбоКонф.УстановитьДанныеT9(ПараметрыЗаполнения);
	ПоказатьСообщенияПриложенияИР(ПолеТекстаПрограммы);
	Если Не ЭтоДокумент Тогда
		ПолеТекстаПрограммы.КончитьОбработкуКоманды(); // Иначе потом РазобратьТекущийКонтекст не выполнится, считая что временный контекст актуален.
	КонецЕсли;
	КоличествоСловВТаблице = ТаблицаСлов.Количество();
	ПереданоСлов = ПереданоСлов + КоличествоСловВТаблице;
	ВыведеноСлов = ВыведеноСлов + КоличествоСловВТаблице;
	Сообщить("Передача слов " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	Сообщить("Выражение = " + ПолеТекстаПрограммы.мКонтекст + ". Найдено типов " + КоличествоТипов + ". Слов передано " + ПереданоСлов + ", выведено " + ВыведеноСлов + ". Основной тип = " + ТипКонтекста);
	КлючХранения = "" + МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс() + ".ДатаОбновленияКэшаМодулейОтображалась";
	Если ТурбоКонф.ВосстановитьЗначениеСеанса(КлючХранения) = Неопределено Тогда
		ДатаОбновленияКэшаМодулей = МодулиИР.ирОбщий.ДатаОбновленияКэшаМодулейЛкс();
		ДобавкаТекста = "";
		ИмяОбработчика = "";
		Если Не ЗначениеЗаполнено(ДатаОбновленияКэшаМодулей) Тогда
			ДобавкаТекста = ПодсказкаОбновленияКэшаМодулей();
			ИмяОбработчика = "ОбновитьКэшМодулей";
		КонецЕсли;
		ВерсияИР = МодулиИР.ирКэш.НомерВерсииПодсистемыИРЛкс();
		Сообщить("Номер версии ИР = " + ВерсияИР);
		РазмерСтатистикиВыбора = XMLСтрока(ПолеТекстаПрограммы.РазмерСтатистикиВыбора());
		ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Размер статистики выбора - " + РазмерСтатистикиВыбора + ". Кэш модулей - " + ДатаОбновленияКэшаМодулей + "." + ДобавкаТекста, 5000,
			ЭтотОбъект, ИмяОбработчика);
		ТурбоКонф.СохранитьЗначениеСеанса(КлючХранения, 1);
		СписокРекомендаций = Новый Массив;
		Если ЛиДоступнаЧистаяПодсказка() Тогда
			ИмяНастройки = "T9AlwaysShowOnCtrlSpace"; 
			Если ТурбоКонф.ПолучитьЗначениеНастройки(ИмяНастройки) = Ложь Тогда
				Если ЛиДоступнаУстановкаПользовательскихНастроек() Тогда
					ТурбоКонф.УстановитьЗначениеНастройкиПрограммы(ЭтотОбъект, ИмяНастройки, Истина, "Нужно для полной замены подсказки, если в базе разрешено приложение ИР");
				Иначе
					// Есть еще одноименное значение сеанса. Оно устанавливается в УстановитьРежимЗаменыШтатнойПодсказки()
					СписокРекомендаций.Добавить("Включить ""Разработчикам/ Всегда показывать подсказку Т9 вместо штатной подсказки""");
				КонецЕсли; 
			КонецЕсли;
			ИмяНастройки = "T9AllowAutoInvokeInsideCommonStrings"; 
			Если ТурбоКонф.ПолучитьЗначениеНастройки(ИмяНастройки) = Ложь Тогда
				Если ЛиДоступнаУстановкаПользовательскихНастроек() Тогда
					ТурбоКонф.УстановитьЗначениеНастройкиПрограммы(ЭтотОбъект, ИмяНастройки, Истина, "Нужно для подсказки имен свойств в строковых литералах, если в базе разрешено приложение ИР");
				Иначе
					// Есть еще одноименное значение сеанса. Оно устанавливается в УстановитьРежимЗаменыШтатнойПодсказки()
					СписокРекомендаций.Добавить("Разрешить автовызов T9 внутри строковых литералов");
				КонецЕсли; 
			КонецЕсли;
			Если ТурбоКонф.ПолучитьЗначениеНастройки("CloseDDEServerWindow") = Ложь Тогда
				СписокРекомендаций.Добавить("Включить ""Разработчикам/ Автоматически закрывать окно DDE Server Window""");
			КонецЕсли; 
			ЛиАвтоПодсказкаКонфигуратора = ЛиАвтоПодсказкаКонфигуратора(МодулиИР);
			Если ЛиАвтоПодсказкаКонфигуратора Тогда
				ПредложитьУстановитьАвтоподсказку(Ложь);
				//СписокРекомендаций.Добавить("Отключить настройку конфигуратора " + НазваниеНастройкиАвтоподсказкаКонфигуратора());
			КонецЕсли;
		Иначе
			Если ТурбоКонф.ПолучитьЗначениеНастройки("T9AssistSmartFieldsEnabled") = Истина Тогда
				СписокРекомендаций.Добавить("Отключить ""Редактирование/ Подсказывать имена колонок""");
			КонецЕсли; 
		КонецЕсли;
		Если СписокРекомендаций.Количество() > 0 Тогда
			ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Рекомендуется изменить настройки Турбоконф:" + Символы.ПС + "- " + СтрСоединить(СписокРекомендаций, Символы.ПС + "- "),
				20000, ЭтотОбъект, "ОткрытьНастройки");
		КонецЕсли;
		ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта);
	КонецЕсли;
КонецПроцедуры  

//.
// Параметры:
//    ПолеТекстаПрограммы - ОбработкаОбъект.ирКлсПолеТекстаПрограммы, Неопределено - 
Процедура ПоказатьСообщенияПриложенияИР(Знач ПолеТекстаПрограммы) Экспорт
	СсылкаМодуля = "";
	Текст = ПолеТекстаПрограммы.ПрочитатьУдалитьСообщенияПользователю(СсылкаМодуля);
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьВсплывающееУведомление(Текст, 5000, СсылкаМодуля); 
	КонецЕсли;
КонецПроцедуры  

Процедура ОткрытьНастройки(Параметры = Неопределено) Экспорт
	Попытка
		ТурбоКонф.ОткрытьНастройки("~Dev");
	Исключение 
		// < 6.1.8887.43036
		ТурбоКонф.ОткрытьНастройки();
	КонецПопытки;
КонецПроцедуры

// .
// Параметры:
//    МодулиИР - Application {V83.Application}, Неопределено - нужно передавать чтобы настройка считалась корректно в сложных конфигурациях, а иначе она может считаться из неправильного файла
// Возвращаемое значение:
//    Неопределено - 
Функция ЛиАвтоПодсказкаКонфигуратора(МодулиИР) Экспорт
	Если МодулиИР <> Неопределено Тогда
		ИмяПрофайлаНастроек = ВосстановитьЗначениеСеансаКонфигуратора("ИмяПрофайлаНастроек");
		Если ИмяПрофайлаНастроек = Неопределено Тогда
			ИмяПрофайлаНастроек = МодулиИР.ирКэш.КаталогИзданияПлатформыВПрофилеЛкс(Ложь) + "\1cv8.pfl";
			СохранитьЗначениеСеансаКонфигуратора("ИмяПрофайлаНастроек", ИмяПрофайлаНастроек);
		КонецЕсли;
	КонецЕсли;
	ЛиАвтоПодсказкаКонфигуратора = Ложь;
	Для Каждого СтрокаРежима Из ЗамещаемыеРежимыАвтоподсказки() Цикл
		ЛиАвтоПодсказкаКонфигуратора = ЛиАвтоПодсказкаКонфигуратора 
			Или "1" = ТурбоКонф.ПолучитьЗначениеНастройкиКонфигуратора(Конфигуратор.ГлавноеОкно, СтрокаРежима.Имя, ИмяПрофайлаНастроек); // https://turboconf.ru/Tasks/8816
	КонецЦикла;
	//ТекстовыйДокумент = Новый ТекстовыйДокумент;
	//ТекстовыйДокумент.Прочитать(ИмяПрофайлаНастроек);
	//ЗначениеНастройки = ТекстМеждуМаркерамиЛкс(ТекстовыйДокумент.ПолучитьТекст(), "{""PointAutoAssist""," + Символы.ПС + "{""B"",", "}", Ложь);
	Возврат ЛиАвтоПодсказкаКонфигуратора;
КонецФункции

Функция НазваниеНастройкиАвтоподсказкаКонфигуратора()
	Возврат """Модули/ Редактирование/ Автоматическая подсказка при наборе '.'""";
КонецФункции

Функция ЛиДоступнаЧистаяПодсказка() Экспорт
	Возврат ТурбоКонф.ПолучитьВерсиюТурбоКонф() >= "6.1.8855.39060";
КонецФункции 

Функция ЛиДоступнаУстановкаПользовательскихНастроек() Экспорт
	Возврат ТурбоКонф.ПолучитьВерсиюТурбоКонф() >= "6.1.8892.26906";
КонецФункции

Функция ПредложитьУстановитьАвтоподсказку(Знач ЛиВключить) Экспорт
	Если Не ТурбоКонф.НайтиЭлементПоИмени("Сервис", "кнопка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЛиВключить Тогда
		НазваниеДействия = "Восстановить штатную автоподсказку в коде?";
	Иначе 
		НазваниеДействия = "Нужно заменить штатную автоподсказку в коде.";
	КонецЕсли;
	ПараметрыОбработчика = Новый Структура("ЛиВключить", ЛиВключить);
	ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), НазваниеДействия + "
	|При этом все методы могут свернуться.", 5000, ЭтотОбъект, "ОбработчикУстановитьАвтоподсказкуКонфигуратора", ПараметрыОбработчика);
	Возврат Истина;
КонецФункции

Процедура ОбработчикУстановитьАвтоподсказкуКонфигуратора(Параметры) Экспорт
	УстановитьАвтоподсказкуКонфигуратора(Параметры.ЛиВключить);
КонецПроцедуры

Функция ЗамещаемыеРежимыАвтоподсказки()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заголовок");
	Результат.Колонки.Добавить("Имя"); 
	ВерсияТурбоконф = ТурбоКонф.ПолучитьВерсиюТурбоКонф();
	Если ВерсияТурбоконф >= "6.1.8856.0" Тогда
		Строка = Результат.Добавить();
		Строка.Заголовок = "Автоматическая подсказка при наборе "".""";
		Строка.Имя = "PointAutoAssist";
	КонецЕсли;
	Если ВерсияТурбоконф >= "6.2.8907.42118" Тогда
		Строка = Результат.Добавить();
		Строка.Заголовок = "Автоматическая подсказка при наборе ""="" и ""<>""";
		Строка.Имя = "AssignAutoAssist";
		Строка = Результат.Добавить();
		Строка.Заголовок = "Автоматическая подсказка при наборе кавычки";
		Строка.Имя = "QuoteAutoAssist";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УстановитьАвтоподсказкуКонфигуратора(ЛиВключить) Экспорт
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	//Если Не ТурбоКонф.НайтиЭлементПоИмени("Сервис", "кнопка") Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	//ИмяЭлемента = "Сервис";
	//КликнутьПоЭлементу("Сервис", "кнопка");
	//Если ТурбоКонф.ПолучитьИмяЭлемента() <> ИмяЭлемента Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	//ИмяЭлемента = "Параметры...";
	////КликнутьПоЭлементу(ИмяЭлемента, "кнопка"); // Почему то не работает, хотя в Мультиметка777238164 работает
	//ТурбоКонф.Клавиша(Клавиши.Up);
	//Если ТурбоКонф.ПолучитьИмяЭлемента() <> ИмяЭлемента Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	//ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.ОткрытьМеню("Сервис", "Параметры...");
	ТурбоКонф.ЖдатьОкно("Параметры", 1000, Истина);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	//ТурбоКонф.Ждать(100);
	КликнутьПоЭлементу("Модули", "элемент вкладки");
	КликнутьПоЭлементу("Контекстная подсказка", "элемент вкладки");
	БылиИзменения = Ложь;
	Для Каждого СтрокаРежима Из ЗамещаемыеРежимыАвтоподсказки() Цикл
		Если Не ТурбоКонф.УстановитьФокусНаЭлемент(СтрокаРежима.Заголовок, "флажок") Тогда
			ТурбоКонф.КонтролКлавиша(Клавиши.Escape);
			Возврат Ложь;
		КонецЕсли; 
		Если ТурбоКонф.ПолучитьСостояниеФлажка() <> ЛиВключить Тогда
			//ТурбоКонф.УстановитьСостояниеФлажка(Не ЛиВключить); // для гарантии установки модифированности и записи конфигуратором файла настроек
			ТурбоКонф.УстановитьСостояниеФлажка(ЛиВключить);
			БылиИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	Если БылиИзменения Тогда
		ПоказатьВсплывающееУведомление("" + ?(ЛиВключить, "Включена", "Отключена") + " штатная автоподсказка редактора кода. Поэтому все методы свернулись.", 5000);
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	Возврат Истина;
КонецФункции

Функция НаборСловИзИР(ПолеТекстаПрограммы, ИмяНабораСлов = "")
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекстСлов = ПолеТекстаПрограммы.ТаблицаСловВJSON(ИмяНабораСлов);
	ТаблицаСлов = ОбъектИзЖСОН(ТекстСлов); // см. ПолеТекстаПрограммы.ТаблицаСловДляАдаптера()
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результат = Новый Массив; 
	Если ТаблицаСлов.Количество() > 0 Тогда
		Попытка
			Пустышка = ТаблицаСлов[0].Приоритет;
			ЕстьПриоритет = Истина;
		Исключение 
			// ИР 7.16-
			ЕстьПриоритет = Ложь;
		КонецПопытки;
	КонецЕсли;
	Попытка
		РазделительВариантаКонтекста = ПолеТекстаПрограммы.РазделительВариантаКонтекста();
	Исключение 
		// ИР 7.28-
		РазделительВариантаКонтекста = "$";
	КонецПопытки;
	ПередатьШаблон = ТурбоКонф.ПолучитьВерсиюТурбоКонф() > "6.2.";
	Для Каждого СтрокаСлова Из ТаблицаСлов Цикл
		Представление = СтрокаСлова.Слово;
		ЗаменятьРодителяПриВставке = Найти(Представление, РазделительВариантаКонтекста) > 0;
		Если ЗаменятьРодителяПриВставке Тогда
			Фрагменты = СтрРазделитьЛкс(Представление, РазделительВариантаКонтекста);
			Фильтр = Фрагменты[0];
			ТекстШаблона = Фрагменты[1] + "." + Фрагменты[0];
			Если СтрокаСлова.ЛиМетод Тогда
				ТекстШаблона = ТекстШаблона + "(<!>)";
			КонецЕсли;
		Иначе
			Фильтр = Представление;
			ТекстШаблона = Неопределено; 
			// <!> - позиция каретки
			// <?> - позиция каретки и автовызов подсказки
			Если Представление = "Новый" Тогда
				ТекстШаблона = Представление + " <?>"; 
			ИначеЕсли Представление = "Перейти" Тогда
				ТекстШаблона = Представление + " ~<?>";
			ИначеЕсли Ложь
				Или Представление = "КонецЕсли" 
				Или Представление = "КонецЦикла"
				Или Представление = "КонецПопытки"
			Тогда
				ТекстШаблона = Представление + ";";
			ИначеЕсли СтрокаСлова.ЛиМетод Тогда
				// Лишняя пара скобок вставляется https://turboconf.ru/Tasks/9522
				Если Представление = "Тип" Тогда
					ТекстШаблона = Представление + "(""<?>"")";
					//СтрокаСлова.ЛиМетод = Ложь;
				ИначеЕсли Представление = "НСтр" Тогда
					ТекстШаблона = Представление + "(""ru='<!>'"")"; 
					//СтрокаСлова.ЛиМетод = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЭлементСписка = Новый Соответствие();
		ЭлементСписка.Вставить("Представление", Представление);
		ЭлементСписка.Вставить("Фильтр", Фильтр);
		ЭлементСписка.Вставить("ЭтоМетод", СтрокаСлова.ЛиМетод);
		ЭлементСписка.Вставить("ВозвращаетЗначение", СтрокаСлова.ЛиРез);
		ЭлементСписка.Вставить("Тип", СтрокаСлова.Тип);
		ЭлементСписка.Вставить("ПредполагаемоеЗначение", Не СтрокаСлова.ЛиТочный);
		ЭлементСписка.Вставить("АвтоТочкаСЗапятойОтключена", Не СтрокаСлова.ЛиМетод Или ЗначениеЗаполнено(СтрокаСлова.Тип));
		ЭлементСписка.Вставить("АвтоперемещениеКурсораОтключено", Ложь);
		ЭлементСписка.Вставить("ИзКонтекста", Истина);
		//ЭлементСписка.Вставить("ЕстьПараметры", СтрокаСлова.Слово <> "Количество");
		ЭлементСписка.Вставить("ЕстьПараметры", Ложь);
		ЭлементСписка.Вставить("ЗаменятьРодителяПриВставке", ЗаменятьРодителяПриВставке);
		Если ПередатьШаблон Тогда
			ЭлементСписка.Вставить("ТекстШаблона", ТекстШаблона);
		КонецЕсли;
		Если ЕстьПриоритет Тогда
			ЭлементСписка.Вставить("Приоритет", СтрокаСлова.Приоритет);
		Иначе
			ЭлементСписка.Вставить("Приоритет", 0);
		КонецЕсли;
		Результат.Добавить(ЭлементСписка);
	КонецЦикла;
	Сообщить("Передача набора слов """ + ИмяНабораСлов + """ = " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	Возврат Результат; 
КонецФункции

// Функция - Поле текста программы ИР
// Параметры:
//   ПодключениеИР -  - 
//   ТекстПоля - Разделитель, Неопределено - "Неопределено" не обновляет текст поля
//   Позиция0Поле - Число - с 0; если 0, то текущий документ получается заново
//   ВыделенныйТекст -  - 
//   ПереходитьВоВложенныйКонтекст -  - 
//   КакВызовМетода -  - 
//   ТребоватьДокумент - Булево - если Истина, то если находимся не в документе, то вернуть Неопределено; при Ложь связь с метаданными не вычисляется
//   РазрешитьПоследнийДокумент -  - 
//   ИмяКонфигурации -  - 
//   выхОбновленаСтруктураФормы -  - 
//   выхИмяРасширения -  - 
//   ИдентифицироватьДокумент - Булево - НАДО установливать, если команда сделала переход в другой модуль
// Возвращаемое значение:
//    - 
Функция ПолеТекстаПрограммыИР(Знач ПодключениеИР, Знач ТекстПоля = "", Знач Позиция0Поле = 0, Знач ВыделенныйТекст = "", ПереходитьВоВложенныйКонтекст = Истина, Знач КакВызовМетода = Неопределено,
	Знач ТребоватьДокумент = Истина, Знач РазрешитьПоследнийДокумент = Ложь, Знач ИмяКонфигурации = "", выхОбновленаСтруктураФормы = Ложь, выхИмяРасширения = "", Знач ИдентифицироватьДокумент = Неопределено,
	Знач СсылкаСтроки = "", выхПереходПоСсылкеВыполнен = Ложь, Знач РазрешитьОбновлениеФормы = Истина, Знач ДобавитьМетодВПоследние = Истина)

	выхПереходПоСсылкеВыполнен = Ложь;
	ТекстМодуля = ТекстПоля;
	ПозицияВТексте = Позиция0Поле;
	Если ИдентифицироватьДокумент = Неопределено Тогда
		ИдентифицироватьДокумент = ЗначениеЗаполнено(ПозицияВТексте);
	КонецЕсли;
	МоментЗапускаОбщий = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МоментЗапуска = МоментЗапускаОбщий;
	ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Сообщить("-ЗаголовокОкна = " + ЗаголовокОкна);
	Если ЗаголовокОкна = "Выражение" И ТурбоКонф.ПолучитьИмяЭлемента() = "Значение" Тогда
		// Антибаг Турбоконфа https://turboconf.ru/Tasks/9912
		Возврат Неопределено;
	КонецЕсли;
	Если ТребоватьДокумент = Неопределено Тогда
		ТребоватьДокумент = ЭтоДокумент();
	КонецЕсли;
	Если Истина
		И ТребоватьДокумент 
		И ЗаголовокОкна <> "Параметры точки останова" 
		И ЗаголовокОкна <> "Ввод выражения" 
	Тогда
		Попытка
			Если ПозицияВТексте > 0 И Не ИдентифицироватьДокумент Тогда
				ТекущийДокумент = Конфигуратор.ТекущийДокумент;
			Иначе 
				ТекущийДокумент = ТурбоКонф.ИдентифицироватьТекущийДокумент(); 
			КонецЕсли; 
		Исключение
			ТекущийДокумент = Неопределено;
		КонецПопытки;
		Если Истина
			И ТекущийДокумент <> Неопределено 
			//И ТекущийДокумент.ТипДокумента <> "СлужебныеСообщения" 
			//И ТекущийДокумент.ТипДокумента <> "Шаблон"
			//И ТекущийДокумент.ТипДокумента <> "Макет"
		Тогда
			ТипТекстовогоДокумента = ТекущийДокумент.ТипДокумента;
			ЗаголовокДокумента = ТекущийДокумент.Заголовок;
			ИмяКонфигурации = ТекущийДокумент.ИмяКонфигурации;
		КонецЕсли;
	ИначеЕсли РазрешитьПоследнийДокумент Тогда
		Попытка
			ПоследнийДокумент = Конфигуратор.ПоследнийДокумент;
		Исключение
			ПоследнийДокумент = Неопределено;
		КонецПопытки;
		Если Истина
			И ПоследнийДокумент <> Неопределено
			И ПоследнийДокумент.Заголовок = "Ввод выражения" 
		Тогда
			ПоследнийДокумент = ВосстановитьЗначениеСеансаКонфигуратора("ПоследнийДокумент");
		КонецЕсли;
		Если ПоследнийДокумент <> Неопределено Тогда
			ЗаголовокДокумента = ПоследнийДокумент.Заголовок;
			ИмяКонфигурации = ПоследнийДокумент.ИмяКонфигурации;
			ТекстМодуля = ПоследнийДокумент.Текст;
			ПозицияВТексте = ПоследнийДокумент.Позиция;
			СтарыйПоследнийДокумент = Новый Структура("Заголовок, ИмяКонфигурации, Текст, Позиция");
			ЗаполнитьЗначенияСвойств(СтарыйПоследнийДокумент, ПоследнийДокумент);
			СохранитьЗначениеСеансаКонфигуратора("ПоследнийДокумент", ПоследнийДокумент);
		КонецЕсли;
	КонецЕсли;
	КлючКэша = "ПолеТекстаПрограммы";
	ПолеТекстаПрограммы = ВосстановитьЗначениеСеансаКонфигуратора(КлючКэша);
	Попытка
		Пустышка = ПолеТекстаПрограммы.мИмяМодуля; 
	Исключение
		ПолеТекстаПрограммы = Неопределено;
	КонецПопытки;
	Если ПолеТекстаПрограммы = Неопределено Тогда
		МодулиИР = МодулиИР(ПодключениеИР);
		ПолеТекстаПрограммы = МодулиИР.ирКэш.ПолеТекстаПрограммы(ЯзыкПрограммы);
		СохранитьЗначениеСеансаКонфигуратора(КлючКэша, ПолеТекстаПрограммы);
		// Сообщить("ПолеТекстаПрограммы0 " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
		// МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;
	Если Ложь
		Или ЗаголовокОкна = "Запрос" 
		Или ЗаголовокОкна = "Произвольное выражение" 
		Или ЗаголовокОкна = "Динамический список" 
		Или ЗаголовокОкна = "Ограничение доступа"
		Или ПолеТекстаПрограммы.ЛиТекстЯзыкаЗапросовЛкс(Лев(ТекстМодуля, 1000))
	Тогда
		ЯзыкПрограммы = 1;
	Иначе
		ЯзыкПрограммы = 0;
	КонецЕсли;
	ПолеТекстаПрограммы.ЯзыкПрограммы = ЯзыкПрограммы;
	Если СтрНачинаетсяС(ЗаголовокОкна, "Настройка объединения модулей ")  Тогда
		СжатоеИмяМодуля = СтрРазделить(ЗаголовокОкна, " ")[3];
		ТекстМодуля = Неопределено;
	ИначеЕсли Истина
		И ЯзыкПрограммы = 0
		И (ТребоватьДокумент Или РазрешитьПоследнийДокумент)
	Тогда
		Если Не ЗначениеЗаполнено(ЗаголовокДокумента) Тогда
			// для защиты от затирания модуля формы, если вызываем переход на ее странице не модуля
			Возврат Неопределено;
		КонецЕсли;
		ПередатьИзмененияМодулей(ПодключениеИР, ПолеТекстаПрограммы);
		СжатоеИмяМодуля = СжатоеИмяМодуля(ПодключениеИР, ТекстМодуля, ИмяКонфигурации, ЗаголовокДокумента, ТипТекстовогоДокумента, Не РазрешитьПоследнийДокумент И ТекстМодуля <> Неопределено, выхИмяРасширения);
		Если СжатоеИмяМодуля = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Сообщить("-Определение имени модуля " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сообщить("-Сжатое имя модуля = "+ СжатоеИмяМодуля);
	// Основное время уходит на передачу большого текста. 10к строк передаются 10мс
	//ПолеТекстаПрограммы.мСтарыйОригинальныйТекст = ТекстМодуля; // Гипотеза не подтвердилась - Для ускорения передаем через свойство, а не параметр, т.к. через параметр потом измененное снаружи свойство обратно поедет
	ПолеТекстаПрограммы.ПрочитатьУдалитьСообщенияПользователю();
	Если ПустаяСтрока(ТекстМодуля) Тогда
		Пустышка = 0; // Вместо условной точки останова
	КонецЕсли;
	Попытка
		ПолеТекстаПрограммы.УстановитьТекст(ТекстМодуля, Ложь,, Ложь, СжатоеИмяМодуля,, ПозицияВТексте + 1, ПозицияВТексте + 1 + СтрДлина(ВыделенныйТекст));
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЧистыйТекстОшибки = ПоследнийФрагментЛкс(ОписаниеОшибки, "(System.Runtime.InteropServices.COMException): ");
		Если Найти(ЧистыйТекстОшибки, "Ошибка инициализации модуля") > 0 Тогда
			ПоказатьВсплывающееУведомление(ЧистыйТекстОшибки,, ЧистыйТекстОшибки); 
			Возврат Неопределено;
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Сообщить("-Передача текста модуля " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПоказатьСообщенияПриложенияИР(ПолеТекстаПрограммы);
	Если Истина
		И ТребоватьДокумент 
		И РазрешитьОбновлениеФормы 
		И ИмяКонфигурации <> СтрРазделить(СжатоеИмяМодуля, " ")[0] // Это не расширение формы
	Тогда
		ПолеТекстаПрограммы.КончитьОбработкуКоманды(); // Перенес в ПолеТекстаПрограммы.УстановитьТекст
		выхОбновленаСтруктураФормы = ПроверитьОбновитьСтруктуруФормы(ПолеТекстаПрограммы);
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(СсылкаСтроки) Тогда
		ПолеТекстаПрограммы.ЗапомнитьИсточникПерехода();
		Если ПолеТекстаПрограммы.ПерейтиПоСсылкеСтрокиМодуля(СсылкаСтроки) Тогда
			ПозицияВТексте = ПолеТекстаПрограммы.ПолеТекста.ВыделениеОдномерное().Конец - 1;
			выхПереходПоСсылкеВыполнен = Истина;
		КонецЕсли;
	КонецЕсли;
	ПолеТекстаПрограммы.РазобратьТекущийКонтекст(Ложь, Ложь, КакВызовМетода, 0, 0, ПереходитьВоВложенныйКонтекст, ПозицияВТексте + 1);

	Сообщить("-Разбор позиции в модуле " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Истина
		И ЯзыкПрограммы = 0 
		И ЗначениеЗаполнено(ТекстПоля) 
		И ТекстПоля <> ТекстМодуля
		И (Ложь
			Или РазрешитьПоследнийДокумент 
			Или ТекстМодуля = Неопределено)
	Тогда
		// например в окне "Вычислить" или "Условие точки останова"
		Сообщить("-текст поля выражения = " + Лев(ТекстПоля, 1000));
		ТекстПоля = СокрП(ТекстПоля);
		Если ТурбоКонф.ПолучитьВерсиюAPI() < 6 Тогда
			АктивноеОкно = ТурбоКонф.ПолучитьАктивноеОкно();
			КлючХранения = "УведомлениеКонтекста." + АктивноеОкно;
			УжеУведомляли = ВосстановитьЗначениеСеансаКонфигуратора(КлючХранения);
			Если УжеУведомляли = Неопределено Тогда
				ИмяТекущегоМетода = ВывестиКонтекстЯзыка(ПолеТекстаПрограммы);
				ПоказатьВсплывающееУведомление("Вычисление в контексте метода """ + ИмяТекущегоМетода + """. Используйте команду ""ИР.ВычислитьВыражение"" для передачи контекста");
				СохранитьЗначениеСеансаКонфигуратора(КлючХранения, 1);
			КонецЕсли;
		КонецЕсли;
		ПолеТекстаПрограммы.ПродолжитьОбработкуКоманды();
		ПолеТекстаПрограммы.ПрочитатьНачалоИКонецТекущейСтроки(ТекстПоля, Позиция0Поле + 1);
		ПолеТекстаПрограммы.РазобратьКонтекстСтроки(Ложь, Ложь, КакВызовМетода);
		ПолеТекстаПрограммы.мПозицияВБлоке = СтрДлина(ПолеТекстаПрограммы.мТекстБлока); 
		ПолеТекстаПрограммы.мТекущаяСтрокаНачало = "Ф=" + ПолеТекстаПрограммы.мТекущаяСтрокаНачало;
		ПолеТекстаПрограммы.мПредшествующийТекст = ПолеТекстаПрограммы.мТекстДляПоискаОпределения + " " + ПолеТекстаПрограммы.мТекущаяСтрокаНачало;
		Сообщить("-Добавка динамического кода " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
	КонецЕсли;
	ВывестиКонтекстЯзыка(ПолеТекстаПрограммы);
	
	Если Истина
		И ЯзыкПрограммы = 0 
		И ЗначениеЗаполнено(СжатоеИмяМодуля) 
		И ДобавитьМетодВПоследние
	Тогда
		// Последние методы
		ПоследниеМетоды = ВосстановитьЗначениеСеансаКонфигуратора("ПоследниеМетоды");
		Если ПоследниеМетоды = Неопределено Тогда
			ПоследниеМетоды = Новый СписокЗначений;
		КонецЕсли;
		Разделитель = ": ";
		СжатоеИмяМодуля = СжатоеИмяМодуля + Разделитель;
		СжатоеИмяМодуля = СтрЗаменить(СжатоеИмяМодуля, ".Модуль:", ":");
		ПолноеИмяМетода = СжатоеИмяМодуля + ПолеТекстаПрограммы.ИмяТекущегоМетода();
		ЭлементСписка = ПоследниеМетоды.НайтиПоЗначению(ПолноеИмяМетода);
		Если ЭлементСписка = Неопределено Тогда
			ЭлементСписка = ПоследниеМетоды.Вставить(0, ПолноеИмяМетода);
			Сдвиг = 1;
		Иначе
			Сдвиг = -ПоследниеМетоды.Индекс(ЭлементСписка);
			ПоследниеМетоды.Сдвинуть(ЭлементСписка, Сдвиг);
		КонецЕсли;
		Если Сдвиг <> 0 Тогда
			ЭлементСписка.Представление = ПолеТекстаПрограммы.СсылкаСтрокиМодуля();
			Пока ПоследниеМетоды.Количество() > МаксЧислоПоследнихМетодов() Цикл
				ПоследниеМетоды.Удалить(ПоследниеМетоды.Количество() - 1);
			КонецЦикла;
			СохранитьЗначениеСеансаКонфигуратора("ПоследниеМетоды", ПоследниеМетоды);
		КонецЕсли;
	КонецЕсли;
	Сообщить("Обновление поля текста программы " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапускаОбщий) + " мс");
	Возврат ПолеТекстаПрограммы;
КонецФункции

Функция МаксЧислоПоследнихМетодов() Экспорт
	Возврат 40;
КонецФункции

//.
// Параметры:
//    ПодключениеИР - Application {V83.Application}, Неопределено - 
//    ПолеТекстаПрограммы - , ОбработкаОбъект.ирКлсПолеТекстаПрограммы, Неопределено - 
Процедура ПередатьИзмененияМодулей(Знач ПодключениеИР, Знач ПолеТекстаПрограммы = Неопределено) Экспорт
	ИмяСкрипта = ИмяСкрипта();
	Попытка
		ДокументыМодулей = ТурбоКонф.ПолучитьМодифицированныеДокументы(Конфигуратор.PID, ИмяСкрипта);
	Исключение
		// 6.5.9436.37942+
		Попытка
			ДокументыМодулей = ТурбоКонф.ПолучитьМодифицированныеДокументы(Конфигуратор.PID);
		Исключение
			// 6.0.8749.33912+
			ДокументыМодулей = Новый Массив;
		КонецПопытки;
	КонецПопытки;
	Если ДокументыМодулей.Количество() > 0 Тогда
		Если ПолеТекстаПрограммы = Неопределено Тогда
			ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, "", 0);
		КонецЕсли;
		СледДокумент = Неопределено; // ОбработкаОбъект.Документ
		Для Индекс = 1 - ДокументыМодулей.Количество() По 0 Цикл // Обратный обход
			Документ = ДокументыМодулей[-Индекс];
			Если Истина
				И Конфигуратор.ТекущийДокумент <> Неопределено
				И Документ.DocumentRuntimeId = Конфигуратор.ТекущийДокумент.DocumentRuntimeId 
			Тогда
				Продолжить;
			КонецЕсли;
			Если Истина
				И СледДокумент <> Неопределено
				И СледДокумент.DocumentRuntimeId = Документ.DocumentRuntimeId
			Тогда
				// Ошибка Турбоконф https://turboconf.ru/Tasks/9074
				Продолжить;
			КонецЕсли;
			ИмяКонфигурации = Документ.ИмяКонфигурации;
			Если Не ЗначениеЗаполнено(ИмяКонфигурации) Тогда
				//  если с момента открытия модуля в нем что то изменили без вызова команд требующих идентификации документа
				// https://turboconf.ru/Tasks/9074
				Если СтрДлина(Документ.Текст) < 1000 Тогда 
					Продолжить;
				КонецЕсли; 
				НачалоТекста = Лев(Документ.Текст, 50000); // Для ускорения анализа
				Если Ложь
					Или Найти(НачалоТекста, Символы.ПС + "&После(""") > 0
					Или Найти(НачалоТекста, Символы.ПС + "&Перед(""") > 0
					Или Найти(НачалоТекста, Символы.ПС + "&Вместо(""") > 0
					Или Найти(НачалоТекста, Символы.ПС + "&ИзменениеИКонтроль(""") > 0
				Тогда 
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			СледДокумент = Документ;
			МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ПолноеИмяМодуля = СжатоеИмяМодуля(ПодключениеИР, Документ.Текст, ИмяКонфигурации, Документ.Заголовок, Документ.ТипДокумента, Ложь);
			Если ПолноеИмяМодуля = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Сообщить("Синхронизация модуля " + ПолноеИмяМодуля + " " + Документ.DocumentRuntimeId + " начата. Длина текста - " + СтрДлина(Документ.Текст) + " символов. Последняя позиция " + Документ.Позиция);
			ПолеТекстаПрограммы.УстановитьТекст(Документ.Текст, Ложь,, Ложь, ПолноеИмяМодуля,, Документ.Позиция, Документ.Позиция);
			Сообщить("Синхронизация модуля " + ПолноеИмяМодуля + " " + Документ.DocumentRuntimeId + " выполнена за " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапуска) + " мс");
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//.
// Параметры:
//    ПодключениеИР - Application {V83.Application}, Неопределено - 
//    ИмяКонфигурации - Строка, Неопределено - 
Функция СжатоеИмяМодуля(Знач ПодключениеИР, Знач ТекстМодуля, Знач ИмяКонфигурации, Знач ЗаголовокДокумента, Знач ТипДокумента, Знач ПроверятьЧтоЭтоОкноСообщений = Истина, выхИмяРасширения = "") Экспорт
	Сообщить("ИмяКонфигурации = " + ИмяКонфигурации);
	Если ИмяКонфигурации = "?" Тогда 
		Если ПроверятьЧтоЭтоОкноСообщений Тогда
			ТурбоКонф.ПоказатьВсплывающееУведомление(, "TurboConf не смог связать окно модуля с конфигурацией. Переоткройте окно модуля.", 4000);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(ЗаголовокДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭтоМодульВнешнегоОбъекта = Ложь;
	Если Истина
		И ТипДокумента <> "ОбычныйМодуль"
		И ТипДокумента <> "МодульФормы"
		И Найти(ТекстМодуля, Символы.ПС + "КонецФункции") = 0
		И Найти(ТекстМодуля, Символы.ПС + "КонецПроцедуры") = 0
		И Найти(ТекстМодуля, Символы.ПС + "EndFunction") = 0
		И Найти(ТекстМодуля, Символы.ПС + "EndProcedure") = 0
		// И Найти(ТекстМодуля, "|ВЫБРАТЬ") = 0
		// И Найти(ТекстМодуля, "|SELECT") = 0
	Тогда
		ПороговаяДлина = 30000; // для 4х Найти() - 2мс
		НачалоМодуля = Прав(ТекстМодуля, ПороговаяДлина);
		Если СтрДлина(НачалоМодуля) = ПороговаяДлина Тогда
			// Это текст НЕ на встроенном языке
			ЯзыкПрограммы = Неопределено;
		Иначе 
			ПороговаяДлина = 3000; // для 4х Найти() и 30000 символов - 2мс
			НачалоМодуля = Прав(ТекстМодуля, ПороговаяДлина);
			Если Истина
				И Найти(ТекстМодуля, "//") = 0
				И Найти(ТекстМодуля, "КонецЕсли") = 0
				И Найти(ТекстМодуля, "EndIf") = 0
				И Найти(ТекстМодуля, "=") = 0
				И Найти(ТекстМодуля, ");") = 0
				И Найти(ТекстМодуля, "()") = 0
				И Найти(ТекстМодуля, "Перем ") = 0
				И Найти(ТекстМодуля, "|") = 0
				И Найти(ТекстМодуля, "&НаКлиенте") = 0
				И Найти(ТекстМодуля, "&НаСервере") = 0
				И Найти(ЗаголовокДокумента, ": Модуль") = 0
				И НРег(Лев(ТекстМодуля, 4)) <> "проц"
				И НРег(Лев(ТекстМодуля, 4)) <> "функ"
			Тогда
				// Это текст НЕ на встроенном языке
				ЯзыкПрограммы = Неопределено;
			ИначеЕсли ПроверятьЧтоЭтоОкноСообщений Тогда
				// Проверка на окно сообщений
				ПозицияКаретки1 = ТурбоКонф.ПолучитьПозициюКаретки();
				ТурбоКонф.КонтролАльтКлавиша(Клавиши.O);
				ТурбоКонф.Ждать(20);
				ПозицияКаретки2 = ТурбоКонф.ПолучитьПозициюКаретки(); 
				Если ПозицияКаретки1.X = ПозицияКаретки2.X И ПозицияКаретки1.Y = ПозицияКаретки2.Y Тогда
					// Теперь точно узнали что это окно сообщений
					ЯзыкПрограммы = Неопределено;
					// ПоказатьВсплывающееУведомление("Чтобы анализ модуля мог определить его тип, добавьте метод");
				Иначе
					//ТурбоКонф.Клавиша(Клавиши.Escape); // Так почему то клавиша сразу нажимается Турбоконфом с задержкой и при открытии ссылки из клиентского приложения мешает поиску метаданных
					ВернутьсяВПредыдущееМестоКонфигуратора();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЯзыкПрограммы = Неопределено Тогда
		Возврат Неопределено; 
	КонецЕсли;
	ПолноеИмяМодуля = СжатоеИмяОбъектаОкна(ПодключениеИР, ИмяКонфигурации, ЗаголовокДокумента, ЭтоМодульВнешнегоОбъекта, выхИмяРасширения);
	Возврат ПолноеИмяМодуля;
КонецФункции

//.
// Параметры:
//   ПодключениеИР - Application {V83.Application}, Неопределено - 
//   ИмяКонфигурации - Строка, Неопределено - 
//   ЗаголовокДокумента - Строка - 
//   ЭтоМодульВнешнегоОбъекта - Булево - 
//   выхИмяРасширения - Строка - 
// Возвращаемое значение:
//   Произвольный, Строка, Неопределено - 
Функция СжатоеИмяОбъектаОкна(Знач ПодключениеИР, Знач ИмяКонфигурации = "", Знач ЗаголовокДокумента = "", Знач ЭтоМодульВнешнегоОбъекта = Ложь, выхИмяРасширения = "") Экспорт
	Если Не ЗначениеЗаполнено(ЗаголовокДокумента) Тогда
		ЗаголовокКонфигуратора = ТурбоКонф.ПолучитьЗаголовокКонфигуратора(Конфигуратор.ГлавноеОкно);
		ЗаголовокДокумента = ЧистыйЗаголовокДочернегоОкна(ЗаголовокКонфигуратора);
		//Сообщить("Заголовок документа свежий = " + ЗаголовокКонфигуратора);
		Если Не ЗначениеЗаполнено(ЗаголовокДокумента) Тогда
			ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
			ЗаголовокДокумента = ЗаголовокОкна;
		КонецЕсли;
	КонецЕсли;
	Сообщить("Заголовок документа = " + ЗаголовокДокумента);
	Если Ложь
		Или ЗаголовокДокумента = "?"
		Или ЗаголовокДокумента = "..." // Соединенные окна документов https://turboconf.ru/Tasks/9359
		//Или ЛиАктивноГлавноеОкно(ЗаголовокДокумента)
	Тогда
		ПоказатьВсплывающееУведомление("Разверните окно модуля, чтобы анализатор мог определить его имя", 3000);
		//Возврат Неопределено;
		ЗаголовокДокумента = "Внешняя обработка: Модуль объекта";
	КонецЕсли;
	МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Мультиметка250108_112016
	ПолноеИмяМодуля = ЗаголовокДокумента;
	Если ПолноеИмяМодуля = "Конфигуратор" Тогда
		// ПоказатьВсплывающееУведомление("Чтобы анализ модуля мог определить его имя, нужно развернуть его окно");
		ПолноеИмяМодуля = "";
	Иначе
		Если СтрНачинаетсяС(ПолноеИмяМодуля, "Конфигурация ") Тогда
			ПервыйФрагмент = СтрРазделить(ПолноеИмяМодуля, ":")[0];
			ПолноеИмяМодуля = СтрЗаменить(ПолноеИмяМодуля, ПервыйФрагмент + ":", "Общая форма") + ":";
		КонецЕсли;
		ФрагментыСборки = Новый Массив;
		ЭтоМодульВнешнегоОбъекта = Ложь;
		Если Найти(ПолноеИмяМодуля, "\") > 0 Тогда
			// Файл
			ФрагментыДвоеточия = СтрРазделить(ПолноеИмяМодуля, ":");
			Если СтрНачинаетсяС(ПолноеИмяМодуля, "\\") Тогда
				// Сетевой файл
				Если ФрагментыДвоеточия.Количество() < 2 Тогда
					ТипМодуля = "Неизвестный";
				ИначеЕсли Найти(ФрагментыДвоеточия[1], " ") > 0 Тогда
					ТипМодуля = ТРег(СтрЗаменить(ФрагментыДвоеточия[1], " ", ""));
				Иначе
					ТипМодуля = ФрагментыДвоеточия[1];
				КонецЕсли;
				ПолноеИмяМодуля = "Ф::" + ФрагментыДвоеточия[0] + "::" + ТипМодуля;
				ЭтоМодульВнешнегоОбъекта = Истина;
			ИначеЕсли Найти(ПолноеИмяМодуля, ":\") > 0 Тогда
				// Локальный файл
				Если ФрагментыДвоеточия.Количество() < 3 Тогда
					ТипМодуля = "Неизвестный";
				ИначеЕсли Найти(ФрагментыДвоеточия[2], " ") > 0 Тогда
					ТипМодуля = ТРег(СтрЗаменить(ФрагментыДвоеточия[2], " ", ""));
				Иначе
					ТипМодуля = ФрагментыДвоеточия[2];
				КонецЕсли;
				ПолноеИмяМодуля = "Ф::" + ФрагментыДвоеточия[0] + ":" + ФрагментыДвоеточия[1] + "::" + ТипМодуля;
				ЭтоМодульВнешнегоОбъекта = Истина;
			КонецЕсли;
		Иначе
			ПолноеИмяМодуля = СтрЗаменить(ПолноеИмяМодуля, "-", " "); // Нужно для Http-Сервис и Бизнес-Процесс
			ФрагментыДвоеточия = СтрРазделить(ПолноеИмяМодуля, ":");
			Если ФрагментыДвоеточия[0] = "Внешняя обработка" Или ФрагментыДвоеточия[0] = "Внешний отчет" Тогда
				ФрагментыДвоеточия[0] = ФрагментыДвоеточия[0] + " Незаписанное";
				ЭтоМодульВнешнегоОбъекта = Истина;
			КонецЕсли;
			ФрагментыПробела = СтрРазделить(ПолноеИмяМодуля, " ");
			Если Прав(ФрагментыПробела[0], 1) = ":" Тогда
				ПолноеИмяМодуля = СтрЗаменить(ПолноеИмяМодуля, ФрагментыПробела[0], ""); // удаляем имя конфигурации из представления модуля конфигурации
				ФрагментыДвоеточия = СтрРазделить(ПолноеИмяМодуля, ":");
			КонецЕсли;
			Если ФрагментыДвоеточия.Количество() > 1 Тогда
				ФрагментыОбъекта = СтрРазделить(СокрЛП(ФрагментыДвоеточия[0]), " ");
				ФрагментыДвоеточия.Удалить(0);
				ИмяОбъекта = ФрагментыОбъекта[ФрагментыОбъекта.ВГраница()];
				ФрагментыОбъекта.Удалить(ФрагментыОбъекта.ВГраница());
				Если ФрагментыОбъекта.Количество() > 0 Тогда
					ТипОбъекта = СтрЗаменить(ТРег(СтрСоединить(ФрагментыОбъекта, " ")), " ", "");
					ФрагментыСборки.Добавить(ТипОбъекта);
				КонецЕсли;
				ФрагментыСборки.Добавить(ИмяОбъекта);
			КонецЕсли;
			ТипМодуля = СокрЛП(ФрагментыДвоеточия[0]);
			Если ЗначениеЗаполнено(ТипМодуля) Тогда
				Если Найти(ТипМодуля, " ") > 0 Тогда
					ТипМодуля = СтрЗаменить(ТРег(ТипМодуля), " ", "");
				КонецЕсли;
				ФрагментыСборки.Добавить(ТипМодуля);
			КонецЕсли;
			ПолноеИмяМодуля = СтрСоединить(ФрагментыСборки, ".");
			ПолноеИмяМодуля = СтрРазделить(ПолноеИмяМодуля, "(")[0]; // При клонировании окна модуля каждому экземпляру добавляется (N) в конец заголовка
		КонецЕсли;
		МоментЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ИмяОсновнойКонфигурации = ИмяОсновнойКонфигурации(ПодключениеИР);
		Если Не ЭтоМодульВнешнегоОбъекта Тогда
			Если ПустаяСтрока(ИмяКонфигурации) Тогда
				ИмяКонфигурации = ИмяОсновнойКонфигурации;
			КонецЕсли;
			Если ИмяКонфигурации <> ИмяОсновнойКонфигурации Тогда
				ПолноеИмяМодуля = ИмяКонфигурации + " " + ПолноеИмяМодуля;
				выхИмяРасширения = ИмяКонфигурации;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ПолноеИмяМодуля;
КонецФункции

//.
// Параметры:
//    ПодключениеИР - Application {V83.Application}, Неопределено  -  
// Возвращаемое значение:
//    Строка - 
Функция ИмяОсновнойКонфигурации(Знач ПодключениеИР) Экспорт 
	ИмяОсновнойКонфигурации = ВосстановитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИмяКонфигурации");
	Если ИмяОсновнойКонфигурации = Неопределено Тогда
		ИмяОсновнойКонфигурации = ПодключениеИР.Метаданные.Имя; // 3мс
		СохранитьЗначениеСеансаКонфигуратора("ПодключениеИР.ИмяКонфигурации", ИмяОсновнойКонфигурации);
	КонецЕсли;
	Возврат ИмяОсновнойКонфигурации;
КонецФункции

Процедура ПерейтиВПоследниеМетоды()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НачатьСлежениеЗаТекущимМетодом();
	ПоследниеМетоды = ВосстановитьЗначениеСеансаКонфигуратора("ПоследниеМетоды"); // СписокЗначений
	Если ПоследниеМетоды = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИндексВыбранного = ВыбратьЭлементСписка(ПоследниеМетоды.ВыгрузитьЗначения(),,,, "Выберите метод",,,, Ложь);
	Если ИндексВыбранного = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылка = ПоследниеМетоды[ИндексВыбранного].Представление;
	ПерейтиПоСсылкеМД(Ссылка);
	ТурбоКонф.ОтжатьМодификаторы(); // Иначе будет иногда залипать CTRL
КонецПроцедуры

Процедура ПоказатьПриложениеИР()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР);
КонецПроцедуры

// . 
// Параметры:
//   ПолеТекстаПрограммы -  - 
// Возвращаемое значение:
//   Булево, Неопределено - загружена ли новая структура в ИР
Функция ПроверитьОбновитьСтруктуруФормы(ПолеТекстаПрограммы)
	Результат = Ложь;
	ДатаОбновленияСтруктурыФормы = ПолеТекстаПрограммы.ДатаОбновленияСтруктурыФормыМодуля();
	Если ДатаОбновленияСтруктурыФормы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сообщить("ДатаОбновленияСтруктурыФормы=" + ДатаОбновленияСтруктурыФормы);
	Если Истина
		И ТипЗнч(ДатаОбновленияСтруктурыФормы) = Тип("Дата") 
		И ТекущаяДата() - ДатаОбновленияСтруктурыФормы > ЧислоСекундДляАвтоОбновленияСтруктурыФормы() // автообновление не чаще раза в Х секнуд
	Тогда
		ОбновитьСтруктуруФормы(ПолеТекстаПрограммы, ЗначениеЗаполнено(ДатаОбновленияСтруктурыФормы)); 
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЧислоСекундДляАвтоОбновленияСтруктурыФормы() Экспорт
	Возврат 300;
КонецФункции

//.
// Параметры:
//    ПолеТекстаПрограммы - ОбработкаОбъект.ирКлсПолеТекстаПрограммы, Неопределено - 
Процедура ОбновитьСтруктуруФормы(Знач ПолеТекстаПрограммы, Знач РазобратьСнимокВФоне = Ложь) Экспорт
	Если ЛиВФоновомЗадании() Тогда
		// Буфер обмена будет возвращать пустое значение
		// Например в фоновом отслеживании текущих методов
		Возврат;
	КонецЕсли;
	Если РазобратьСнимокВФоне Тогда
		ИмяМетода = "ОбновитьСтруктуруФормыВФоне";
		МаксЧислоСекундЖдатьПередОбновлениемФормы = МаксЧислоСекундЖдатьПередОбновлениемФормы();
		Если ЗапрещенЗапускМоноЗадания(ИмяМетода, МаксЧислоСекундЖдатьПередОбновлениемФормы) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекстСтруктурыФормы = ""; 
	//ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно); // 50мс Без этого часто не будет срабатывать в вызове с подключением приложения ИР
	СтароеЗначениеБуфераОбмена = ТурбоКонф.ПолучитьБуферОбмена();
	АктивироватьТекущийОбъектВДеревеКонфигурации();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Сообщить("Активация формы в дереве - " + Длительность + "мс");
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТурбоКонф.КонтролКлавиша(Клавиши.C);
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала < ЧислоСекундДляАвтоОбновленияСтруктурыФормы() Цикл
		ТурбоКонф.Ждать(50);
		Попытка
			ОписаниеФормы = ТурбоКонф.ПолучитьБуферОбмена("1C:MD8 Data");
			ОписаниеОшибки = "";
		Исключение
			ОписаниеФормы = "";
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		Если ПолеТекстаПрограммы.ПроверитьОписаниеФормыИзБуфераОбмена(ОписаниеФормы) Тогда
			ТекстСтруктурыФормы = ТурбоКонф.ПолучитьБуферОбмена("1C:MD8 External Data");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ВернутьсяВПредыдущееМестоКонфигуратора();
	УстановитьБуферОбмена(СтароеЗначениеБуфераОбмена);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Сообщить("Копирование формы в буфер обмена - " + Длительность + "мс");
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Сообщить("ОшибкаПолученияСнимкаФормы=" + ОписаниеОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстСтруктурыФормы) Тогда
		ПоказатьВсплывающееУведомление("Сделайте форму видимой в дереве конфигурации, чтобы анализ модуля мог получить ее новую структуру", 4000);
	Иначе
		Если РазобратьСнимокВФоне Тогда
			ПараметрыЗадания = Новый Массив;
			ПараметрыЗадания.Добавить(ТекстСтруктурыФормы);
			ПараметрыЗадания.Добавить(ПолеТекстаПрограммы.мИмяМодуля);
			ПараметрыЗадания.Добавить(Истина);
			ЗапуститьМоноФоновоеЗадание(ИмяМетода, МаксЧислоСекундЖдатьПередОбновлениемФормы, ПараметрыЗадания);
		Иначе
			ОбновитьСтруктуруФормыВФоне(, ТекстСтруктурыФормы, ПолеТекстаПрограммы.мИмяМодуля);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//.
// Параметры:
//   ТекстСтруктурыФормы - Строка - 
Процедура ОбновитьСтруктуруФормыВФоне(Знач КлючСостоянияФоновогоМетода = "", Знач ТекстСтруктурыФормы, Знач ИмяМодуля, Знач ВФоне = Ложь) Экспорт
	Если ВФоне Тогда
		МоментНачала = ТекущаяДата();
		Пока ЛиОсновнойПотокЗанят() Цикл
			Если ТекущаяДата() - МоментНачала > МаксЧислоСекундЖдатьПередОбновлениемФормы() Тогда
				Возврат;
			КонецЕсли;
			ТурбоКонф.Ждать(2000);
		КонецЦикла;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы.мИмяМодуля <> ИмяМодуля Тогда
		// TODO сделать обновление и при смене активного модуля
		Возврат;
	КонецЕсли;
	Успех = Ложь;
	Сообщить("СтруктураФормы=" + Лев(ТекстСтруктурыФормы, 1000));
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ПолеТекстаПрограммы.УстановитьСлужебныеДанныеФормы(ТекстСтруктурыФормы);
		Успех = Истина;
	Исключение
		ПоказатьВсплывающееУведомление("Ошибка разбора снимка формы: " + ОписаниеОшибки(), 4000);
	КонецПопытки;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Сообщить("Разбор снимка формы " + ?(ВФоне, "фоновый", "синхронный") + " - " + Длительность + "мс");
	Если Успех Тогда
		ПоказатьВсплывающееУведомление("Кэш активной управляемой формы обновлен. Он обновляется периодически и при вводе точки от ее нового элемента", 3000);
	КонецЕсли;
КонецПроцедуры

Функция МаксЧислоСекундЖдатьПередОбновлениемФормы() Экспорт
	Возврат 60;
КонецФункции

// Защита от ошибки Турбоконфа с пустым параметром
Процедура УстановитьБуферОбмена(Текст)
	Если ЗначениеЗаполнено(Текст) Тогда // Защита от странной ошибки - Внешнее исключение (System.ArgumentNullException): Значение не может быть неопределенным. Имя параметра: text}    
		ТурбоКонф.УстановитьБуферОбмена(Текст);
	КонецЕсли;
КонецПроцедуры

Функция КлючКэшаИмениКонфигурацииДляПоля(Знач НомерРодителяПоля = 0, Знач ИдентификаторПоляСырой = Неопределено)
	Если НомерРодителяПоля = 0 Тогда
		Если ИдентификаторПоляСырой = Неопределено Тогда
			ИдентификаторПоля = ТурбоКонф.ПолучитьRuntimeId(); // 9мс
			// ИдентификаторПоля = ИдентификаторТекущегоЭлементаОкна();
			ИдентификаторПоля = СтрСоединить(ИдентификаторПоля, "-");
		Иначе
			ИдентификаторПоля = СтрЗаменить(ИдентификаторПоляСырой, " ", "-");
		КонецЕсли;
	Иначе
		//ВызватьИсключение "Внутренняя ошибка";
		ИдентификаторПоля = ТурбоКонф.ПолучитьRuntimeIdСИерархией(НомерРодителяПоля)[1]; // 9мс
		// ИдентификаторПоля = ТурбоКонф.ПолучитьRuntimeIdСИерархиейСтроками();
		ИдентификаторПоля = СтрСоединить(ИдентификаторПоля, "-");
	КонецЕсли;
	Сообщить("ИдентификаторПоля=" + ИдентификаторПоля);
	КлючКэша = "ИмяКонфигурации." + XMLСтрока(ИдентификаторПоля);
	Возврат КлючКэша;
КонецФункции

// Не используется
// теперь эту информацию получаем от Турбокнофа
Функция _ИмяКонфигурации()
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ГлавноеОкно);
	АктивироватьТекущийОбъектВДеревеКонфигурации();
	КлючКэшаИмениКонфигурации = КлючКэшаИмениКонфигурацииДляПоля(2);
	ИмяКонфигурации = ВосстановитьЗначениеСеансаКонфигуратора(КлючКэшаИмениКонфигурации);
	Если ПустаяСтрока(ИмяКонфигурации) Тогда
		СохранитьЗначениеСеансаКонфигуратора(КлючКэшаИмениКонфигурации, ИмяКонфигурации);
		ТурбоКонф.Клавиша(Клавиши.Home);
		ТурбоКонф.Ждать(100);
		ИмяКонфигурации = ВыделенныйТекст(Ложь);
		Если ИмяКонфигурации = "Мои шаблоны" Тогда
			// Залипла клавиша SHIFT при нажтии CTRL+T
			Возврат Неопределено;
		Иначе
			СохранитьЗначениеСеансаКонфигуратора(КлючКэшаИмениКонфигурации, ИмяКонфигурации);
		КонецЕсли;
		ВернутьсяВПредыдущееМестоКонфигуратора();
		АктивироватьТекущийОбъектВДеревеКонфигурации();
	КонецЕсли;
	Сообщить("ИмяКонфигурации = " + ИмяКонфигурации);
	ВернутьсяВПредыдущееМестоКонфигуратора();
	Возврат ИмяКонфигурации;
КонецФункции

Процедура ВернутьсяВПредыдущееМестоКонфигуратора() Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.OemMinus);
КонецПроцедуры

Функция ЧистыйЗаголовокДочернегоОкна(ЗаголовокОкнаКонфигуратора)
	ПолноеИмяМодуля = ЗаголовокОкнаКонфигуратора;
	ПозицияТире = Найти(ПолноеИмяМодуля, " - Конфигуратор");
	ПолноеИмяМодуля = СокрЛП(Лев(ПолноеИмяМодуля, ПозицияТире));
	Возврат ПолноеИмяМодуля;
КонецФункции

Функция ВывестиКонтекстЯзыка(ПолеТекстаПрограммы)
	ИмяМетода = ПолеТекстаПрограммы.ИмяТекущегоМетода();
	Сообщить("-Язык: " + ЯзыкПрограммы + ", Модуль: " + ПолеТекстаПрограммы.мИмяМодуля + ", Метод: " + ИмяМетода  + ", Позиция: " + ПозицияВТексте + ", Выражение: " + ПолеТекстаПрограммы.мКонтекст);
	Возврат ИмяМетода;
КонецФункции

//_ТолькоТекстовыеДокументы - не включать, т.к. нужна доступность в окне "Выражение"
//&ЗапроситьИнформациюОДокументе
Процедура ПоказатьПараметрыМетода()
	Если Не ПроверитьРазрешениеИР() Тогда
		ПродолжитьОбработкуНажатияКлавиш();
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ВФоне = Истина;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
	Если ПолеТекстаПрограммы <> Неопределено Тогда
		ФормаВызовМетода = ПолеТекстаПрограммы.ФормаВызовМетода(Истина);
		Если ФормаВызовМетода.Открыта() Тогда
			//ТурбоКонф.АктивироватьОкно(ТурбоКонф.НайтиОкноПоЗаголовку(ФормаВызовМетода.Заголовок));
			//Возврат;
			ВФоне = Ложь;
			ФормаВызовМетода.Закрыть();
		КонецЕсли;
	КонецЕсли; 
	Если Не ЭтоДокумент() Тогда
		ВФоне = Ложь;
	КонецЕсли;
	Если ВФоне Тогда
		Ключ = "ЛиФормаВызовМетодаОткрывалась";
		Модули = МодулиИР(ПодключениеИР);
		ЛиФормаВызовМетодаОткрывалась = ВосстановитьЗначениеСеансаКонфигуратора(Ключ);
		Если Ложь
			Или ЛиФормаВызовМетодаОткрывалась <> Истина // В некоторых окружениях в управляемом приложении первое открытие окна уходило на задний план
			Или Не Модули.ирКэш.ЛиСеансТолстогоКлиентаУПЛкс() // Нужно для обычного приложения, чтобы окно появлялось при повторном вызове
		Тогда
			ВосстановитьОкноПриложения(ПодключениеИР);
			ПодключениеИР.Visible = Ложь;
			СохранитьЗначениеСеансаКонфигуратора(Ключ, Истина);
		КонецЕсли;
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОткрытьПараметрыМетода",, Истина);
	Иначе
		ОткрытьПараметрыМетода();
	КонецЕсли;
КонецПроцедуры

//.
// Возвращаемое значение:
//    ОбработкаОбъект.ирКлсПолеТекстаПрограммы - 
Функция ПолеТекстаПрограммыИзКэша(Знач ИДКонфигуратора = Неопределено) Экспорт
	ПолеТекстаПрограммы = ВосстановитьЗначениеСеансаКонфигуратора("ПолеТекстаПрограммы", ИДКонфигуратора); // ОбработкаОбъект.ирКлсПолеТекстаПрограммы
	Возврат ПолеТекстаПрограммы;
КонецФункции

