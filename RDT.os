	МодулиИР.ирКлиент.ОткрытьПользователяИБЛкс(ИмяПользователя);
КонецПроцедуры 

Процедура ОткрытьЖурналПоПользователю()
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 1);
