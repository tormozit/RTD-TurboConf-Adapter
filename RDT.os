КонецПроцедуры 

Процедура СброситьПарольПользователю()
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	УстановитьФокусНаКнопкуСправка();
	НажатьКлавишуЦикл(Клавиши.Tab, 4);
	ТурбоКонф.Ждать(20);
	ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	ТурбоКонф.Клавиша(Клавиши.Tab);
	УстановитьЗначениеПолюВвода("", Ложь);
КонецПроцедуры

Процедура УстановитьОтборТолькоОшибки()
	Если Не ТурбоКонф.НайтиЭлементПоИмени("Основные", "вкладка") Тогда
		ПоказатьВсплывающееУведомление("Недоступно в этом окне");
		Возврат;
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Отборы", "кнопка");
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	НажатьКлавишуЦикл(Клавиши.Tab, 3, Истина);
	
	// Уровни важности
	//КликнутьПоЭлементу("Выключить все", "кнопка"); // Неуникальное имя кнопки
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	НажатьКлавишуЦикл(Клавиши.Tab, 3, Истина); 
	
	// Типы событий
	Если АктивироватьСтрокуДерева("Информационная база.Ошибка изменения конфигурации базы данных") Тогда
		ТурбоКонф.Клавиша(Клавиши.Space);
	КонецЕсли;
	
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);

КонецПроцедуры

Процедура ИмпортЭкспортНастроекКонфигуратора()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВосстановитьОкноПриложения(ПодключениеИР);
	МодулиИР = МодулиИР(ПодключениеИР);
	МодулиИР.ирКлиент.ОткрытьУправлениеПрофайлами1СЛкс(Истина);
КонецПроцедуры

Процедура ОткрытьСравнениеВерсийМетода()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	НажатьКлавишуЦикл(Клавиши.Left, 3);
	ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
	ИмяМетода = МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстЯчейки, " ");
	ЗаголовокЛевый = Сред(ТекстЯчейки, СтрДлина(ИмяМетода) + 2);
	ТурбоКонф.Клавиша(Клавиши.Right);
	ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
	ЗаголовокПравый = Сред(ТекстЯчейки, СтрДлина(ИмяМетода) + 2);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстПравый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстЛевый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	Модально = Истина; 
	
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Сравнение.*", 5000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(ТекстЛевый, ТекстПравый, Модально, ЗаголовокЛевый, ЗаголовокПравый,,, ИмяМетода,, "ВстроенныйЯзык", ИмяМетода);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
КонецПроцедуры

Процедура ОткрытьСравнениеТекстов()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ТурбоКонф.УстановитьФокусНаЭлемент("", "документ");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстПравый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстЛевый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	ВосстановитьОкноПриложения(ПодключениеИР);
	МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(ТекстЛевый, ТекстПравый, Ложь,,,,,,, "ВстроенныйЯзык", ЗаголовокОкна);
КонецПроцедуры

Процедура НайтиТочкуОстановаИлиЗакладку()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если НайтиВСписке() Тогда
		КликнутьПоЭлементу("Перейти к исходному коду", "кнопка");
	КонецЕсли;
КонецПроцедуры    

Процедура НайтиВСпискеОбъектовМетаданных()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если НайтиВСписке() Тогда
	КонецЕсли;
КонецПроцедуры  

Процедура НайтиЭлементКоллекцииВОкне() 
	ТурбоКонф.ОтжатьМодификаторы();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаПутемПеремещения();
	ЗаголовокНачальногоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если КликнутьПоЭлементу("Вывести список...", "кнопка") Тогда
		ТурбоКонф.ЖдатьОкно("Вывести список", 1000, Истина);
		УстановитьФокусВПервуюТаблицуИлиСписок();
		Если Ложь
			Или ЗаголовокНачальногоОкна = "ТаблицаЗначений"
			Или ЗаголовокНачальногоОкна = "Структура"
			Или ЗаголовокНачальногоОкна = "Соответствие"
			Или ЗаголовокНачальногоОкна = "СписокЗначений"
			Или Найти(ЗаголовокНачальногоОкна, "ТабличнаяЧасть.") > 0
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "КоллекцияСтрок")
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "КоллекцияКолонок")
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "ДанныеФормы")
		Тогда
			// Ускорение
			ТурбоКонф.Клавиша(Клавиши.Down);
			ТурбоКонф.Клавиша(Клавиши.Space); // - Значение элемента
			ТурбоКонф.Клавиша(Клавиши.Down);
			ТурбоКонф.Клавиша(Клавиши.Space); // - Тип элемента
		КонецЕсли;
		Окно = ТурбоКонф.ПолучитьАктивноеОкно();
		ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
		ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, 5000);  
		КликнутьПоЭлементу("Закрыть", "кнопка"); // Окно само не восстанавливает фокус
		Счетчик = 0;
		Успех = Ложь;
		Пока Счетчик < 10  Цикл
			ТурбоКонф.Ждать(20); // Нужно время чтобы конфигуратор после передачи управления главному окну активировал предыущее дочернее
			ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
			Сообщить("ЗаголовокОкна=" + ЗаголовокОкна);
			Если ЛиАктивноГлавноеОкно(ЗаголовокОкна) Тогда
				Успех = Истина;
				Прервать;
			КонецЕсли;
			Если ЗаголовокОкна = "Выражение" Тогда  
				УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
				ПоследнееВыражение = ТурбоКонф.ПолучитьЗначение();
			КонецЕсли;
			ЗакрытьМодальноеОкно();
			//ЗакрытьДочернееОкноКонфигуратора(); // тоже работает
			Счетчик = Счетчик + 1;
		КонецЦикла; 
		Если Не Успех Тогда
			Возврат;
		КонецЕсли; 
		ИмяФайлаТабличногоДокумента = СохранитьСодержимоеОкнаВоВременныйФайл();
		ЗакрытьДочернееОкноКонфигуратора();
		//ПерейтиКТекущейСтрокеИсполнения(); // Контекст может находиться не в верхней строке стека
		ПодключениеИР = ОткрытьОкноВыражения();  // Почему то тут срабатывает команда ВычислитьВыражение скрипта при отправке нажатия SHIFT+F9
		Если ПодключениеИР = Неопределено Тогда
			УдалитьФайлы(ИмяФайлаТабличногоДокумента);
			Возврат;
		КонецЕсли;
		УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
		УстановитьЗначениеПолюВвода(ПоследнееВыражение);
		ЖдатьВычислениеВыражения();
		ТурбоКонф.Клавиша(Клавиши.F2);
		ТурбоКонф.ЖдатьОкно(ЗаголовокНачальногоОкна, 1000, Истина);
		ТурбоКонф.Ждать(20);
		ТурбоКонф.Клавиша(Клавиши.Up); // Иначе поиск не сработает  
		НайтиВСписке(ЯчейкиТекущейСтроки, ИмяФайлаТабличногоДокумента);
	КонецЕсли;
КонецПроцедуры  

Процедура КнопкаОткрытьЭлементКоллекции()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ИмяСвойства = ПоследнийФрагментЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	ТурбоКонф.Клавиша(Клавиши.F2);
	ЖдатьОкноВыражение();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Ждать(20);
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Down); // Иначе поиск не сработает
	Если Истина
		И ЗначениеЗаполнено(ИмяСвойства)
		И ИмяСвойства <> "элемента"
		И ИмяСвойства <> "Индекс"
	Тогда
		НайтиСтрокуВОкне(ИмяСвойства);
	КонецЕсли;
КонецПроцедуры  

Процедура СократитьКоллекциюИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если Не КликнутьПоЭлементу("Показать значение в отдельном окне", "кнопка") Тогда
		Возврат;
	КонецЕсли;
	ЖдатьОкноВыражение();
	Фрагменты = СтрРазделить(ТурбоКонф.ПолучитьЗначение(), "[]", Ложь);
	Индекс = Число(Фрагменты[Фрагменты.ВГраница()]);
	ЗакрытьМодальноеОкно();
	ЗакрытьМодальноеОкно();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	ВыражениеКоллекции = ТурбоКонф.ПолучитьЗначение();
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "СокрКол");
	УстановитьЗначениеПолюВвода(ТекстВызова + "(" + ВыражениеКоллекции + ", " + XMLСтрока(Индекс) + ")");
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(ВыражениеКоллекции);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.F2);
	Если Найти(ТекстыЯчеек[1], "Ошибка ") > 0 Тогда
		ПоказатьВсплывающееУведомление(ТекстыЯчеек[1]);
	КонецЕсли;
КонецПроцедуры  

Процедура ЗапомнитьКоллекциюДляСравнения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ОкноКоллекции = ТурбоКонф.ПолучитьАктивноеОкно();
	КликнутьПоЭлементу("Вывести список...", "кнопка");
	ТурбоКонф.ЖдатьОкно("Вывести список", 1000, Истина);
	ОкноПараметров = Турбоконф.ПолучитьАктивноеОкно();
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина); 
	// Сначала активируется окно коллекции, затем активируется главное окно, но без принятия ввода
	ТурбоКонф.ЖдатьСменуАктивногоОкна(ОкноПараметров, 1000);
	ТурбоКонф.ЖдатьСменуАктивногоОкна(ОкноКоллекции, 1000);
	ИмяДокумента = МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТурбоКонф.ПолучитьЗаголовокКонфигуратора(Конфигуратор.ГлавноеОкно), " - ");
	ТурбоКонф.АктивироватьОкно(ОкноКоллекции);
	БуферСравненияКоллекций = ВосстановитьЗначениеСеансаКонфигуратора("БуферСравненияКоллекций");
	Если БуферСравненияКоллекций = Неопределено Тогда
		БуферСравненияКоллекций = Новый Массив;
	КонецЕсли;
	БуферСравненияКоллекций.Добавить(ИмяДокумента);
	Если БуферСравненияКоллекций.Количество() > 1 Тогда
		Пока Не ЛиАктивноГлавноеОкно() Цикл
			ЗакрытьМодальноеОкно();
		КонецЦикла;
		ИмяФайла2 = СохранитьСодержимоеОкнаВоВременныйФайл(, 2);
		ВернутьсяВПредыдущееМестоКонфигуратора();
		ИмяФайла1 = СохранитьСодержимоеОкнаВоВременныйФайл(, 2);
		БуферСравненияКоллекций.Очистить();
		ТурбоКонф.ОткрытьМеню("Файл", "Сравнить файлы…");
		ТурбоКонф.ЖдатьОкно("Сравнить файлы", 1000, Истина);
		ТурбоКонф.УстановитьЗначение(ИмяФайла1);
		ТурбоКонф.Клавиша(Клавиши.Tab);
		ТурбоКонф.УстановитьЗначение(ИмяФайла2);
		ТурбоКонф.Клавиша(Клавиши.Enter);
	КонецЕсли;
	СохранитьЗначениеСеансаКонфигуратора("БуферСравненияКоллекций", БуферСравненияКоллекций);
КонецПроцедуры  

Функция ЖдатьОкноВыражение() Экспорт
	Попытка
		//ТурбоКонф.ЖдатьОкно("Выражение", 1000, Истина,, Истина); // 6.3.9141.36481 https://turboconf.ru/Tasks/9996
	Исключение
	КонецПопытки;
	Если Не ЖдатьПотерюАктивностиОкна(,, Истина) Тогда
		ВызватьИсключение "Не дождались окна ""Выражение""";
	КонецЕсли;
КонецФункции  

Процедура КнопкаНоваяОбычнаяГруппаВертикальная(Знач НомерВариантаГруппы = 1)
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.Home);
	НажатьКлавишуЦикл(Клавиши.Down, НомерВариантаГруппы - 1);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	АктивироватьСвойствоВПалитреСвойств("Группировка");
	ТурбоКонф.КонтролКлавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Up);
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры 

Процедура КнопкаНоваяОбычнаяГруппаГоризонтальная(Знач НомерВариантаГруппы = 1)
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.Home);
	НажатьКлавишуЦикл(Клавиши.Down, НомерВариантаГруппы - 1);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	АктивироватьСвойствоВПалитреСвойств("Группировка");
	ТурбоКонф.КонтролКлавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры  

Процедура КнопкаУстановитьФорматПолнойДаты()
	УстановитьФокусНаКнопкуСправка();
	ТурбоКонф.Клавиша(Клавиши.Tab);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	ТурбоКонф.Ждать(20);
	Если Не ТурбоКонф.УстановитьФокусНаЭлемент("Формат даты", "флажок") Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Tab);
	УстановитьЗначениеПолюВвода("dd.MM.yyyy HH:mm:ss");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
КонецПроцедуры  

Процедура КнопкаНайтиКартинку()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ИмяКартинки = ТурбоКонф.ПолучитьИмяЭлемента();
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Картинки.*", 5000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		ВыбраннаяКартинка = МодулиИР.ирКлиент.ОткрытьВыборКартинкиЛкс(, ИмяКартинки);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если ВыбраннаяКартинка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если ВыбраннаяКартинка.Встроенная Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	КонецЕсли;
	НайтиСтрокуВОкне(ВыбраннаяКартинка.Имя, Истина);
КонецПроцедуры    

Процедура НастроитьОтборПоПодсистемам()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КонтекстИнтерфейса = КонтекстИнтерфейса();
	Если Не КонтекстИнтерфейса.ПоддерживаетПоиск Тогда
		ПоказатьВсплывающееУведомление("В данном контексте не поддерживается, т.к. в нем не работает поиск");
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	МодулиИР = МодулиИР(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Выбор.*", 5000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		ВыбранныеПодсистемы = МодулиИР.ирКлиент.ОткрытьВыборПодсистемЛкс();
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если ВыбранныеПодсистемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	// Снимаем все пометки
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Space);
	// Устанавливаем выбранные пометки
	Для Каждого ПолноеИмяПодсистемы Из СтрРазделить(ВыбранныеПодсистемы, ", ", Ложь) Цикл
		ИмяПодсистемы = ПоследнийФрагментЛкс(ПолноеИмяПодсистемы);
		Если Не НайтиУзелДерева(ПодключениеИР, ИмяПодсистемы) Тогда
			ПоказатьВсплывающееУведомление(СтрШаблон("Подсистема %1 не найдена в окне конфигуратора", ИмяПодсистемы));
		Иначе
			ТурбоКонф.Клавиша(Клавиши.Space);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры       

//&ВосстанавливатьБуферОбмена
Процедура ВыполнитьПроизвольныйКод()
	Если Не ЛиДоступенВводВыражения() Тогда
		ПоказатьВсплывающееУведомление("Недоступно во вложенном окне из-за недоступности ввода выражения");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ВычисленноеВыражение = ТекстВычисленногоМногострочногоВыражения();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	КлючПамяти = ПолеТекстаПрограммы.ПолноеИмяМетода() + ";ПроизвольныйКод";
	Если Истина
		И Найти(ВычисленноеВыражение, Символы.ПС) 
		И Найти(ВычисленноеВыражение, ";")
	Тогда
		СтарыйТекст = ВычисленноеВыражение;
	Иначе
		СтарыйТекст = ВосстановитьЗначениеСеансаКонфигуратора(КлючПамяти);
	КонецЕсли;
	ТекстПоля = Новый Массив;
	Если ЗначениеЗаполнено(СтарыйТекст) Тогда
		ТекстПоля.Добавить(СтарыйТекст);
	КонецЕсли;
	ВременноеВыражение = "Новый Структура(""_"")";
	ТекущееВыражение = ТурбоКонф.ПолучитьЗначение();
	Если Истина
		И Найти(СтарыйТекст, ТекущееВыражение) = 0
		И Найти(ТекущееВыражение, "ирОбщий.Оперировать") = 0
		И Найти(ТекущееВыражение, ВременноеВыражение) = 0
		И Найти(ВычисленноеВыражение, Символы.ПС) = 0
	Тогда
		ТекстПоля.Добавить("//" + ТекущееВыражение);
	КонецЕсли;
	ТекстПоля = СтрСоединить(ТекстПоля, Символы.ПС);
	ТурбоКонф.Клавиша(Клавиши.Tab);
	ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка();
	Если ТекстыЯчеек.Количество() Тогда
		ТекстОшибки = ТекстыЯчеек[1];
		//Сообщить("ТекстОшибки=" + ТекстОшибки);
	КонецЕсли;
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	УстановитьЗначениеПолюВвода(ВременноеВыражение);
	ЖдатьВычислениеВыражения();
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Ждать(20);
	ОткрытьОкноУстановкиЗначенияВВидеВыражения();
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ТекстУведомления = "Запущен рачет типов переменных"; 
	// Почему то такое уведомление не скрывается
	//Уведомление = ПоказатьВсплывающееУведомление(ТекстУведомления); // Не исчезает до закрытия окна
	//ПолеТекстаПрограммы.РассчитатьТипыПеременных();
	//ТурбоКонф.СкрытьВсплывающееУведомление(Уведомление);
	ТурбоКонф.ПоказатьУведомление(ТекстУведомления, 2000);
	БлокируемоеОкно = ОткрытьГлавноеОкноИРИОповеститьОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Текст.*", 10000, БлокируемоеОкно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		СтруктураВызова = ПолеТекстаПрограммы.ОткрытьРедакторКодаДляОтладчика(ТекстПоля, ТекстОшибки); // Основное время перед открытием уходит на расчет типов переменных модуля
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(БлокируемоеОкно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если СтруктураВызова = Неопределено Тогда
		ТурбоКонф.Клавиша(Клавиши.Escape);
		Возврат;
	КонецЕсли;
	Если КлючПамяти <> Неопределено Тогда
		СохранитьЗначениеСеансаКонфигуратора(КлючПамяти, СтруктураВызова.Текст);
	КонецЕсли;
	
	// Так не увидим текст ошибки
	//ТурбоКонф.ВставитьТекст("ирОбщий.Оперировать(" + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ", 2, " + """" + СтруктураВызова.ИменаПараметров + """, " + СтруктураВызова.ИменаПараметров + ")");
	//ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
    //
	ИмяХранилища = "КодДляОтладчика";
	ТурбоКонф.ВставитьТекст("ирОбщий.СохранитьЗначениеЛкс(""" + ИмяХранилища + """, " + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ")");
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	ЗакрытьМодальноеОкно();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода("ирОбщий.Оперировать(ирОбщий.ВосстановитьЗначениеЛкс(""" + ИмяХранилища + """), 2, " + """" + СтруктураВызова.ИменаПараметров + """, " + СтруктураВызова.ИменаПараметров + ")");
	УстановитьФокусВПервуюТаблицуИлиСписок();
КонецПроцедуры

Процедура ОткрытьОкноУстановкиЗначенияВВидеВыражения() Экспорт
	КликнутьПоЭлементу("Установить новое значение в виде выражения", "кнопка");
	ТурбоКонф.ЖдатьОкно("Ввод выражения", 1000, Истина);
	ТурбоКонф.Ждать(20);
КонецПроцедуры

//&ВосстанавливатьБуферОбмена
Процедура ПрерватьОтлаживаемыйКод()
	Если Не ЛиДоступенВводВыражения() Тогда
		ПоказатьВсплывающееУведомление("Недоступно во вложенном окне из-за недоступности ввода выражения");
		Возврат;
	КонецЕсли;
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФиктивноеВыражениеДляУстановкиЗначения();
	ОкноВыражения = ТурбоКонф.ПолучитьАктивноеОкно();
	СтруктураВызова = ПолеТекстаПрограммы.КодОчисткиПеременныхДляОтладчика();

	// Так не увидим текст ошибки, но тут она не интересна и не упремся в длину поля ввода
	ТурбоКонф.ВставитьТекст("ирОбщий.Оперировать(" + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ", 2, 
	|" + """" + СтруктураВызова.ИменаПараметров + """, 
	|" + СтруктураВызова.ИменаПараметров + ")");
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	ТурбоКонф.Ждать(50);
	ЗакрытьМодальноеОкно();
	ЗакрытьМодальноеОкно();
	//ПоказатьВсплывающееУведомление("Очищены все локальные переменные");
	ТурбоКонф.ШифтКлавиша(Клавиши.F11);
КонецПроцедуры

//&ВосстанавливатьБуферОбмена
Процедура КнопкаВставитьУсловиеИзТабло()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
	ТурбоКонф.КопироватьТекстВБуфер();
	ТекстУсловия = СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена();
	ВернутьсяВПредыдущееМестоКонфигуратора();
	ДобавитьУсловиеОстанова(ТекстУсловия);
КонецПроцедуры  

//&ВосстанавливатьБуферОбмена
Процедура КнопкаВставитьДинамическоеПрисвоение()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстСтарый = АктивироватьУсловиеВОкнеПараметрыТочкиОстанова();
	ФрагментыРавно = СтрРазделить(ТекстСтарый, "= ", Ложь);
	Если ФрагментыРавно.Количество() > 0 Тогда
		ЛевоеЗначение = ФрагментыРавно[0];
	Иначе
		ЛевоеЗначение = "ЧемуПрисвоить";
	КонецЕсли;
	Если ФрагментыРавно.Количество() > 1 Тогда
		ПравоеЗначение = ФрагментыРавно[1];
	Иначе
		ПравоеЗначение = "ЧтоПрисвоить";
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "Пр");
	Если Найти(ТекстСтарый, ТекстВызова) Тогда
		Возврат;
	КонецЕсли;
	ТекстУсловия = ТекстВызова + "(" + ЛевоеЗначение + ", " + ПравоеЗначение + ", 1)";
	КомандаВыделитьВсе();
	ТурбоКонф.ВставитьТекст(ТекстУсловия);
КонецПроцедуры 

//&ВосстанавливатьБуферОбмена
Процедура КнопкаВставитьУсловиеИзМодуля()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	РазобратьПозициюВТексте();
	Выражение = ВыделенныйТекст;
	Если ПустаяСтрока(Выражение) Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст);
		Выражение = ПолеТекстаПрограммы.ТекущееОбъектноеВыражение();
		Если Прав(Выражение, 1) = "(" Тогда
			Выражение = Выражение + ")";
		КонецЕсли;
		ИмяТипаКонтекста = "";
		Если ПолеТекстаПрограммы.ЛиТекущееВыражениеИмеетСлово("Количество", "Метод", ИмяТипаКонтекста) Тогда
			Выражение = Выражение + ".Количество() > 0";
		ИначеЕсли ИмяТипаКонтекста = "Строка" Тогда
			Выражение = "Найти(" + Выражение + ", """")";
		Иначе
			Выражение = Выражение + " = ";
		КонецЕсли;
	ИначеЕсли Найти(Выражение, " ") Тогда
		Выражение = "(" + Выражение + ")";
	КонецЕсли;
	ДобавитьУсловиеОстанова(Выражение);
КонецПроцедуры 

//&ВосстанавливатьБуферОбмена
Процедура КнопкаВставитьВыражениеИзМодуля()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	РазобратьПозициюВТексте();
	Выражение = ВыделенныйТекст;
	Если ПустаяСтрока(Выражение) Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст);
		Выражение = ПолеТекстаПрограммы.ТекущееОбъектноеВыражение();
		Если Прав(Выражение, 1) = "(" Тогда
			Выражение = Выражение + ")";
		КонецЕсли;
		ИмяТипаКонтекста = "";
		Если ПолеТекстаПрограммы.ЛиТекущееВыражениеИмеетСлово("Количество", "Метод", ИмяТипаКонтекста) Тогда
			Выражение = Выражение + ".Количество()";
		ИначеЕсли ИмяТипаКонтекста = "Строка" Тогда
			Выражение = "Лев(" + Выражение + ", 100)";
		КонецЕсли;
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.F9);
	ТурбоКонф.ЖдатьОкно("Параметры точки останова", 200, Истина);
	ТурбоКонф.Ждать(10); // эффект не подтвержден
	ТурбоКонф.УстановитьФокусНаЭлемент("Выводить в окно служебных сообщений", "флажок");
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	НажатьКлавишуЦикл(Клавиши.Tab, 2);
	ТурбоКонф.ВставитьТекст(Выражение);
	Если СтрДлина(Выражение) > 60 Тогда
		ТурбоКонф.Клавиша(Клавиши.Home);
	КонецЕсли;
КонецПроцедуры 

//&ВосстанавливатьБуферОбмена
Процедура КнопкаВставитьУсловиеИзБуфера()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Выражение = ТурбоКонф.ПолучитьБуферОбмена();
	Если ПустаяСтрока(Выражение) Тогда
		Возврат;
	КонецЕсли;        
	ТекстУсловия = Выражение + " = ";
	ДобавитьУсловиеОстанова(ТекстУсловия);
КонецПроцедуры 

Процедура КнопкаПерейтиИзНавигатора()
КонецПроцедуры 

Функция СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена(Знач БазовыйПуть = "") Экспорт
	ТекстыЯчеек = СтрРазделить(ТурбоКонф.ПолучитьБуферОбмена(), Символы.Таб + Символы.ПС + Символы.ВК);
	ЭлементыУсловия = Новый Массив;
	ЧислоКолонокВСтроке = 4;
	Для НомерСтрокиТекста = 1 По Макс(1, ТекстыЯчеек.Количество() / ЧислоКолонокВСтроке) Цикл
		ИндексПервойЯчейки = (НомерСтрокиТекста-1)*ЧислоКолонокВСтроке;
		ТипЗначения = ТекстыЯчеек[ИндексПервойЯчейки + 2];
		Если ПустаяСтрока(ТипЗначения) Тогда
			Продолжить;
		КонецЕсли;
		ТекстВыражения = ТекстыЯчеек[ИндексПервойЯчейки + 0];
		Если Найти(ТекстВыражения, ".") = 0 Тогда
			ТекстВыражения = БазовыйПуть + ТекстВыражения;
		КонецЕсли;
		ЗначениеВыражения = ТекстыЯчеек[ИндексПервойЯчейки + 1];
		Если Ложь
			Или ТипЗначения = "Строка" 
			Или ТипЗначения = "String" 
			Или ТипЗначения = "Булево"
			Или ТипЗначения = "Boolean" 
		Тогда
			ЭлементУсловия = ТекстВыражения + " = " + ТекстВВыражениеВстроенногоЯзыкаЛкс(ТекстБезКрайнихСимволовЛкс(ЗначениеВыражения));
		ИначеЕсли Ложь
			Или ТипЗначения = "Null"
			Или ТипЗначения = "Неопределено"
			Или ТипЗначения = "Undefined"
		Тогда
			ЭлементУсловия = ТекстВыражения + " = " + ТипЗначения;
		ИначеЕсли Ложь
			Или ТипЗначения = "Число" 
			Или ТипЗначения = "Number" 
		Тогда
			ЭлементУсловия = ТекстВыражения + " = " + СтрЗаменить(ЗначениеВыражения, Символы.НПП, "");
		Иначе
			ЭлементУсловия = """""+" + ТекстВыражения + " = " + ТекстВВыражениеВстроенногоЯзыкаЛкс(ЗначениеВыражения);
		КонецЕсли;
		Сообщить("ЭлементУсловия="+ЭлементУсловия);
		ЭлементыУсловия.Добавить(ЭлементУсловия);
	КонецЦикла;
	ТекстУсловия = СтрСоединить(ЭлементыУсловия, Символы.ПС + "И ");
	Возврат ТекстУсловия;
КонецФункции 

//&ВосстанавливатьБуферОбмена
Процедура ВставитьОшибкуИзБуфера()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ПричиныОшибок = Новый Массив;
	ТекстОшибки1 = ТурбоКонф.ПолучитьБуферОбмена();
	МодулиИР = МодулиИР(ПодключениеИР);
	ПричинаОшибки1 = СокрЛП(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстОшибки1, "{", Ложь));
	Если ЗначениеЗаполнено(ПричинаОшибки1) Тогда
		ПричиныОшибок.Добавить(ПричинаОшибки1);
	КонецЕсли;
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.O);
	//ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	ТурбоКонф.Ждать(20);
	ТекстОшибки2 = ТурбоКонф.ПолучитьТекстТекущегоЭлемента();
	ПричинаОшибки2 = СокрЛП(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстОшибки2, "{", Ложь));
	Если ЗначениеЗаполнено(ПричинаОшибки2) Тогда
		ПричиныОшибок.Добавить(ПоследнийФрагментЛкс(ПричинаОшибки2, Символы.ПС));
	КонецЕсли;
	ТурбоКонф.ОткрытьМеню("Отладка", "Остановка по ошибке...");
	Если ПричиныОшибок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Останавливаться по ошибке", "флажок");
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Останавливаться только на ошибках, включающих текст", "флажок");
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка();
	ЧислоКолонок = 2;
	ЗаголовокКолонки = "Текст в сообщении об ошибке";
	Для Каждого Причина Из ПричиныОшибок Цикл
		//НайтиСтрокуВОкне(Причина); // Тут не работает поиск
		ИндексЯчейки = ТекстыЯчеек.Найти(Причина + " " + ЗаголовокКолонки);
		Если ИндексЯчейки <> Неопределено Тогда
			ТурбоКонф.Клавиша(Клавиши.Home);
			НажатьКлавишуЦикл(Клавиши.Down, ИндексЯчейки / ЧислоКолонок);
			ТурбоКонф.Клавиша(Клавиши.Delete);
		КонецЕсли;
		КликнутьПоЭлементу("Добавить", "кнопка");
		УстановитьЗначениеПолюВвода(Причина);
	КонецЦикла;
КонецПроцедуры 

//&ВосстанавливатьБуферОбмена
Процедура КнопкаУсловиеОстанова()
	//ПодключениеИР = ПодключениеИР();
	//Если ПодключениеИР = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.КопироватьТекстВБуфер();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	ПутьКСвойству = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьЗначение());
	Если ЗначениеЗаполнено(ПутьКСвойству) Тогда
		ПутьКСвойству = ПутьКСвойству + ".";
	КонецЕсли;
	ТекстУсловия = СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена(ПутьКСвойству);
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(ТекстУсловия, Истина);
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ДобавитьУсловиеОстанова(ТекстУсловия);
КонецПроцедуры 

Процедура ВычислитьСвойствоРодителяИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение(Истина);
	Если ПустаяСтрока(СтруктураВыражения.Родитель) Тогда
		Возврат;
	КонецЕсли;    
	УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
КонецПроцедуры     

//.
// Возвращаемое значение:
//   Структура - 
Функция СтруктураВыраженияОкнаВыражение(Знач ПерейтиНаУровеньВышеЕслиРаскрытОдинРодитель = Ложь) Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Родитель = СтрокаБезПоследнегоФрагментаЛкс(Выражение);
	Свойство = ПоследнийФрагментЛкс(Выражение);
	Если ПерейтиНаУровеньВышеЕслиРаскрытОдинРодитель Тогда
		ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(3);
		Если ЯчейкиТекущейСтроки.Количество() Тогда
			КликнутьПоЭлементу(ЯчейкиТекущейСтроки[0], ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента());
			РазвернутьДеревоИПерейтиВНачало();
			ТекстКорневойЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
			Если Истина
				И Найти(Родитель, ".")
				И ТекстКорневойЯчейки = Родитель + " Свойство" 
			Тогда
				Выражение = Родитель;
				Родитель = СтрокаБезПоследнегоФрагментаЛкс(Выражение);
				Свойство = ПоследнийФрагментЛкс(Выражение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Свойство = СтрРазделить(Свойство, "[]")[0];
	Результат = Новый Структура;
	Результат.Вставить("Выражение", Выражение);
	Результат.Вставить("Родитель", Родитель);
	Результат.Вставить("Свойство", Свойство);
	Сообщить("Выражение="+Выражение);
	Сообщить("Родитель="+Родитель);
	Возврат Результат;
КонецФункции     

Процедура ПодробноОкнаВыражение()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Если Найти(СтруктураВыражения.Свойство, "(") > 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(СтруктураВыражения.Выражение, Истина);
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СтруктураВыражения.Родитель) Тогда
		СтруктураВыражения.Родитель = СтруктураВыражения.Выражение;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "Стк");
	Если СтрНачинаетсяС(СтруктураВыражения.Родитель, ТекстВызова) Тогда
		СтруктураВыражения.Родитель = СтрЗаменить(СтруктураВыражения.Родитель, ТекстВызова + "(", "");
		СтруктураВыражения.Родитель = СтрЗаменить(СтруктураВыражения.Родитель, ")", ""); // Опасно
	КонецЕсли;
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Родитель + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ЖдатьВычислениеВыражения();
	Если Не НайтиСтрокуВОкне(СтруктураВыражения.Свойство, Истина) Тогда
		ПоказатьВсплывающееУведомление("Тип объекта не поддерживается");
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	КонецЕсли;
КонецПроцедуры  

Процедура КнопкаЛовитьИзменениеЗначенияВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(СтруктураВыражения.Выражение, Истина);
		Возврат;
	КонецЕсли;
	ВыражениеРодитель = Модули.ирОбщий.СтрокаБезПоследнегоФрагментаЛкс(СтруктураВыражения.Выражение);
	ВыражениеСын = ПоследнийФрагментЛкс(СтруктураВыражения.Выражение);
	Если Ложь
		Или ПустаяСтрока(ВыражениеРодитель)
	Тогда
		ПоказатьВсплывающееУведомление("Допускается передача только выражения с точкой");
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ЗапомнитьДляПроверкиИзмененийЛкс");
	Выражение = ТекстВызова + "(" + ВыражениеРодитель + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	Результат = ЖдатьВычислениеВыражения();
	ЗакрытьМодальноеОкно();
	ГлобальныйПутьКСвойству = ТекстБезКрайнихСимволовЛкс(Результат[1]) + "." + ВыражениеСын;
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "Изм");
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
	СвернутьДеревоИПерейтиВНачало();
	ТурбоКонф.Ждать(10);
	Для Сч=1 По 20 Цикл
		Если Не НайтиСтрокуВОкне(ТекстВызова) Тогда 
		//Если ЛиТаблицаПуста() Тогда // Если включено, удаляем все выражения для ускорения 
			Прервать;
		КонецЕсли;
		ТурбоКонф.Клавиша(Клавиши.Delete);
		Прервать;
	КонецЦикла;
	Выражение = ТекстВызова + "(" + ГлобальныйПутьКСвойству + ", """ + Модули.ирОбщий.ТекущееВремяЛкс() + """)"; 
	Если ПодготовитьТаблоДляДобавления() Тогда
		ДобавитьВыражениеВТабло(Выражение);
		КлючСостоянияШаганияОтладчика = КлючСостоянияШаганияОтладчика();
		СостояниеШагания = СостояниеШагания(СтруктураВыражения);
		СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияШаганияОтладчика, СостояниеШагания);
		КликнутьПоЭлементу(" Значение", "неизвестный"); // Нельзя делать в фоновом задании, т.к. будут жесткие подвисания в перемещении указателя мыши
		ТурбоКонф.Клавиша(Клавиши.Up);
		Если Не ЗапуститьМоноФоновоеЗадание("ШагатьОтладчикомДоИзмененияСвойства") Тогда
			ПоказатьВсплывающееУведомление("Пошаговая отладка уже выполняется");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция СостояниеШагания(Знач СтруктураВыражения)
	СостояниеШагания = Новый Структура;
	СостояниеШагания.Вставить("Остановить", Ложь);
	СостояниеШагания.Вставить("Выражение", СтруктураВыражения.Выражение);
	Возврат СостояниеШагания;
КонецФункции

Процедура ШагатьОтладчикомДоИзмененияСвойства(КлючСостоянияФоновогоМетода) Экспорт
	КлючСостоянияШаганияОтладчика = КлючСостоянияШаганияОтладчика();
	СостояниеШагания = ВосстановитьЗначениеСеансаКонфигуратора(КлючСостоянияШаганияОтладчика); // см. СостояниеШагания
	Уведомление = ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), "Не жми клавиши. Пока активно окно шагаю до изменения свойства = " + СостояниеШагания.Выражение,
		Неопределено, ЭтотОбъект, "ОстановитьШагание",, "Остановить");
	ТурбоКонф.Клавиша(Клавиши.F11); // Первый шаг не проверяем, т.к. старое закэшированное значение может дать ложное срабатывание
	Счетчик = 1;
	МоментНачала = ТекущаяДата();
	Успех = Ложь;
	Попытка
		Пока Истина Цикл
			ТурбоКонф.Клавиша(Клавиши.F11);
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
			ТурбоКонф.Ждать(5); // Иначе табло не успевает обновиться. Чем больше значение и чем меньше выражений в табло, тем выше вероятность сразу увидеть новые значения выражений
			Если ТурбоКонф.ПолучитьАктивноеОкно() <> Конфигуратор.ГлавноеОкно Тогда
				ПричинаОстановки = "потери активности окна конфигуратора";
				Прервать;
			КонецЕсли;
			ТекстЗначения = ТурбоКонф.ПолучитьИмяЭлемента();
			//Сообщить("ТекстЗначения="+ТекстЗначения);
			Если СтрНачинаетсяС(ТекстЗначения, "Истина") Тогда
				ПричинаОстановки = "ИЗМЕНЕНИЯ значения в одном из последних шагов";
				Успех = Истина;
				Прервать;
			КонецЕсли;
			Если Найти(ТекстЗначения, "{") > 0 Тогда
				ПричинаОстановки = "потери в кэше указателя на объект или мешающих выражений в табло";
				Прервать;
			КонецЕсли;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		Длительность = Макс(1, ТекущаяДата() - МоментНачала);
		Скорость = Цел(Счетчик / Длительность);
		Статистика = СтрШаблон(" Шаги: %1/%2=%3 ш/с", Счетчик, Длительность, Скорость);
		ДлительностьУведомления = ?(Успех, Неопределено, 5000);
		ПоказатьВсплывающееУведомление("Шагание остановлено из-за " + ПричинаОстановки + ". " + Статистика, ДлительностьУведомления);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ТурбоКонф.СкрытьВсплывающееУведомление(Уведомление); 
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
КонецПроцедуры

Процедура ОстановитьШагание(ПараметрыОбработчика) Экспорт
КонецПроцедуры

Функция КлючСостоянияШаганияОтладчика() Экспорт
	Возврат "ОстановитьШаганиеОтладчика";
КонецФункции

Процедура УстановитьРодителяИСвойствоВОкнеВыражение(Знач СтруктураВыражения) Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Если ЗначениеЗаполнено(СтруктураВыражения.Родитель) Тогда
		УстановитьЗначениеПолюВвода(СтруктураВыражения.Родитель);
	Иначе
		УстановитьЗначениеПолюВвода(СтруктураВыражения.Выражение);
	КонецЕсли;
	ЖдатьВычислениеВыражения();
	НайтиСтрокуВОкне(СтруктураВыражения.Свойство, Истина);
КонецПроцедуры

Процедура СравнитьОбъектыИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(СтруктураВыражения.Выражение, Истина);
		Возврат;
	КонецЕсли;
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(3);
	Если ЯчейкиТекущейСтроки.Количество() Тогда
		Если ЯчейкиТекущейСтроки[2] = "Строка Тип" Тогда
			ЗапомнитьТекстДляСравнения(ПодключениеИР, ПолеТекстаПрограммы, ЯчейкиТекущейСтроки[1]);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ЗапомнитьДляСравненияЛкс");
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Выражение + ", " + Модули.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВыражения.Выражение);
	//УказательОбъектаДляСравнения = ВосстановитьЗначениеСеансаКонфигуратора("УказательОбъектаДляСравнения");
	//СохранитьЗначениеСеансаКонфигуратора("УказательОбъектаДляСравнения", Неопределено);
	//Если УказательОбъектаДляСравнения <> Неопределено Тогда
	//	Выражение = Выражение + ", " + УказательОбъектаДляСравнения;
	//КонецЕсли;
	Выражение = Выражение + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	Если ТекстыЯчеек[2] = "ТаблицаЗначений" Тогда
		ТурбоКонф.Клавиша(Клавиши.F2);
	ИначеЕсли ТекстыЯчеек[2] = "Строка" Тогда
		Текст = ТекстБезКрайнихСимволовЛкс(ТекстыЯчеек[1]);
		ПоказатьВсплывающееУведомление(Текст);
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	Иначе
		// Ошибка
		//ПоказатьВсплывающееУведомление(СтрШаблон("Запомненный ранее объект (%1) не доступен в текущем контексте", УказательОбъектаДляСравнения));
		//УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	КонецЕсли;
КонецПроцедуры 

Процедура СериализоватьИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Если Не ЛиДоступенВводВыражения() Тогда
		ДобавитьВыражениеВОчередьТабло(СтруктураВыражения.Выражение, Истина);
		Возврат;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ОбъектВСтрокуXMLЛкс");
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Выражение + ")";
	ТекстыЯчеек = ВычислитьЗначениеВыраженияОтладчика(Выражение);
	Если ЗначениеЗаполнено(ТекстыЯчеек[2]) Тогда
		Текст = ТекстБезКрайнихСимволовЛкс(ТекстыЯчеек[1]);
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
		ОткрытьРедакторТекста(Текст,, "XML");
	Иначе
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
		ПоказатьВсплывающееУведомление("Ошибка сериализации значения");
	КонецЕсли;
КонецПроцедуры     

//.
// Параметры:
//   Выражение - Массив - 
// Возвращаемое значение:
//   Массив - 
Функция ВычислитьЗначениеВыраженияОтладчика(Знач Выражение) Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	Возврат ТекстыЯчеек;
КонецФункции     

Процедура КонтекстВычисленияКоллекции(Знач ПодключениеИР, ВыражениеКоллекции = Неопределено, ИмяСвойства = Неопределено, ПредставлениеЗначения = Неопределено) Экспорт
	Модули = МодулиИР(ПодключениеИР);
	ПредставлениеЗначения = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	Если Лев(ПредставлениеЗначения, 1) <> """" Тогда
		ПредставлениеЗначения = СтрЗаменить(ПредставлениеЗначения, Символы.НПП, "");
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ИмяСвойства = ПоследнийФрагментЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	ТурбоКонф.Клавиша(Клавиши.F2);
	ЖдатьОкноВыражение();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение();
	Найденные = Модули.ирОбщий.НайтиРегВыражениеЛкс(Выражение, "\[\d+\]");
	Найденное = Найденные.Получить(Найденные.Количество() - 1);
	ВыражениеКоллекции = Лев(Выражение, Найденное.ПозицияВхождения);
КонецПроцедуры    

Процедура ВключитьВТаблоИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло");
	Если ОчередьТабло = Неопределено Тогда
		ОчередьТабло = Новый СписокЗначений;
	КонецЕсли;
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение();
	ДобавитьВыражениеВОчередьТабло(Выражение);
	Если ТурбоКонф.ПолучитьДоступностьЭлемента("Показать значение в отдельном окне", "кнопка") Тогда
		ВыражениеДляТабло = Выражение;
		СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
		СтруктураЗначения = ЗначениеВыраженияОкнаВыражение(СтруктураВыражения.Выражение);
		Если СтруктураЗначения <> Неопределено Тогда
			Если СтруктураЗначения.ТипЗначения = "Строка" Тогда
				ВыражениеДляТабло = "СтрДлина(" + ВыражениеДляТабло + ")";
			Иначе
				ВыражениеДляТабло = ВыражениеДляТабло + ".Количество()";
			КонецЕсли;
		КонецЕсли;
		ДобавитьВыражениеВОчередьТабло(ВыражениеДляТабло);
	КонецЕсли;
КонецПроцедуры 

Процедура ДобавитьСвойствоВТаблоИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ИмяСвойства = ПоследнийФрагментЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	ТурбоКонф.Клавиша(Клавиши.F2);
	ЖдатьОкноВыражение();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение() + "." + ИмяСвойства;
	ЗакрытьМодальноеОкно();
	ДобавитьВыражениеВОчередьТабло(Выражение);
КонецПроцедуры    

Процедура ДобавитьНайтиВТаблоИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыражениеКоллекции = Неопределено; // Строка
	ИмяСвойства = Неопределено; // Произвольный, Строка
	ПредставлениеЗначения = Неопределено; // Произвольный, Строка
	КонтекстВычисленияКоллекции(ПодключениеИР, ВыражениеКоллекции, ИмяСвойства, ПредставлениеЗначения);
	Выражение = ВыражениеКоллекции + ".Найти(" + ПредставлениеЗначения + ", """ + ИмяСвойства + """)";
	ЗакрытьМодальноеОкно();
	ДобавитьВыражениеВОчередьТабло(Выражение);
КонецПроцедуры    

Процедура ДобавитьКоличествоВТаблоИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыражениеКоллекции = "";
	КонтекстВычисленияКоллекции(ПодключениеИР, ВыражениеКоллекции);
	Выражение = ВыражениеКоллекции + ".Количество()";
	ЗакрытьМодальноеОкно();
	ДобавитьВыражениеВОчередьТабло(Выражение);
КонецПроцедуры    

Процедура ДобавитьВыражениеВОчередьТабло(Знач Выражение, Знач ЛиИззаНедоступностиВвода = Ложь) Экспорт
	ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло");
	Если ОчередьТабло = Неопределено Тогда
		ОчередьТабло = Новый СписокЗначений;
	КонецЕсли;
	Если ОчередьТабло.НайтиПоЗначению(Выражение) = Неопределено Тогда
		ОчередьТабло.Добавить(Выражение);
		СохранитьЗначениеСеансаКонфигуратора("ОчередьТабло", ОчередьТабло);
	КонецЕсли;
	Если ЛиИззаНедоступностиВвода Тогда
		Причина = " из-за недоступности ввода";
	КонецЕсли;
	ПоказатьВсплывающееУведомление("Добавлено в очередь табло" + Причина + ":
			|" + Выражение);
	ЗапуститьМоноФоновоеЗадание("ДобавитьОчередьВТаблоФоновый");
КонецПроцедуры    

// У вызываемого в фоне метода должен быть первый параметр КлючСостоянияФоновогоМетода
// Параметры:
//   ИмяМетода -  - 
//   МаксСекундФоновогоМетода - Число - столько секунд запрещено запускать новый экземпляр метода, если не завершился предыдущий
//   ПараметрыЗадания -  - 
// Возвращаемое значение:
//    - 
Функция ЗапуститьМоноФоновоеЗадание(ИмяМетода, Знач МаксСекундФоновогоМетода = Неопределено, Знач ПараметрыЗадания = Неопределено)
	Если ЗапрещенЗапускМоноЗадания(ИмяМетода, МаксСекундФоновогоМетода) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Бесполезная проверка, т.к. предыдущие запуски в другом процессе сидят и тут мы их не увидим
	//ВыбранныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("ИмяМетода, Состояние", ИмяМетода, СостояниеФоновогоЗадания.Активно));
	//Если ВыбранныеЗадания.Количество() > 0 Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	КлючСостоянияФоновогоМетода = КлючСостоянияФоновогоМетода(ИмяМетода);
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, ТекущаяДата());
	Если ПараметрыЗадания = Неопределено Тогда
		ПараметрыЗадания = Новый Массив;
	КонецЕсли;
	ПараметрыЗадания.Вставить(0, КлючСостоянияФоновогоМетода);
	ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, ПараметрыЗадания);
	Возврат Истина;
КонецФункции

Функция ЗапрещенЗапускМоноЗадания(Знач ИмяМетода, Знач МаксДлительностьФоновогоМетода) Экспорт
	Если Не ЗначениеЗаполнено(МаксДлительностьФоновогоМетода) Тогда
		МаксДлительностьФоновогоМетода = МаксДлительностьФоновогоМетода();
	КонецЕсли;
	КлючСостоянияФоновогоМетода = КлючСостоянияФоновогоМетода(ИмяМетода);
	ДатаЗапуска = ВосстановитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода);
	ЗапрещенЗапуск = Истина
		И ДатаЗапуска <> Неопределено
		И ТекущаяДата() - ДатаЗапуска < МаксДлительностьФоновогоМетода;
	Возврат ЗапрещенЗапуск;
КонецФункции

Функция КлючСостоянияФоновогоМетода(ИмяМетода) Экспорт
	Возврат "ДатаЗапускаФоновогоМетода." + ИмяМетода;
КонецФункции    

// Секунды
Функция МаксДлительностьФоновогоМетода() Экспорт
	Возврат 600;
КонецФункции    

Функция ПоказатьВсплывающееУведомление(Текст, ЧислоМиллисекунд = 4000, СсылкаМодуля = "")
	Если ЗначениеЗаполнено(СсылкаМодуля) Тогда
		ИмяМетода = "ОткрытьСсылкуМодуляИзУведомления";
		Параметры = Новый Структура("СсылкаМодуля", СсылкаМодуля); 
		ИмяДействия = "Открыть модуль";
	КонецЕсли;
	Возврат ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), Текст, ЧислоМиллисекунд, ЭтотОбъект, ИмяМетода, Параметры, ИмяДействия); 
КонецФункции

Процедура ОткрытьСсылкуМодуляИзУведомления(Параметры) Экспорт
	ТурбоКонф.АктивироватьОкно(Конфигуратор.ОкноВызоваСкрипта);
	ПерейтиПоСсылкеМД(Параметры.СсылкаМодуля);
КонецПроцедуры

Процедура ДобавитьОчередьВТаблоФоновый(КлючСостоянияФоновогоМетода) Экспорт
	Попытка
		Успех = Истина;
		МоментНачала = ТекущаяДата();
		Пока Истина Цикл
			Если Ложь
				Или Конфигуратор = Неопределено
				Или ТекущаяДата() - МоментНачала > МаксДлительностьФоновогоМетода() 
			Тогда
				Успех = Ложь;
				Прервать;
			КонецЕсли;
			Если ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно Тогда
				Прервать;
			КонецЕсли;
			ТурбоКонф.Ждать(1000);
		КонецЦикла;
		ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло"); // СписокЗначений
		ПредставлениеСписка = СтрСоединить(ОчередьТабло.ВыгрузитьЗначения(), Символы.ПС);
		Если Не Успех Тогда
			ПоказатьВсплывающееУведомление("Не дождались освобождения главного окна конфигуратора. Очередь табло очищена:
			|" + ПредставлениеСписка);
		Иначе
			//Если ПодготовитьТаблоДляДобавления() Тогда
			//	Для Каждого ОчередьЭлемент Из ОчередьТабло Цикл
			//		ДобавитьВыражениеВТабло(ОчередьЭлемент.Значение);
			//	КонецЦикла;
			//	ПоказатьВсплывающееУведомление("В табло добавлены выражения из очереди:
			//			|" + ПредставлениеСписка);
			//Иначе
			//	ПоказатьВсплывающееУведомление("Не удалось добавить очередь в табло. Очередь табло очищена:
			//			|" + ПредставлениеСписка);
			//КонецЕсли;
			Для Каждого ОчередьЭлемент Из ОчередьТабло Цикл
				ДобавитьВыражениеВТаблоИзОкнаВыражение(ОчередьЭлемент.Значение);
			КонецЦикла;
			ПоказатьВсплывающееУведомление("В табло добавлены выражения из очереди:
					|" + ПредставлениеСписка);
		КонецЕсли;
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
	СохранитьЗначениеСеансаКонфигуратора("ОчередьТабло", Неопределено);
КонецПроцедуры

// Пока не поддерживает фоновый режим. В нем вместо этого метода следует использовать ДобавитьВыражениеВТаблоИзОкнаВыражение
Функция ПодготовитьТаблоДляДобавления() Экспорт
	Успех = Истина;
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
	ТурбоКонф.Клавиша(Клавиши.End);
	ТурбоКонф.Ждать(10);
	Если Не СтрЗаканчиваетсяНа(ТурбоКонф.ПолучитьИмяЭлемента(), " Выражение") Тогда
		//НажатьКлавишуЦикл(Клавиши.Left, 2); // Тут не работает смена активной колонки https://www.hostedredmine.com/issues/1004581
		//ТурбоКонф.УстановитьФокусНаЭлемент(" Выражение", "неизвестный"); // ошибка - Метод или операция не реализована  https://turboconf.ru/Tasks/10264
		Если ЛиВФоновомЗадании() Тогда
			ПоказатьВсплывающееУведомление("Добавление в табло недоступно из фонового метода. Используй метод ДобавитьВыражениеВТаблоИзОкнаВыражение");
			Успех = Ложь;
		ИначеЕсли Не КликнутьПоЭлементу(" Выражение", "неизвестный") Тогда
			Успех = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Успех;
КонецФункции

// Добавить выражение в уже активированную ячейку "Выражение" панели табло. Предварительно нужно вызвать ПодготовитьТаблоДляДобавления
Процедура ДобавитьВыражениеВТабло(Знач Выражение) Экспорт
	ТурбоКонф.Клавиша(Клавиши.Down);
	СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	УстановитьЗначениеПолюВвода(Выражение);	
КонецПроцедуры

Процедура ДобавитьВыражениеВТаблоИзОкнаВыражение(Знач Выражение) Экспорт
	СохранитьЗначениеСеансаКонфигуратора("ЗапретОбработкиОткрытияВыражения", Истина);
	//ОткрытьОкноВыражения();
	ТурбоКонф.ШифтКлавиша(Клавиши.F9);
	СохранитьЗначениеСеансаКонфигуратора("ЗапретОбработкиОткрытияВыражения", Неопределено);
	Попытка
		ТурбоКонф.ЖдатьОкно("Выражение", 1000, Истина);
	Исключение
		Возврат; 
	КонецПопытки;
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ТурбоКонф.УстановитьФокусНаЭлемент("Включить в табло", "кнопка");
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры

Процедура СледитьЗаТекущимМетодомФоновый(Знач КлючСостоянияФоновогоМетода) Экспорт
	ДатаАктивностиКонтрольногоОкна = Дата(1,1,1);
	Пока Конфигуратор <> Неопределено Цикл
		Попытка   
			Если ЛиПриложениеИРЗаблокировано() Тогда
				//
			//ИначеЕсли ТурбоКонф.ВосстановитьЗначениеСеанса("ПриЗавершенииРаботыПрограммы") = Истина Тогда
			//	// Особой пользы от этого не выявлено
			//	Прервать;
			Иначе
				ПодключениеИР = ПодключениеИРИзКэша();
				Если ПодключениеИР = Неопределено Тогда
					Прервать;
				КонецЕсли; 
				ТекстОбновленияНапарника = ТурбоКонф.ВосстановитьЗначениеСеанса("ТекстОбновленияНапарника");
				ПринудительноЗапомнить = ТурбоКонф.ВосстановитьЗначениеСеанса("ПринудительноЗапомнитьМетод");
				ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
				Если Ложь
					Или ЗначениеЗаполнено(ТекстОбновленияНапарника)
					Или ПринудительноЗапомнить = Истина
					Или ЗаголовокОкна = "JumpToForm" 
					Или ЗаголовокОкна = "Навигатор по метаданным"
					Или ЗаголовокОкна = "Перейти по номеру строки"
					Или ЗаголовокОкна = "Процедуры и функции"
					Или ЗаголовокОкна = "Закладки"
					Или ЗаголовокОкна = "Поиск"
					Или ЗаголовокОкна = "Объект перехода"
					//Или ЗаголовокОкна = "Точки останова"
				Тогда
					ДатаАктивностиКонтрольногоОкна = ТекущаяДата();
				КонецЕсли; 
				//Сообщить("ф1=" + (ТекущаяДата() - ДатаАктивностиКонтрольногоОкна < 10));
				//Сообщить("ф2=" + (Не ЛиОсновнойПотокЗанят()));
				//Сообщить("ф3=" + (ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно));
				//Сообщить("ф4=" +  (ТипТекущегоЭлементаИнтерфейса() = ПеречТипЭлемента.Документ));
				Если Истина
					И ТекущаяДата() - ДатаАктивностиКонтрольногоОкна < 20
					И Не ЛиОсновнойПотокЗанят()
					И ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно 
				Тогда
					ТипТекущегоЭлемента = ТипТекущегоЭлементаИнтерфейса();
					Если ТипТекущегоЭлемента = ПеречТипЭлемента.Документ Тогда
						ЗапомнитьМетод(Ложь);
						ДатаАктивностиКонтрольногоОкна = Дата(1,1,1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ТурбоКонф.СохранитьЗначениеСеанса("ПринудительноЗапомнитьМетод", );
		Исключение
			ПоказатьВсплывающееУведомление(ОписаниеОшибки());
		КонецПопытки;
		ТурбоКонф.Ждать(2000);
	КонецЦикла;
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
КонецПроцедуры

// Фактически выполняется только начиная с версии 6.4.9263.37276
// Параметры:
//   ЧислоСекундПокоя - Число - сколько секунд должно пройти с последнего нажатия клавиши, чтобы считать поток свободным
// Возвращаемое значение:
//   Булево - 
Функция ЛиОсновнойПотокЗанят(Знач ЧислоСекундПокоя = 3) Экспорт
	Если ТурбоКонф.ПолучитьВерсиюТурбоКонф() < "6.4.9263.37276" Тогда
		ОсновнойПотокЗанят = Ложь;
	Иначе
		ОсновнойПотокЗанят = Ложь
			Или ТурбоКонф.ВыполняетсяВзаимодействие
			Или ТурбоКонф.ОткрытаПодсказкаT9
			Или ТекущаяДата() - ТурбоКонф.ВремяПоследнегоНажатияКлавишиКлавиатуры < ЧислоСекундПокоя;
	КонецЕсли;
	//Сообщить("ЛиОсновнойПотокЗанят." + Конфигуратор.PID + "="+ОсновнойПотокЗанят);
	Возврат ОсновнойПотокЗанят;
КонецФункции

//.
// Параметры:
//   ВызыватьИсключение -  - 
//   КлавишаЗакрытия - ПеречислениеСсылка.Клавиши - по умолчанию Escape
Процедура ЗакрытьМодальноеОкно(Знач ВызыватьИсключение = Истина, Знач КлавишаЗакрытия = Неопределено, Знач ЗажатьКонтрол = Ложь, Знач ЗажатьШифт = Ложь, Знач ЧислоМиллисекунд = 1000) Экспорт
	Если КлавишаЗакрытия = Неопределено Тогда
		КлавишаЗакрытия = Клавиши.Escape;
	КонецЕсли;
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	Если ЗажатьКонтрол Тогда
		ТурбоКонф.КонтролКлавиша(КлавишаЗакрытия);
	ИначеЕсли ЗажатьШифт Тогда
		ТурбоКонф.ШифтКлавиша(КлавишаЗакрытия);
	Иначе
		ТурбоКонф.Клавиша(КлавишаЗакрытия);
	КонецЕсли;
	ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, ЧислоМиллисекунд,, ВызыватьИсключение); 
	ЖдатьОсвобожденияПотокаВвода();
КонецПроцедуры

// Закрыть дочернее (немодальное) окно конфигуратора. В понимании Турбоконфа оно не является окном.
Процедура ЗакрытьДочернееОкноКонфигуратора() Экспорт
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.ШифтКлавиша(Клавиши.Escape);
	//ЖдатьСменуТекущегоЭлемента(СтарыйИД); // Иногда ИД не меняется
КонецПроцедуры   

//.
// Параметры:
//   СтарыйИД - Строка - идентификатор текущего элемента, полученный методом см. ПолучитьRuntimeIdСтрокой
Функция ЖдатьСменуТекущегоЭлемента(Знач СтарыйИД, Знач ЧислоМиллисекунд = 2000, Знач ВызыватьИсключение = Ложь) Экспорт
	Попытка                                                                                       
		Результат = ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, ЧислоМиллисекунд, ВызыватьИсключение);
		ЖдатьОсвобожденияПотокаВвода();
	Исключение
		// Иногда возникает непонятная ошибка https://turboconf.ru/Tasks/9760 
		ТурбоКонф.Ждать(50);
	КонецПопытки;
	Возврат Результат;
КонецФункции   

Функция УстановитьФокусВПервуюТаблицуИлиСписок(Знач ПерейтиВНачало = Ложь) Экспорт
	Попытка
		Результат = ТурбоКонф.УстановитьФокусНаЭлемент("", "таблицу");
		Если Не Результат Тогда
			Результат = ТурбоКонф.УстановитьФокусНаЭлемент("", "список");
		КонецЕсли;
	Исключение
		Описание = ОписаниеОшибки();
		//ПоказатьВсплывающееУведомление(Описание);
		// Сюда приходим иногда из команды "Вычислить выражение"
		Возврат Ложь;
	КонецПопытки;
	Если ПерейтиВНачало Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.Home);
	КонецЕсли;
	Возврат Результат;
КонецФункции

//.
// Параметры:
//   ТекстУсловия - Строка - 
Процедура ДобавитьУсловиеОстанова(Знач ТекстУсловия) Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.F9);
	Попытка
		ТурбоКонф.ЖдатьОкно("Параметры точки останова", 200, Истина);
	Исключение
		Если ТурбоКонф.ПолучитьЗаголовокТекущегоОкна() = "Конфигуратор" Тогда
			ЗакрытьМодальноеОкно();
			ПоказатьВсплывающееУведомление("В измененной строке недоступна установка точки останова. Условие помещено в буфер обмена:
			|" + ТекстУсловия);
			УстановитьБуферОбмена(ТекстУсловия);
			Возврат;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ТурбоКонф.Ждать(10); // эффект не подтвержден
	СтарыйТекст = АктивироватьУсловиеВОкнеПараметрыТочкиОстанова();
	Если ЗначениеЗаполнено(СтарыйТекст) Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.End);
		ТекстУсловия = Символы.ПС + "И " + ТекстУсловия;
	КонецЕсли;
	ТурбоКонф.ВставитьТекст(ТекстУсловия);
	Если СтрДлина(ТекстУсловия) > 60 Тогда
		ТурбоКонф.Клавиша(Клавиши.Home);
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьФокусВПолеВводаВыраженияОкнаВыражение() Экспорт
	ТурбоКонф.УстановитьФокусНаЭлемент("Рассчитать", "кнопка");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТурбоКонф.Ждать(30); // - Для дальнейшего вызова ТурбоКонф.ПолучитьЗначение()
КонецПроцедуры

Процедура НажатиеCtrlENTER() Экспорт
	ЗаголовокТекущегоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	ТипТекущегоЭлемента = ТипТекущегоЭлементаИнтерфейса();
	Если Истина
		И ЗаголовокТекущегоОкна = "Редактирование типа данных" 
		И ТипТекущегоЭлемента = ПеречТипЭлемента.ЭлементСписка
	Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура НажатиеEscape() Экспорт
	ПодключениеИР = ПодключениеИРИзКэша();
	Если ПодключениеИР <> Неопределено Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
		Если ПолеТекстаПрограммы <> Неопределено Тогда
			ФормаВызовМетода = ПолеТекстаПрограммы.ФормаВызовМетода();
			Если ФормаВызовМетода.Открыта() Тогда
				ФормаВызовМетода.Автообновление = Ложь;
				ФормаВызовМетода.Закрыть();
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Побочный эффект https://turboconf.ru/Tasks/10059 
	//ПродолжитьОбработкуНажатияКлавиш();
	ТурбоКонф.Клавиша(Клавиши.Escape); 
КонецПроцедуры

Функция ШаблонЗаголовкаОкнаКоллекции() Экспорт
	// Мультиметка250919_124213 Но другом месте слеши удвоены!
	Возврат "^(?!.*\s)(COMОбъект|ВнешнийОбъект|.*DOM|.*Структура|.*Соответствие|.*Массив|СписокЗначений|.*ЭлементыФормы|Колонки|[^.]*ТабличнаяЧасть(\..+){2}|ТаблицаЗначений|Строка(Таблицы|Дерева)Значений|.*Коллекци.*|ДанныеФормы.*|Кнопки.*)$";
КонецФункции

//&ТолькоТекстовыеДокументы
Процедура ОбсудитьИИ() Экспорт
	ПодключениеИР = ПодключениеИР(,, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,,, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НачатьОжиданиеМодальныхОконПриложенияИР(ПодключениеИР);
	Попытка
		НовыйТекст = ПолеТекстаПрограммы.ОткрытьЧатИИ(, Истина);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Конфигуратор.ОкноВызоваСкрипта,, ПодключениеИР);
	Если ЗначениеЗаполнено(НовыйТекст) Тогда
		//ТурбоКонф.Ждать(100);
		ТурбоКонф.ВставитьТекст(НовыйТекст);
	КонецЕсли;
КонецПроцедуры

Процедура Тест()  
ЗапросНапарника = Новый HTTPЗапрос("/api/v1/complete");
ЗапросНапарника.Заголовки = Неопределено;
СоединениеНапарника = Новый HTTPСоединение("https://code.1c.ai", 443);
Ответ = СоединениеНапарника.ОтправитьДляОбработки(ЗапросНапарника);
КонецПроцедуры

ТурбоКонф = Новый ("ТурбоКонф");
// Служебная секция. Для контекстной подсказки
#Если Сервер И Не Сервер Тогда
	ТурбоКонф = Обработки.ТурбоКонф.Создать();
#КонецЕсли

// настройки
ПапкаПортативногоИР = ""; // Сюда можно вручную прописать путь, если нужен портативный вариант ИР из конкретной папки. По умолчанию он ищется в папке ".\user_scripts\ИР"
МинимальнаяВерсияИР = "7.96"; 
