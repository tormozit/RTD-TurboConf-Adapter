Процедура УстановитьОтборТолькоОшибки()
	Если Не ТурбоКонф.НайтиЭлементПоИмени("Основные", "вкладка") Тогда
		ПоказатьВсплывающееУведомление("Недоступно в этом окне");
		Возврат;
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Отборы", "кнопка");
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	НажатьКлавишуЦикл(Клавиши.Tab, 3, Истина);
	
	// Уровни важности
	//КликнутьПоЭлементу("Выключить все", "кнопка"); // Неуникальное имя кнопки
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Space);
	НажатьКлавишуЦикл(Клавиши.Tab, 3, Истина); 
	
	// Типы событий
	Если АктивироватьСтрокуДерева("Информационная база.Ошибка изменения конфигурации базы данных") Тогда
		ТурбоКонф.Клавиша(Клавиши.Space);
	КонецЕсли;
	
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);

КонецПроцедуры

Процедура ОткрытьСравнениеВерсийМетода()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	НажатьКлавишуЦикл(Клавиши.Left, 3);
	ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
	ИмяМетода = МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстЯчейки, " ");
	ЗаголовокЛевый = Сред(ТекстЯчейки, СтрДлина(ИмяМетода) + 2);
	ТурбоКонф.Клавиша(Клавиши.Right);
	ТекстЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
	ЗаголовокПравый = Сред(ТекстЯчейки, СтрДлина(ИмяМетода) + 2);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстПравый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстЛевый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	Модально = Истина; 
	
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ОповеститьПользователяОПриостановке(ПодключениеИР); 
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Сравнение.*", 5000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(ТекстЛевый, ТекстПравый, Модально, ЗаголовокЛевый, ЗаголовокПравый,,, ИмяМетода,, "ВстроенныйЯзык", ИмяМетода);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
КонецПроцедуры

Процедура ОткрытьСравнениеТекстов()
	ПодключениеИР = ПодключениеИР(, Ложь, Ложь);
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ТурбоКонф.УстановитьФокусНаЭлемент("", "документ");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстПравый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТекстЛевый = ТурбоКонф.ПолучитьТекстМодуля("", 0);
	ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	ВосстановитьОкноПриложения(ПодключениеИР);
	МодулиИР.ирКлиент.Сравнить2ЗначенияВФормеЛкс(ТекстЛевый, ТекстПравый, Ложь,,,,,,, "ВстроенныйЯзык", ЗаголовокОкна);
КонецПроцедуры

Процедура НайтиТочкуОстановаИлиЗакладку()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если НайтиВСписке() Тогда
		КликнутьПоЭлементу("Перейти к исходному коду", "кнопка");
	КонецЕсли;
КонецПроцедуры    

Процедура НайтиВСпискеОбъектовМетаданных()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если НайтиВСписке() Тогда
	КонецЕсли;
КонецПроцедуры  

Процедура НайтиЭлементКоллекцииВОкне() 
	ТурбоКонф.ОтжатьМодификаторы();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтрокиСпискаПутемПеремещения();
	ЗаголовокНачальногоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	Если КликнутьПоЭлементу("Вывести список...", "кнопка") Тогда
		ТурбоКонф.ЖдатьОкно("Вывести список", 1000, Истина);
		УстановитьФокусВПервуюТаблицуИлиСписок();
		Если Ложь
			Или ЗаголовокНачальногоОкна = "ТаблицаЗначений"
			Или ЗаголовокНачальногоОкна = "Структура"
			Или ЗаголовокНачальногоОкна = "Соответствие"
			Или ЗаголовокНачальногоОкна = "СписокЗначений"
			Или Найти(ЗаголовокНачальногоОкна, "ТабличнаяЧасть.") > 0
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "КоллекцияСтрок")
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "КоллекцияКолонок")
			Или СтрНачинаетсяС(ЗаголовокНачальногоОкна, "ДанныеФормы")
		Тогда
			// Ускорение
			ТурбоКонф.Клавиша(Клавиши.Down);
			ТурбоКонф.Клавиша(Клавиши.Space); // - Значение элемента
			ТурбоКонф.Клавиша(Клавиши.Down);
			ТурбоКонф.Клавиша(Клавиши.Space); // - Тип элемента
		КонецЕсли;
		Окно = ТурбоКонф.ПолучитьАктивноеОкно();
		ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
		ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, 5000);  
		КликнутьПоЭлементу("Закрыть", "кнопка"); // Окно само не восстанавливает фокус
		Счетчик = 0;
		Успех = Ложь;
		Пока Счетчик < 10  Цикл
			ТурбоКонф.Ждать(20); // Нужно время чтобы конфигуратор после передачи управления главному окну активировал предыущее дочернее
			ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
			Сообщить("ЗаголовокОкна=" + ЗаголовокОкна);
			Если ЛиАктивноГлавноеОкно(ЗаголовокОкна) Тогда
				Успех = Истина;
				Прервать;
			КонецЕсли;
			Если ЗаголовокОкна = "Выражение" Тогда  
				УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
				ПоследнееВыражение = ТурбоКонф.ПолучитьЗначение();
			КонецЕсли;
			ЗакрытьМодальноеОкно();
			//ЗакрытьДочернееОкноКонфигуратора(); // тоже работает
			Счетчик = Счетчик + 1;
		КонецЦикла; 
		Если Не Успех Тогда
			Возврат;
		КонецЕсли; 
		ИмяФайлаТабличногоДокумента = СохранитьСодержимоеОкнаВоВременныйФайл();
		ЗакрытьДочернееОкноКонфигуратора();
		//ПерейтиКТекущейСтрокеИсполнения(); // Контекст может находиться не в верхней строке стека
		ПодключениеИР = ОткрытьОкноВыражения();  // Почему то тут срабатывает команда ВычислитьВыражение скрипта при отправке нажатия SHIFT+F9
		Если ПодключениеИР = Неопределено Тогда
			УдалитьФайлы(ИмяФайлаТабличногоДокумента);
			Возврат;
		КонецЕсли;
		УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
		УстановитьЗначениеПолюВвода(ПоследнееВыражение);
		ЖдатьВычислениеВыражения();
		ТурбоКонф.Клавиша(Клавиши.F2);
		ТурбоКонф.ЖдатьОкно(ЗаголовокНачальногоОкна, 1000, Истина);
		ТурбоКонф.Ждать(20);
		ТурбоКонф.Клавиша(Клавиши.Up); // Иначе поиск не сработает  
		НайтиВСписке(ЯчейкиТекущейСтроки, ИмяФайлаТабличногоДокумента);
	КонецЕсли;
КонецПроцедуры  

Процедура КнопкаОткрытьЭлементКоллекции()
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ИмяСвойства = ПоследнийФрагментЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	ТурбоКонф.Клавиша(Клавиши.F2);
	ЖдатьОкноВыражение();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Down); // Иначе поиск не сработает
	НайтиСтрокуВОкне(ИмяСвойства);
КонецПроцедуры  

Процедура СократитьКоллекциюИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если Не КликнутьПоЭлементу("Показать значение в отдельном окне", "кнопка") Тогда
		Возврат;
	КонецЕсли;
	ЖдатьОкноВыражение();
	Фрагменты = СтрРазделить(ТурбоКонф.ПолучитьЗначение(), "[]", Ложь);
	Индекс = Число(Фрагменты[Фрагменты.ВГраница()]);
	ЗакрытьМодальноеОкно();
	ЗакрытьМодальноеОкно();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	ВыражениеКоллекции = ТурбоКонф.ПолучитьЗначение();
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "СокрКол");
	УстановитьЗначениеПолюВвода(ТекстВызова + "(" + ВыражениеКоллекции + ", " + XMLСтрока(Индекс) + ")");
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(ВыражениеКоллекции);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.F2);
	Если Найти(ТекстыЯчеек[1], "Ошибка ") > 0 Тогда
		ПоказатьВсплывающееУведомление(ТекстыЯчеек[1]);
	КонецЕсли;
КонецПроцедуры  

Функция ЖдатьОкноВыражение() Экспорт
	Попытка
		//ТурбоКонф.ЖдатьОкно("Выражение", 1000, Истина,, Истина); // 6.3.9141.36481 https://turboconf.ru/Tasks/9996
	Исключение
	КонецПопытки;
	Если Не ЖдатьПотерюАктивностиОкна(,, Истина) Тогда
		ВызватьИсключение "Не дождались окна ""Выражение""";
	КонецЕсли;
КонецФункции  

Процедура КнопкаНоваяОбычнаяГруппаВертикальная(Знач НомерВариантаГруппы = 1)
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.Home);
	НажатьКлавишуЦикл(Клавиши.Down, НомерВариантаГруппы - 1);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	АктивироватьСвойствоВПалитреСвойств("Группировка");
	ТурбоКонф.КонтролКлавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Up);
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры 

Процедура КнопкаНоваяОбычнаяГруппаГоризонтальная(Знач НомерВариантаГруппы = 1)
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.Клавиша(Клавиши.Home);
	НажатьКлавишуЦикл(Клавиши.Down, НомерВариантаГруппы - 1);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	ТурбоКонф.Клавиша(Клавиши.Enter);
	АктивироватьСвойствоВПалитреСвойств("Группировка");
	ТурбоКонф.КонтролКлавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Клавиша(Клавиши.Enter);
КонецПроцедуры  

Процедура КнопкаУстановитьФорматПолнойДаты()
	УстановитьФокусНаКнопкуСправка();
	ТурбоКонф.Клавиша(Клавиши.Tab);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	ТурбоКонф.Ждать(20);
	Если Не ТурбоКонф.УстановитьФокусНаЭлемент("Формат даты", "флажок") Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.Клавиша(Клавиши.Tab);
	УстановитьЗначениеПолюВвода("dd.MM.yyyy HH:mm:ss");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
КонецПроцедуры  

Процедура КнопкаНайтиКартинку()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ИмяКартинки = ТурбоКонф.ПолучитьИмяЭлемента();
	ОповеститьПользователяОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Картинки.*", 5000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		ВыбраннаяКартинка = МодулиИР.ирКлиент.ОткрытьВыборКартинкиЛкс(, ИмяКартинки);
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если ВыбраннаяКартинка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	ТурбоКонф.КонтролКлавиша(Клавиши.PageUp);
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Если ВыбраннаяКартинка.Встроенная Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.PageDown);
	КонецЕсли;
	НайтиСтрокуВОкне(ВыбраннаяКартинка.Имя, Истина);
КонецПроцедуры    

Процедура НастроитьОтборПоПодсистемам()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КонтекстИнтерфейса = КонтекстИнтерфейса();
	Если Не КонтекстИнтерфейса.ПоддерживаетПоиск Тогда
		ПоказатьВсплывающееУведомление("В данном контексте не поддерживается, т.к. в нем не работает поиск");
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	МодулиИР = МодулиИР(ПодключениеИР);
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ОповеститьПользователяОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("Выбор.*", 5000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		ВыбранныеПодсистемы = МодулиИР.ирКлиент.ОткрытьВыборПодсистемЛкс();
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если ВыбранныеПодсистемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	// Снимаем все пометки
	ТурбоКонф.Клавиша(Клавиши.Home);
	ТурбоКонф.Клавиша(Клавиши.Space);
	ТурбоКонф.Клавиша(Клавиши.Space);
	// Устанавливаем выбранные пометки
	Для Каждого ПолноеИмяПодсистемы Из СтрРазделить(ВыбранныеПодсистемы, ", ", Ложь) Цикл
		ИмяПодсистемы = ПоследнийФрагментЛкс(ПолноеИмяПодсистемы);
		Если Не НайтиУзелДерева(ПодключениеИР, ИмяПодсистемы) Тогда
			ПоказатьВсплывающееУведомление(СтрШаблон("Подсистема %1 не найдена в окне конфигуратора", ИмяПодсистемы));
		Иначе
			ТурбоКонф.Клавиша(Клавиши.Space);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры       

//&ВосстанавливатьБуферОбмена
Процедура ВыполнитьПроизвольныйКод()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	ВычисленноеВыражение = ТекстВычисленногоМногострочногоВыражения();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	КлючПамяти = ПолеТекстаПрограммы.ПолноеИмяМетода() + ";ПроизвольныйКод";
	Если Истина
		И Найти(ВычисленноеВыражение, Символы.ПС) 
		И Найти(ВычисленноеВыражение, ";")
	Тогда
		СтарыйТекст = ВычисленноеВыражение;
	Иначе
		СтарыйТекст = ВосстановитьЗначениеСеансаКонфигуратора(КлючПамяти);
	КонецЕсли;
	ТекстПоля = Новый Массив;
	Если ЗначениеЗаполнено(СтарыйТекст) Тогда
		ТекстПоля.Добавить(СтарыйТекст);
	КонецЕсли;
	ВременноеВыражение = "Новый Структура(""_"")";
	ТекущееВыражение = ТурбоКонф.ПолучитьЗначение();
	Если Истина
		И Найти(СтарыйТекст, ТекущееВыражение) = 0
		И Найти(ТекущееВыражение, "ирОбщий.Оперировать") = 0
		И Найти(ТекущееВыражение, ВременноеВыражение) = 0
		И Найти(ВычисленноеВыражение, Символы.ПС) = 0
	Тогда
		ТекстПоля.Добавить("//" + ТекущееВыражение);
	КонецЕсли;
	ТекстПоля = СтрСоединить(ТекстПоля, Символы.ПС);
	ТурбоКонф.Клавиша(Клавиши.Tab);
	ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка();
	Если ТекстыЯчеек.Количество() Тогда
		ТекстОшибки = ТекстыЯчеек[1];
		//Сообщить("ТекстОшибки=" + ТекстОшибки);
	КонецЕсли;
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	УстановитьЗначениеПолюВвода(ВременноеВыражение);
	ЖдатьВычислениеВыражения();
	ТурбоКонф.Клавиша(Клавиши.Add);
	ТурбоКонф.Клавиша(Клавиши.Down);
	ТурбоКонф.Ждать(20);
	ОткрытьОкноУстановкиЗначенияВВидеВыражения();
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	ИдентификаторПроцессаИР = МодулиИР.ирКэш.ИдентификаторПроцессаОСЛкс();
	ТекстУведомления = "Запущен рачет типов переменных"; 
	// Почему то такое уведомление не скрывается
	//Уведомление = ПоказатьВсплывающееУведомление(ТекстУведомления); // Не исчезает до закрытия окна
	//ПолеТекстаПрограммы.РассчитатьТипыПеременных();
	//ТурбоКонф.СкрытьВсплывающееУведомление(Уведомление);
	ТурбоКонф.ПоказатьУведомление(ТекстУведомления, 2000);
	ОповеститьПользователяОПриостановке(ПодключениеИР);
	ТурбоКонф.НачатьВызовВнешнегоОкнаАсинх("^Текст.*", 10000, Окно, РежимОткрытияВнешнегоОкна.Диалог, Истина, ИдентификаторПроцессаИР);
	Попытка
		СтруктураВызова = ПолеТекстаПрограммы.ОткрытьРедакторКодаДляОтладчика(ТекстПоля, ТекстОшибки); // Основное время перед открытием уходит на расчет типов переменных модуля
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьВызовВнешнегоОкнаАсинх(Окно, ИдентификаторПроцессаИР, ПодключениеИР);
	Если СтруктураВызова = Неопределено Тогда
		ТурбоКонф.Клавиша(Клавиши.Escape);
		Возврат;
	КонецЕсли;
	Если КлючПамяти <> Неопределено Тогда
		СохранитьЗначениеСеансаКонфигуратора(КлючПамяти, СтруктураВызова.Текст);
	КонецЕсли;
	
	// Так не увидим текст ошибки
	//ТурбоКонф.ВставитьТекст("ирОбщий.Оперировать(" + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ", 2, " + """" + СтруктураВызова.ИменаПараметров + """, " + СтруктураВызова.ИменаПараметров + ")");
	//ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
    //
	ИмяХранилища = "КодДляОтладчика";
	ТурбоКонф.ВставитьТекст("ирОбщий.СохранитьЗначениеЛкс(""" + ИмяХранилища + """, " + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ")");
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	ЗакрытьМодальноеОкно();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода("ирОбщий.Оперировать(ирОбщий.ВосстановитьЗначениеЛкс(""" + ИмяХранилища + """), 2, " + """" + СтруктураВызова.ИменаПараметров + """, " + СтруктураВызова.ИменаПараметров + ")");
	УстановитьФокусВПервуюТаблицуИлиСписок();
КонецПроцедуры

Процедура ОткрытьОкноУстановкиЗначенияВВидеВыражения() Экспорт
	КликнутьПоЭлементу("Установить новое значение в виде выражения", "кнопка");
	ТурбоКонф.ЖдатьОкно("Ввод выражения", 1000, Истина);
	ТурбоКонф.Ждать(20);
КонецПроцедуры

//&ВосстанавливатьБуферОбмена
Процедура ПрерватьОтлаживаемыйКод()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст, Ложь, Ложь, Ложь, Истина);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МодулиИР = МодулиИР(ПодключениеИР);
	УстановитьФиктивноеВыражениеДляУстановкиЗначения();
	ОкноВыражения = ТурбоКонф.ПолучитьАктивноеОкно();
	СтруктураВызова = ПолеТекстаПрограммы.КодОчисткиПеременныхДляОтладчика();

	// Так не увидим текст ошибки, но тут она не интересна и не упремся в длину поля ввода
	ТурбоКонф.ВставитьТекст("ирОбщий.Оперировать(" + МодулиИР.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВызова.Текст) + ", 2, 
	|" + """" + СтруктураВызова.ИменаПараметров + """, 
	|" + СтруктураВызова.ИменаПараметров + ")");
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter);
	ТурбоКонф.Ждать(50);
	ЗакрытьМодальноеОкно();
	ЗакрытьМодальноеОкно();
	//ПоказатьВсплывающееУведомление("Очищены все локальные переменные");
	ТурбоКонф.ШифтКлавиша(Клавиши.F11);
КонецПроцедуры

//&ВосстанавливатьБуферОбмена
Процедура ВставитьУсловиеИзТабло()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьМодальноеОкно();
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
	ТурбоКонф.КопироватьТекстВБуфер();
	ТекстУсловия = СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена();
	ВернутьсяВПредыдущееМестоКонфигуратора();
	ДобавитьУсловиеОстанова(ТекстУсловия);
КонецПроцедуры 

Процедура КнопкаПерейтиИзНавигатора()
КонецПроцедуры 

Функция СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена(Знач БазовыйПуть = "") Экспорт
	ТекстыЯчеек = СтрРазделить(ТурбоКонф.ПолучитьБуферОбмена(), Символы.Таб + Символы.ПС + Символы.ВК);
	ЭлементыУсловия = Новый Массив;
	ЧислоКолонокВСтроке = 4;
	Для НомерСтрокиТекста = 1 По Макс(1, ТекстыЯчеек.Количество() / ЧислоКолонокВСтроке) Цикл
		ИндексПервойЯчейки = (НомерСтрокиТекста-1)*ЧислоКолонокВСтроке;
		ТипЗначения = ТекстыЯчеек[ИндексПервойЯчейки + 2];
		Если ПустаяСтрока(ТипЗначения) Тогда
			Продолжить;
		КонецЕсли;
		ТекстВыражения = БазовыйПуть + ТекстыЯчеек[ИндексПервойЯчейки + 0];
		ЗначениеВыражения = ТекстыЯчеек[ИндексПервойЯчейки + 1];
		Если Ложь
			Или ТипЗначения = "Строка" 
			Или ТипЗначения = "Булево"
		Тогда
			ЭлементУсловия = ТекстВыражения + "=" + ЗначениеВыражения;
		ИначеЕсли Ложь
			Или ТипЗначения = "Null"
			Или ТипЗначения = "Неопределено"
		Тогда
			ЭлементУсловия = ТекстВыражения + "=" + ТипЗначения;
		ИначеЕсли ТипЗначения = "Число" Тогда
			ЭлементУсловия = ТекстВыражения + "=" + СтрЗаменить(ЗначениеВыражения, Символы.НПП, "");
		Иначе
			ЭлементУсловия = """""+" + ТекстВыражения + "=""" + ЗначениеВыражения + """";
		КонецЕсли;
		Сообщить("ЭлементУсловия="+ЭлементУсловия);
		ЭлементыУсловия.Добавить(ЭлементУсловия);
	КонецЦикла;
	ТекстУсловия = СтрСоединить(ЭлементыУсловия, Символы.ПС + "И ");
	Возврат ТекстУсловия;
КонецФункции 

//&ВосстанавливатьБуферОбмена
Процедура ВставитьОшибкуИзБуфера()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ПричиныОшибок = Новый Массив;
	ТекстОшибки1 = ТурбоКонф.ПолучитьБуферОбмена();
	МодулиИР = МодулиИР(ПодключениеИР);
	ПричинаОшибки1 = СокрЛП(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстОшибки1, "{", Ложь));
	Если ЗначениеЗаполнено(ПричинаОшибки1) Тогда
		ПричиныОшибок.Добавить(ПричинаОшибки1);
	КонецЕсли;
	ЗакрытьМодальноеОкно(, Клавиши.Enter, Истина);
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.КонтролАльтКлавиша(Клавиши.O);
	//ЖдатьСменуТекущегоЭлемента(СтарыйИД);
	ТурбоКонф.Ждать(20);
	ТекстОшибки2 = ТурбоКонф.ПолучитьТекстТекущегоЭлемента();
	ПричинаОшибки2 = СокрЛП(МодулиИР.ирОбщий.ПервыйФрагментЛкс(ТекстОшибки2, "{", Ложь));
	Если ЗначениеЗаполнено(ПричинаОшибки2) Тогда
		ПричиныОшибок.Добавить(ПоследнийФрагментЛкс(ПричинаОшибки2, Символы.ПС));
	КонецЕсли;
	ТурбоКонф.ОткрытьМеню("Отладка", "Остановка по ошибке...");
	Если ПричиныОшибок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Останавливаться по ошибке", "флажок");
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	ТурбоКонф.УстановитьФокусНаЭлемент("Останавливаться только на ошибках, включающих текст", "флажок");
	Если Не ТурбоКонф.ПолучитьСостояниеФлажка() Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТекстыЯчеек = ТурбоКонф.ПолучитьЭлементыСписка();
	ЧислоКолонок = 2;
	ЗаголовокКолонки = "Текст в сообщении об ошибке";
	Для Каждого Причина Из ПричиныОшибок Цикл
		//НайтиСтрокуВОкне(Причина); // Тут не работает поиск
		ИндексЯчейки = ТекстыЯчеек.Найти(Причина + " " + ЗаголовокКолонки);
		Если ИндексЯчейки <> Неопределено Тогда
			ТурбоКонф.Клавиша(Клавиши.Home);
			НажатьКлавишуЦикл(Клавиши.Down, ИндексЯчейки / ЧислоКолонок);
			ТурбоКонф.Клавиша(Клавиши.Delete);
		КонецЕсли;
		КликнутьПоЭлементу("Добавить", "кнопка");
		УстановитьЗначениеПолюВвода(Причина);
	КонецЦикла;
КонецПроцедуры 

//&ВосстанавливатьБуферОбмена
Процедура КнопкаУсловиеОстанова()
	//ПодключениеИР = ПодключениеИР();
	//Если ПодключениеИР = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ТурбоКонф.КопироватьТекстВБуфер();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	ПутьКСвойству = СтрокаБезПоследнегоФрагментаЛкс(ТурбоКонф.ПолучитьЗначение());
	Если Найти(ПутьКСвойству, ".") Тогда
		ПутьКСвойству = "";
	ИначеЕсли ЗначениеЗаполнено(ПутьКСвойству) Тогда
		ПутьКСвойству = ПутьКСвойству + ".";
	КонецЕсли;
	ТекстУсловия = СобратьУсловиеИзЗначенийВыраженийВБуфереОбмена(ПутьКСвойству);
	ЗакрытьМодальноеОкно();
	ДобавитьУсловиеОстанова(ТекстУсловия);
КонецПроцедуры 

Процедура ВычислитьСвойствоРодителяИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение(Истина);
	Если ПустаяСтрока(СтруктураВыражения.Родитель) Тогда
		Возврат;
	КонецЕсли;    
	УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
КонецПроцедуры     

//.
// Возвращаемое значение:
//   Структура - 
Функция СтруктураВыраженияОкнаВыражение(Знач ПерейтиНаУровеньВышеЕслиРаскрытОдинРодитель = Ложь) Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение();
	УстановитьФокусВПервуюТаблицуИлиСписок();
	Родитель = СтрокаБезПоследнегоФрагментаЛкс(Выражение);
	Свойство = ПоследнийФрагментЛкс(Выражение);
	Если ПерейтиНаУровеньВышеЕслиРаскрытОдинРодитель Тогда
		ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(3);
		Если ЯчейкиТекущейСтроки.Количество() Тогда
			КликнутьПоЭлементу(ЯчейкиТекущейСтроки[0], ТурбоКонф.ПолучитьНазваниеТипаТекущегоЭлемента());
			РазвернутьДеревоИПерейтиВНачало();
			ТекстКорневойЯчейки = ТурбоКонф.ПолучитьИмяЭлемента();
			Если Истина
				И Найти(Родитель, ".")
				И ТекстКорневойЯчейки = Родитель + " Свойство" 
			Тогда
				Выражение = Родитель;
				Родитель = СтрокаБезПоследнегоФрагментаЛкс(Выражение);
				Свойство = ПоследнийФрагментЛкс(Выражение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Свойство = СтрРазделить(Свойство, "[]")[0];
	Результат = Новый Структура;
	Результат.Вставить("Выражение", Выражение);
	Результат.Вставить("Родитель", Родитель);
	Результат.Вставить("Свойство", Свойство);
	Сообщить("Выражение="+Выражение);
	Сообщить("Родитель="+Родитель);
	Возврат Результат;
КонецФункции     

Процедура ПодробноОкнаВыражение()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Если Найти(СтруктураВыражения.Свойство, "(") > 0 Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СтруктураВыражения.Родитель) Тогда
		СтруктураВыражения.Родитель = СтруктураВыражения.Выражение;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "Стк");
	Если СтрНачинаетсяС(СтруктураВыражения.Родитель, ТекстВызова) Тогда
		СтруктураВыражения.Родитель = СтрЗаменить(СтруктураВыражения.Родитель, ТекстВызова + "(", "");
		СтруктураВыражения.Родитель = СтрЗаменить(СтруктураВыражения.Родитель, ")", ""); // Опасно
	КонецЕсли;
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Родитель + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ЖдатьВычислениеВыражения();
	Если Не НайтиСтрокуВОкне(СтруктураВыражения.Свойство, Истина) Тогда
		ПоказатьВсплывающееУведомление("Тип объекта не поддерживается");
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьРодителяИСвойствоВОкнеВыражение(Знач СтруктураВыражения) Экспорт
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Если ЗначениеЗаполнено(СтруктураВыражения.Родитель) Тогда
		УстановитьЗначениеПолюВвода(СтруктураВыражения.Родитель);
	Иначе
		УстановитьЗначениеПолюВвода(СтруктураВыражения.Выражение);
	КонецЕсли;
	ЖдатьВычислениеВыражения();
	НайтиСтрокуВОкне(СтруктураВыражения.Свойство, Истина);
КонецПроцедуры

Процедура СравнитьОбъектыИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	ЯчейкиТекущейСтроки = ЯчейкиТекущейСтроки(3);
	Если ЯчейкиТекущейСтроки.Количество() Тогда
		Если ЯчейкиТекущейСтроки[2] = "Строка Тип" Тогда
			ЗапомнитьТекстДляСравнения(ПодключениеИР, ПолеТекстаПрограммы, ЯчейкиТекущейСтроки[1]);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ЗапомнитьДляСравненияЛкс");
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Выражение + ", " + Модули.ирОбщий.ТекстВВыражениеВстроенногоЯзыкаЛкс(СтруктураВыражения.Выражение);
	//УказательОбъектаДляСравнения = ВосстановитьЗначениеСеансаКонфигуратора("УказательОбъектаДляСравнения");
	//СохранитьЗначениеСеансаКонфигуратора("УказательОбъектаДляСравнения", Неопределено);
	//Если УказательОбъектаДляСравнения <> Неопределено Тогда
	//	Выражение = Выражение + ", " + УказательОбъектаДляСравнения;
	//КонецЕсли;
	Выражение = Выражение + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	Если ТекстыЯчеек[2] = "ТаблицаЗначений" Тогда
		ТурбоКонф.Клавиша(Клавиши.F2);
	ИначеЕсли ТекстыЯчеек[2] = "Строка" Тогда
		Текст = Модули.ирОбщий.ТекстИзВстроенногоЯзыкаЛкс(ТекстыЯчеек[1]);
		ПоказатьВсплывающееУведомление(Текст);
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	Иначе
		// Ошибка
		//ПоказатьВсплывающееУведомление(СтрШаблон("Запомненный ранее объект (%1) не доступен в текущем контексте", УказательОбъектаДляСравнения));
		//УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
	КонецЕсли;
КонецПроцедуры 

Процедура СериализоватьИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТекстаПрограммы = ПолеТекстаПрограммыБезКонтекста(ПодключениеИР);
	Если ПолеТекстаПрограммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураВыражения = СтруктураВыраженияОкнаВыражение();
	Модули = МодулиИР(ПодключениеИР);
	ТекстВызова = ТекстВызоваФункцииРежимаОтладки(ПолеТекстаПрограммы, "ОбъектВСтрокуXMLЛкс");
	Выражение = ТекстВызова + "(" + СтруктураВыражения.Выражение + ")";
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	УстановитьЗначениеПолюВвода(Выражение);
	ТекстыЯчеек = ЖдатьВычислениеВыражения();
	Если ТекстыЯчеек[2] = "Строка" Тогда
		Текст = Модули.ирОбщий.ТекстИзВстроенногоЯзыкаЛкс(ТекстыЯчеек[1]);
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
		ОткрытьРедакторТекста(Текст,, "XML");
	Иначе
		УстановитьРодителяИСвойствоВОкнеВыражение(СтруктураВыражения);
		ПоказатьВсплывающееУведомление("Ошибка сериализации значения");
	КонецЕсли;
КонецПроцедуры     

Процедура ВключитьВТаблоИзВыражения()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло");
	Если ОчередьТабло = Неопределено Тогда
		ОчередьТабло = Новый СписокЗначений;
	КонецЕсли;
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение();
	ДобавитьВыражениеВОчередьТабло(Выражение);
КонецПроцедуры 

Процедура ВключитьВТаблоИзКоллекции()
	ПодключениеИР = ПодключениеИР();
	Если ПодключениеИР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьФокусВПервуюТаблицуИлиСписок();
	ИмяСвойства = ПоследнийФрагментЛкс(ТурбоКонф.ПолучитьИмяЭлемента(), " ");
	ТурбоКонф.Клавиша(Клавиши.F2);
	ЖдатьОкноВыражение();
	УстановитьФокусВПолеВводаВыраженияОкнаВыражение();
	Выражение = ТурбоКонф.ПолучитьЗначение() + "." + ИмяСвойства;
	ЗакрытьМодальноеОкно();
	ДобавитьВыражениеВОчередьТабло(Выражение);
КонецПроцедуры    

Процедура ДобавитьВыражениеВОчередьТабло(Знач Выражение) Экспорт
	ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло");
	Если ОчередьТабло = Неопределено Тогда
		ОчередьТабло = Новый СписокЗначений;
	КонецЕсли;
	Если ОчередьТабло.НайтиПоЗначению(Выражение) = Неопределено Тогда
		ОчередьТабло.Добавить(Выражение);
		СохранитьЗначениеСеансаКонфигуратора("ОчередьТабло", ОчередьТабло);
	КонецЕсли;
	ПоказатьВсплывающееУведомление("Добавлено в очередь табло:
			|" + Выражение);
	ЗапуститьМоноФоновоеЗадание("ДобавитьОчередьВТаблоФоновый");
КонецПроцедуры    

Процедура ЗапуститьМоноФоновоеЗадание(ИмяМетода, Знач МаксДлительностьФоновогоМетода = Неопределено)
	Если Не ЗначениеЗаполнено(МаксДлительностьФоновогоМетода) Тогда
		МаксДлительностьФоновогоМетода = МаксДлительностьФоновогоМетода();
	КонецЕсли;
	КлючСостоянияФоновогоМетода = КлючСостоянияФоновогоМетода(ИмяМетода);
	ДатаЗапуска = ВосстановитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода);
	Если Истина
		И ДатаЗапуска <> Неопределено
		И ТекущаяДата() - ДатаЗапуска < МаксДлительностьФоновогоМетода
	Тогда
		Возврат;
	КонецЕсли;
	// Бесполезная проверка, т.к. предыдущие запуски в другом процессе сидят и тут мы их не увидим
	//ВыбранныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("ИмяМетода, Состояние", ИмяМетода, СостояниеФоновогоЗадания.Активно));
	//Если ВыбранныеЗадания.Количество() > 0 Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода);
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, ТекущаяДата());
КонецПроцедуры

Функция КлючСостоянияФоновогоМетода(ИмяМетода) Экспорт
	Возврат "ДатаЗапускаФоновогоМетода." + ИмяМетода;
КонецФункции    

Функция МаксДлительностьФоновогоМетода() Экспорт
	Возврат 600;
КонецФункции    

Функция ПоказатьВсплывающееУведомление(Текст, ЧислоМиллисекунд = 4000)
	Возврат ТурбоКонф.ПоказатьВсплывающееУведомление(НазваниеСкрипта(), Текст, ЧислоМиллисекунд);
КонецФункции

Процедура ДобавитьОчередьВТаблоФоновый() Экспорт
	КлючСостоянияФоновогоМетода = КлючСостоянияФоновогоМетода("ДобавитьОчередьВТаблоФоновый");
	Попытка
		Успех = Истина;
		МоментНачала = ТекущаяДата();
		Пока Истина Цикл
			Если Ложь
				Или Конфигуратор = Неопределено
				Или ТекущаяДата() - МоментНачала > МаксДлительностьФоновогоМетода() 
			Тогда
				Успех = Ложь;
				Прервать;
			КонецЕсли;
			Если ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно Тогда
				Прервать;
			КонецЕсли;
			ТурбоКонф.Ждать(1000);
		КонецЦикла;
		ОчередьТабло = ВосстановитьЗначениеСеансаКонфигуратора("ОчередьТабло"); // СписокЗначений
		ПредставлениеСписка = СтрСоединить(ОчередьТабло.ВыгрузитьЗначения(), Символы.ПС);
		Если Не Успех Тогда
			ПоказатьВсплывающееУведомление("Не дождались освобождения главного окна конфигуратора. Очередь табло очищена:
			|" + ПредставлениеСписка);
		Иначе
			ТурбоКонф.КонтролАльтКлавиша(Клавиши.W);
			ТурбоКонф.Клавиша(Клавиши.End);
			//НажатьКлавишуЦикл(Клавиши.Left, 2); // Тут не работает смена активной колонки
			Если Не КликнутьПоЭлементу(" Выражение", "неизвестный") Тогда
				ПоказатьВсплывающееУведомление("Не удалось добавить очередь в табло. Очередь табло очищена:
				|" + ПредставлениеСписка);
			Иначе
				Для Каждого ОчередьЭлемент Из ОчередьТабло Цикл
					ТурбоКонф.Клавиша(Клавиши.Down);
					СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
					ТурбоКонф.Клавиша(Клавиши.Enter);
					ЖдатьСменуТекущегоЭлемента(СтарыйИД);
					УстановитьЗначениеПолюВвода(ОчередьЭлемент.Значение);
				КонецЦикла;
				ПоказатьВсплывающееУведомление("В табло добавлены выражения из очереди:
						|" + ПредставлениеСписка);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	СохранитьЗначениеСеансаКонфигуратора("ОчередьТабло", Неопределено);
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
КонецПроцедуры

Процедура СледитьЗаТекущимМетодомФоновый() Экспорт
	КлючСостоянияФоновогоМетода = КлючСостоянияФоновогоМетода("СледитьЗаТекущимМетодомФоновый");
	ДатаАктивностиОкнаСпискаМетодов = Дата(1,1,1);
	Попытка
		Пока Конфигуратор <> Неопределено Цикл
			ПодключениеИР = ПодключениеИРИзКэша();
			Если ПодключениеИР = Неопределено Тогда
				Прервать;
			КонецЕсли; 
			ЗаголовокОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
			Если Ложь
				Или ЗаголовокОкна = "JumpToForm" 
				Или ЗаголовокОкна = "Процедуры и функции"
				Или ЗаголовокОкна = "Закладки"
			Тогда
				ДатаАктивностиОкнаСпискаМетодов = ТекущаяДата();
			КонецЕсли;
			Если Истина
				И ТурбоКонф.ПолучитьАктивноеОкно() = Конфигуратор.ГлавноеОкно 
				И ПолучитьТипТекущегоЭлемента() = ТипЭлемента.Документ
			Тогда
				Если ТекущаяДата() - ДатаАктивностиОкнаСпискаМетодов < 5 Тогда
					ЗапомнитьМетод(Ложь);
				Иначе
					// ТекущийДокумент.Позиция слишком редко обновляется, поэтому бесполезная функция
					//ТекущийДокумент = ТурбоКонф.ИдентифицироватьТекущийДокумент();
					//Если Истина
					//	И ТекущийДокумент <> Неопределено
					//	И ЗначениеЗаполнено(ТекущийДокумент.Позиция)
					//Тогда
					//	ПолеТекстаПрограммыИР(ПодключениеИР, Неопределено, ТекущийДокумент.Позиция,, Ложь, Ложь);
					//КонецЕсли;
				КонецЕсли;
				ДатаАктивностиОкнаСпискаМетодов = Дата(1,1,1);
			КонецЕсли;
			ТурбоКонф.Ждать(2000);
		КонецЦикла;
	Исключение
		ПоказатьВсплывающееУведомление(ОписаниеОшибки());
	КонецПопытки;
	СохранитьЗначениеСеансаКонфигуратора(КлючСостоянияФоновогоМетода, Неопределено);
КонецПроцедуры

//.
// Параметры:
//   ВызыватьИсключение -  - 
//   КлавишаЗакрытия - ПеречислениеСсылка.Клавиши - по умолчанию Escape
Процедура ЗакрытьМодальноеОкно(Знач ВызыватьИсключение = Истина, Знач КлавишаЗакрытия = Неопределено, Знач ЗажатьКонтрол = Ложь, Знач ЧислоМиллисекунд = 1000) Экспорт
	Если КлавишаЗакрытия = Неопределено Тогда
		КлавишаЗакрытия = Клавиши.Escape;
	КонецЕсли;
	Окно = ТурбоКонф.ПолучитьАктивноеОкно();
	Если ЗажатьКонтрол Тогда
		ТурбоКонф.КонтролКлавиша(КлавишаЗакрытия);
	Иначе
		ТурбоКонф.Клавиша(КлавишаЗакрытия);
	КонецЕсли;
	ТурбоКонф.ЖдатьЗакрытияОкна(Окно,, ЧислоМиллисекунд,, ВызыватьИсключение); 
КонецПроцедуры

// Закрыть дочернее (немодальное) окно конфигуратора. В понимании Турбоконфа оно не является окном.
Процедура ЗакрытьДочернееОкноКонфигуратора() Экспорт
	//СтарыйИД = ИдентификаторТекущегоЭлементаОкна();
	ТурбоКонф.ШифтКлавиша(Клавиши.Escape);
	//ЖдатьСменуТекущегоЭлемента(СтарыйИД); // Иногда ИД не меняется
КонецПроцедуры   

//.
// Параметры:
//   СтарыйИД - Строка - идентификатор текущего элемента, полученный методом см. ПолучитьRuntimeIdСтрокой
Процедура ЖдатьСменуТекущегоЭлемента(Знач СтарыйИД, Знач ЧислоМиллисекунд = 2000) Экспорт
	Попытка
		ТурбоКонф.ЖдатьСменуТекущегоЭлемента(СтарыйИД, ЧислоМиллисекунд, Ложь);
	Исключение
		// Иногда возникает непонятная ошибка https://turboconf.ru/Tasks/9760 
		ТурбоКонф.Ждать(100);
	КонецПопытки;
КонецПроцедуры   

Функция УстановитьФокусВПервуюТаблицуИлиСписок(Знач ПерейтиВНачало = Ложь) Экспорт
	Результат = ТурбоКонф.УстановитьФокусНаЭлемент("", "таблицу");
	Если Не Результат Тогда
		Результат = ТурбоКонф.УстановитьФокусНаЭлемент("", "список");
	КонецЕсли; 
	Если ПерейтиВНачало Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.Home);
	КонецЕсли;
	Возврат Результат;
КонецФункции

//.
// Параметры:
//   ТекстУсловия - Строка - 
Процедура ДобавитьУсловиеОстанова(Знач ТекстУсловия) Экспорт
	ТурбоКонф.КонтролКлавиша(Клавиши.F9);
	ТурбоКонф.ЖдатьОкно("Параметры точки останова", 1000, Истина);
	СтарыйТекст = АктивироватьУсловиеВОкнеПараметрыТочкиОстанова();
	Если ЗначениеЗаполнено(СтарыйТекст) Тогда
		ТурбоКонф.КонтролКлавиша(Клавиши.End);
		ТекстУсловия = Символы.ПС + "И " + ТекстУсловия;
	КонецЕсли;
	ТурбоКонф.ВставитьТекст(ТекстУсловия);
	ТурбоКонф.Клавиша(Клавиши.Home);
КонецПроцедуры

Процедура УстановитьФокусВПолеВводаВыраженияОкнаВыражение() Экспорт
	ТурбоКонф.УстановитьФокусНаЭлемент("Рассчитать", "кнопка");
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТурбоКонф.ШифтКлавиша(Клавиши.Tab);
	ТурбоКонф.Ждать(20); // - Для дальнейшего вызова ТурбоКонф.ПолучитьЗначение()
КонецПроцедуры

Процедура НажатиеCtrlENTER() Экспорт
	ЗаголовокТекущегоОкна = ТурбоКонф.ПолучитьЗаголовокТекущегоОкна();
	ТипТекущегоЭлемента = ТурбоКонф.ПолучитьТипТекущегоЭлемента();
	Если Истина
		И ЗаголовокТекущегоОкна = "Редактирование типа данных" 
		И ТипТекущегоЭлемента = ТипЭлемента.ЭлементСписка
	Тогда
		ТурбоКонф.УстановитьСостояниеФлажка(Истина);
	КонецЕсли;
	ТурбоКонф.КонтролКлавиша(Клавиши.Enter); 
КонецПроцедуры

//&ТолькоТекстовыеДокументы
Процедура НажатиеEscape() Экспорт
	ПодключениеИР = ПодключениеИРИзКэша();
	Если ПодключениеИР <> Неопределено Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
		Если ПолеТекстаПрограммы <> Неопределено Тогда
			ФормаВызовМетода = ПолеТекстаПрограммы.ФормаВызовМетода();
			Если ФормаВызовМетода.Открыта() Тогда
				ФормаВызовМетода.Автообновление = Ложь;
				ФормаВызовМетода.Закрыть();
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Побочный эффект https://turboconf.ru/Tasks/10059 
	//ПродолжитьОбработкуНажатияКлавиш();
	ТурбоКонф.Клавиша(Клавиши.Escape); 
КонецПроцедуры

Процедура _ОбновитьПодсказкуПоВызовуМетодаСКонтролемЧастоты() Экспорт
	КлючКэшаЧастота = "ПоследнееОбновлениеПодсказкиВызоваМетода";
	ПоследнийМомент = ВосстановитьЗначениеСеансаКонфигуратора(КлючКэшаЧастота);
	Если Истина
		И ПоследнийМомент <> Неопределено
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - ПоследнийМомент < 200
	Тогда
		Возврат;
	КонецЕсли;
	_ОбновитьПодсказкуПоВызовуМетода();
	СохранитьЗначениеСеансаКонфигуратора(КлючКэшаЧастота, ТекущаяУниверсальнаяДатаВМиллисекундах());
КонецПроцедуры

Функция _ОбновитьПодсказкуПоВызовуМетода() Экспорт
	ПодключениеИР = ПодключениеИРИзКэша();
	Если ПодключениеИР <> Неопределено Тогда
		ПолеТекстаПрограммы = ПолеТекстаПрограммыИзКэша();
		Если ПолеТекстаПрограммы <> Неопределено Тогда
			ФормаВызовМетода = ПолеТекстаПрограммы.ФормаВызовМетода();
			Если ФормаВызовМетода.Открыта() Тогда
				РазобратьПозициюВТексте(Ложь);
				ПолеТекстаПрограммыИР(ПодключениеИР, ТекстМодуля, ПозицияВТексте, ВыделенныйТекст,, Истина);
				//ФормаВызовМетода.ОбновитьПодсказкуПоВызовуМетода(); // Нужно дорабатывать флаг Автообновление
				ФормаВызовМетода.ОбновитьИлиЗакрытьФорму(Ложь, Истина); // полезный только 2й параметр
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура Тест()  
	//ТурбоКонф.Перейти("Документ.Распоряжение");
	//ТурбоКонф.Перейти("НастройкиДинамическогоСпискаTormozit ОбщаяФорма.НастройкиДинамическогоСписка");
